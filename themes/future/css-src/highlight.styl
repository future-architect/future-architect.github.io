// JetBrains Darcula（GoLand などの既定テーマ）に寄せた配色。
// ただし Darcula はエディタ用でWebのアクセシビリティ基準を前提にしておらず、
// そのまま使うとコメント・キーワード・文字列が WCAG AA（4.5）を下回る。
// 色相はDarculaのまま、明度だけ上げて基準を満たすようにしている。
// 以前は Tomorrow Theme 由来の配色だったが、背景が暗くコントラストも低いため
// キーワードが埋もれて見えていた。
highlight-background = #2b2b2b     // 以前は #2d2d2d。わずかに明るくする
highlight-current-line = #323232
highlight-selection = #214283
highlight-foreground = #a9b7c6     // 青みのあるグレー
highlight-comment = #9a9a9a
highlight-red = #ff6b68
highlight-orange = #e08744         // キーワード
highlight-yellow = #ffc66d         // 関数名・型名
highlight-green = #84a86f          // 文字列
highlight-blue = #6897bb           // 数値・リテラル・関数
highlight-purple = #b18ac4
// 横スクロールのつまみ (#2775)。OS 既定の半透明の黒はこの地の上で 1.9 しかなく、
// 出ていても位置が読めない。地に対して 4.10、本文の #a9b7c6 に対しては 1.69 で、
// 見えるが文字と競合しない明るさにする
highlight-scrollbar = #7f8b9c
// 差分専用。文字列の緑（#6a8759）だと削除側の赤に対して弱く見えるため、
// 追加・削除を同じくらいの鮮やかさに揃える
highlight-diff-added = #89d185
highlight-diff-removed = #ff6b68
// 折り返しトグルの外形（絵柄16px＋padding 5px×2＋枠1px×2）。
// トグルは絶対配置で行から外れているので、タブがこの幅を自分で避ける (#2818)
wrap-toggle-size = 28px
article-padding = 20px
// 狭い画面での左右 (#2563)。.container と note（モバイル）と同じ値。
// 箱を画面端まで引き出したぶんの打ち消しとして効き、コードの1文字目が
// 段落の左端に揃う（詳細は末尾のメディアクエリのコメント）
article-padding-narrow = 12px
font-size = 13px

$code-block
  background: highlight-background
  margin: 0
  padding: 15px article-padding
  // 角丸はここで持つ。以前は .highlight table だけに付いていたため、
  // 言語指定の無いコードブロック（figure を作らない素の pre）だけ角が立っていた (#2456)。
  // 値はサイトの角丸3段のうち「箱」の段（_variables.styl の card-radius）
  border-radius: card-radius
  // 枠線は持たない。Astro（Expressive Code）は 1.5px の枠を持つが、
  // あちらはタブバーが全幅でブロックと一体の箱になっているため枠が輪郭として働く。
  // 当サイトはタブを内容幅に縮めているので、枠を入れるとタブと本体の間に
  // 横線が残って2つの部品に見える。ブロック自身の暗さを輪郭にする (#2456)
  border: none
  overflow: auto
  // トラックは transparent。ブロック自身の地がそのまま見える
  scrollbar-color: highlight-scrollbar transparent
  color: highlight-foreground
  // font-size を指定しないと body の 13px を継承してしまい、
  // 本文（.article-entry p の 1.2em = 15.6px）より小さくなって読みにくい。
  // 等幅フォントは同じ値でも字面が大きく見え、暗い背景では膨張して見えるため、
  // 本文よりわずかに小さい 14px にしている（このファイルが元々持っていた値）
  font-size: font-size
  // コードの1行は「行として並ぶもの」なので行の段（_variables.styl の
  // leading-row）。px で持つのは行番号・折り返しトグルが同じ値で高さを揃えるため
  line-height: font-size * leading-row

$line-numbers
  color: #666
  font-size: 0.95em

.article-entry
  pre, code
    font-family: font-mono
  code
    background: var(--surface-mute)
    // 角を丸めて、地色の矩形ではなく「札」として読めるようにする (#2456)
    border-radius: radius-small
    // text-shadow: 0 1px #fff を外した。字の下に白い縁が出て輪郭が二重になり、
    // 等幅の細い字ほど滲んで見えていた。#eee 地に #424242 でコントラスト比 8.7 あり、
    // 縁取りで字を起こす必要がない
    // 本文は font-size 1.2em(15.6px) / line-height 1.75em(27.3px)。
    // 字面が約18pxなので上下の余りは片側4.5px。0.25em(3.9px)までなら
    // 上下の行の札と当たらない
    padding: 0.25em 0.4em
  // リンク内のインラインコードは、link-blue がこの地の上で AA に届かないので
  // 一段暗い段に替える。theme-styles.styl 側にも同じ指定があり（あちらの方が
  // 詳細度が高い）、値は _variables.styl の1箇所から引く
  a code
    color: var(--link-on-tint)
  pre
    @extend $code-block
    code
      background: none
      border-radius: 0
      padding: 0
  // 折り返しトグルの付くブロックだけ、scripts/code_wrap_toggle.js が
  // figure を1枚包む。役割はトグルの位置の基準を横スクロールの外に作ること
  // だけで、この箱自体は背景も余白も持たない (#2821)
  .code-block
    position: relative
  // コードブロックの構造は figure.highlight > figcaption + table。
  // 背景を figure ではなく table に持たせる。figure が背景を持つと
  // ファイル名の行まで幅いっぱいに暗くなり、暗い面積がその分増える
  .highlight
    // 「この箱は今スクロールできるか」を CSS から見るためのコンテナ (#2752)。
    // 折り返しトグルを、実際に溢れているブロックにだけ出すのに使う。
    // scroll-state は寸法の封じ込め（containment）を伴わないのでレイアウトは変わらない
    container-type: scroll-state
    margin: 0
    overflow: auto
    scrollbar-color: highlight-scrollbar transparent
    pre
      border: none
      margin: 0
      padding: 0
    // 横に長いコードでも背景が途切れないよう、内容幅まで伸ばしたうえで
    // 最低でも親幅を確保する。スクロールは figure 側が受け持つ
    table
      @extend $code-block
      display: block
      width: max-content
      min-width: 100%
      margin: 0
    td
      border: none
      padding: 0
    // ファイル名は内容ぶんの幅だけを持つタブにする。
    // 以前はコードブロック上部の全幅バーだったが、暗い面積を減らしたい。
    // 本文と同じ余白に小さなグレー文字が浮いていた頃の
    // 「どのコードブロックの名前か分からない」問題は、タブでも起きない
    figcaption
      // inline-block だと行ボックスのベースライン分の隙間がタブの下に出るため、
      // ブロックのまま内容幅に縮める
      display: block
      width: fit-content
      max-width: 100%
      margin: 0
      padding: 6px article-padding
      background: highlight-background
      border-radius: card-radius card-radius 0 0
      color: highlight-foreground
      // ファイル名はコードではなくブロックのラベルなので、本文と同じ書体にする。
      // Astro（Expressive Code）も UI と中身で書体を分けている
      // （--ec-uiFontFamily はサンセリフ、コードだけ等幅） (#2456)
      font-family: font-ja
      // コード本体と同じ 13px にする。0.85em(11px) では名指ししている
      // コードより小さく、ラベルが従属して見えていた。
      //
      // 1.06em（Astro の UI:コード比）まで上げるとラテン文字は収まりが良いが、
      // ファイル名の3割（2200件中681件）は「Go1.26以前の書き方」のような
      // 日本語で、和文は字面が全角ボックスいっぱいなのに対しラテン小文字は
      // 半分強しか埋めない。同じ font-size でも和文だけ大きく見えるため、
      // 両方に最適な1つの値は無い。中身と同じという説明できる値に置く (#2456)
      font-size: 1em
      line-height: leading-row
      overflow: hidden
      text-overflow: ellipsis
      white-space: nowrap
      vertical-align: bottom
    // ファイル名が長いと、タブが右上の折り返しトグルの下に潜る (#2818)。
    // トグルは絶対配置なので行ボックスを縮めてくれない（float だった頃は
    // 避けていた）。タブ側で幅を空ける。トグルが今出ているかに関わらず引くのは、
    // 出す出さないを決めているのがコンテナクエリで、未対応のブラウザでは
    // 出たままになるため。8px はタブとトグルの間隔
    &:has(> .code-wrap-input) figcaption
      max-width: unquote("calc(100% - " + (wrap-toggle-size + 8px) + ")")
    // タブが乗る側だけ角を落として、タブと本体をつなげて見せる
    figcaption + table
      border-top-left-radius: 0
    // 折り返しトグル (#2752)。scripts/code_wrap_toggle.js が、横に溢れる
    // ブロックにだけ input と label を差し込む。JS は使わず、ランキングの
    // タブと同じ `input:checked` と兄弟結合子で切り替える。
    // 幅768px以上では収まるブロック（code-wrap-narrow）は末尾で隠す
    //
    // input は隠すが display: none にはしない。タブ（radio）はそうしているが、
    // あちらはラベルが常に見えていて選択状態も面で分かる。こちらは
    // 単独の切り替えなので、キーボードで辿れないと押せなくなる。
    //
    // **ラベルを置く帯の高さはこの input が流れの中で作る** (#2844)。
    // ラベルは絶対配置なので場所を空けられず、figure に padding を持たせると
    // figure 自身がコンテナ（container-type: scroll-state）なので
    // 「トグルが今出ているか」で消せない。input なら下の出し分けが
    // そのまま display: none になり、帯も一緒に畳まれる
    .code-wrap-input
      display: block
      appearance: none
      width: 1px
      height: 0
      margin: 0
      opacity: 0
      // 幅1pxとはいえ帯の高さぶん伸びるので、押せる的にしない
      pointer-events: none
    // 帯はファイル名のタブと同じ役。タブがあるブロックはタブ自身が帯なので、
    // 無いブロックだけこの高さを持つ。28px（枠1＋padding5＋絵柄16＋padding5＋枠1）に
    // タブとの間隔4pxを足した値
    &:not(:has(> figcaption)) > .code-wrap-input
      height: wrap-toggle-size
      margin-bottom: 4px
    // ファイル名のタブ（figcaption）と同じ帯の右端に置く。
    // タブより低くしてあるので、両方あるときの帯の高さは今までと変わらない。
    //
    // **基準は figure の外の .code-block** (#2821)。figure は横スクロールを
    // 受ける箱なので、その中を基準にすると（float でも sticky でも絶対配置でも）
    // 中身と一緒に左へ流れて画面外へ出る。sticky が効かないのは、包含ブロックが
    // figure の「見えている幅」しかなく右へ動く余地が無いため
    .code-wrap-label
      position: absolute
      top: 0
      right: 0
      padding: 5px
      // 小物の段（_variables.styl の3段のうち radius-small）
      border-radius: radius-small
      // 触っていないときは絵柄だけ。枠も面も出さない。
      // 枠を消すのではなく透明にするのは、hover と入で寸法が変わって
      // 帯の高さがずれるのを防ぐため（.tab_item と同じ理屈）
      border: 1px solid transparent
      color: var(--ink-mute)
      background-color: transparent
      cursor: pointer
      transition: background-color hover-speed ease, color hover-speed ease
    // 折り返しのアイコン（Tabler Icons v3.31 の text-wrap）。
    //
    // **絵柄をここに置いているのは、フィルターから辞書を引けないため。**
    // アイコンの辞書は _partial/svg-icon.ejs が1箇所で持つ決まり (#2774) だが、
    // このラベルを差し込むのは scripts/code_wrap_toggle.js で、EJS の partial を
    // 呼べない。JS の中に SVG を書くと絵柄が「辞書」と「JS」の2箇所になるので、
    // 絵柄はここだけに置く。EJS 側でも同じ絵柄が要るようになったら、辞書を
    // 共有モジュールへ切り出して両方から引く形にする。
    //
    // mask にするのは色を状態へ追従させるため。background-image だと入
    // （ネイビーの面）で絵柄が黒のまま残る。ラベル自身に mask を掛けると
    // 枠と面まで削られるので、擬似要素に掛ける
    .code-wrap-label::before
      content: ''
      display: block
      width: 16px
      height: 16px
      background-color: currentColor
      wrap-icon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23000' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M4 6h16'/%3E%3Cpath d='M4 18h5'/%3E%3Cpath d='M4 12h13a3 3 0 0 1 0 6h-4l2 -2m0 4l-2 -2'/%3E%3C/svg%3E"
      -webkit-mask: url(wrap-icon) center / 16px 16px no-repeat
      mask: url(wrap-icon) center / 16px 16px no-repeat
    .code-wrap-label:hover
      background-color: var(--surface-mute)
      color: var(--ink-strong)
    // 入は塗りで示す。チップと同じネイビーの面で、押していない状態（枠だけ）と
    // 見間違えない
    .code-wrap-input:checked + .code-wrap-label
      background-color: var(--brand-navy)
      border-color: var(--brand-navy)
      color: #fff
    // input 自体は見えないので、輪郭はラベルに出す
    .code-wrap-input:focus-visible + .code-wrap-label
      outline: 2px solid var(--brand-navy)
      outline-offset: 2px
    .code-wrap-input:checked ~ table
      // 折り返すので内容ぶんの幅は要らない
      width: auto
      // pre の white-space はブラウザ既定が要素に直接当たるので、
      // table 側に書いても継承では上書きできない
      pre
        white-space: pre-wrap
        // 印は本文の左（コードブロックのパディング側）へはみ出すので、
        // pre では切り取らない。pre は $code-block から overflow: auto を
        // 継いでいるが、.highlight の中では padding が 0 なので印がそのまま
        // 切られる。折り返し中は横に溢れないため、隠す必要も無い
        overflow: visible
        // 行を埋めてから割る。overflow-wrap（anywhere / break-word）は
        // 「入らない語をまず次の行へ送り、それでも入らないときだけ割る」ため、
        // `$ curl <長いURL>` が「$ curl」だけの行と URL の行に分かれて3行になる。
        // word-break なら1行目を埋めてから割るので2行で済む。
        // 識別子が途中で切れるが、エディタのワードラップと同じ振る舞い
        word-break: break-all
        // 折り返しで生まれた行に印を出す。行番号が無いので、印が無いと
        // 2行目が続きなのか元からの改行なのか読めない。
        //
        // **折り返したかどうかを選ぶセレクタは無いが、「2行目以降」は塗れる。**
        // 論理行をブロックにして、背景を1行ぶん下へずらして敷く。1行に収まった
        // 行では高さが 0 以下になり何も出ないので、実際の描画に対して正確に出る。
        // ビルド時に行の幅を測ってメディアクエリで出し分ける手もあるが、
        // 768px 未満はコードの幅が画面幅に連動して連続に変わるので当たらない。
        //
        // **ぶら下げインデントは置かない。** padding で content edge を動かすと
        // タブ幅（tab-size: 2em）の起点もそこへ移り、字下げの深さごとにコードの
        // 位置がずれる。折り返しの入切で字下げが動いてはいけない
        .line
          display: block
          // 印は本文の左に出す。負のマージンで箱をパディング側へ広げ、同じ幅の
          // padding で戻すので content edge は動かない（＝字下げも変わらない）
          margin-left: -8px
          padding-left: 8px
          // 素の .line は1行ぶんの固定高。折り返すと足りなくなる。
          // 空行は中身が無く高さを持てないので下限を置く
          height: auto
          min-height: font-size * leading-row
          // 2行目の頭から下端まで1本の縦線を引く。始点は1行ぶんを整数に切り上げた
          // 位置で、丸め誤差で1行目に線の切れ端が乗らないようにする。
          // 引く長さを始点より 2px 多く削るので、折り返していない行では
          // 長さが負になり線そのものが出ない
          wrap-line-top = ceil(font-size * leading-row)
          background-image: linear-gradient(highlight-comment, highlight-comment)
          background-repeat: no-repeat
          background-size: 2px unquote('calc(100% - ' + (wrap-line-top + 2px) + ')')
          background-position: left 2px top wrap-line-top
        // 論理行が block になったぶん、行区切りの <br> は空行を1つ増やしてしまう
        br
          display: none
    .gutter pre
      @extend $line-numbers
      text-align: right
      padding-right: 20px
    .line
      height: font-size * leading-row
  .gist
    margin: 0 article-padding * -1
    border-style: solid
    border-color: var(--rule-base)
    border-width: 1px 0
    background: highlight-background
    padding: 15px article-padding 15px 0
    .gist-file
      border: none
      font-family: font-mono
      margin: 0
      .gist-data
        background: none
        border: none
        .line-numbers
          @extend $line-numbers
          background: none
          border: none
          padding: 0 20px 0 0
        .line-data
          padding: 0 !important
      .highlight
        margin: 0
        padding: 0
        border: none
      .gist-meta
        background: highlight-background
        color: highlight-comment
        font: 0.85em font-sans
        text-shadow: 0 0
        padding: 0
        margin-top: 1em
        margin-left: article-padding
        // 暗い地の上のリンク色。旧 color-link（#258fb8）は 3.84 で AA 未満
        // だった（この地では 7.33）
        a
          color: #57c8eb
          font-weight: normal
          &:hover
            text-decoration: underline

pre
  .comment
    color: highlight-comment
  .variable
  .attribute
  .tag
  .regexp
    color: highlight-red
  // CSS のセレクタ (#2608)。旧 .css .class / .id / .pseudo の後継で、色も引き継ぐ。
  // 言語をネストさせる書き方（.css .id）は v11 では当たらない。
  // language-css という単一クラスで出すため、子孫セレクタの親側が存在しない
  .selector-class
  .selector-tag
  .selector-pseudo
  .selector-id
    color: highlight-red
  .number
  .literal
    color: highlight-blue
  .built_in
  .params
    color: highlight-orange
  // 型名・関数名。以前 .title はコメント色で、関数名が地味に見えていた
  .class
  .type
  .title
    color: highlight-yellow
  // アノテーション・デコレータ (#2608)。Java の @RestController、Python の
  // @pytest.mark.parametrize、Dart の @override、C のプリプロセッサ指令。
  // Darcula がアノテーションに当てているのは黄緑寄りの色なので、パレットの黄を採る。
  // 旧 .preprocessor（オレンジ）と旧 .python .decorator（青）の後継にあたるが、
  // 2つの色に分かれていたものが v11 では meta 1つに統合されている
  .meta
    color: highlight-yellow
  .string
    color: highlight-green
  // 文字リテラル (#2608)。文字列の仲間なので同じ色にする
  .character
    color: highlight-green
  .function
    color: highlight-blue
  // 名前と値の組の「名前」側 (#2608)。YAML・JSON のキー、TypeScript の
  // オブジェクト型のキー、JavaScript のプロパティ名。
  // Darcula が YAML のキーと インスタンスフィールドに当てている紫に対応する。
  // これまで紫は csv の5列目でしか使っておらず、色数は増えない。
  //
  // YAML はキーと値しかない言語なので、キーが地の文の色だと
  // 「文字列の緑」と「地の文」の2色にしかならず、他の言語に比べて平坦に見えていた
  .attr
  .property
    color: highlight-purple
  // 区切り記号 (#2608) は中身より一段引く。JSON の { } : , は6,528箇所あって
  // 構造の骨組みでしかなく、中身と同じ強さで出ると記号の並びが目に付く。
  // csv-comma と同じ判断。
  //
  // 演算子（.operator、sql 1,655 / java 228）には色を付けない。Darcula も
  // 演算子は地の文の色で出す。加えて sql の operator の内訳は EXPLAIN の
  // 罫線 | が528箇所を占めており、色を付けると罫線が主役になる
  .punctuation
    color: highlight-comment
  // console / shell のプロンプト（$）も引いた色にする。隣のコマンドより
  // 目立つ理由が無い。
  //
  // highlight.js はプロンプトを class="meta prompt_" の2クラスで出すため、
  // .meta（黄）と .prompt_ が同じ要素に当たる。単独クラス同士では詳細度が
  // 並ぶので、どちらが効くかは記述順しだいになる。順序で決めると
  // 「どこで最終値が決まるか追えない」状態になり、CSSの文字サイズで
  // 2度踏んだ罠（#1927 / #1928）と同じ形なので、詳細度で明示して決める。
  // 239箇所すべてがこの2クラスの組（console 121 / shell 118）
  .meta.prompt_
    color: highlight-comment
  // キーワードは太字にして最も目立たせる（JetBrains と同じ扱い）
  .keyword
    color: highlight-orange
    font-weight: bold
  // Markdown / AsciiDoc の記法 (#2460)。言語自体は highlight.js の既定バンドルに
  // 入っていてトークンには分かれていたが、これらのクラスに色の指定が無く、
  // すべて地の文の色で出ていた（＝ハイライトされていないように見えた）。
  // 色は既存のパレットから選び、新しい色は増やしていない
  .section
    color: highlight-yellow
    font-weight: bold
  .bullet
    color: highlight-orange
  .quote
    color: highlight-comment
  .code
    color: highlight-green
  .link
  .symbol
    color: highlight-blue
  // 強調は色を持たせず、字面だけで示す。
  //
  // 強調は「目立たせる」だけで意味の種類を表さないため、構文の色（見出しの黄、
  // 記号のオレンジ）と並ぶと色が役割の手がかりにならなくなる。かといって
  // 明度だけ上げる案も、地の文との差を付けると浮いて見えた（11.49 → 9.44 →
  // 8.18 と3段階下げても明るく感じる）。太字・斜体という字面の変化だけで
  // 強調は十分に伝わるので、色は地の文のまま置く。
  //
  // なお highlight.js は ** ごと1つの span にするので（`**text**` で1トークン）、
  // 記号だけを別扱いにすることはそもそもできない
  .strong
    font-weight: bold
  .emphasis
    font-style: italic
  // csv は列ごとに色を変える（scripts/csv_column_highlight.js、#2529）。
  // 色は構文の意味ではなく列の位置を表すだけなので、専用の色は作らず既存の
  // トークン色を順に借りる。csv のブロックには他のトークンが出ないため、
  // 同じ色でも意味が衝突しない。6色で足りない列は先頭に戻って循環する
  .csv-col-1
    color: highlight-orange
  .csv-col-2
    color: highlight-yellow
  .csv-col-3
    color: highlight-green
  .csv-col-4
    color: highlight-blue
  .csv-col-5
    color: highlight-purple
  .csv-col-6
    color: highlight-foreground
  // 区切りは列の中身より一段引く。カンマが色の主役になると列の切れ目より
  // 記号の並びが目に付く
  .csv-comma
    color: highlight-comment
  // diff_[language] ではキーワードから色を外し、太字だけ残す。
  // 差分の赤緑と構文の色が同時に出ると色数が多すぎて読み取りにくいため
  .keyword-plain
    font-weight: bold
  // diff_[language]（scripts/diff_language_highlight.js）では、差分行の中にも
  // 言語の構文ハイライトの span が入る。差分であることの方が重要なので、
  // 行内の子要素まで色を上書きして差分の色を優先する。
  // font-weight には触らないため、キーワードの太字はそのまま残る
  .deletion
  .deletion *
    color: highlight-diff-removed
  .addition
  .addition *
    color: highlight-diff-added

// 狭い画面ではコードを画面端まで伸ばし、左右の余白を詰める (#2563)。
// note（#2521）と同じ構えで、技術ブログの主役であるコードに幅を渡す。
//
// 幅375pxで1行に見える字数は 39.9 → 45.0 字になる（本文カラム351px・
// padding 40px の 311px から、100vw・padding 24px の 351px へ）。
// 横スクロールが必要なブロックは 71.8% から 64.0% に下がる。
//
// padding が 12px なのは、箱を端まで引き出したぶんの打ち消しとして効かせて
// コードの1文字目を段落の左端に揃えるため。note と同じ理屈で、値も同じ。
// ファイル名のタブも同じだけ詰める（詰めないとタブの文字とコードの
// 1文字目が8pxずれる）。
//
// 当初は「横スクロールする箱を画面端に接させると戻るスワイプと競合する」
// として全幅を避けたが、これは誤りだった。ブラウザが端ジェスチャを
// スクロール要素へ渡すのは、その方向にスクロールできるときだけで、
// コードは読み込み時 scrollLeft が 0 なので戻る向きの払いは吸われない。
// 12px の余白も逃げ場になっていない（端ジェスチャの判定領域より狭い）。
@media (max-width: 767px)
  .article-entry
    pre
      padding-left: article-padding-narrow
      padding-right: article-padding-narrow
    .highlight
      table
        padding-left: article-padding-narrow
        padding-right: article-padding-narrow
      figcaption
        padding-left: article-padding-narrow
        padding-right: article-padding-narrow
    // 端まで伸ばすのは .article-entry の直下にあるコードだけ (#2568 と同じ形)。
    // calc(50% - 50vw) の 50% は包む箱の幅を指すので、折りたたみ（141件）や
    // 箇条書き（117件）の中では包む箱のぶんだけ余分に外へ出てしまう。
    // details の中では overflow: hidden に切り落とされる。
    //
    // トグルの付くブロックは figure が .code-block に包まれている (#2821)。
    // **伸ばすのは包む箱の側**で、figure ではない。ラベルの位置は
    // .code-block を基準にするので、箱が画面端まで伸びていないと
    // ラベルだけコードの内側に取り残される
    > figure.highlight,
    > .code-block,
    > pre
      margin-inline: calc(50% - 50vw)
    // 画面端まで伸びた面に角丸は掛からない
    > pre
      border-radius: 0
    > figure.highlight,
    > .code-block > figure.highlight
      table
        border-radius: 0
      // タブは内容幅のまま。左は画面端に接するので落とし、右上だけ残す
      figcaption
        border-radius: 0 card-radius 0 0
      // 画面端まで伸びたぶん、トグルもコードの1文字目と同じだけ内側へ入れる
      .code-wrap-label
        right: article-padding-narrow

// **実際に横スクロールできるブロックにだけトグルを出す** (#2752)。
//
// ビルド時に測れるのは行の幅までで、読者の画面幅・当たる等幅フォントの字送り
// （SF Mono 0.6em / Consolas 0.55em）・拡大率は分からない。そのため
// scripts/code_wrap_toggle.js の閾値は余裕を取った見積もりでしかなく、
// 「押しても何も起きないトグル」が残る。scroll-state のコンテナクエリなら
// ブラウザに「今スクロールできるか」を聞けるので、見積もりが要らない。
//
// **未対応のブラウザでは出したままになる**（安全側）。未知の機能名を含む
// コンテナクエリは条件が unknown になり、not を付けても一致しないため。
// その場合は下のメディアクエリだけが効く。
// **@css で素の CSS として通す。** Stylus は @container を知らず、条件を
// 落として `@container;` だけを出す。中身が無条件で効いてトグルが全部消える
@css {
  @container not scroll-state(scrollable: inline) {
    .article-entry .highlight .code-wrap-input,
    .article-entry .highlight .code-wrap-label {
      display: none;
    }
    /* 折り返しを入にすると溢れが消えてこの条件に入るので、入のときは出したまま。
       でないと一度折り返したら戻せなくなる */
    .article-entry .highlight .code-wrap-input:checked {
      display: block;
    }
    .article-entry .highlight .code-wrap-input:checked + .code-wrap-label {
      display: block;
    }
  }
}

// scroll-state に未対応のブラウザ向けの見積もり。幅768px以上ではコードに
// 使える幅が最小でも 656px あるので、それより狭いブロックは横スクロールしない。
// 640px より広いブロックは、サイドバーが出る 1025px 以上で溢れうるため残す
@media (min-width: 768px)
  .article-entry .highlight .code-wrap-narrow,
  .article-entry .highlight .code-wrap-narrow + .code-wrap-label
    display: none
  .article-entry .highlight .code-wrap-narrow:checked
    display: block
  .article-entry .highlight .code-wrap-narrow:checked + .code-wrap-label
    display: block
