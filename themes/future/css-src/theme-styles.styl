/* Custom Hatebu Button */
.hatebu-btn,
.hatebu-btn:visited {
  /* #1b95e0 は白背景に対してコントラスト比3.27で、11pxの文字ではAA基準(4.5)に満たない。
     同系色のまま暗くして5.65まで上げる。枠線と hover 時の背景は視認性に影響しないため元の色のまま */
