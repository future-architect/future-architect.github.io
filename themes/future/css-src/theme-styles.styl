/* General Overrides of Metronic */
@import "highlight"

/***
Footer
***/
/* 地はブランドのネイビー (#2839)。白地の本文との切れ目を面で作る。
   以前はグレー地＋ネイビーの円の見出しだったが、フッターごと作り直した。
   暗地の上の文字・面・差し色は :root の --on-dark-* / --navy-raised /
   --crimson-on-dark が持つ */
.site-footer {
  background-color: var(--brand-navy);
  color: var(--on-dark-mute);
  font-size: text-base;
}
.site-footer .container {
  padding-top: 64px;
  padding-bottom: 24px;
}
/* 4列。ブランドの列だけ広く取る（説明文とアイコンが入る） */
.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1.4fr;
  gap: 48px;
  margin-bottom: 48px;
}
@media (max-width: 991px) {
  .footer-grid {
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
}
/* 狭い幅でも、行が短い2列（リソース・アクティビティ）は横に並べる。
   1列に積むとフッターだけで画面数枚ぶんの高さになる。
   説明とアイコンを持つブランドの列と、ボタンを持つコンタクトの列は
   横幅が要るので全幅にする */
@media (max-width: 575px) {
  .footer-grid {
    grid-template-columns: 1fr 1fr;
    gap: 32px 24px;
  }
  .footer-brand,
  .footer-col-contact {
    grid-column: 1 / -1;
  }
}

/* ブランドの列 */
.footer-logo {
  display: inline-block;
  color: var(--on-dark-strong);
  font-size: text-title;
  font-weight: 700;
  text-decoration: none;
}
.footer-logo:hover,
.footer-logo:focus {
  color: var(--on-dark-strong);
  text-decoration: none;
}
.footer-desc {
  margin: 12px 0 0;
  line-height: leading-body;
}

/* 見出しは列のラベル。本文の h2（1.85em）とは役が違うのでここで持つ */
.footer-heading {
  margin: 0 0 16px;
  color: var(--on-dark-strong);
  font-size: text-base;
  font-weight: 700;
  letter-spacing: 0.05em;
}

.footer-list {
  margin: 0;
  padding: 0;
  list-style: none;
}
.footer-list li + li {
  margin-top: 10px;
}
/* 企業情報だけは短いラベルが3つ並ぶので横に流す */
.footer-list-inline {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 16px;
}
.footer-list-inline li + li {
  margin-top: 0;
}

/* リンクは静止時に下線を持たず、hover で下線が左から伸びる (#2839)。
   サイトの他のリンクは hover-speed の素の下線だが、フッターは
   読者がわざわざ辿り着いた先で、ここだけ動きを持たせても認知負荷にならない。
   速さの段を増やさないよう、フッター専用の値をここ1箇所で持つ */
.site-footer .footer-link {
  position: relative;
  display: inline-block;
  color: var(--on-dark);
  text-decoration: none;
  /* 文字の濃さは他の部品と同じ hover-speed で変える。ここが無いと、
     下線が伸びている間に色だけ先に切り替わって足並みが揃わない */
  transition: color hover-speed ease;
}
.site-footer .footer-link::after {
  content: '';
  position: absolute;
  left: 0;
  bottom: -2px;
  width: 100%;
  height: 1px;
  background-color: var(--crimson-on-dark);
  transform: scaleX(0);
  transform-origin: bottom right;
  transition: transform footer-underline-speed ease;
}
.site-footer .footer-link:hover,
.site-footer .footer-link:focus {
  color: var(--on-dark-strong);
  text-decoration: none;
}
.site-footer .footer-link:hover::after,
.site-footer .footer-link:focus::after {
  transform: scaleX(1);
  transform-origin: bottom left;
}
/* 動きを減らす設定では下線を出したまま止める。反応そのものは消さない */
@media (prefers-reduced-motion: reduce) {
  .site-footer .footer-link::after {
    transition: none;
  }
}

/* OSS の印。ラベルの一部ではなく属性なので、地を一段上げた小さなチップにする */
.footer-tag {
  margin-left: 6px;
  padding: 1px 5px;
  border-radius: radius-small;
  background-color: var(--navy-raised);
  color: var(--on-dark-mute);
  font-family: font-mono;
  font-size: text-meta;
  vertical-align: 1px;
  transition: background-color hover-speed ease, color hover-speed ease;
}
/* 行ごと反応させる。チップだけ地のままだと、下線が伸びる間そこだけ取り残される */
.footer-link:hover .footer-tag,
.footer-link:focus .footer-tag {
  background-color: var(--brand-crimson);
  color: var(--on-dark-strong);
}

/* 購読・フォローの丸 */
.footer-social {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin: 24px 0 0;
  padding: 0;
  list-style: none;
}
.footer-social li {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
.footer-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  /* Lighthouse の target-size（最低24px）を満たす段。記事のシェアボタンと同じ */
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background-color: var(--navy-raised);
  color: var(--on-dark);
  text-decoration: none;
  transition: background-color hover-speed ease, color hover-speed ease;
}
.footer-icon:hover,
.footer-icon:focus {
  background-color: var(--brand-crimson);
  color: var(--on-dark-strong);
  text-decoration: none;
}
.footer-icon .svg-icon {
  width: 18px;
  height: 18px;
  margin-right: 0;
}
/* Feedly のマークは Tabler に無く、輪郭ではなく塗りの図形。mask で
   currentColor を拾わせ、他のアイコンと同じ色の振る舞いにそろえる */
.footer-icon-feedly::before {
  content: '';
  width: 18px;
  height: 18px;
  background-color: currentColor;
  -webkit-mask: url("data:image/svg+xml;base64,") center / contain no-repeat;
  mask: url("data:image/svg+xml;base64,") center / contain no-repeat;
}
/* 購読者数。丸の中ではなく下に置く。数字はアイコンの一部ではなく実績で、
   押す対象でもない（記事のシェア数を枠の外に出しているのと同じ #2716） */
.footer-count {
  color: var(--on-dark-mute);
  font-family: font-mono;
  font-size: text-meta;
  /* 桁が変わってもアイコンの中心からずれない */
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

/* コンタクトの列 */
.footer-contact {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.footer-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.footer-label {
  color: var(--on-dark-mute);
  font-size: text-meta;
  font-weight: 700;
  letter-spacing: 0.05em;
}
.footer-btn-row {
  display: flex;
  gap: 8px;
}
.footer-btn-row .footer-btn {
  flex: 1 1 0;
}
/* アイコンだけのボタン。X はアイコンが「X」と読めるので文字を重ねない (#2036)。
   幅は隣の「メール」と等分のまま。X で問い合わせてもらう方が望ましいので、
   文字が無いぶん細くして目立たなくすることはしない。
   .svg-icon の既定は文字の前に置く前提で右に間隔を持つので、文字が無いぶん戻す */
.footer-btn-icon .svg-icon {
  margin-right: 0;
}
/* ボタンの土台。コンタクトの3つと下段の誤字報告で共有する */
.footer-btn,
.footer-pr {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 14px;
  border: 1px solid var(--rule-on-dark);
  border-radius: radius-small;
  color: var(--on-dark);
  font-size: text-meta;
  text-decoration: none;
  transition: background-color hover-speed ease, border-color hover-speed ease, color hover-speed ease;
}
/* フッターのボタンは2段。記事への問い合わせ（メール / X）は枠だけの控えめな形で、
   hover は地を一段上げるところまで */
.footer-btn:hover,
.footer-btn:focus {
  background-color: var(--navy-raised);
  border-color: var(--navy-raised);
  color: var(--on-dark-strong);
  text-decoration: none;
}
/* もう一段上。お仕事のご相談と誤字報告に使う。静止時から地を一段上げた面で、
   hover でクリムゾンに塗る。差し色を静止時に置くと「仕事が欲しい」主張が
   強く出すぎるので、反応にだけ使う。
   .footer-btn と同じ詳細度なので、後に置いて勝たせる */
.footer-btn-fill,
.footer-pr {
  background-color: var(--navy-raised);
  border-color: var(--navy-raised);
}
.footer-btn-fill:hover,
.footer-btn-fill:focus,
.footer-pr:hover,
.footer-pr:focus {
  background-color: var(--brand-crimson);
  border-color: var(--brand-crimson);
  color: var(--on-dark-strong);
  text-decoration: none;
}
.footer-btn .svg-icon,
.footer-pr .svg-icon {
  width: 15px;
  height: 15px;
}

/* 下段。区切りは面ではなく線で、地との差は 1.22 */
.footer-bottom {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding-top: 24px;
  border-top: 1px solid var(--rule-on-dark);
  font-size: text-meta;
}
.footer-bottom-links {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 20px;
}
.footer-pr {
  padding: 6px 12px;
}
.footer-credo {
  margin: 0;
  color: var(--on-dark-mute);
  font-family: font-mono;
  font-size: text-meta;
}
/* 飾りの記号。いいねの ♡（#2755 で塗らないと決めたもの）とは別物で、
   押せる部品ではないため塗ってよい */
.footer-heart {
  color: var(--crimson-on-dark);
}
@media (max-width: 767px) {
  .footer-bottom {
    flex-direction: column;
    align-items: flex-start;
  }
}

/* 短いページでフッターが画面の中ほどに浮くのを防ぐ (#2590)。

   .wrap（ヘッダー＋本文＋フッターの外枠）を縦のフレックスにして、
   フッターだけ auto マージンで下へ寄せる。ページが画面より高ければ
   これまでどおり本文のあとに続く。

   露出したのは /specials/ を作ってから。中身が h1 と段落とリンク3本しか
   無く、サイトで最も短いページになった。それまではサイドバーの
   カテゴリ一覧（18件）がどのページでも高さを作っていた。

   フッターの後ろにあるのは GA の <script> だけ（display: none）なので、
   auto マージンの余りはフッターの上に入る */
.wrap {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  /* モバイルの 100vh はアドレスバーを含む高さなので、短いページで
     わずかにスクロールが出る。対応ブラウザでは表示領域ぶんに直す */
  min-height: 100dvh;
}
.wrap > footer {
  margin-top: auto;
}

/* パンくず (#2705)。現在地（url を持たない末尾の項目）に当たるスタイルが無く、
   リンクと同じ色・下線なしで並んでいた。記事ページとカテゴリ一覧は同じ3項目が
   並ぶので（ホーム > カテゴリ > Programming）、末尾がリンクかどうかしか違いが無く、
   人には区別が付かなかった。機械には itemprop="item" の有無で伝わっている */
.breadcrumb {
  /* metronic が `font: 14px "Open Sans", sans-serif` の一括指定でフォントを
     決めていて、ここだけ本文の font-ja から外れていた。Webフォントは
     読み込んでいないので 'Open Sans' は効かず総称 sans-serif に落ちる。
     中身は日本語のラベルなので本文と同じスタックに戻す。
     サイズ 14px は metronic 側の1箇所に残す */
  font-family: font-ja;
  color: var(--ink-mute);
}
/* 区切りの記号は項目より弱くする。読む対象ではなく並びの目印 */
.breadcrumb > li + li:before {
  color: var(--ink-faint);
}
/* metronic の #5f6d7b は ink の3段（#2534）の外にある色で、役割で選んだ値ではない */
.breadcrumb a,
.sg-crumb {
  color: var(--ink-mute);
}
/* 添えの情報のリンクと同じ「ink-mute から ink-strong へ一段濃く＋下線」(#2699)。
   打ち消しが無いと metronic の a:hover が勝って青（--a-color）に飛ぶ */
.breadcrumb a:hover,
.breadcrumb a:focus,
.sg-crumb-hover {
  color: var(--ink-strong);
  text-decoration: underline;
}
/* 現在地は太さだけで示す (#2722)。#2705 では ink-strong にも濃くしていたが、
   14px の帯の中で色と太さを同時に動かすと現在地だけ黒く浮いて見えた。
   色はリンクと同じ ink-mute のまま（.breadcrumb から継ぐ）。
   下線も付けない。リンクの hover が ink-strong ＋下線なので、太字・下線・素の
   3つで現在地・hover 中のリンク・リンクが見分けられる。
   太字をリンク側に広げないのは、2〜4項目すべてが太いと帯が重くなり現在地の
   強調が消えるため（日付・著者名の太字は単独で置くメタ情報という違いがある） */
.breadcrumb > li.active,
.sg-crumb-current {
  font-weight: bold;
}

/* ページャ。丸い的が並ぶ帯なので、間隔はタブ（.tab_item）と同じ
   space-step の1段で持つ。狭い幅では項目が折り返す。

   **左は丸の内側の余白ぶん引き戻す。** 白い丸は地と同じ色で見えないので、
   帯は「文字の列」として読まれる。揃える相手は列の基準線（パンくず・節見出し・
   .pagination-info・フッターのサイト名）で、引き戻さないと文字だけが 12px
   右へずれる。ページャは記事1件の中の部品ではなく列全体に対する送りなので、
   カードの中身（.col の padding のぶん基準線より 12px 右）には合わせない。
   負の値を丸の padding と同じ変数から引いて、片方だけ動かせないようにする。

   以前は下にランキングとタグ一覧が続いていて間隔が埋まっていたが、
   それらをホーム以外から外した（#2006）ことで、記事カードとフッターに
   挟まれて窮屈に見えるようになった。上下に余白を置く */
pager-pad-x = space-step * 3
.pagination {
  display: flex;
  flex-wrap: wrap;
  gap: space-step;
  margin: 48px 0 56px (- pager-pad-x);
}
.pagination > a,
.pagination > span {
  border: none;
  border-radius: 999px;
  /* metronic 由来の #868c93 は白地で 3.39 しかなく WCAG AA に届かない。
     添えのリンクの段（白地で 6.19）に寄せる */
  color: var(--ink-mute);
  padding: 6px pager-pad-x;
  line-height: leading-row;
  text-decoration: none;
  background-color: var(--surface-base);
  transition: background-color hover-speed ease, color hover-speed ease;
}
.pagination > a:hover,
.pagination > a:focus {
  color: var(--brand-navy);
  background-color: var(--surface-mute);
}
/* 塗るのは選択中のページだけ。span 全体に掛けると省略の「…」
   （span.space）まで塗られ、クリックできそうに見えて迷わせる (#2091)。
   「…」は base の .pagination > span（グレー文字・白地）のままにする */
.pagination span.current {
  color: var(--on-dark-strong);
  cursor: default;
  background-color: var(--brand-navy);
}
.pagination .space {
  cursor: default;
}

/* フッター直前に来る最後のブロックに付ける共通クラス。
   間隔はページ送りの下（.pagination）に揃える */
.footer-gap {
  margin-bottom: 56px;
}

/* Extra info topbar tweaks */
@media (max-width: 480px) {
  .pre-header .list-inline li {
    margin-bottom: 2px;
  }
  .page-header-fixed .pre-header {
    opacity: 0;
  }
}
@media (max-width: 767px){
  .pre-header .pull-right {
      float: right !important;
  }
}

/* Menu tweak */
@media (max-width: 1024px) {
  .page-header-fixed .header-navigation {
	  height: auto !important;
  }
}

/* Typography and Posts */
p {
  line-height: leading-row;
}
.article-entry p,
.article-entry li {
  text-align: inherit !important;
  line-height: leading-body !important;
  font-size: text-body;
  color: var(--ink-strong);
}
/* details の summary は p / li と違って本文サイズの指定対象から漏れており、
   body の 13px を継承して周囲（1.2em = 15.6px）より小さく表示されていた */
.article-entry summary {
  font-size: text-body;
  line-height: leading-body;
}

/* 画像のキャプション (#2517)。記事側は Zenn と同じく画像の直下を `*` で挟んで書き、
   scripts/figure_caption.js が figure/figcaption に組み替える。
   コードブロックのファイル名も figcaption だが、あちらは figure.highlight の中で
   highlight.styl が濃い色のタブに仕立てているので、:not(.highlight) で分ける */
/* 画像は左寄せ（.blog-item img に中央寄せの指定はない）。キャプションを
   カラム幅で中央寄せすると、幅の狭い画像でキャプションだけ右にずれる。
   display: table でボックスを画像の幅に縮め、その中で中央に置く */
.article-entry figure:not(.highlight) {
  display: table;
  max-width: 100%;
  margin: 24px 0;
}
.article-entry figure:not(.highlight) > figcaption {
  display: table-caption;
  caption-side: bottom;
  padding-top: 8px;
  /* 本文（1.2em = 15.6px）より一段小さくして、図の補足だと分かるようにする */
  font-size: text-row;
  /* 本文の #424242 より薄いが、白地でコントラスト比 6.19 は確保する */
  color: var(--ink-mute);
  text-align: center;
}

/* 表示数式（$$ ... $$）を左寄せにする (#2598)。画像・コードブロックと同じく
   本文の左端から始め、ブロック要素で数式だけが中央に飛ぶ状態をやめる。
   hexo-filter-mathjax は中央寄せの <style> を </head> 直前（site.css の
   <link> より後）に注入するので、同じ詳細度では負ける。.article-entry を
   前置して上書きする。
   上下の空きは画像（figure の 24px）に合わせる。既定の 1em は数式の
   フォントサイズ基準なので、式の大きさで空きが変わってしまう */
.article-entry mjx-container[jax='SVG'][display='true'] {
  text-align: left;
  margin: 24px 0;
}

/* 本文中の折りたたみをグレーの枠で囲む (#2457)。畳まれた中身があることが
   形で分かるようにする。作りはモバイル目次の箱（.toc-mobile）と同じ。
   Zenn は中身を専用の要素で包んで枠を分けているが、Hexo の出力は
   summary と中身が直接並ぶだけなので、枠は details 自身に持たせ、
   中身の左右の余白は子要素のマージンで作る（コードブロックの地を
   枠いっぱいに広げないため padding ではなく margin）。
   記事末尾の関連記事などの折りたたみは .article-entry の外なので影響しない */
/* 中身の余白は枠側のパディングで決める。子要素のマージンに持たせると、
   .article-entry .highlight { margin: 0 }（詳細度が上）に負けて
   コードブロックだけ左右が枠いっぱいに広がり、下だけ空くという
   不揃いになる。summary は負のマージンで枠幅いっぱいに戻す */
.article-entry details {
  margin: 24px 0;
  /* 全体指定の details { padding-bottom: 24px } もここで上書きする */
  padding: 0 14px;
  border: 1px solid var(--rule-base);
  border-radius: card-radius;
  /* 本文の大きさは p / li にしか指定が無く、折りたたみの中身は
     <div>（62件）や <dd>（18件）で書かれることが多い。それらは指定から
     漏れて body の 13px に落ち、本文より小さく出ていた。中身の入れ物が
     何であっても本文と同じになるよう、ここで基準を与える */
  font-size: text-body;
}
/* 自前で 1.2em を持つ子には二重に掛けない */
.article-entry details p,
.article-entry details li {
  font-size: 1em;
}
/* コードは 13px 固定。ファイル名（figcaption）が 1em でコード本体と同じ
   大きさを得ているので、details の 1.2em を図ごと持ち込まない (#2456) */
.article-entry details figure.highlight {
  font-size: text-base;
}
/* 閉じているときに下の余白を持たせると、見出しだけの高さが不必要に伸びる */
.article-entry details[open] {
  padding-bottom: 14px;
}
/* 末尾の要素が持つ下マージンは枠の余白と二重になり、下だけ広く見える。
   コードブロックは .article-entry .highlight（詳細度が上）に勝つよう別に書く */
.article-entry details > :last-child {
  margin-bottom: 0;
}
.article-entry details > .highlight:last-child {
  margin-bottom: 0;
}
/* 折り返しトグルの付くコードブロックは .code-block に包まれているので、
   直接子のセレクタから外れる (#2821)。包む箱の margin を 0 にしても
   中の figure の下マージンが相殺で抜けてくるため、figure 側に書く */
.article-entry details > .code-block:last-child > .highlight {
  margin-bottom: 0;
}
.article-entry details > summary {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 -14px;
  padding: 10px 14px;
  /* details 側で 1.2em を持つので、summary の 1.2em は打ち消す */
  font-size: 1em;
  /* 既定の三角は位置を制御できないので消し、回転させられる疑似要素に置き換える */
  list-style: none;
  transition: background-color hover-speed ease;
}
.article-entry details > summary::-webkit-details-marker {
  display: none;
}
.article-entry details > summary::before {
  content: "";
  width: 0;
  height: 0;
  flex-shrink: 0;
  border-left: 6px solid var(--ink-faint);
  border-top: 5px solid transparent;
  border-bottom: 5px solid transparent;
  transition: transform 0.2s ease;
}
.article-entry details[open] > summary::before {
  transform: rotate(90deg);
}
.article-entry details > summary:hover {
  background-color: var(--surface-mute);
}
/* 中身との間隔も summary 側で持つ。子要素の margin-top では
   コードブロック（margin: 0）に負ける */
.article-entry details[open] > summary {
  margin-bottom: 14px;
  border-bottom: 1px solid var(--rule-base);
}

/* 開閉を高さのアニメーションで見せる。対応ブラウザだけの上乗せで、
   未対応なら今までどおり即座に開く。
   interpolate-size は継承するので details に置き、サイト全体には広げない */
/* 折りたたみは本文の外にもある（モバイル目次・関連記事・ランキング・被参照）。
   同じページの同じ操作で反応が違うのを避けるため、セレクタは details 全体で持つ。
   クラスを付けて回す方式にすると、折りたたみを増やすたびに付け忘れが起きる (#2522) */
/* Stylus は selector(...) の中の :: を解釈できずパースに失敗するので、
   条件は unquote で文字列のまま渡す */
@supports unquote('selector(details::details-content)') {
  details {
    interpolate-size: allow-keywords;
  }
  details::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size 0.18s ease, content-visibility 0.18s allow-discrete;
  }
  details[open]::details-content {
    block-size: auto;
  }
}
.article-entry li p {
  font-size: 1em;
}
.article-entry li li {
  font-size: 1.0em;
}
/* 引用は左ボーダーだけで示す。以前はグレーの背景も敷いていたが、
   技術ブログ系のサービス（Zenn / Qiita / はてなブログ）はいずれも
   左ボーダーのみで、背景を敷く例は少ない。
   文字サイズ・文字色とも本文と同じにする。引用は補足ではなく本文の
   一部であり、色数を増やさないほうが指定漏れの事故も起きにくい */
blockquote p {
  margin: 0.5rem 0 0.5rem 0;
}
/* 見出しは body の 13px を基準に em で決める。px 直指定だと body を
   変えたときに追従せず、本文（1.2em = 15.6px）との相対関係も崩れる。
   UI 部品（ページャ・タグ・サイドバー等）は本文と連動させる必要が無く、
   継承の影響も受けたくないため px のままにしている。

   以前は 0.15em 刻みの等差（h2 24.05 / h3 22.1 / h4 20.15 / h5 18.2px）
   だったが、h2:h3 が 1.09 倍しかなく階層が読み取れなかった。
   h2 24.05 / h3 19.5 / h4 16.9 / h5・h6 15.6px に組み直し、h2:h3 を
   1.23 倍にする。太さは 700 に統一し、階層はサイズと間隔だけで表す。
   h5・h6 は本文と同じサイズで、太字であることが見出しの印になる（#2455）*/
/* サイズと太さは .article-title / .list-page と共有する（下方の1箇所）。
   ここで持つのは罫線と空きだけ */
.article-entry h1 {
  border-bottom: solid 2px var(--rule-weak);
  margin-bottom: 8px;
  margin-top: 64px;
  padding-bottom: 8px;
}
/* 本文の先頭に来る h1 は、そのページのタイトルであってページ内の節ではない
   （Markdown で書いた特設ページ）。直前にあるのはパンくずなので、
   節の間隔（64px）ではなく他ページと同じ 30px を空ける (#2580)。
   .article-entry は flex アイテムの中にあり margin が外へ抜けないため、
   この値がそのままパンくずとの間隔になる */
.article-entry > h1:first-child {
  margin-top: 30px;
}
/* .sg-* はスタイルガイドの見本 (#2856)。見本のために値を書き写すと
   サイズを決める場所が2つに増えるので、セレクタを足して実物を借りる */
.article-entry h2,
.sg-h2 {
  /* 節の切れ目は「直前の空き」で作る。サイズを上げると記事タイトルとの
     上下関係が詰まり、罫線を濃くすると本文の流れを分断する (#2524) */
  margin-top: 56px;
  font-size: 1.85em;
  /* 罫線は白地とのコントラスト比 1.19 でほとんど見えないが、これは意図。
     節の区切りは空きが担っていて、線は「そこに境目がある」と気づかせる
     程度でよい。読みやすさの指標ではないので濃くしない */
  border-bottom: solid 1px var(--rule-weak);
  line-height: leading-heading;
  margin-bottom: 12px;
  padding-bottom: 8px;
  font-weight: 700;
}
/* 節の切れ目が分かるよう、直前との空きは h4 以下（24px）より広く取る。
   以前は h3〜h5 が一律 20px で、どの階層に入ったのかが間隔から読めなかった */
.article-entry h3,
.sg-h3 {
  margin-top: 32px;
  margin-bottom: 10px;
  font-size: 1.5em;
  font-weight: 700;
}
.article-entry h4,
.sg-h4 {
  margin-top: 24px;
  font-size: 1.3em;
  font-weight: 700;
}
/* h6 はこれまで指定が無く、ブラウザ既定の 16px / weight 500 で描かれていた。
   h5 は本文と同じサイズ、h6 はそれより一段小さくして最下層だと示す。
   本文より小さい見出しは Zenn（h5 1em / h6 0.9em）と同じ扱い方で、
   h5 と h6 が同居する記事（/articles/20201021/ 等）でも段が付く */
.article-entry h5,
.sg-h5 {
  margin-top: 24px;
  font-size: 1.2em;
  font-weight: 700;
}
.article-entry h6,
.sg-h6 {
  margin-top: 24px;
  font-size: 1.1em;
  font-weight: 700;
}
.blog-item img {
  max-width: 100%;
  height: auto;
  margin: 16px 0px;
  border-radius: radius-small;
}
/* 表示幅は px の上限で決める (#2629)。列幅に対する % だと画面が狭いほど画像が
   小さくなり、幅375pxでは middle が 228px・small が 158px まで縮んでいた
   （クラスを付けない画像は 351px）。段は2つで、値は _variables.styl が持つ。
   width ではなく max-width で抑えるのが要点で、img の自然幅は元画像の実寸なので
   `min(100%, 520px, 元画像の幅)` が自動で効く。% の頃は元画像より大きく引き伸ばして
   いた箇所が147あり（middle 69・small 78）、そこはぼやけていた。
   min() は Stylus が先に計算して 100% に潰すので、文字列を組んで unquote で渡す
   （clamp で2回踏んだ罠と同型 #1983 / #2008）。s() は使えない（%% がそのまま出る） */
.blog-item .img-middle-size {
  max-width: unquote('min(100%, ' + img-width-middle + ')');
}
.blog-item .img-small-size {
  max-width: unquote('min(100%, ' + img-width-small + ')');
}
.blog-item .img-reset-size {
  width: initial;
}
/* 一覧・パネルのサムネイルを包むリンク (#2458)。大きさは併用するクラスが持つ
   （card-thumb / panel-thumb / hiring-card-thumb）。ここが持つのは共通の振る舞いだけで、
   overflow は object-fit: cover の切り抜きに要る。

   このリンクは常に隣のタイトルと同じ行き先なので、マークアップ側で
   tabindex="-1" と aria-hidden="true" を付けてタブ順と読み上げから外している。
   付け忘れると1件につきタブが2回止まる（#2845） */
.thumb-link {
  overflow: hidden;
}
/* インラインSVGアイコン (#2306 / #2336)。文字サイズに対する相対値で、決めるのはここ1箇所。
   線画（stroke=currentColor）なので文字色にそのまま追従する */
.svg-icon {
  width: 1em;
  height: 1em;
  vertical-align: -0.125em;
  margin-right: 0.3em;
}
/* 文字の後ろに置くアイコン（外部リンクの矢印）。既定は見出し・ラベルの先頭に
   置く前提で右にマージンを持つので、左右を入れ替える (#2729) */
.svg-icon-trailing {
  margin-right: 0;
  margin-left: 0.25em;
}
/* 見出しへのアンカー (#2736)。hexo-renderer-marked が差し込む中身の空のリンクに
   headerlink.js がリンクのアイコンを入れ、見出しの末尾へ移している。

   以前は metronic の `h1:hover ::before` が `#` を出していたが、
   `margin-left: -0.8em` の絶対配置で見出しの箱の外に浮いていて、
   グリフの右端と見出しの左端の間に **どちらの箱でもない 0.3em の隙間**が
   残っていた。押しに行くとカーソルが見出しから外れてマークが消えるので、
   クリックできないマークだった。子孫の全要素（`:hover ::before`）が対象なのも
   誤りで、`<a>` を含む見出し134件・`<strong>` 11件・`<sup>` 4件では `#` が
   2つ以上出ていた（`code` / `span` / `i` だけ打ち消してあった）。

   場所は常に確保して opacity だけ動かす。hover のたびに見出しの文字が
   動くのを避けるためで、文字と地続きなので押しに行っても消えない */
.headerlink {
  opacity: 0;
  transition: opacity hover-speed ease;
}
/* 大きさは見出しに追従させる。16px 固定にすると h1（32px）では半分の
   大きさに見え、h6（14.3px）では文字より大きくなる。
   0.7em はほぼ大文字の高さで、vertical-align 0（ベースライン）に置くと
   アイコンの中心と大文字の中心が揃う（既定の -0.125em は 1em の絵柄用） */
.headerlink .svg-icon {
  width: 0.7em;
  height: 0.7em;
  vertical-align: 0;
}
/* 色は選択・focus と同じインタラクションのネイビー。
   状態ごとに書いているのは詳細度のためで、metronic の `a:hover`（青）・
   `.article-entry a:hover`（下線）・`.article-entry a:visited`（紫）に
   勝つ組み合わせがそれぞれ違う */
.headerlink,
.headerlink:visited,
.headerlink:hover,
.headerlink:focus,
.article-entry .headerlink:hover,
.article-entry .headerlink:focus {
  color: var(--brand-navy);
  text-decoration: none;
}
/* hover が無い端末では出さない。全見出しの後ろにアイコンが並ぶと本文の
   邪魔になるので、タップでの sticky hover ごと切る。
   キーボードの所在（focus-visible）はメディアクエリの外に置く */
@media (hover: hover) {
  h1:hover > .headerlink,
  h2:hover > .headerlink,
  h3:hover > .headerlink,
  h4:hover > .headerlink,
  h5:hover > .headerlink,
  h6:hover > .headerlink {
    opacity: 1;
  }
}
.headerlink:focus-visible {
  opacity: 1;
}
.thumb-link img {
  border-radius: radius-small;
  display: block;
  max-width: 100%;
}
/* キーボードのフォーカスの輪郭 (#2686)。metronic に
   `a, a:focus, a:hover, a:active { outline: 0 }` があってブラウザ既定の輪郭が
   全リンクで消えており、hover の反応がキーボードの唯一の目印を兼ねていた。
   そのため多くのルールが `:hover, :focus` を一緒に書く形になっていた。
   反応（hover）と所在（focus）は別の役目なので、輪郭をここで1箇所持つ。
   :focus ではなく :focus-visible なので、マウスで押したときには出ない。
   色は選択・タブと同じインタラクションのネイビー。
   タブ（.tab_item）と検索の入力欄は、帯・写真の中なので内側にずらす例外を自分で持つ */
a:focus-visible,
button:focus-visible,
input:focus-visible,
summary:focus-visible,
[tabindex]:focus-visible {
  outline: 2px solid var(--brand-navy);
  outline-offset: 2px;
}
/* ヘッダーを飛ばす行き先 (#2846)。Tab の起点はブラウザが持っていて、
   ホイールで送っただけでは動かない。読者がページのどこを見ていても Tab は
   先頭の検索窓に入り、そこから本文まで25ストップ（うち23は検索のヒント）
   かかっていた。
   position: fixed なので、押されるまで画面の外に置いても
   ブラウザがページを先頭まで送らない。読んでいた位置のまま帯だけが出る */
.skip-link {
  position: fixed;
  /* 画面の角に貼り付けない。輪郭（outline-offset 2px）が画面の外に落ちて
     上と左の2辺が切れる */
  top: 8px;
  left: 8px;
  z-index: 1000;
  padding: 10px 16px;
  border-radius: radius-small;
  background-color: var(--brand-navy);
  color: var(--on-dark-strong);
  font-size: text-row;
  text-decoration: none;
  transform: translateY(-200%);
}
.skip-link:focus {
  transform: translateY(0);
  color: var(--on-dark-strong);
  text-decoration: none;
}
/* 暗い地の上では輪郭も暗地用の段にする (#2847 / #2839)。フッターの地
   （同じ --brand-navy）ではネイビーの輪郭が 1.00 で、所在の目印になっていない。
   白なら 16.34。ヘッダーは白地になったので対象から外した (#2877)。
   反応（hover）の色とは別に保つため、差し色ではなく無彩色の最上段を使う */
.site-footer :focus-visible,
.skip-link:focus-visible {
  outline-color: var(--on-dark-strong);
}
/* 一覧カードのサムネは OGP 標準比（1200:630）で中央を切り抜いて大きさを揃える
   (#2305)。既存サムネの49%（比率1.75以上）はほぼ無加工で収まる。
   連載パネル（.panel-thumb は #2271 の 200:135）と We're hiring カードは対象外。
   アンカーは xs 幅で float が外れて inline になるため display を明示する。

   **比は img に持たせる。** 列（.card-thumb）に持たせると左右の padding 24px が
   比に含まれ、列が狭いほど画像だけが縦長になる（幅240pxの列で 1.71）(#2916) */
.card-thumb {
  display: block;
}
.card-thumb img {
  width: 100%;
  height: auto;
  aspect-ratio: unquote('1200 / 630');
  object-fit: cover;
  /* カードの囲みが無くなったぶん、角を丸めて「置かれている」形にする (#2747)。
     サムネイルは小物なので radius-small */
  border-radius: radius-small;
}
/* 共有ボタンの上下。1.5em（19.5px）だと本文の段落間（16px）とほぼ同じ空きで、
   丸の列が形として目立つぶん「ここが区切り」に見えていた (#2874)。
   区切りは .article-appendix の面が1つだけ持つので、ここは本文の段落と同じ刻みに揃える。
   下を持たないのは、帯までの空きを .article-appendix の margin-top だけで
   決めるため。著者紹介があってもなくても同じ空きになる */
.social-area {
	padding: 16px 0 0;
}

.img-frame-line {
  border: 1px solid var(--rule-base);
  margin-bottom: 1em;
}


/******************************
 全体レイアウト
******************************/
body {
  /* 以前は "Hiragino Kaku Gothic Pro"（旧macOS向け）が先頭で、現行の
     Hiragino Sans も Windows の Yu Gothic UI も指定が無かった。
     フォント一覧は _variables.styl の font-ja に集約している */
  font-weight: 400;
  font-size: text-base;
  font-family: font-ja;
  /* clip であって hidden ではない (#2909)。hidden にすると縦が auto に計算されて
     body 自身がスクロールコンテナになり、中の position: sticky が
     「body のスクロールポート基準」になって効かなくなる。body は伸びるだけで
     スクロールしないため、目次が追従しない。clip は横のはみ出しを隠すが
     スクロールコンテナを作らない */
  overflow-x: clip;
}

#article-nav {
    clear: both;
}

/* カードは囲みを持たない (#2747)。1件のまとまりは項目の外（48px）と
   中（タイトル→概要 8px / 概要→メタ 12px / メタ→シェアボタン 8px）の
   間隔の差が作る。中の最大が 12px なので、外はその4倍。

   80px から下げた (#2914)。80px は「概要2行で1件が約160px」を前提に、
   節見出しの前の空き（56px）より大きく取った値だった。実際の概要文は
   中央値5行・最大7行で、1件は幅375pxで中央値460px・最大530pxある。
   **カードの区切り（80px）が節の区切り（56px）より大きいのは階層が逆で、**
   さらに #2911 で区切り線が入ったので、空きだけが分ける役を負っていない。
   横に並んで箱でないと成立しない部品（連載・特設パネル / We're hiring / タブ）は
   個別に枠線を持つ */
/* 一括指定にしない (#2951)。margin-left / margin-right まで 0 になり、
   一覧カード（.row）が持つ負のマージン（ガターの半分）を打ち消していた。
   カードの中身だけが本文列の左端から 12px 右にいて、節見出しとそろっていなかった */
.article-card {
  margin-bottom: 48px;
}
/* カードのタイトルは本文色・下線なしで統一しているため、押せるかどうかを
   伝えるのは hover だけ (#2449)。影が無くなったので、持ち上がりの代わりに
   中身を一段引かせる。

   **文字は下線で返す。色は動かさない。**以前は ink-strong → ink-mute に
   落としていたが、**状態の差が 1.62:1** しかなく変化が読み取れない。UI の状態は
   並べて比べられない（前の色を覚えていない）ので、同時に見える2色の判別より
   大きい差が要る。色を濃くする方向はもう無く（ink-strong が最濃）、
   青は地の文の参照リンクの色なので使えない (#2893)。
   下線は #2948 で地の文のリンクが常時持つようになり、語彙に入っている。
   太さと位置もそちらに揃える（1px / offset 3px）。

   画像は opacity 0.7 のまま。**カード全体の透明度では下げない。**
   0.7 だと本文の文字が白地に対して 4.23、0.8 でもメタ行の文字が 3.89 で
   AA を割る（透明度は文字と画像を区別せず、薄い方から先に読めなくなる）。
   画像は文字ではないので透明度でよい。
   img をまとめて指すのは、一覧のサムネ・パネルのサムネ・We're hiring のロゴを
   同じだけ引かせるため */
.article-card img {
  transition: opacity hover-speed ease;
}
.article-card:hover .archive-post-title,
.article-card:hover .panel-title,
.article-card:hover .hiring-card-label {
  text-decoration: underline;
  text-underline-offset: 3px;
  text-decoration-thickness: 1px;
}
.article-card:hover img {
  opacity: 0.7;
}
/* 一覧の1件の中を詰める (#2747)。囲みが無いぶん、1件のまとまりは
   「外の空き（.article-card の下マージン）が中の空きより十分大きい」ことで作る。
   metronic の既定のままだと差が2倍に届かず、メタ行が次の記事の見出しと
   同じ間隔で並んで見える。
   .blog-info を持つ .article-card は一覧の1件だけ（パネルは .panel-meta） */
.article-card .blog-info {
  margin-top: 12px;
}
/* シェアボタンは1件の最後の要素なので、その下に余白を残さない。
   ul は Bootstrap の既定で下に 1rem 持っており、1件の外の空きに上乗せされて
   いた（80px のつもりが 96px）。サムネイルの下辺をここにそろえるので、
   残っていると画像だけが 16px 長く伸びる */
.article-card .social-button {
  margin-bottom: 0;
  padding-bottom: 0;
}
/* 一覧ではシェア数を絶対配置にして、行の高さの計算から外す。
   そろえたいのは丸ボタンの下辺とサムネイルの下辺なので、数字は下にはみ出す。
   記事ページ側は文字どおり最後の要素なので、そちらは流れの中に残す */
.archives > .article-card .share-count {
  position: absolute;
  top: calc(100% + 3px);
  left: 0;
  right: 0;
  text-align: center;
}
/* 記事の間の罫線。空き（80px）の真ん中に置いて上下に 40px ずつ残す。
   区切りの線なので rule-weak（記事本文の h2 の下と同じ役）。

   .row に border を引くと、行が持つ負のマージン（ガターの半分）ぶん
   左右に線がはみ出す。行の外に線を置いてガターぶん戻すと、
   サムネイルの左端から本文の右端までに幅が合う。

   最後の1件の下には引かない。ページャーとの境目は空きが持つ */
.archives > .article-card {
  position: relative;
  /* シェア数は絶対配置で高さの外に出してあるので、その分を箱の下に足す。
     箱の下辺が数字の下端に来るので、外の空き（80px）も罫線の位置も
     数字から測られる。足さないと空きが数字のぶん食われる */
  padding-bottom: 14px;
}
.archives > .article-card:not(:last-child)::after {
  content: '';
  position: absolute;
  left: calc(var(--bs-gutter-x) * 0.5);
  right: calc(var(--bs-gutter-x) * 0.5);
  bottom: -24px;
  border-bottom: 1px solid var(--rule-weak);
}
/* 縦積みになる幅では、サムネイルとタイトルの間に空きが無い（.row の gutter-y は 0、
   見出しの margin も上は 0）。`.blog-posts h2 { padding-top: 15px }` が代わりを
   務めていたが、記事タイトルが h3 になって外れた (#2919)。
   中の空き（タイトル→概要 10px / 概要→メタ 12px）と同じ段に置く */
@media (max-width: 575px) {
  .archives > .article-card > .card-thumb {
    margin-bottom: 12px;
  }
}
/* 列が横に並ぶ幅でも OGP 比を保つ (#2916)。以前は列の高さを本文列に合わせて
   伸ばし（.row の既定 align-items: stretch）、画像を絶対配置で埋めていたので、
   **比が概要文の長さで決まっていた**。同じ画像が 0.55〜2.63 の比で出て、
   576〜768px では左右が4〜6割切り落とされていた。

   伸ばす狙いは「画像の下辺とシェアボタンの下辺をそろえる」ことだったが、
   シェアボタンは #2915 で「残す」と決まったので、そろえる相手が居続ける。
   **比と下辺は同時に成立しない**ので、比を優先して上ぞろえにする。
   サムネが本文列より低い行では、画像の下に空きが出る */
@media (min-width: 576px) {
  .archives > .article-card > .card-thumb {
    align-self: start;
  }
}
/* We're hiring のパネル。サムネイルを左に小さく固定し、見出しと説明を右に積む。
   記事末の他の節と同じく囲みは持たず、2枚の区別は .row の gutter（24px）で作る。
   左端を節見出し・関連記事の行にそろえるため、内側の余白も持たない (#2820) */
.career-counseling .article-card {
  display: flex;
  gap: 12px;
  /* 画像の縦横比がまちまち（88px幅で高さ32〜46px）なので、上揃えだと
     本文より低い画像が浮いて見える。垂直中央で釣り合わせる (#2347) */
  align-items: center;
  margin: 0;
}
/* 2列の切れ目は間隔だけが作るので、gutter の 24px（.row > * の左右 12px）では
   左のパネルの説明文が右のパネルのロゴに近すぎる。内側だけ 24px に広げて
   列間を 48px にする。中の空き（ロゴと文章の 12px）の4倍で、外が内より
   十分大きい状態を作る (#2747)。列の外側は 12px のままなので、
   節見出し・関連記事の行との左右の揃いは動かない。
   パネルは常に2枚（scripts/hiring_panels.js） */
@media (min-width: 768px) {
  .career-counseling .row > :first-child {
    padding-right: 24px;
  }
  .career-counseling .row > :last-child {
    padding-left: 24px;
  }
}
.hiring-card-thumb {
  flex: 0 0 88px;
  line-height: 0;
}
.hiring-card-thumb img {
  width: 88px;
  height: auto;
  border-radius: radius-small;
}
.hiring-card-body {
  min-width: 0;
}
/* カードの中のタイトルなので、色は .panel-title と同じ ink-strong にする (#2699)。
   指定が無いと metronic の `a { color: var(--a-color) }` が出て、
   静止状態から青いリンクに見える */
.hiring-card-label {
  display: block;
  color: var(--ink-strong);
  font-weight: bold;
  margin-bottom: 4px;
}
/* 反応はカードの引き（.article-card:hover）だけにする (#2699)。節が class="nav" を
   持つため .nav a:hover の灰色の面がサムネとラベルの両方に付き、そこに
   .article-entry a:hover の下線と metronic の a:hover の青が重なっていた。
   関連記事・ランキングが #2686 で同じ面を打ち消しているのと同じ形。
   **色は動かさない。**カード側の反応が下線になったので、ink-mute に
   落とすとラベルを直接指したときだけ余分に変わる（逆の理由で #2747 では
   ink-mute にしていた）*/
.career-counseling .article-card a:hover,
.career-counseling .article-card a:focus {
  background-color: transparent;
  color: var(--ink-strong);
  text-decoration: none;
}
/* 絞り込みを解く導線を持つ、見出しの直下の注記。地の文なので本文と同じ大きさで、
   1.2em は .article-entry 配下にしか効かないのでここで明示する。
   対になる「◯◯以外の記事へ」（カテゴリページ側）は .more-link に寄せた (#2900)。
   あちらは次の行き先そのものだが、こちらは絞り込みの状態の説明で、
   リンクを持たない文（「◯◯タグにまとまっています」）も含む */
.list-page-note {
  margin: 0 0 20px;
  color: var(--ink-mute);
  font-size: text-body;
}

/* ホームの「連載から探す」と、カテゴリ・タグの「よく読まれている記事」で共用する
   カード。We're hiring と同じ横並びの作り */
.series-panels .article-card,
.post-panel {
  display: flex;
  /* 「特集」のパネルは本文が4行（ラベル・タイトル・メタ・導線）で 91px あり、
     88×59 のサムネの 1.5 倍の高さになる。12px では文字の塊がサムネに寄って見える
     ので一段広げた (#2892)。他の6箇所も同じ部品なので一緒に動かす */
  gap: 16px;
  /* 固定59pxのサムネより本文（1行タイトル＋メタ）が低いことが多く、
     上揃えだと本文が上に張り付く。hiring カードと同じ垂直中央 (#2347) */
  align-items: center;
  padding: 18px;
  margin: 0;
  /* 囲みは .article-card ではなくここが持つ (#2747)。枠は「カード・箱を囲む線」
     なので rule-weak（区切りの線）ではなく rule-base */
  border: 1px solid var(--rule-base);
  border-radius: card-radius;
}
.panel-thumb {
  flex: 0 0 88px;
  line-height: 0;
}
/* パネルの大きさが正で、画像はそこに収める (#2271)。標準サムネ（200×135）と
   同じ比率の枠に固定し、縦長・正方形のサムネは中央で切り抜く。
   height: auto だと画像側がカードの高さを引き伸ばしてしまう */
.panel-thumb img {
  width: 88px;
  height: 59px;
  object-fit: cover;
  border-radius: radius-small;
}
/* 特設ページの本文 (#2345)。1.2em は .article-entry 配下にしか効かないので、
   記事本文と同じ実効サイズ（15.6px）をここで明示する。
   行長はページレイアウト（記事と同じ col-md-9 + サイドバー）が抑える */
.specials-text {
  font-size: text-body;
  line-height: leading-body;
  color: var(--ink-strong);
}
/* ロゴ等の「切り抜くと欠ける」画像用。全体を収めて余白は白で埋める (#2345) */
.panel-thumb-contain img {
  object-fit: contain;
  background: var(--surface-base);
}
.panel-body {
  min-width: 0;
}
/* 「特集」の枠には連載・アクティビティ・リソースが混ざって出るので、種別を名乗る
   ラベルを置く (#2892)。**チップの形にしない。** 丸い枠＋薄い地はサイト全体で
   タグの印になっていて、別の意味に流用すると「押せば絞り込める」と読まれる。
   代わりにアイコン＋文字にして、連載は /series/ の h1 と同じ絵を使う。
   太字にするのは、すぐ下の .panel-meta が同じ ink-mute で、役の違いが
   大きさ（12px 対 11.7px）では読み取れないため */
.panel-label {
  display: block;
  margin-bottom: 6px;
  color: var(--ink-mute);
  font-size: text-meta;
  font-weight: bold;
  line-height: leading-row;
}
.panel-title {
  display: block;
  margin-bottom: 4px;
  color: var(--ink-strong);
  font-size: text-body;
  font-weight: bold;
}
/* 反応を返すのはカード（.article-card:hover の引き）で、ここでは足さない (#2686)。
   以前は下線も出していて、1回のカーソル移動で2つの反応が起きていた。
   ルールを消すのではなく打ち消しで残すのは、消すと metronic の
   `a:hover { color: var(--a-color); text-decoration: underline }`（0,1,1）が
   .panel-title（0,1,0）に勝って、タイトルが青くなって下線が出るため。
   **打ち消すだけで状態は動かさない。**カード側の反応が下線になったので、
   ここで色を落とすとタイトルに乗せたときだけ余分に変わる */
.panel-title:hover,
.panel-title:focus {
  color: var(--ink-strong);
  text-decoration: none;
}
.panel-meta {
  color: var(--ink-mute);
  font-size: text-meta;
}
/* 種別が混ざる回だけ、全件導線がパネルの中に入る (#2892)。p の既定の下マージンは
   カードの底に空きを作るだけなので落とす */
.series-panel .more-link {
  margin-bottom: 0;
}
/* 反響のハートは日付の右に少し離して置く */
.panel-meta .snscount {
  margin-left: 8px;
}
/* 表のセルの中の箇条書き (#2464)。1セルに複数の項目を積むときに使う。
   .article-entry の外なので li は 1.2em を継がず、記号と字下げだけ落とす */
.cell-list {
  margin: 0;
  padding-left: 0;
  list-style: none;
}
.cell-list li + li {
  margin-top: 4px;
}
/* 有無だけを示すセル (#2464)。中身は ● ひとつなので列ごと中央に寄せる */
.cell-mark {
  text-align: center;
}
/* 日付・長さのような短いメタの列 (#2854)。和文の見出し（「公開日」）は
   字の間で折り返せるので、列が詰まると「公開/日」に割れる */
.cell-nowrap {
  white-space: nowrap;
}

/* ホーム冒頭のブログ説明 */
/* パンくずとの間隔は他のページの .margin-top-30 に合わせる
   （隣接マージンが相殺されるので、そのまま 30px になる） */
.site-lede {
  margin-top: 30px;
  margin-bottom: 28px;
}
/* 1.2em は .article-entry 配下にしか効かないので、ここで明示する */
.site-lede-text {
  margin: 0;
  font-size: text-body;
}

/* 記事の概要文。一覧（トップ・タグ・カテゴリ・著者）と We're hiring カードで共用。
   一覧の1件の中に置く1〜3行なので、段落の地の文（leading-body）ではなく
   行の段に乗せる。25件が縦に並ぶ面では、開けたぶんがそのまま帯の長さになる */
.lede {
  line-height: leading-row;
}
/* 一覧の概要文はメインコンテンツなので本文と同じ 1.2em にする (#2064)。
   We're hiring カード側は宣伝の補足なので body の 13px 継承のまま (#2048) */
.archive-post-item .lede {
  font-size: text-body;
  /* **2行で止める** (#2914)。lede は23〜160字（中央値110字）で行数が揃わず、
     幅375pxでは中央値5行・最大7行あった。25件が縦に並ぶ面なので、1行の差が
     1ページで546px になる。省略の形は .series-nav-item-title (#2045) と
     .link-preview-card-description と同じ */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
/******************************
 見出し
******************************/
/* 日本語フォントは全角の字送りが固定のため、「」（）：・ などの約物の前後に
   不自然な余白が出る。palt（プロポーショナルメトリクス）で詰めて見出しを締める。
   本文に効かせると詰まって読みにくくなるので、見出しと記事タイトルに限定する */
.article-title,
.archive-post-title,
.article-entry h1,
.article-entry h2,
.article-entry h3,
.article-entry h4 {
  font-feature-settings: "palt" 1;
}
/* 折り返した見出しの最終行が短いと、見出しと本文の隙間が3倍空いて見える (#2776)。
   読者が見ているのは「見出しの下の10px」ではなく「ほぼ空の行23.4px ＋ 10px」。

   **効かせるのは幅768px以上だけ** (#2822)。balance は2行以上のときしか働かず、
   本文列は 768px 以上なら 498px、1200px 以上なら 813px あるので、対象は
   h2 の 6.5% / 0.7% に留まる。幅375pxの列（327px）では h2 の 19.8% が2行になり、
   そこで均等に割ると1行目が列の65%しか埋めずに折り返しが早く見える
   （貪欲なら96%）。狭い列では最終行の短さより1行目の短さの方が目に付く。

   記事タイトル（.article-title / .list-page / .article-entry h1）は幅によらず
   pretty。あちらは中央値29文字で長く、均等化すると「列幅の半分×2行」に縮む (#2655) */
@media (min-width: 768px) {
  .article-entry h2,
  .article-entry h3,
  .article-entry h4,
  .article-entry h5,
  .article-entry h6 {
    text-wrap: balance;
  }
}
/* クラスでサイズを持たない h2（「関連記事」「We're hiring」「タグから記事を探す」
   サイドバーの見出しなど）。

   以前は max-width:1024px のメディアクエリでのみ 24px を与えていたため、
   1024px を超えるとブラウザ既定の 1.5em（19.5px）に落ち、
   デスクトップの方がモバイルより小さいという逆転が起きていた。
   幅に依存しない指定にして、本文の h2（1.85em）と揃える。

   同じ場所にあった裸の h1（28px）は、テンプレート上のすべての h1 が
   .list-page を持つため実質デッドコードだったので落とす。

   .article-entry h2（0,1,1）・.article-title（0,1,0）・.list-page（0,1,0）は
   いずれも詳細度で勝つため、この指定には影響されない */
h2 {
  font-size: text-display;
}
/* サイドバーは記事本文の導線ではなく添え物なので、本文の見出しより一段抑える */
.blog-sidebar h2 {
  font-size: text-lead;
}

/******************************
 ソーシャルボタン
******************************/
/* 間隔は gap で持つ。padding-left と li の margin で作ると、
   折り返した行の先頭に余白が残って左端が揃わない */
ul.social-button {
  border: none;
  display: flex;
  flex-wrap: wrap;
  /* 四角い箱だった頃の 16px は円には空きすぎるが、10px だとコピーを足して
     4〜5個並んだときに詰まって見えた (#2565)。4の倍数の段ではその間の 12px */
  gap: 8px 12px;
  list-style-type: none;
  padding: 8px 0 4px;
  width: auto;
}
ul.social-button li {
  margin: 0;
}

/* シェアボタン (#2716)。ブランド色をやめてサイトの語彙で描く。
   アイコンはネイビー（白地で 16.3）、枠は rule-base。サービスの区別は
   アイコンの形が担うので文字のラベルは持たない。

   シェア数は枠の外（ボタンの下）に置く。数字はボタンの一部ではなく
   「そのボタンがどれだけ押されたか」の実績で、押す対象でもない。
   0 のときは出さないので、枠の中に入れると押せる箱の高さが4つで揃わない */
.share-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  /* コピーの吹き出しの位置の基準 (#2565) */
  position: relative;
}
.share-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  /* 円。Lighthouse の target-size（最低24px）を満たす最小の段。
     フッターの丸（.footer-icon）は暗地で単独に置くので一段大きい 34px */
  width: 28px;
  height: 28px;
  padding: 0;
  color: var(--brand-navy);
  border: 1px solid var(--rule-base);
  border-radius: 50%;
  box-sizing: border-box;
  text-decoration: none;
  transition: background-color hover-speed ease, border-color hover-speed ease,
    color hover-speed ease;
}
/* タグチップ（.tag-list-link）と同じネイビー反転。小さな操作部品の反応を
   1種類にそろえる (#2686)。枠も同色にしないと縁だけ残って見える。
   アイコンは fill: currentColor なので color の白がそのまま効く */
.share-btn:hover,
.share-btn:focus {
  background: var(--brand-navy);
  border-color: var(--brand-navy);
  color: var(--on-dark-strong);
  text-decoration: none;
}
.share-btn-icon {
  display: block;
  /* 円の内側（26px）に対して余白が上下左右 6px 残る大きさ */
  width: 14px;
  height: 14px;
}
/* リンクのコピーと共有は button なので、ボタンの既定の見た目を消す (#2565)。
   円と反転は a と共通で .share-btn が持つ */
button.share-btn {
  background: transparent;
  font: inherit;
  cursor: pointer;
}
/* 線画のアイコン（.svg-icon）はブランドロゴと同じ 14px に合わせる。
   既定は文字に添える用で 1em ＋ 右マージンを持っている */
.share-btn .svg-icon {
  width: 14px;
  height: 14px;
  margin-right: 0;
  vertical-align: 0;
}
/* コピーの合図は2つ。円の中のアイコンをチェックに差し替え、円の上に
   「コピーしました」の吹き出しを出す。アイコンだけだと何が起きたか読み取れない。

   吹き出しは absolute で浮かせる。行に場所を取らせると、押した瞬間に
   ボタンの並びが動く。押せる部品ではないので pointer-events も切る */
.share-copied {
  position: absolute;
  bottom: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-bottom: 6px;
  padding: 3px 8px;
  border-radius: radius-small;
  background: var(--brand-navy);
  color: var(--on-dark-strong);
  font-size: text-meta;
  font-weight: bold;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity hover-speed ease;
}
.share-btn.is-copied + .share-copied {
  opacity: 1;
}
.share-icon-done {
  display: none;
}
.share-btn.is-copied > .svg-icon {
  display: none;
}
.share-btn.is-copied .share-icon-done {
  display: inline-flex;
}
/* 数字はボタンと同じネイビー (#2723)。#2716 では「本文に添える属性」として
   日付・タグと同じ ink-mute にしていたが、それだと枠の外に置いた数字が
   ボタンと切れて見えた。同じ色にすると円と数字が1つの部品として読める。
   押せる部分ではないので hover では動かさない（反応はボタンが持つ #2686） */
.share-count {
  color: var(--brand-navy);
  font-size: text-meta;
  line-height: 1;
  /* 太字にしない。ネイビーは ink-mute の2.6倍濃い（6.19 → 16.34）ので、
     11px で bold にすると線が潰れて数字が太って見えた */
  font-weight: normal;
  /* 桁が変わってもアイコンの中心からずれないように等幅の数字にする */
  font-variant-numeric: tabular-nums;
}

/* アイコンだけのリンク（GitHub / X / Youtube / RSS）。フッターと著者ページの
   プロフィール (#2774) で共有する。下線は文字のための印なので消し、反応は
   チップと同じ「地を一段」で示す。タップ領域は Lighthouse の
   target-size（最低24px）を満たす 28px 角。
   絵の色は地に合わせて置き場所ごとに決める（フッターはネイビー、
   著者ページは ink-strong） */
.icon-link {
  /* 行内（Contact の文中）でも行として（Links のアイコン行）でも使うため
     inline-flex。文中では行の高さに揃える */
  display: inline-flex;
  vertical-align: middle;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  padding: 0;
  border-radius: 50%;
  text-decoration: none;
}
.icon-link:hover,
.icon-link:focus {
  background-color: var(--surface-mute);
}
.icon-link .svg-icon {
  width: 18px;
  height: 18px;
  margin-right: 0;
}
/* アイコンの行 */
.icon-row {
  display: flex;
  gap: 8px;
}
/* 読み上げ専用テキスト。視覚上はアイコンが名乗るリンクで、
   スクリーンリーダー向けの情報（（外部サイト）等）だけを残すために使う */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
/* 横に溢れる表の受け皿（table_filter.js が包む）。OS 既定のつまみは白地で
   1.8 しかなく位置が読めない (#2775)。白地では ink-faint が 4.61。
   トラックは transparent で地をそのまま見せる */
.scroll {
  overflow-x: auto;
  scrollbar-color: var(--ink-faint) transparent;
}
/*
  テーブルはヘッダに地色を敷き、本文行は白で揃える（Zenn と同じ構成）。

  以前はヘッダが白でデータ1行目に縞が入っていたため、構造の起点である
  ヘッダより下の行の方が目立つ逆転が起きていた。
  行を目で追う役割は全セルの罫線がすでに果たしており、縞は二重の仕掛けだった。
  記事中のテーブル789個を数えると中央値4行・73%が6行以下で、
  縞が効く長さの表はそもそも少ない。
*/
// 表のセルの罫線。行を目で追う役をこの線が担っているので、枠（rule-base）より
// 一段強い段を使う
table-border = rule-strong

table {
  table-layout: auto;
  border-collapse: collapse;
  margin: 0 2px 2em;
  background-color: var(--surface-base); // :::info の中で背景が塗りつぶされるため
}
th, td {
  border: solid 1px table-border;
  padding: 8px 10px;
}
th {
  // 900 は Hiragino / Yu Gothic に該当ウェイトが無く、ブラウザの合成太字になって輪郭が濁る
  font-weight: 700;
  // 地は面の段から選び、表のための専用の値は持たない (#2743)。
  // Zenn は青みのある #edf2f7 だが、本ブログの配色では水色に寄って浮く
  background-color: var(--surface-tint);
}
// インラインコードの地色 #eee はヘッダの地色とほぼ同じ明度で、そのままだと溶ける。
// ヘッダ内では一段暗くして、本文セル（白地に #eee）と同じ「浮いて見える」関係を保つ。
// 濃さの決め方は note の中と同じ規則（code-bg）に寄せた。以前は #e2e2e2 の
// 固定値で、狙いは同じなのに導き方が2つに分かれていた (#2487)
.article-entry th code {
  background: code-bg(surface-tint);
}
.highlight .pre {
  margin-bottom: 50px;
}
.highlight table {
  table-layout:auto;
  width: 100%;
  border-collapse: collapse;
  border: none;
}
.highlight tr {
  border: none;
}
.highlight .gutter .line {
  font-size: text-meta;
  color: lightgray;
}
.article-entry .highlight {
  // 角丸は table 側（highlight.styl）に移した。figure は背景を持たない
  tab-size: 2em;
  margin-bottom: 0.5rem
}
.highlight ::selection {
  background-color: gray;

}

/* リンクの折り返し */
article a {
  word-wrap: break-word;
  word-break: break-all;
}
.blog-sidebar a {
	color: var(--ink-strong);
}

/* 特設ページの Spotify プレイヤー (#2854)。iframe は既定でインラインなので、
   ブロックにしないと前後に行間ぶんの隙間が入る。角丸は Spotify が
   埋め込みコードで案内している見え方 */
.podcast-embed {
  display: block;
  border-radius: 12px;
}

/* ワンライナーの折り返し */
code {
  word-wrap: break-word;
  width: 100%;
}
.archives-wrap {
  margin-top: 30px;
}
/* トップページのリンク */
.archive-post-item a {
  color: var(--ink-strong);
}
/* 反応を返すのはカード（.article-card:hover の引き）で、ここでは足さない。
   **色も動かさない。**以前は ink-mute に落として「サムネに乗せたときと
   タイトルに乗せたときで引きを揃える」形だったが、カード側の反応が下線に
   なったので、ここで色を動かすとタイトルに乗せたときだけ余分に変わる。
   text-decoration: none を残すのは、素の a:hover の下線が概要文まで引かれるため。
   タイトルの下線はカード側の規則が h3 に付ける */
.archive-post-item a:hover,
.archive-post-item a:active,
.archive-post-item a:focus {
  text-decoration: none;
}
.archive-post-title {
  font-size: text-title;
  font-weight: bold;
}
/* .list-page はテンプレート上すべての h1 に付くページ見出し。
   記事タイトルより小さく細い独自サイズ（2em / bold）を持っていたが、
   「ページの主題を名乗る h1」という役割は同じなので見た目ごと揃える。

   本文の h1（.article-entry h1）も同じ扱いにする (#2577)。Markdown で書いた
   特設ページはレイアウトが page.title を出さないため、本文の h1 がそのページの
   唯一のタイトルになる。EJS で書いた特設ページのタイトルは .list-page なので、
   揃えないと同じ役割の見出しが 26px と 32px に割れる（/specials/markdown/ と
   /specials/guidelines/ が実際にそうなっていた）。
   h2（1.85em = 24.05px）との比も 1.08 から 1.16〜1.33 になる */
.article-title,
.list-page,
.article-entry h1,
.sg-title {
  color: var(--ink-strong);
  /* 新しいフォントスタックでは実際の太字フェイス（Hiragino Sans の W8 など）が
     当たるため、700 より太くしても潰れずに出る */
  font-weight: 800;
  /* 記事タイトルのサイズはこの1行だけで決まる。

     以前は基本・max-width:1024px・min-width:1200px の3箇所に分かれており、
     どこで最終値が決まるのか追えなかった。実際にタイトルが縮む不具合を
     #1927 / #1928 の2回に分けて直すことになり、いずれも「後から書いた指定が
     メディアクエリに負ける／勝つ」という記述順の問題が原因だった。

     さらに 1024px と 1025px の境で 24px → 30.4px と不連続に跳んでいた。
     Bootstrap 由来の calc(1.325rem + 0.9vw) と、後から足した 24px が
     別々の経緯で積み重なった結果で、流体でも段階切替でもない中間状態だった。

     clamp で下限・可変・上限を1箇所に書くことで、記述順に依存せず、
     幅の変化に対しても連続する。

     下限は 24px から 28px に上げ (#2524)、そこから 26px に下げた (#2599)。
     24px を避けるのは本文 h2（1.85em = 24.05px）と同着になるからで、
     26px なら比 1.08 が付く。#2524 が直したのは「同着」であって、
     階層はサイズ・太さ・直前の空き・罫線の4つで作っている
     （タイトル 800／ページ先頭、h2 700／直前56pxの空きと罫線）ので、
     比 1.08 でも役割は読み取れる。

     28px はモバイルで字数が足りなかった。幅375pxの本文列351pxに
     全角12.5字しか入らず、4行以上が 177件（12%）出ていた。
     26px では13.5字・113件（7%）になる。タイトルは長く（中央値29文字）
     h2 は短い（中央値7文字）ため、同じ 1px でも両者で効き方が違う。

     可変部（1.325rem + 0.9vw）が 26px を超えるのは幅533pxからなので、
     533〜756px の範囲も 26.0〜28.0px の連続値になる（従来はこの帯が
     28px で平らだった）。clamp のまま下限だけを動かすので、
     どの幅でも値は1つの式から連続して決まる。 */
  font-size: unquote('clamp(26px, 1.325rem + 0.9vw, 32px)');
  /* 折り返しは balance ではなく pretty (#2655)。
     balance は行数を変えずに各行の幅を均等化するので、1行をわずかに
     超えたタイトルが「列幅の半分 × 2行」になる。凸凹を均す＝短い側に
     合わせるため全体が縮む。実測では PC1200px で2行以上の556件のうち
     425件、1440px では330件のうち287件（87%）が最長行が列幅の3/4未満に
     なっていた。#2599 が縮めたかった凸凹（104件）より副作用の方が多い。

     pretty は最終行が1語だけ残るのを避けるだけで、均等化はしない。
     タイトルは中央値29文字で1行をわずかに超えるものが多く、PC1200px では
     2行の541件のうち246件が最終行が列幅25%未満（0〜4%＝1〜2文字だけ次行、
     が最多）。ここは pretty が効く形なので、指定を外して貪欲に戻すのでは
     なくこちらを選ぶ。
     未対応ブラウザは貪欲な折り返しになるだけで崩れない */
  text-wrap: pretty;
  /* 行間は見出しの段。1.2 では 32px・太さ800の日本語が2行になると行が
     貼り付いて見える (#2570)。タイトルが2行以上になるのは幅1200pxで
     38%（本文列に移した後）なので、例外的な見え方ではなく既定として効く */
  line-height: leading-heading;
}
/* 入れ子のマーカーはブラウザ既定だと ● → ○ → ■ と切り替わり、3段でひと回りして
   繰り返す。4段目以降は形で段を区別できず、段の深さは字下げで読み取れるので
   全段 ● にそろえる (#2540)。
   色は本文（ink-strong）から一段落として記号を主張させない。役割は「本文に添える
   属性」なので日付・タグと同じ ink-mute に乗せる。ここで専用の灰色を作ると、
   既にある3色（ink-strong / ink-mute / ink-faint）と見分けの付かない4つ目が増える。
   中黒と連番で色を分けないのも同じ理由で、マーカーの扱いを一つに保つ */
.article-entry ul {
  list-style-type: disc;
}
.article-entry li::marker {
  color: var(--ink-mute);
}

/* 本文の箇条書きのインデントを低く。スマホ対応 */
.article-entry ul {
  padding-inline-start: 20px;
}
.article-entry ol {
  padding-inline-start: 20px;
}
/* 連番・中黒と本文の間隔 (#2500)。既定ではマーカーが本文の左端に貼り付き、
   「1.」と本文が詰まって見える。

   ul / ol 側の padding-inline-start を広げても直らない。あれはマーカーが
   収まる幅を決めるもので、マーカーと本文が一緒に右へ動くだけで両者の間隔は
   変わらない。間隔を作るには本文側（li）を動かす必要がある。

   ::marker の content に空白を混ぜる手もあるが、そちらはマーカーの中身ごと
   置き換えるので type 属性や入れ子の番号種別を潰す。padding なら
   箱の話に閉じていて、番号の振り方には触れない */
.article-entry li {
  padding-left: 0.4em;
}
/* 中黒は「1.」より字が細く、同じ 0.4em でも本文との間隔が広く見える (#2531)。
   マーカーは本文の左端に右揃えで置かれるので、字が細いぶんだけ空きが増える。
   子セレクタなのは、ul の中に置かれた ol の項目まで詰めないため */
.article-entry ul > li {
  padding-left: 0.15em;
}
/* 入れ子は1段ごとに字下げが積み上がる。2段目以降を詰めて、深い入れ子でも
   モバイルの本文幅を残す (#2531)。1段目の 20px は本文との段差として保つ */
.article-entry li ul,
.article-entry li ol {
  padding-inline-start: 16px;
}
.inline-code-color {
  border-radius: radius-small;
  border: 1px solid var(--rule-base);
  display: inline-block;
  height: .8em;
  margin-left: 4px;
  vertical-align: middle;
  width: .8em;
}

/* インラインコードのフォントカラーを赤→黒に */
.article-entry code {
  color: var(--ink-strong);
}

/* インラインコードの地の上では link-blue が AA を下回るため、
   一段暗い link-on-tint に替える。highlight.styl 側にも同じ指定があるが、
   こちらの方が詳細度が高く後勝ちするので両方を揃えておく。
   値は _variables.styl の1箇所から引くので、揃っていることを主張する必要が無い */
.article-entry a code {
  color: var(--link-on-tint);
}

.article-entry a:visited code {
  color: var(--link-visited);
}

.nav {
  display: block;
}
.nav li a {
  padding: 6px 4px;
  display: block;
  text-decoration: none;
  transition: background-color hover-speed ease;
}
.nav a:hover, .nav a:focus {
  background-color: var(--surface-mute);
}
/* タブレットで発生する右側の余白を削除。
   狙いは横のはみ出しだけなので clip で、hidden にはしない (#2909)。
   hidden だと .wrap がスクロールコンテナになり、中の position: sticky が
   .wrap のスクロールポート基準になって効かなくなる（body と同じ罠）。
   .wrap は display: flex なので、clip に変えても整形コンテキストは変わらない */
.wrap {
  overflow-x: clip;
}

.publish-date {
  color: var(--ink-mute);
  font-weight: bold;
}
/* 日付・著者名の hover は .article-category-link と同じ
   ink-mute から ink-strong へ一段濃く＋下線にする (#2699)。
   打ち消しが無いと metronic の a:hover が勝って青（--a-color）に飛び、
   基底が ink 系の色なのに hover だけ別の系統になっていた */
.publish-date:hover,
.publish-date:focus,
.post-author:hover,
.post-author:focus {
  color: var(--ink-strong);
  text-decoration: underline;
}

/* Tag */
.blog-tags ul {
  padding: 0;
}
.blog-tags li {
  display: inline-block;
}
/* 記事メタ行の下のタグ (#2907)。間隔は gap で持ち、縦横とも同じ 8px にする。
   上の空きは .blog-info の行間（12px）と同じにして、メタ行が折り返した2行目と
   同じ間隔で続いて見えるようにする。
   チップは枠の内側に文字があるぶん、左端が日付・著者より右へずれる。
   揃えるのは枠ではなく文字の位置なので、枠線(1px)と左パディング(8px)を戻す
   （記事メタ行・タグ一覧で行った補正と同じ規則 #2429 / #2453） */
.article-header-tags {
  display: flex;
  flex-wrap: wrap;
  /* チップの間隔は 12px。地を外して枠だけになったぶん、8px では隣のチップと
     近すぎて1つの帯に見えた。サイドバーとカードのチップ（margin ベースで実測
     13px）ともそろう。刻みは4の倍数 (#2864) */
  gap: 12px;
  /* 既定の stretch だと、余白を持つチップが1つ混じるだけで行の全チップが
     その高さまで伸びる (#2764) */
  align-items: baseline;
  /* 下の 28px は .blog-info が持っていた下の空き（margin 20px + padding 8px）。
     タグが続くときはそれを下の行へ送るので、本文までの空きは変わらない */
  margin: 12px 0 28px -9px;
}
/* タグが続くときだけ、メタ行は下の空きを持たない */
.article-header .blog-info:has(+ .article-header-tags) {
  margin-bottom: 0;
  padding-bottom: 0;
}
/* 1記事だけのタグは非リンクの .tag-list-text で描かれる。
   どちらも margin を落とさないと gap に上乗せされる (#2764) */
.article-header-tags .tag-list-link,
.article-header-tags .tag-list-text {
  margin: 0;
}
/* 狭い画面では記事のメタ行を2行に分ける (#2738 / #2907)。1行目「いつ・誰が」、
   2行目「どれだけ書かれ、読まれたか」。タグはその下の行が持つ。
   切れ目と行間は空の li（.blog-info-break）が持つ。PC では1行に収めるので出さない。
   metronic の `.blog-info li { display: inline-block }` に勝つ詳細度が要る。
   単一クラスで書くと PC でも表示され、項目の間隔が gap の2つ分に開く */
.blog-info .blog-info-break {
  display: none;
}
@media (max-width: 767px) {
  .article-header .blog-info {
    row-gap: 0;
  }
  .article-header .blog-info-break {
    display: block;
    flex-basis: 100%;
    height: 10px;
  }
}
/* チップは枠の内側に文字があるぶん、囲みの左端に対して右へずれて見える。
   揃えるのは枠の位置ではなく文字の位置なので、チップの左マージン(4px)と
   枠線(1px)と左パディング(8px)を戻す（記事メタ行で行った補正と同じ規則 #2429 / #2453）。
   ul 側に置くので、折り返した2行目以降にも同じだけ効く */
ul.tag-list {
  margin-left: -13px;
}
.tag-list-link {
  color: var(--ink-mute);
  position: relative;
  margin: 4px 6px 7px 4px;
  display: inline-block;
  box-sizing: border-box;
  padding: 2px chip-pad-x 1px chip-pad-x;
  /* ピル型のチップは受賞チップ（.award-chip / .article-award / .award-badge）と
     同じ「枠だけ」で作る。**地を持たない。** 面の差は白地に対して 1.09 しか
     出ておらず、輪郭を作っていたのは枠の方だった（#2681 で --brand-gray から
     surface-tint へ薄めた続き）。
     **地を外すぶん枠を一段強める。** rule-base は白地と 1.36 で、地が無いと
     輪郭が頼りない（rule-strong は 1.61）。rule-strong は表の枠・タブの上辺・
     ツールチップの点線が既に静止で使っている段で、新しい役ではない。
     文字 ink-mute は白地と 6.19 で AA */
  background-color: transparent;
  border: 1px solid var(--rule-strong);
  border-radius: 999px;
  font-weight: bold;
  font-size: text-meta;
  color: var(--ink-mute);
  line-height: leading-row;
  /* ネイビーへの反転を一瞬で切り替えると硬く見えるので、短く送る (#2686) */
  transition: background-color hover-speed ease, border-color hover-speed ease,
    color hover-speed ease;
}
.tag-list-link:hover,
.tag-list-link:focus {
  background: var(--brand-navy);
  /* 塗りつぶす側なので枠も同色にする。#ddd のままだと輪の縁だけ残って見える */
  border-color: var(--brand-navy);
  color: var(--on-dark-strong);
  text-decoration: none;
}

.tag-list-text {
  color: var(--ink-mute);
  position: relative;
  margin: 4px 6px 7px 4px;
  display: inline-block;
  box-sizing: border-box;
  padding: 2px chip-pad-x 1px chip-pad-x;
  /* .tag-list-link と同じ地と枠。理由もそちらのコメントを参照 */
  background-color: transparent;
  border: 1px solid var(--rule-strong);
  border-radius: 999px;
  font-size: text-meta;
  color: var(--ink-mute);
  line-height: leading-row;
}

.blog-tags li a span {
  font-size: 0.5em;
  margin-left:5px;
}
/* カテゴリは著者名（.post-author）と同じテキストリンクにする。

   以前はタグ（.tag-list-link）と同じ丸みのあるチップにしていたが、
   タグそのものに見えてしまい、一覧から記事ページへ移動したときに
   「タグが1つ増えた」と誤認する原因になっていた。
   著者名と同じ素のテキストなら、タグとは別の種類の情報だと一目で分かる */
.article-category-link {
  color: var(--ink-mute);
  font-weight: bold;
}
/* hover は ink-mute から ink-strong へ一段濃くする。著者名・カテゴリ見出し・
   タグクラウドの hover と同じ規則。以前は metronic 由来の --main-font-color
   （#292929）を指していたが、この変数は名前が実態と合っていない
   （metronic の body は #424242 = ink-strong）ので ink の3段に寄せた (#2681) */
.article-category-link:hover,
.article-category-link:focus {
  color: var(--ink-strong);
  text-decoration: underline;
}
.sidebar-categories li a,
.sidebar-series-list li a {
  padding: 10px 0;
  border-bottom: 1px solid var(--rule-weak);
  color: var(--ink-strong);
}
/* 連載の行はアイコンを持たないので、そのままだと文字が上下の枠より左に出る
   （カテゴリの文字はアイコン 1em + 0.3em で 16.9px、タグの文字はチップの枠1px +
   左パディング8px で 9px から始まる）。下のタグ側に合わせるのは、カテゴリ側の
   16.9px まで下げると狭い列で折り返す行が増えるため (#2892) */
.sidebar-series-list li a {
  padding-left: chip-pad-x + 1px;
}
/* カテゴリの行も同じ位置から始める (#2908)。群のラベルが枠を持つので、
   その中の文字（枠1px + 左パディング）とアイコンの頭を揃える */
.sidebar-categories li a {
  padding-left: chip-pad-x + 1px;
}
/* Blog Item */
.blog-item .blog-item-img {
  margin: 6px 0 25px;
}
/* 左の線は border ではなく疑似要素のバーにして、両端を丸める (#2457)。
   border-left では角を丸められない。
   中の段落の外側マージンを消すのは、線を文字の高さに合わせるため。
   マージンが残ると線だけが上下に伸びて、引用が実際より長く見える */
.blog-item blockquote {
  position: relative;
  padding: 2px 0 2px 20px;
  color: var(--ink-mute);
}
/* 本文の p / li は色を自分で持っているので、引用の中では上書きしないと
   継承が届かない (.article-entry p の 0,1,1 に勝つ 0,1,2) */
.blog-item blockquote p,
.blog-item blockquote li {
  color: var(--ink-mute);
}
.blog-item blockquote::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 4px;
  /* 幅4pxのバーの端を半円にする値（幅の半分）。箱の角丸の段ではない */
  border-radius: 2px;
  background: var(--rule-base);
}
.blog-item blockquote > :first-child {
  margin-top: 0;
}
.blog-item blockquote > :last-child {
  margin-bottom: 0;
}
.blog-item .blog-info {
  margin: 20px 0;
  padding: 8px 0;
}
/* 項目間の間隔は gap の1箇所で決める。
   以前は a の padding 16px・li の padding 8px・metric 専用の 28px・
   タグの margin と項目の種類ごとに別の仕組みで間隔を作っており、
   実効値が 20〜38px までバラついていた (#2049)。
   28px は PV・文字数の間隔として使っていた値。
   折り返し時は各行が字下げ無しで頭から始まる。
   行の間は 4px だと日付・著者・タグ・文字数が1つの塊に潰れて見えたので
   12px 取る。狭い画面では3行に折り返す (#2453) */
.blog-info {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 12px 28px;
}
/* 補足が title にあることを示す。点線と help カーソルは abbr で使われる
   慣習で、これが無いとツールチップの存在に気づけない。
   li ではなく span に掛けるのは、li だと padding-left の空白にまで
   点線が伸びてしまうため。
   対象は文字数・PV に限る。`.blog-info-item span[title]` と広く取ると
   1記事だけのタグ（非リンクの .tag-list-text）も巻き込み、
   チップの中に点線が引かれる (#2764) */
.blog-info-metric span[title] {
  cursor: help;
  text-decoration: underline dotted var(--rule-strong);
  text-underline-offset: 3px;
}


/* 脚注は本文と地続きに見えていた。区切り線が inline-block のせいで
   中途半端な幅で止まり、本文との間隔も hr の 1rem しか無かった (#2457)。
   ブロックにして線を本文幅いっぱいに引き、本文との間を h2 の前と同じだけ空ける */
#footnotes {
  display: block;
  margin-top: 48px;
}
#footnotes hr {
  margin: 0 0 16px;
  border: 0;
  border-top: 1px solid var(--rule-weak);
  background: none;
  opacity: 1;
}

#footnotelist li {
  padding-top: 0.2em;
  /* 脚注のリストは list-style: none で左詰めにしてある（footnotes.js）。
     マーカーが無いので .article-entry li の左padding（マーカーとの間隔用）は
     用が無く、脚注の行だけ右にずれてしまう (#2500) */
  padding-left: 0;
  /* 脚注は補足情報なので本文（.article-entry li の 1.2em）から一段落とす。
     Zenn / Qiita / はてなも本文の約0.9倍に縮小している。中間値を新設せず、
     関連記事など記事末尾ゾーンと同じ body の 13px に乗せる (#2060)。
     line-height は本文と同じ段のままでよい。倍率なので自身のサイズ基準で再計算される */
  font-size: 1em;
}
/* .toc-section は目次の見た目（リストと行）だけを持つ。サイドバー特有の
   余白と、モバイルで隠す指定はサイドバー側のセレクタに寄せる。
   本文前のモバイル目次（.toc-mobile）が同じ見た目を使い回すため (#2452) */
/* 押し下げは margin で持つ (#2909)。padding だと下の overflow-y: auto の
   内側に入り、目次が長い記事でスクロールして消える */
.blog-sidebar .toc-section {
  margin-top: 50px;
  /* 左右の 4px は下の overflow-y: auto のため。スクロールコンテナになると
     行のフォーカスの輪郭（2px ＋ outline-offset 2px）が箱の縁で切られる */
  padding: 0 4px;
  /* スクロールに追従する (#2909)。帯は追従しないので、上端は画面の上から
     少しだけ空ける。サイドバーが本文の下に落ちる幅（1024px以下）では
     目次自体を隠しているので、この指定は横並びのときだけ効く。

     見出しが多い記事（h2〜h4 の中央値は10、最大62）では画面に収まらないので、
     中でスクロールさせる。可視領域 800px で24項目まで入り、溢れるのは
     全1,481本のうち68本（5%） */
  position: sticky;
  top: 24px;
  max-height: unquote('calc(100vh - 48px)');
  overflow-y: auto;
}
/* 見出しにも行と同じ左パディングを与えて、文字の左端を項目と揃える。
   行の a は ホバー背景を文字に密着させないため左右に 8px 持っており (#1957)、
   見出し側に無いと項目だけが右へ出る。記事はほぼ h2 始まりで最上位の項目が
   必ずこの位置に来るため、ずれがそのまま目に付いていた (#2483)。

   「目次」は見出しというよりブロックのラベルなので、項目と同じ14pxの太字に
   する。サイドバー見出しの 18.2px は2文字だと太い塊に見え、項目14pxとの差も
   中途半端だった。モバイルの summary と同じ規格に揃える */
.blog-sidebar .toc-section h2 {
  padding-left: 8px;
  font-size: text-row;
}
/* 項目のサイズはリスト側で決める。行の a に置くと字下げの 1em が
   body の 13px のままになり、文字だけ大きくなって階層の幅が合わない。
   14px はサイドバー見出し18.2px と本文15.6px に対する一段下（#2483）*/
.toc-section ol {
  font-size: text-row;
}
.toc-section ol, .toc-section li {
  list-style-type: none;
  padding-left: 0px;
}
.toc-section li > ol{
  list-style-type: none;
  margin: 2px 0;
  /* 下位の見出しであることが分かる程度に字下げする */
  padding: 0 0 0 1em;
}
/* 以前は margin だけで上下のパディングが無く、行が詰まって見えるうえ、
   ホバー時の背景も文字に密着していた。パディングで行の高さを確保し、
   クリック領域も広げる */
.toc-section a {
  list-style-type: none;
  margin: 1px 0;
  padding: 4px 8px;
  display: block;
  color: var(--ink-strong);
  text-decoration: none;
  line-height: leading-row;
  border-radius: radius-small;
  transition: background-color hover-speed ease;
}
/* 読んでいる節の行は hover と同じ面を塗る (#2909)。丸や箱の的を持つ部品の
   現在地は面、という規則（ページャ・タブと同じ）に乗せる。
   印は aria-current が兼ねるので、専用のクラスは持たない。

   **:focus ではなく :focus-visible。** :focus だとマウスで目次をクリックした行に
   面が残り続け、読み進めたあとの現在地の面と2つ並んで、どちらが現在地か
   分からなくなる。キーボードの読者には輪郭（a:focus-visible）と合わせて出る */
.toc-section a:hover, .toc-section a:focus-visible, .toc-section a[aria-current] {
  background-color: var(--surface-mute);
}
/* 本文とサイドバーの間隔は 44px（本文側 24px ＋ サイドバー側 20px。どちらも
   列自身の 12px を置き換える形で効く）。Zenn・はてなと同じ帯 (#2483 / #2892)。
   縦積みになる幅では列が横に並ばず間隔の意味が無いので、横並びのときだけ足す。
   本文側に多く寄せるのは、サイドバー側に足すと列の内寸が削れて行が折り返すため */
@media (min-width: 1025px) {
  main.blog-posts {
    padding-right: 24px;
  }
  .blog-sidebar {
    padding-left: 20px;
  }
}

/* タブレット以下はサイドバーを本文の下に落とす (#2044)。
   Bootstrap の md（768px〜）で横並びになるが、その幅では列が窮屈。
   境界はヘッダーメニューの切替（max-width: 1024px）に揃え、
   iPad の縦（768px）横（1024px）ともモバイルと同じ縦積みにする */
@media (max-width: 1024px) {
  main.blog-posts,
  aside.blog-sidebar {
    width: 100%;
  }
  /* サイドバーごと本文の下に落ちた目次は末尾に出ても役に立たないため隠す。
     以前はモバイル（768px）だけ隠していた。
     代わりに本文の直前へ .toc-mobile を出す (#2452) */
  .blog-sidebar .toc-section {
    display: none;
  }
}

/* モバイルの目次 (#2452)。表示・非表示は下の min-width で切り替える。
   max-width 側に display を書くと、ここの指定と同じ詳細度で後勝ちになり、
   どちらが効くかが記述順で決まってしまう */
.toc-mobile {
  display: block;
  margin-bottom: 20px;
  border: 1px solid var(--rule-base);
  border-radius: radius-small;
  /* details には全体で padding-bottom: 24px が掛かっている（本文中の折りたたみ
     ブロック向け）。枠で囲む目次では最後の項目の下だけ余白が空くので打ち消す */
  padding-bottom: 0;
}
.toc-mobile > summary {
  padding: 10px 12px;
  cursor: pointer;
  font-weight: bold;
  /* サイドバーの「目次」と同じ規格 (#2483) */
  font-size: text-row;
  transition: background-color hover-speed ease;
}
.toc-mobile > summary:hover {
  background-color: var(--surface-mute);
}
/* 開いたときだけ見出しと中身を線で分ける */
.toc-mobile[open] > summary {
  border-bottom: 1px solid var(--rule-base);
}
/* 左右は 4px。行の a が持つ 8px と足して 12px になり、summary の文字と
   項目の文字の左端が揃う（サイドバーと同じ考え方 #2483）*/
.toc-mobile .toc-section {
  padding: 6px 4px;
}
/* 素の ol が持つ下マージン（1rem）が残ると、最後の項目の下だけ余白が広くなる。
   枠の中の余白は上下ともこのブロックの padding で決める */
.toc-mobile .toc-section > ol {
  margin-bottom: 0;
}
/* サイドバーの目次が出る幅（1024px より上）では本文前の目次は出さない。
   max-width: 1024px の裏返しなので、両方出る幅も両方消える幅も無い */
@media (min-width: 1025px) {
  .toc-mobile {
    display: none;
  }
}

/* 「日付 / ♡ / タイトル」の3列。列幅は ul 単位の auto なので、
   ♡ の列はその年（月）の最大桁に合う (#2793)。
   字下げを li ではなくここで持つのは、subgrid の item に padding を置くと
   端の列がそのぶん削られ、日付の列が痩せるため */
.article-list {
  padding-inline-start: 1.2em;
  display: grid;
  grid-template-columns: auto auto 1fr;
  column-gap: 12px;
  row-gap: 8px;
}
/* 2行目をタイトルの左端にぶら下げるため、行は親の列をそのまま使う。
   直前の宣言は subgrid を解さないブラウザ向けで、行ごとの auto 3列に落ちる */
.article-list li {
  list-style: none;
  display: grid;
  grid-template-columns: auto auto 1fr;
  grid-template-columns: subgrid;
  grid-column: 1 / -1;
  align-items: baseline;
  /* 折り返しが前提の行になるので、フォント依存の normal に任せない */
  line-height: leading-row;
}
/* 日付と♡は行に添える属性なので ink-mute（_variables.styl の区分）。
   太字にしないのは、1,475行が並ぶ帯で太字が3つ並ぶと主役が消えるため。
   日付が座標であることは、揃った列の位置が示す (#2803) */
.article-list .date {
  color: var(--ink-mute);
}
.article-list .count {
  color: var(--ink-mute);
}
/* 行として並ぶ記事名なので太らせない。主従は日付・♡から太字を外したこと
   （上の2つ）と、サイズ 1.1em・色 ink-strong が持つ (#2803) */
.article-list .title {
  text-decoration: none;
  font-size: text-row;
}
/* 記事へのリンクは本文ではないので、月ページのカード一覧
   （.archive-post-item a）と同じ ink-strong に揃える (#2754)。
   hover の下線は metronic の a:hover が持つ */
.article-list .title a {
  color: var(--ink-strong);
}
/* 年・月の区切り。罫線を持たず直前の空きで階層を作るのは
   .article-entry h3 と同じ。サイズだけは一覧の行に合わせて本文と同じ 1.2em */
.article-list-period {
  margin: 32px 0 10px;
  font-size: text-body;
  font-weight: 700;
}
.article-list-period:first-child {
  margin-top: 0;
}

/*Archive*/
.archive-list {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  padding-left: 0;
  list-style: none;
  margin: 10px 0 20px;
}
/* 年ごとのカード。以前は幅100pxの素のテキストが並ぶだけで、
   リンクなのか見分けが付かなかった。
   枠は li が持つ。hexo の list_archives は件数の span をリンクの外に
   出すため、a に枠を付けると件数だけカードの外にはみ出して
   「(94)」が何の数か分からなくなる (#2114) */
.archive-list-item {
  position: relative;
  padding: 8px 16px;
  margin: 0 12px 12px 0;
  border: 1px solid var(--rule-weak);
  border-radius: card-radius;
  text-align: center;
  transition: background-color hover-speed ease, border-color hover-speed ease;
}
.archive-list-item a {
  color: var(--ink-strong);
  text-decoration: none;
  font-size: text-body;
  font-weight: bold;
}
/* 件数までカードに含めた分、リンクの当たりもカード全体に広げる */
.archive-list-item a:after {
  content: '';
  position: absolute;
  inset: 0;
}
/* 素のテキストリスト時代の margin-left: 8px がカード化後も残っていて、
   ホバーのたびにカードが右へ飛んでいた。位置は動かさず面の色だけで応える */
.archive-list-item:hover,
.archive-list-item:focus-within {
  background-color: var(--surface-mute);
  border-color: var(--rule-base);
}
/* 年の下の段に「94本」。カッコ書きだと何の数か分からない。
   記事数の単位はサイト全体で「本」に揃える (#2209) */
.archive-list-count {
  display: block;
  color: var(--ink-mute);
  font-size: text-meta;
}
.archive-list-count:after {
  content: "本";
}
.archive-list-current {
  font-weight: bold;
}
/* 投稿が無い月のダミーカード (#2219)。月が歯抜けだと「無い」のか
   見落としなのか区別できない。リンクにせず、ホバーにも応えない */
.archive-list-item-empty:hover {
  background-color: transparent;
  border-color: var(--rule-weak);
}
.archive-list-empty {
  color: var(--ink-faint);
  font-size: text-body;
  font-weight: bold;
}

.post-author {
  color: var(--ink-mute);
  font-weight: bold;
}
/* 著者ページの傾向パネル。タグ・カテゴリのリンクは通常の表現のまま、
   「この著者が何本書いたか」はパネル側が名乗る。
   リンクの右肩に著者内の件数を出すと、他ページの「タグ総数」と
   同じ表現で違う意味になり、クリック先の件数とも食い違う (#2129) */
.tendency-panels {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  padding-left: 0;
  list-style: none;
}
.tendency-panel {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 12px;
  border: 1px solid var(--rule-weak);
  border-radius: card-radius;
}
/* チップ自身の margin はパネルの gap と二重になるので消す */
.tendency-panel .tag-list-link {
  margin: 0;
}
.tendency-panel-count {
  color: var(--ink-mute);
  font-size: text-meta;
  white-space: nowrap;
}
/* 関連タグは目的ごとに群を分けており、ラベルが目的を名乗る (#2569)。
   節見出しではなくブロックの名札なので、目次の「目次」と同じ 14px にする
   （h3 の既定値は bootstrap の calc(1.3rem + .6vw) で、ここを見ても
   実効サイズが分からなくなる）。
   間隔はこの節の中で完結させたいので、共有部品である一覧の下マージンを消して
   群と群の間はラベルの上マージンだけで決める */
.related-tag-groups .tendency-panels {
  margin-bottom: 0;
}
.related-tag-groups .panels-label {
  margin: 0 0 8px;
  color: var(--ink-mute);
  font-size: text-row;
  font-weight: 700;
}
.related-tag-groups .tendency-panels + .panels-label {
  margin-top: 24px;
}
/* 著者一覧の年別タブ。ランキングと同じ radio + label 方式だが、
   年ごとの ID ルールを毎年 CSS に足さずに済むよう、input+label+content を
   隣接させて flex の order で並べ替える。ラベルだけ order:1 で帯に並び、
   選択された組のコンテンツが order:2 + 全幅で下段に出る */
/* 期間ページのグラフ切り替えタブ (#2171)。year-tabs と同じ input+label+content
   方式だが、非表示側を display:none にすると ECharts が幅0のまま初期化されて
   描画が壊れるため、高さ0で畳んで幅は保つ */
.tabs.chart-tabs {
  display: flex;
  flex-wrap: wrap;
}
.chart-tabs .tab_item {
  float: none;
  order: 1;
}
.chart-tabs .tab_content {
  order: 2;
  width: 100%;
  display: block;
  height: 0;
  padding: 0 22px;
  overflow: hidden;
}
.chart-tabs input:checked + .tab_item + .tab_content {
  height: auto;
  padding: 18px 22px;
  overflow: visible;
}
.tabs.year-tabs {
  /* 後方の .tabs { display: flow-root } と同詳細度だと記述順で負けて
     flex が効かず、ラベルがインライン扱いで選択コンテンツの後ろに
     折り返してしまう。クラスを2つ重ねて順序に依存させない */
  display: flex;
  flex-wrap: wrap;
  /* 見出しを持たないブロックなので、上のチャートとの区切りは余白で付ける。
     ラベルが負のマージンで 8px 帯の上に出るぶんも見込む */
  margin-top: 40px;
}
.year-tabs .tab_item {
  float: none;
  order: 1;
}
.year-tabs .tab_content {
  order: 2;
  width: 100%;
}
/* 全期間は年のタブと性質が違う（集計であって1つの年ではない）ので、
   右端に離して置く */
.year-tabs .tab_item-all {
  margin-left: auto;
}
.year-tabs input:checked + .tab_item + .tab_content {
  display: block;
}
/* /specials/gallery/ の部品ギャラリー (#2985)。運営用のページなので、
   /doctor/ と同じく素の一覧と枠だけで組む。新しい段は作らない */
.gallery-ledger {
  padding-left: 0;
  list-style: none;
}
.gallery-ledger > li {
  padding: 6px 0;
  border-bottom: 1px solid rule-weak;
}
.gallery-note {
  display: block;
  color: ink-mute;
  font-size: text-meta;
}
/* 見本の枠の名札。何の部品を見ているかを枠ごとに名乗る */
.gallery-name {
  margin: 0 0 12px;
  color: ink-mute;
  font-size: text-meta;
}
/* 見本を持たない部品が分類から漏れたときの注意。差し色にするのは、
   台帳に並ぶ行と違って**直す先がある**ため */
.gallery-alert {
  margin: 16px 0 0;
  color: brand-crimson;
  font-size: text-body;
}
/* 見本を1つずつ枠で囲む。地は白のまま——中の部品が白地の上で決めた値を持つ (#2874) */
.gallery-item {
  margin: 16px 0 32px;
  padding: 16px;
  border: 1px solid rule-base;
  border-radius: card-radius;
}
/* アイコン・メダルのように小さい見本を敷き詰める */
.gallery-icons {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  padding-left: 0;
  list-style: none;
}
.gallery-icons > li {
  width: 96px;
  text-align: center;
}
/* サイドバーの枠はその列の内寸で描かないと実物と違って見える (#2943 の 208〜298px) */
.gallery-sidebar-scale {
  max-width: 253px;
}
/* /doctor/ の検査結果リスト */
.doctor-list {
  padding-left: 0;
  list-style: none;
}
.doctor-list > li {
  padding: 6px 0;
  border-bottom: 1px solid var(--rule-weak);
}
.doctor-note {
  display: block;
  color: var(--ink-mute);
  font-size: text-meta;
}
/* 名前の直後に添える注記。横に流したい列で使う（#2418）。
   行ごとに区切り線が入るので、行間・項目間は開けすぎない */
.doctor-note-inline {
  color: var(--ink-mute);
  font-size: text-meta;
  margin: 0 5px 0 2px;
}
.doctor-list .doctor-inline-row {
  line-height: leading-row;
}
/* 節の中の小見出し（年ごとの列など）。h2 の節見出しより一段小さく */
.doctor-subhead {
  margin: 16px 0 8px;
  font-size: text-body;
  font-weight: bold;
}
/* 件数の少ない検査どうしを横に並べる (#2418)。狭い画面では縦に戻す。
   節の見出しごと並べるので、中の一覧は各列で通常どおり縦に積む */
.doctor-cols {
  display: grid;
  gap: 0 32px;
}
@media (min-width: 768px) {
  .doctor-cols {
    grid-template-columns: 1fr 1fr;
  }
}
/* /doctor/ のオントロジーツリー。系統ごとの小さな木を多段組で敷き詰める */
.ontology-forest {
  column-width: 300px;
  column-gap: 32px;
  margin: 14px 0;
}
.ontology-tree {
  break-inside: avoid; /* 木の途中で段が割れると親子が追えない */
  list-style: none;
  padding-left: 0;
  margin: 0 0 14px;
}
.ontology-tree ul {
  list-style: none;
  padding-left: 14px;
  margin-left: 6px;
  border-left: 1px solid var(--rule-base); /* 縦罫で階層を示す */
}
.ontology-tree li {
  padding: 2px 0;
}
.ontology-concept {
  color: var(--ink-mute);
}
.ontology-count {
  color: var(--ink-mute);
  font-size: text-meta;
  margin-left: 5px;
}
.ontology-versions {
  display: block; /* Go は版が12個並ぶので、名前と同じ行に置くと折り返して階層が崩れる */
  color: var(--ink-mute);
  font-size: text-meta;
}
.author-list {
  padding-inline-start: 0px;
  display: flex;
  flex-wrap: wrap;
  max-width: auto;
  padding: 0 0 25px 0;
}
.author-list li {
  list-style: none;
  margin-bottom: 8px;
  width: 160px;
  min-width: 160px;
}
.author-list .author-list-count {
  padding: 0 5px 0 5px;
}
/* 著者名は一覧の主役なので、既定の青（--a-color #0072E5）だと
   400人分が一面の青になって読みにくい。名前が並ぶ一覧のリンクは
   サイドバーのカテゴリ（.sidebar-categories li a）と同じ #424242 に揃え、
   反応は色ではなく下線で返す（.awards-hall-name と同じ規則） (#2463) */
.author-list-link {
  color: var(--ink-strong);
}
.author-list-link:hover,
.author-list-link:focus {
  color: var(--ink-strong);
  text-decoration: underline;
}

/* モバイルではサイドバーが本文の下に落ちるので、探索の枠は隠す。
   一覧とページャの後ろに出しても読者は辿り着かない（目次を
   .toc-mobile に移しているのと同じ理由 #2452）。タグとカテゴリの
   行き先はヘッダーの検索窓のパネルとナビが持つ (#2885) */
@media screen and (max-width: 768px){
  .category,
  .sidebar-series,
  .sidebar-tags {
    display: none;
  }
}
.category-list {
  font-size: text-body;
  list-style: none;
  padding: 0 5px 5px 5px;
}
.category-list-item  {
  padding: 0 5px 5px 5px;
}
.category-list-link {
  padding: 0 6px 0 0;
}
.category-list-current a {
  font-weight: bold;
}
/* /categories/ の群の見出し (#2908)。節見出し（.bottom-content-header）の下の段 */
.category-group-heading {
  margin: 32px 0 0;
  font-size: text-lead;
  font-weight: 700;
  color: var(--ink-strong);
}
/* /categories/ の一覧。1件は 名前＋統計 / 説明 / タグ の3段構成。
   17件を縦に積むと長いので、幅があるときは2列にする。
   auto-fit + minmax で、狭い幅では自動的に1列へ落ちる */
.category-index {
  list-style: none;
  padding-left: 0;
  /* 直上の注記と最初のカテゴリが貼り付かないよう間を空ける */
  margin-top: 12px;
  display: grid;
  column-gap: 40px;
}
/* auto-fit だと画面幅で列数が変わり、広い画面で3列になって窮屈になる。
   2列と決め打ちし、1件ぶんの幅が確保できない狭い画面では1列に落とす */
@media screen and (min-width: 768px) {
  .category-index {
    grid-template-columns: 1fr 1fr;
  }
}
/* 1件が3行（名前＋統計／説明／タグ）になり、行間（8px）とカテゴリ間の差が
   小さくて塊が分かれて見えなかった (#2405)。内側は変えず、外側だけ広げる */
.category-index-item {
  padding: 22px 0 18px;
  border-bottom: 1px solid var(--rule-weak);
}
/* カテゴリ名と統計チップの行。メタは nowrap（語の途中で割らない）なので、
   狭い幅では行ごと折り返して見切れを防ぐ (#2342) */
.category-index-head {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 8px;
}
/* カテゴリの一言説明 (#2405)。メタと同じ従属情報のグレー */
.category-index-desc {
  margin: 0 0 8px;
  color: var(--ink-mute);
}
.category-index-name {
  font-size: text-body;
  font-weight: bold;
  color: var(--ink-strong);
}
.category-index-name:hover,
.category-index-name:focus {
  color: var(--ink-strong);
  text-decoration: underline;
}
/* 連載ナビの「全 N 本」と同じ扱い。長いカテゴリ名に押されて折り返すと
   「直近1年」「35本」に割れて読めなくなるので縮ませない */
.category-index-meta {
  flex: none;
  color: var(--ink-mute);
  font-size: text-meta;
  white-space: nowrap;
  /* 名前の次の行に並ぶチップ (#2405)。下のタグチップ（塗り）とは
     枠線だけ・グレー文字で性質の違いを示す */
  padding: 2px 10px;
  border: 1px solid var(--rule-weak);
  border-radius: 999px;
}

/* サイドバーの人気のタグ (#2885)。本文では ul.tag-list の負のマージンで
   チップの枠が節見出しより 9px 左に出るが、狭い列だとカテゴリの一覧と
   左端が割れて見える。チップ自身の左マージンぶんだけ戻して枠の左端を揃える */
.sidebar-tags ul.tag-list {
  margin-left: -4px;
}
/* 全件導線はチップの中の文字の左端に合わせる。.more-link の既定の右寄せだと、
   狭い列ではチップの並びから離れて宙に浮く。足す 1px はチップの枠 */
.sidebar-tags .more-link {
  text-align: left;
  padding-left: chip-pad-x + 1px;
}
/* 導線は行の文字の左端に合わせる。タグの枠と同じ値なので、サイドバーの
   「すべての◯◯を見る」2本が同じ位置から始まる (#2892) */
.sidebar-series .more-link {
  text-align: left;
  padding-left: chip-pad-x + 1px;
}

/* ホームのランキングと、ページャの後ろに出る関連タグ・関連カテゴリの節 */
.popular-articles {
  margin-top: 40px;
  /* 下の余白が .margin-bottom-20 の 20px しか無く、上（ページャの下 56px と
     見出しの上 48px）に比べて狭かった。フッターとの間隔を上側と揃える。
     ページャの下が 56px なので、それに合わせる */
  margin-bottom: 56px;
}
.tag-cloud a {
  display: inline-block;
  /* 間隔は右と下に取る。左に取ると折り返した行頭にも効いて字下げに見える。
     クラウドは密度が持ち味なので、チップの一覧より狭めにする */
  margin: 0 8px 4px 0;
  /* タグチップ（.tag-list-link）と同じ色。リンク既定の青のままだと
     同じページのタグ表示の中で色が割れる (#2126) */
  color: var(--ink-mute);
}
/* 面を持たない裸のリンクなので、反応は下線（.breadcrumb a / .publish-date と同じ）*/
.tag-cloud a:hover,
.tag-cloud a:focus {
  color: var(--ink-strong);
  text-decoration: underline;
}
/* 記事末の著者紹介 (#2567)。見出しを持たない1件の塊なので枠（card）に載せる。
   関連記事・参照記事は枠を外して節見出し + 行にしたので、左端をそちらに
   揃えるため padding は 0 を明示する */
.author-box {
  padding: 0;
  /* 共有ボタンとの間。下は持たない（帯までの空きは .article-appendix が持つ）*/
  margin: 16px 0 0;
}
.author-box-body {
  display: flex;
  /* 丸と文章がくっつくと1つの塊に見えるので、丸の半径ぶんに近い間隔を取る */
  gap: 20px;
  /* 見出しを持たないので、card の内側の余白はここで持つ */
  padding: 0.8em;
}
/* 名前の1文字目を丸に載せる。アイコン画像を持っていないので、
   vuls.biz と同じくイニシャルで代える。ネイビー塗りの白抜き（16.34）は
   ランキングの2〜3位・ページャーの選択色と同じ既存の塗り */
.author-box-initial {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--brand-navy);
  color: var(--on-dark-strong);
  font-size: text-title;
  font-weight: bold;
  /* 字を丸の中心に置く。行の高さが残ると下寄りに見える */
  line-height: 1;
}
/* 名前はイニシャルの丸と同じネイビーにして対にする。ネイビーは塗り面と
   インタラクションに使う色で文字色には使っていないが、ここは丸と1組の
   見え方を作る箇所なので例外にする（白地で 16.34） */
.author-box-name {
  display: block;
  color: var(--brand-navy);
  font-weight: bold;
}
/* 記事末は .article-entry の外なので本文のリンクの下線が効かない。
   hover は下線だけで示す。色はこれ以上濃くできないので動かさない。
   打ち消しが無いと metronic の a:hover が勝って青（--a-color）に飛ぶ */
.author-box-name:hover,
.author-box-name:focus {
  color: var(--brand-navy);
  text-decoration: underline;
}
/* 名前のすぐ下に続く紹介文。本文（p は 1.2em）ではなく添えの情報なので
   body の 13px のまま置く */
.author-box-about {
  margin: 4px 0 0 0;
}
/* 導線は紹介文の続きなので、.more-link の既定（右寄せ）ではなく本文の左端に揃える。
   丸のぶんの字下げは親（.author-box-text）が持つので、ここでは数値を決めない。
   紹介文とくっつくと1つの段落に見えるため、上の間隔を本文の行送りぶん空ける */
.author-box .more-link {
  text-align: left;
  margin-top: 14px;
  /* 枠の内側の空きは .author-box-body の padding だけで決める。bootstrap の
     p の margin-bottom: 1rem が残ると、最後の行の下だけ 16px 足されて
     上 10.4px 対 下 26.4px になる (#2813) */
  margin-bottom: 0;
}

/* 連載の前 / 次。左右に並ぶ2つで1組の部品なので、囲み（card）を持たせて
   どこまでが1組かを示す。前を左・次を右に置いて進行方向を示す */
/* 本文のすぐ後ろに来るので、本文との間隔を空けて別のブロックだと分かるようにする */
.series-nav {
  margin-top: 40px;
}
.series-nav .card {
  padding: 0;
  overflow: hidden;
}
.series-nav-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  padding: 0.7em 0.9em;
  border-bottom: 1px solid var(--rule-weak);
}
.series-nav-title {
  margin: 0;
  font-size: text-body;
  font-weight: bold;
}
/* 「連載」は見出しの一部ではなくラベル。塗りつぶすと連載名より目立つので、
   NEW ラベル（.newitem）と同じ薄い枠線だけの作りに揃える */
.series-nav-kicker {
  display: inline-block;
  margin-right: 0.6em;
  padding: 0 4px;
  background-color: transparent;
  border: 1px solid var(--rule-base);
  border-radius: radius-small;
  color: var(--ink-mute);
  font-size: text-meta;
  font-weight: normal;
  line-height: leading-row;
  vertical-align: middle;
}
/* 連載の規模。連載名の対角に置く。長い連載名に押されて折り返すと
   「全 7」「本」に割れて読めなくなるので nowrap で縮ませない */
.series-nav-count {
  flex: none;
  margin: 0;
  color: var(--ink-mute);
  font-size: text-meta;
  white-space: nowrap;
}
/* 索引へは連載名そのものから辿る。別途「索引を見る」を置くと導線が二重になる */
.series-nav-title > a {
  color: var(--ink-strong);
}
.series-nav-title > a:hover {
  color: var(--ink-strong);
  text-decoration: underline;
}
.series-nav-pair {
  display: flex;
}
/* flex: 1 なので、片方しか無いときはその一方が幅いっぱいに広がる */
.series-nav-item {
  flex: 1 1 0;
  display: block;
  min-width: 0;
  padding: 0.8em 0.9em;
  color: var(--ink-strong);
}
/* 背景色が変わることで押せると分かるので、文字色は本文と同じ黒のままにする。
   a:hover のリンク色がここまで効くと、記事タイトルが青くなって落ち着かない。
   面は surface-mute。行に敷く面は目次・サイドバー・年月カード・ランキングと
   同じ値にする（以前はここだけ surface-tint で一段薄かった #2686） */
a.series-nav-item {
  transition: background-color hover-speed ease;
}
a.series-nav-item:hover,
a.series-nav-item:hover .series-nav-item-title {
  background: var(--surface-mute);
  color: var(--ink-strong);
  text-decoration: none;
}
.series-nav-next {
  text-align: right;
}
.series-nav-prev + .series-nav-next {
  border-left: 1px solid var(--rule-weak);
}
/* 行き先が無い側。リンクではないので薄く、上下は中央に置いて
   隣のリンク（見出し＋タイトルの2行）と釣り合わせる */
.series-nav-end {
  display: flex;
  align-items: center;
  color: var(--ink-mute);
  font-size: text-meta;
}
.series-nav-next.series-nav-end {
  justify-content: flex-end;
  text-align: right;
}
/* 端の案内文の下に添える、隣の連載への導線 (#2383)。
   青のリンク色はナビのカードの中で浮くので、ナビ内の他のリンクと同じ
   濃いグレーに揃える（案内文の #777 より濃いので地の文とは区別できる）。
   案内文と地続きに読めないよう、行間は広めに取る */
.series-nav-succession {
  display: block;
  margin-top: 0.9em;
  color: var(--ink-strong);
}
.series-nav-succession:hover {
  color: var(--ink-strong);
  text-decoration: underline;
}
.series-nav-dir {
  display: block;
  margin-bottom: 0.2em;
  color: var(--ink-mute);
  font-size: text-meta;
}
.series-nav-prev .series-nav-dir:before {
  content: '‹ ';
}
.series-nav-next .series-nav-dir:after {
  content: ' ›';
}
/* 前後の記事名。連載名（.series-nav-title = 1.2em の太字）との序列は
   大きさが持つので、こちらは太らせない (#2803) */
.series-nav-item-title {
  display: block;
  font-size: 1em;
  line-height: leading-row;
}
/* モバイルでも縦に積まず、前 | 次 の横並び構造を保つ (#2045)。
   狭い幅で長いタイトルが何行も折り返して縦積みに見えるのが問題だったので、
   構造ではなくタイトル側を2行で省略して解決する */
@media (max-width: 767px) {
  .series-nav-item-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
}

/* 行は面の内側の左端に揃える。1件ごとの枠が無いので字下げする理由が無く、
   節の外の空きは .article-appendix の padding が持つ */
.related-post-link,
.reference-post-link {
  padding: 0;
  margin: 0;
  list-style: none;
}
/* サムネ・タイトルの左端を節見出しに揃える。`.nav li a` の左右 4px は
   サイドバーの「1リンク＝1行」向けで、こちらでは見出しと 4px ずれる。
   上下の 6px は行の高さを決めているので残す */
.related-post-link .related-posts-item a,
.reference-post-link .reference-posts-item a {
  padding-left: 0;
  padding-right: 0;
}
.related-posts-item,
.reference-posts-item,
.featured-posts-item {
  list-style: none;
  padding: 0.5em 0;
  border-bottom: 1px solid var(--rule-weak);
}
/* ランキング・関連記事・被参照記事の行の反応 (#2686)。3つとも同じ部品
   （postListItem）で組んだ「サムネ＋タイトル＋メタ」の行なので、反応も揃える。
   1行が複数のリンクでできているので、リンク単位ではなく行（li）に面を敷く。

   以前はランキングだけ .nav a:hover が文字とサムネに別々に付き、順位の丸は
   白く残っていた。関連記事・被参照記事は .nav ではないので面が付かず、
   下線だけだった。同じ見た目の3つで反応が2種類あった */
.related-posts-item,
.reference-posts-item,
.featured-posts-item {
  position: relative;
  transition: background-color hover-speed ease;
}
.related-posts-item:hover,
.reference-posts-item:hover,
.featured-posts-item:hover {
  background-color: var(--surface-mute);
}
/* 面が光るなら行ごと押せないと嘘になる。1行は「順位の丸＋サムネ＋タイトル＋
   日付」でできていて、押せるのはサムネとタイトルだけ、順位の丸と余白は
   死んでいた。タイトルのリンクの当たりを行全体に広げる。
   年月カード（.archive-list-item）が同じ形で #2219 で同じ手を使っている。
   サムネのリンク（.post-list-icon）は同じ記事への重複リンク（aria-hidden で
   読み上げからも外している）なので、広げるのはタイトル側だけにする */
.related-posts-item > a:not(.post-list-icon):after,
.reference-posts-item > a:not(.post-list-icon):after,
.featured-posts-item > a:not(.post-list-icon):after,
.related-posts-item .post-list-body > a:after,
.reference-posts-item .post-list-body > a:after,
.featured-posts-item .post-list-body > a:after {
  content: '';
  position: absolute;
  inset: 0;
}
/* 反応は行の面だけにする。中のリンクの面（.nav a:hover はサイドバーの
   「1リンク＝1行」のためのもの）と、metronic の a:hover の下線を止める。
   .nav a:hover と同じ詳細度なので、後に置いて勝たせる */
.related-posts-item a:hover,
.related-posts-item a:focus,
.reference-posts-item a:hover,
.reference-posts-item a:focus,
.featured-posts-item a:hover,
.featured-posts-item a:focus {
  background-color: transparent;
  color: var(--ink-strong);
  text-decoration: none;
}
/* 上の metronic 由来の節に `.related-post-link a { font-size: 1.2em }` があり、
   関連記事のタイトルだけ大きくなっていた。参照記事側には同じ指定が無い。
   両者を本文と同じ大きさに揃える。
   行として並ぶ記事名は太らせない（#2803）。太さを上げると、同じ帯に並ぶ
   日付・反響（0.85em・ink-mute）より先に帯全体が重くなる。
   主従はサイズと色（ink-strong 対 ink-mute）が持つ */
.related-posts-item > a,
.reference-posts-item > a,
.related-posts-item .post-list-body > a,
.reference-posts-item .post-list-body > a {
  font-size: 1em;
  color: var(--ink-strong);
}
/* ランキングはホームの主役なので、本文と同じ 1.2em で読ませる。
   関連記事・参照記事は記事に付随する自動生成の情報なので 1em に留める。
   太さは3つとも素のまま。序列は大きさが持つ */
.featured-posts-item > a,
.featured-posts-item .post-list-body > a {
  font-size: text-body;
  color: var(--ink-strong);
}
/* ランキングのサムネ (#2230)。カードにはせず、リストの密度を保ったまま
   タイトルの手がかりとして小さく添える。サムネの無い記事は
   同じ大きさの空き枠を置いて行頭を揃える */
.post-list-item-thumb {
  display: flex;
  /* サムネの中心を本文ブロックの中間に置く。タイトル＋日付の2行の
     項目では両者の境目に来る */
  align-items: center;
  gap: 12px;
}
/* ランキングの順位 (#2249)。2桁まで幅を揃えて右詰めにする。
   幅は font-size 基準なので、字を大きくしても2桁の収まりは変わらない。
   0.9em では本文より小さく、順位が目に入らなかった (#2463) */
.post-list-rank {
  flex-shrink: 0;
  /* 円に載せて順位だと分かるようにする。行の高さはサムネ（32px）が決めるので、
     26px なら行が伸びない。2桁でも収まる大きさ (#2463) */
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  /* 行の gap（10px）だけだとサムネに貼り付いて見えるので、順位の側で足す */
  margin-right: 6px;
  border-radius: 50%;
  /* 地は最下段（4位以下）の色。塗る段はクラスで上書きする */
  background: var(--surface-mute);
  /* この地の上で 5.34 で AA。ink の3段のうち ink-faint まで薄くすると
     3.97 で届かないので、ここは ink-mute で止める */
  color: var(--ink-mute);
  font-size: text-row;
  font-weight: bold;
  /* 桁によって字幅が変わると円の中で数字が動く */
  font-variant-numeric: tabular-nums;
  line-height: 1;
  /* 行の面と同じ速さで送る。transition は基底側に書く (#2686) */
  transition: background-color hover-speed ease;
}
/* 行の hover で面が surface-mute になると、塗りを持たない4位以下の丸が
   同じ色なので面に溶けて消える (#2717)。hover の間だけ白抜きにする。
   数字のコントラストも 5.34 から 6.19 に上がる。
   1位（クリムゾン）と2〜3位（ネイビー）は塗りを自分で持つので、
   :not() で外す。付けないとこの規則（0,2,1）が
   .post-list-rank-first（0,1,0）に勝って塗りを潰す */
.featured-posts-item:hover .post-list-rank:not(.post-list-rank-first):not(.post-list-rank-high) {
  background: var(--surface-base);
}
/* 1位はコンセプトブックの差し色（クリムゾン。白抜きで 5.35 = AA）。
   「差し色は画面内で1箇所」の文法に従うので、2位以下には広げない (#2681) */
.post-list-rank-first {
  background: var(--brand-crimson);
  color: var(--on-dark-strong);
}
/* 1位は数字ではなく王冠 (#2681)。crown の絵柄は 24 の枠のうち縦を 6〜18 しか
   使わないため、既定の 1em では実寸 9.6px にしかならず山が潰れる。
   1.35em で縦 12.9px・横 18.4px になり、26px の円の中で上下左右の余白が釣り合う。
   .svg-icon の既定は接頭のアイコン用に margin-right を持つので、円の中では消す */
.post-list-rank-first .svg-icon {
  width: 1.35em;
  height: 1.35em;
  margin-right: 0;
}
/* 2〜3位はネイビー塗り（白抜き 16.34）。4位以下まで塗ると帯が強すぎた。
   段の判定は popular_posts.js が持つ */
.post-list-rank-high {
  background: var(--brand-navy);
  color: var(--on-dark-strong);
}
.post-list-icon {
  flex-shrink: 0;
  /* 索引記事の表では日付のセルの中に置く。inline のままだと日付と同じ行に
     並ぼうとして、行box の下に文字の descender ぶんの余白も残る (#2790) */
  display: block;
}
/* 日付のセルの中だけ、真下に来る日付との間を1段空ける。
   flex の中（一覧・ランキング）では gap が持つので当てない */
.article-entry td > .post-list-icon {
  margin-bottom: space-step;
}
/* ::before は隠れているランキングでサムネの代わりに置く空の箱。
   content が無いと生成されないので、ここでは寸法だけ相乗りさせる */
.post-list-icon img,
.post-list-icon::before,
.post-list-icon-empty {
  display: block;
  /* 48×32 では何の画像か読み取れなかった (#2777)。比は 3:2 のまま 1.5倍にする。
     サムネの実寸は幅300px・高さがばらばら（比 1.0〜3.2）なので、
     この箱に object-fit: cover で切り取って収める */
  width: 72px;
  height: 48px;
  /* metronic の img { margin-bottom: 10px } が全画像に効いていて、
     このマージンが枠の中で画像を押し下げる。inline 時のベースライン
     余白と合わせて、ここで両方とも打ち消す */
  margin: 0;
  object-fit: cover;
  border-radius: radius-small;
}
.post-list-icon-empty {
  background: var(--surface-mute);
}
.post-list-body {
  min-width: 0;
}
.related-posts-item:last-child,
.reference-posts-item:last-child,
.featured-posts-item:last-child {
  border-bottom: none;
}
/* 被参照が多い記事では先頭5件だけ見せ、残りは details で畳む。
   全件を並べると記事末尾が長くなりすぎるが、件数で打ち切ると
   参照された事実そのものが隠れてしまうため、開けば全部見える形にする。
   JS は使わない */
.reference-post-more,
.related-posts-more {
  padding: 0;
}
.reference-post-more > summary,
.related-posts-more > summary,
.ranking-more > summary {
  padding: 0.5em 0;
  border-top: 1px solid var(--rule-weak);
  color: var(--ink-mute);
  font-size: text-meta;
  cursor: pointer;
}
.reference-post-more > summary:hover,
.related-posts-more > summary:hover,
.ranking-more > summary:hover {
  color: var(--ink-strong);
}
/* 全体指定の details { padding-bottom: 24px } を打ち消す（本文中の折りたたみ
   ブロック向けの余白で、.article-entry details と .toc-mobile も同じ理由で
   外している）。畳んだ状態だと「残り N本を表示」の下に24pxの空きが残り、
   枠の下辺との間が開いて見えていた。下の余白は枠（.tab_content）が持つ */
.ranking-more {
  padding-bottom: 0;
}
/* 畳んだ側の ul は details 側で余白を持つので、二重に付けない */
.reference-post-more .reference-post-link,
.related-posts-more .related-post-link {
  padding: 0;
}
/* 直前の ul の最終行は、summary の上線と重なって二重線になる */
.reference-post-link:has(+ .reference-post-more) .reference-posts-item:last-child,
.related-post-link:has(+ .related-posts-more) .related-posts-item:last-child,
.featured-post-link:has(+ .ranking-more) .featured-posts-item:last-child {
  border-bottom: none;
}
/* タイトルの後ろに続くメタ情報。日付と反響の数は判断材料であって
   見出しではないので、小さめの文字で添える。
   ただし #999 では白背景に対してコントラスト比2.84しかなく WCAG AA を
   大きく下回るため、色は落としすぎない */
.post-meta {
  display: inline-block;
  margin-left: 0.6em;
  font-size: text-meta;
  color: var(--ink-mute);
  white-space: nowrap;
}
.post-meta-date {
  margin-right: 0.5em;
}
/* 数字は日付と同じ大きさに揃える。以前は記号を大きくするために囲み全体を
   1.15em にしており、数字だけ日付より大きく見えていた (#2453)。
   metronic の `.snscount { padding: 0 10px }` は日付との間隔が空きすぎるので
   ここで打ち消す */
.snscount {
  padding: 0;
  letter-spacing: 0.03em;
  padding-right: 0.1em;
}
/* ♡（U+2661）は細い輪郭の記号で、小さくすると線が潰れて欠けて見える。
   記号だけ一段大きくする */
.snscount-icon {
  font-size: 1.15em;
}
/* 一覧ページ */
.summary {
  font-weight: bold;
  list-style: none;
  padding-inline-start: 0px;
  display: flex;
  flex-wrap: wrap;
  /* 一段小さいシェア内訳（.summary-sub）が主要タイルと上端で揃うと
     浮いて見えるため、ラベル行を基準に下端で揃える (#2096) */
  align-items: flex-end;
  /* 項目の間隔は gap で持つ。padding-left で空けると、折り返した行の
     先頭にも余白が残って左端が揃わない */
  gap: 8px 24px;
  padding: 0 0 4px 0;
}
.summary li {
  list-style: none;
  padding-inline-start: 0px;
  padding: 0;
}
/* 記事数やシェア数の統計。以前は .summary の 1.2em に 1.6em を掛けた
   25px で、ページ見出し（26px）とほぼ同じ大きさだった。一覧ページの
   主役は記事一覧であって統計ではないので、見出しより明確に下げる。
   em の連鎖をやめ、UI 部品として px で1箇所に書く（CLAUDE.md の方針）。
   #2911 でサイドバーへ移した先が内寸 208〜298px の列なので、20px では
   行の6割を数字が占めていた。同じ理由で 16px までもう一段下げる。
   幅では変えない（下限 17px は 16px を下回らないための下げ止まりだった） */
.summary-count {
  font-size: text-body;
  font-weight: bold;
}
.summary-label {
  font-size: text-meta;
  /* 親の bold に対する lighter は結局 normal になる。意図を明示する */
  font-weight: normal;
}
/* シェアの内訳（X・Facebook・はてブ・Pocket）。読者の行動を変える数字では
   ないので、投稿数・著者数と同格に並べず一段小さくする (#2096) */
.summary-sub .summary-count {
  font-size: text-row;
}
/* 直近1年の投稿が無いときの表記。0 のタイルを並べるより文で言う方が伝わる */
.summary-note {
  margin: 0 0 8px;
  color: var(--ink-mute);
  font-size: text-meta;
}
/* そのページ自身の統計とグラフ (#2911)。カテゴリ・タグ・著者ページで
   本文の先頭からサイドバーへ移した。読者の目的は「その記事を読む」ことで、
   総シェア数の内訳も投稿数の推移もその判断には効かない。消さないのは運営と
   書き手がこの数字を見に来るため */
/* 節の見出しは置かないので、上の空きは他の節の h2（margin-top-30）と同じ量を持つ */
.sidebar-stats {
  margin-top: 30px;
}
.sidebar-stats .summary-panels {
  /* 列の内寸は 208〜298px。累計の7タイルを横に並べると 480px 要るので縦に積む */
  flex-direction: column;
  margin-bottom: 0;
}
/* タイルではなく行。ラベルを左、数値を右に置いて桁の位置をそろえる */
/* タイル（数値の下にラベル）を行（数値の右にラベル）に組み替える。
   208〜298px の列にタイルを7つ並べると 480px 要る。クラスと大きさの段は
   本文の統計と共有するので、ここで持つのは並べ方だけ */
.sidebar-stats .summary {
  flex-direction: column;
  align-items: stretch;
  gap: (space-step) 0;
  padding-bottom: 0;
}
.sidebar-stats .summary li {
  display: flex;
  align-items: baseline;
  /* 数値とラベルは1つのまとまりなので、行の中では詰める */
  gap: 6px;
}
/* 数字は幅をそろえて右寄せにする。桁数が違うとラベルの開始位置がずれ、
   縦に読めなくなる（実測で最大31px）。幅は EJS が桁数から配る
   （--summary-count-width）。tabular-nums は数字1文字の幅をそろえる指定で、
   ch（「0」の幅）で数えた値と実際の幅を一致させる */
.sidebar-stats .summary-count {
  display: inline-block;
  width: var(--summary-count-width, 3ch);
  text-align: right;
  font-variant-numeric: tabular-nums;
}
/* シェアの内訳は総シェア数の内訳で、読者の行動を変える数字ではない。
   本文のタイルが .summary-sub で数値を一段小さくしていた区別はそのまま効く (#2096)。
   縦に並ぶぶん大きさだけでは従属が読み取りにくいので字下げを足し、
   文字も一段薄い ink-faint に落とす（白地で 4.5 を満たす最も薄い段。これより薄くしない）。

   **字下げに加えて左の縦線で「1つの塊」を示す。** 字下げと薄さだけだと
   「弱い項目が4つ並んでいる」ようにしか見えず、直上の総シェア数の内訳だと
   読み取れない。線は引用と同じ考え方（塊の左に1本、#2457）で、
   線は塊を囲う役なので段は rule-base（区切りの rule-weak ではない）。
   行の間の空き（4px）を上下2pxずつまたいで1本につなぐ。
   最初の行の上と最後の行の下は伸ばさない。

   **線は数値の箱の左端に置く**（枠の内側の端ではない）。パネルの端に置くと
   数値から 13px 離れ、内訳ではなく枠の飾りに見える */
.sidebar-stats .summary li.summary-sub {
  position: relative;
  padding-left: (space-step * 2);
}
.sidebar-stats .summary li.summary-sub::before {
  content: '';
  position: absolute;
  left: (space-step * 2);
  top: -(space-step / 2);
  bottom: -(space-step / 2);
  border-left: 1px solid var(--rule-base);
}
.sidebar-stats .summary li.summary-sub:first-of-type::before {
  top: 0;
}
.sidebar-stats .summary li.summary-sub:last-child::before {
  bottom: 0;
}
/* ch は自分の font-size を見るので、数値を一段小さくした内訳では
   同じ 5ch でも箱が狭くなり、字下げが 8px のはずが 3px に潰れていた
   （潰れ方は桁数で変わるので固定値では戻せない）。段の比で戻す */
.sidebar-stats .summary li.summary-sub .summary-count {
  /* Stylus は px 同士の割り算に px を残すので unit() で無次元に戻す。
     付いたままだと calc が「長さ×長さ」になって無効になり、width が
     auto に落ちて桁ごとに幅が変わる（一度踏んだ） */
  width: s('calc(var(--summary-count-width, 3ch) * %s)', unit(text-body / text-row, ''));
}
.sidebar-stats .summary-sub .summary-count,
.sidebar-stats .summary-sub .summary-label {
  color: var(--ink-faint);
}

/* 高さは本文にあった 250px から下げる。細い列で縦に長いと棒より余白が目立つ。
   軸ラベルに約20px 取られるので、棒が立つのは 100px ぶん。
   上の空きは数字の枠と地続きに見えない量を取る（枠の中の行間隔より広く） */
.sidebar-stats-chart {
  width: 100%;
  height: 120px;
  margin-top: (space-step * 6);
}
/* タブレット以下ではサイドバーが本文の下に落ちる。記事一覧25本とページャの
   後ろに数字を出しても読者は辿り着かないので、目次と同じく出さない (#2452)。
   総本数は一覧の見出しの「全N本」が幅に関係なく出す */
@media (max-width: 1024px) {
  .sidebar-stats {
    display: none;
  }
}

/* 統計は「累計」「直近1年」の時間軸ごとにパネルで束ねて1行に収める (#2276)。
   枠は tendency-panel と同じ意匠。時間軸はパネルのラベルが名乗る */
.summary-panels {
  display: flex;
  flex-wrap: wrap;
  align-items: stretch;
  gap: 12px;
  margin-bottom: 12px;
}
.summary-panel {
  border: 1px solid var(--rule-weak);
  border-radius: card-radius;
  padding: 6px 16px 2px;
}
.summary-panel-label {
  display: block;
  margin-bottom: 2px;
  color: var(--ink-mute);
  font-size: text-meta;
}
.summary-panel .summary-note {
  margin: 12px 0;
}
/* 著者ページの表彰パネル (#2149)。賞の名前1行＋受賞年のバッジ列 */
.summary-panel .award-name {
  margin: 10px 0 6px;
  font-weight: bold;
}
/* 賞の名前はタグの一覧へのリンク (#2760)。パネルの見出しの位置にあるので
   青くせず、反応は下線で返す（.awards-hall-name / .author-list-link と同じ規則） */
.summary-panel .award-name a {
  color: var(--ink-strong);
  text-decoration: none;
}
.summary-panel .award-name a:hover,
.summary-panel .award-name a:focus {
  color: var(--ink-strong);
  text-decoration: underline;
}
.award-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 0 0 12px;
  padding: 0;
  list-style: none;
}
/* /authors/ の表彰一覧 (#2409)。
   金は #7a5f16 を使う。既存バッジの #8a6d1a は淡金の地（#f7edcf）に対して
   4.19 で AA を割るため、この面では一段濃い金にする（対 #f7edcf 5.17、対白 6.04）。
   Webフォントも画像も足さず、色と余白と既存アイコンだけで祝いの場を作る */
.awards-hall {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin: 20px 0 28px;
}
.awards-hall-card {
  flex: 1 1 260px;
  max-width: 400px;
  padding: 18px 22px;
  border: 1px solid var(--award-card-rule);
  border-radius: card-radius;
  /* 淡い金のグラデーション。単色より奥行きが出て、賞状の紙の質感に寄る。
     質感を担うのはこの色と枠線で、影は持たない (#2747)。1つだけ影を残すと
     「どこに影を使うか」の判断が戻ってくる */
  background: linear-gradient(135deg, var(--award-card-from), var(--award-card-to));
}
.awards-hall-label {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 1em;
  font-weight: bold;
  color: var(--award-gold-on-tint);
  /* 称号は字間を開けて記章らしく見せる */
  letter-spacing: 0.12em;
}
.awards-hall-label .svg-icon {
  width: 1.25em;
  height: 1.25em;
  margin-right: 0;
}
.awards-hall-name {
  display: block;
  margin: 8px 0 12px;
  font-size: text-display;
  font-weight: bold;
  color: var(--ink-strong);
  text-decoration: none;
}
.awards-hall-name:hover,
.awards-hall-name:focus {
  color: var(--ink-strong);
  text-decoration: underline;
}
/* 受賞年は「メダル＋年」を並べる。回数が視覚的な量として伝わる */
.awards-hall-years {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  /* チップの左 padding（8px）の分だけ戻す。揃えるのは枠の位置ではなく
     中身の位置で、補正しないと上の称号・著者名より右にずれて見える (#2429 と同じ規則) */
  margin-left: -8px;
}
.awards-hall-medal {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 10px 3px 8px;
  border-radius: 999px;
  background: rgba(255,255,255,0.75);
  font-size: text-meta;
  font-weight: bold;
  color: var(--award-gold-on-tint);
}
/* 数字が読める実寸が要る。1.1em だと数字が5px前後にしかならず消える (#2451)。
   チップ（.award-chip 1.15em × 1.35em）と同じ約20pxに揃える */
.awards-hall-medal .svg-icon {
  width: 1.6em;
  height: 1.6em;
  margin-right: 0;
}
/* メダルの色は回数で決まる。規則は .award-medal（部品側）が1箇所で持つ */
/* 各年の記録。左に年、右に受賞者チップ */
.award-years {
  margin: 0;
  padding-left: 0;
  list-style: none;
}
.award-years li {
  display: flex;
  align-items: baseline;
  gap: 16px;
  padding: 8px 0;
  border-top: 1px solid var(--rule-weak);
}
.award-years li:last-child {
  border-bottom: 1px solid var(--rule-weak);
}
.award-years .award-year {
  flex: none;
  min-width: 3.2em;
  font-size: text-title;
  font-weight: bold;
  color: var(--ink-faint);
  letter-spacing: -0.01em;
}
.award-years .award-winners {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
/* チップは著者ページの受賞バッジ（.award-badge）と同じ形。ページをまたいで
   同じものが同じ見た目になるようにする */
.award-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 12px;
  border: 1px solid var(--rule-strong);
  border-radius: 999px;
  background: transparent;
  font-size: text-row;
  color: var(--ink-strong);
  text-decoration: none;
  transition: background-color hover-speed ease, border-color hover-speed ease;
}
/* メダルの円の中に受賞回数が入る（award-medal.ejs）。
   数字が読める大きさが必要なので、他のアイコンより一段大きくする。
   メダルだけ金にして名前の文字色と分ける。表彰の場なので徽章に色を持たせる
   （#8a6d1a 対 灰地 #f5f5f5 は 4.50。文字基準でも AA を満たす） */
/* チップの地は回数によらず灰のまま。回数はメダルの色だけで表す
   （地の色まで変えると一覧が賑やかになりすぎ、記録として読みにくい）。
   メダルの数字が読める大きさが要るので、他のアイコンより一段大きくする */
.award-chip .svg-icon {
  width: 1.35em;
  height: 1.35em;
  margin-right: 0;
}
/* 受賞記事のバッジ (#2422)。タイトルの上に置く。
   地は他の受賞バッジ（.award-badge / .award-chip）と同じ灰。
   色を持つのはメダルだけで、その色は受賞回数（灰→銅→金）が決める */
.article-award-line {
  margin: 0 0 6px;
}
.article-award {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 2px 10px;
  border: 1px solid var(--rule-strong);
  border-radius: 999px;
  background: transparent;
  color: var(--ink-strong);
  font-weight: bold;
}
/* 発表記事へのリンクになっている場合 (#2562)。チップの形は変えず、
   下線を外して hover / focus では枠と地だけを一段強める。

   色は hover でも文字色のまま置く。リンク色にすると賞の印ではなく
   本文中のリンクに見える。ここで color を書かないと Bootstrap の
   a:hover（0,1,1）が .article-award（0,1,0）に勝って青くなる。

   タグのチップ（.tag-list-link）のように地を反転させないのは、
   メダルが色（灰・銅・金）で受賞回数を表しているため。濃い地に載せると
   その3色が読めなくなる。地は surface-mute までで、この面でも
   メダルはAAを満たす（灰 4.95 / 銅 4.53 / 金 5.21） */
a.article-award {
  text-decoration: none;
  transition: background-color hover-speed ease, border-color hover-speed ease;
}
/* チップの反応は地を一段動かす。ネイビーに反転できるのは、中身が色で情報を
   持たないものだけ（#2686）。タグチップは文字だけなので反転するが、ここは
   メダルの色が受賞回数を表しているのでグレーで止める。ネイビー地に載せると
   灰 2.64 / 銅 3.11 / 金 2.70 でどれも AA に届かない（#eee なら 5.34 / 4.53 / 5.21） */
a.article-award:hover,
a.article-award:focus {
  background: var(--surface-mute);
  color: var(--ink-strong);
}
/* メダルの色は .award-medal（回数で決まる）に任せる。ここで色を指定すると
   詳細度で勝って灰→銅→金の規則を潰してしまう */
.article-award .svg-icon {
  width: 1.15em;
  height: 1.15em;
  margin-right: 0;
}
/* 受賞メダルの色は「何回目の受賞か」で決まる (#2409)。/authors/ の一覧でも
   著者ページのバッジでも同じ規則が効くよう、部品のクラスに持たせる。
   淡金の地（殿堂カード #f7edcf）と灰地（チップ #f5f5f5）の両方で AA を満たす値:
   灰 #666 4.91 / 銅 #a05a2b 4.50 / 金 #7a5f16 5.17（いずれも淡金地での比）。
   金は彩度が低く線の細さのままだと隣の銅に負けるので、線だけ太くして
   目方で勝たせる（塗ると質感が浮いて他のメダルと別物に見える） */
.award-medal {
  color: var(--ink-mute);
}
.award-medal-2 {
  color: var(--award-bronze);
}
.award-medal-3 {
  color: var(--award-gold-on-tint);
  stroke-width: 2.6;
}
/* 地を一段動かすだけで止める理由は a.article-award と同じ（メダルの色） */
.award-chip:hover,
.award-chip:focus {
  background: var(--surface-mute);
  color: var(--ink-strong);
  text-decoration: none;
}
/* 受賞年のバッジはグレースケール。金は殿堂入りだけに使い、称号の格を色で分ける
   （灰アイコン#6e6e6e: 対 淡灰#f5f5f5 4.68。AA充足） */
.award-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 12px;
  border: 1px solid var(--rule-strong);
  border-radius: 999px;
  background: transparent;
  font-weight: bold;
}
.award-badge svg {
  flex: none;
}
/* バッジは li の中に入っている（リンクになる年だけ <a>）。li は箱としてだけ
   使うので、中のバッジが高さいっぱいに揃うよう flex にする */
.award-badges li {
  display: flex;
}
/* アイコンは共有部品（.svg-icon）。バッジは gap で間隔を取るので、
   部品側の右マージンは打ち消す */
.award-badge .svg-icon {
  width: 1.15em;
  height: 1.15em;
  margin-right: 0;
}
/* 受賞年のバッジは代表記事へのリンクになる (#2760)。形は変えず、下線を外して
   hover / focus では枠と地だけを一段強める。color を書かないと Bootstrap の
   a / a:hover が勝って青くなる。色を動かさない理由は a.article-award と
   同じで、メダルの色が受賞回数を表しているため */
a.award-badge {
  color: var(--ink-strong);
  text-decoration: none;
  transition: background-color hover-speed ease, border-color hover-speed ease;
}
a.award-badge:hover,
a.award-badge:focus {
  background: var(--surface-mute);
  color: var(--ink-strong);
}
/* 殿堂入り（3回受賞）だけ金（#8a6d1a: 対 白文字 4.90。AA充足） */
.award-badge-hall {
  background: var(--award-gold);
  border-color: var(--award-gold);
  color: var(--on-dark-strong);
}
.award-badge-hall svg {
  color: var(--on-dark-strong);
}
/* ページ単位の節見出し。記事末の帯（.article-appendix）の3節もこれを使う (#2874)。
   We're hiring の節は .article-entry を持つので、そのままだと
   .article-entry h2（詳細度 0,1,1）に負ける。値は1箇所で持ったまま
   セレクタだけ足して 0,2,0 にする */
.bottom-content-header,
.article-entry .bottom-content-header {
  font-weight: bold;
  /* 見出しと直後のコンテンツが近すぎて窮屈に見えていた。
     既定の h2 マージン（0.5rem ≒ 8px）しか無く、見出しが本文に貼り付いていた。
     上にも余白を取り、セクションの区切りとして塊が分かれて見えるようにする */
  margin: 48px 0 20px;
  /* 罫線は本文の h2 だけが持つ印。.article-entry h2 から降りてくるのを止める */
  border-bottom: none;
  padding-bottom: 0;
}
/* 見出しの行の右端に添えを置く形 (#2911)。h1 と RSS の .list-page-header と
   同じ作りだが、見出しと小さい文字を並べるのでベースラインで揃える。
   h2 の margin はこの中に残るので、節の前の空きは変わらない */
.section-heading-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
}
/* 数は見出しではなく添え。押す対象でもないので、他のメタ情報と同じ段に置く */
.section-heading-meta {
  flex: none;
  color: var(--ink-mute);
  font-size: text-row;
}
/* ランキングはページ最上部に来るため、上の余白はパンくずが担う */
.home-ranking .bottom-content-header {
  margin-top: 16px;
}
/* 記事末の自動生成ブロックを1つの面に乗せる (#2874)。本文に従属するもの
   （連載ナビ・共有ボタン・著者紹介）と、従属が弱い二次生成のもの（関連記事・
   被参照・We're hiring）の境目を出す。ここは空きでは分けられない。
   もともと 67.5px（著者紹介がある記事は 48px）空いていて、本文の中の節の
   切れ目（56px）より広いのに地続きに見えていたため、量ではなく質を変える。

   面は surface-tint（静止した面の段）。全幅の帯にしてフッターのネイビーに
   接するので、角丸は持たない（両端が画面の外に出るため丸める相手が無い）。
   左右の揃いは中の .container が他ページと同じ形で持つ */
.article-appendix {
  background: var(--surface-tint);
  /* 帯の上の空きは1箇所で持つ。中の最後の要素（共有ボタンの padding /
     著者紹介のカード）には下の空きを持たせない */
  margin-top: 40px;
  padding: 40px 0;
}
/* 中身は白の面に戻す。行の細線（rule-weak）・行の hover（surface-mute）・
   NEW の枠（rule-base）・空サムネはいずれも白地の上で決めた値で、グレーの上では
   一段弱くなる（#2732 で確認した性質）。グレーは領域の枠として外側に残し、
   読む対象は白の上に置く */
.article-appendix-inner {
  background: var(--surface-base);
  border-radius: card-radius;
  padding: 24px;
}
/* 節の間は見出しの margin-top（48px）が持つ。帯の内側の上端では二重になるので落とす */
.article-appendix section:first-child > .bottom-content-header {
  margin-top: 0;
}
/* 帯はフッターのネイビーに接する。.wrap は縦の flex で `.wrap > footer` が
   margin-top: auto を持つため、中身が画面より短いページではその余りが
   帯とネイビーの間に白として入る。余りは帯より前（本文の container）で吸わせる */
.wrap > .article-appendix + footer {
  margin-top: 0;
}
.wrap > .container:has(+ .article-appendix) {
  margin-bottom: auto;
}

/* ランキングのタブ。JS を使わず radio + label で切り替えている。

   以前は選択タブの下だけに線を引く形で、しかも .tabs label の
   color: #ECEBEB（ほぼ白）が .tab_item より詳細度で勝っていたため
   未選択タブがほとんど読めず、どれが選ばれているか分からなかった。
   選択タブの border-bottom はセミコロンが抜けていて直後の指定も死んでいた。

   タブと本体を1つの枠で囲む一般的な形にする。選択タブだけ本体と同じ白地に
   なり、下辺を本体の枠線に重ねて繋がって見せる */
/* タブと本体を1枚のカードに収める。

   以前はタブと本体がそれぞれ影を持つ別々の面で、境目で接していた。
   その形だと境目に落ちうるものが次々に出てきて（本体の枠線、タブの下向きの
   影、本体の上向きの影、タブ左右の影）、1つ潰すたびに別の要因が現れる。
   接している限り終わらないので、面そのものを1つにする。

   float したタブを含めるのは flow-root。overflow: hidden だと影が親の箱の
   外側で切り取られ、角丸も四角く削られる */
.tabs {
  display: flow-root;
  /* 見えない radio の位置の基準。帯の外へ飛ばすとフォーカス時に
     ブラウザがそこまでページを送ってしまう */
  position: relative;
  /* カード全体の地色はタブ帯の色にする。タブは操作であってコンテンツでは
     ないので、本体と同じ白地に浮かせると用途のない余白に見える。
     帯として右端まで塗り、選択タブだけ白にして本体とつなげる。

     コードブロックのファイル名タブのように内容ぶんで止める案も試したが、
     帯が途中で切れるとカードの影と地色の整合が崩れ、タブだけが浮いて
     見えてしまった。帯は端まで伸ばす */
  background-color: var(--surface-tint);
  border-radius: card-radius;
  /* 輪郭は影ではなく枠線が持つ (#2747)。横に並ぶタブと本体を包む箱なので、
     一覧のように間隔だけでは成立しない */
  border: 1px solid var(--rule-base);
}
.tab_item {
  float: left;
  /* 真下に出す .tab-hint の基準 (#2852) */
  position: relative;
  /* 上辺のアクセントは箱の内側に置く。以前は負のマージン（-8px）でカードの外へ
     出していたが、枠線を持つと線がタブを横切るので内側に収めた (#2747)。
     文字の位置は変わらない（border 3 + padding 10 = 13。未選択も選択も同じ）。

     未選択時の枠は透明なので、何も起きていないように見える */
  padding: 10px 22px 10px;
  margin: 0 4px 0 0;
  font-size: text-row;
  line-height: leading-row;
  letter-spacing: 0.02em;
  color: var(--ink-mute);
  /* 未選択タブは帯の地色をそのまま見せる。塗りを重ねると帯の中で
     さらに面が分かれて見える */
  background-color: transparent;
  /* 枠線は出さない。地色より濃いグレーの線が縁取ると、タブの面と線が
     食い違って見えて古びた印象になる。
     消すのではなく透明にするのは、選択時にボックスの寸法が変わって
     高さがずれるのを防ぐため */
  border: 1px solid transparent;
  border-top: 3px solid transparent;
  border-radius: card-radius card-radius 0 0;
  /* 影と地色はカード（.tabs）が持つ。ここで面を分けない */
  cursor: pointer;
  transition: background-color hover-speed ease, border-top-color hover-speed ease,
    color hover-speed ease;
}
.tab_item:hover {
  background-color: var(--surface-mute);
  /* 押せることは上辺の色で伝える。枠線全体は出さない */
  border-top-color: var(--rule-strong);
  color: var(--ink-strong);
}
/* 矢印キーで切り替えられることは画面に出ていない (#2852)。キーボードで
   フォーカスしているタブの真下（本体の上の余白 18px の中）にだけ出す。
   絶対配置なのでレイアウトは動かず、マウスの読者には一度も出ない。

   帯の右や上ではなく真下なのは、離れていると気づかないため。右端に置くと
   ホームの帯では最後のタブから 700px 離れ、上の余白（20px）は見出しが
   左半分を占めていて左に寄せられない。

   文字は label の中の span が持ち（_partial/tab-hint.ejs が1箇所で持つ）、
   ::after の生成文字列にはしない。生成文字列はラジオの読み上げ名に
   混ざる（「トレンド ← → で切り替え」になった）。span 側は aria-hidden で外す。

   色は同時に出るフォーカスの輪郭と同じネイビー。2つを1つの信号として読ませる
   （白地で 16.34。差し色のクリムゾンは 5.35 で ink-mute の 6.19 より低い）*/
.tab-hint {
  position: absolute;
  /* 枠の 1px ぶん下。ラベルの下辺と本体の境目にそろう */
  top: unquote('calc(100% + 1px)');
  /* ラベルの左 padding 22px − 枠 1px。タブの文字の頭にそろう */
  left: 21px;
  color: var(--brand-navy);
  font-size: text-meta;
  line-height: leading-row;
  font-weight: 400;
  letter-spacing: 0;
  white-space: nowrap;
  visibility: hidden;
}
.tabs input[type="radio"]:focus-visible + .tab_item .tab-hint {
  visibility: visible;
}
/* 幅が足りずタブが2行に折り返すと、真下の文字が2行目のタブに重なる
   （著者ページの年タブが 992px 未満で折り返す）。狭い幅では出さない。
   矢印キーを使う読者はキーボードのある画面幅にいる */
@media (max-width: 991px) {
  .tab-hint {
    display: none;
  }
}
/* 輪郭は見えない radio ではなく、その label に描く。
   帯の中なので内側にずらす（#2686 の例外はこれ）*/
.tabs input[type="radio"]:focus-visible + .tab_item {
  outline: 2px solid var(--brand-navy);
  outline-offset: -2px;
}
/* ラジオボタンは見せず、label をタブとして見せる。ただし display: none には
   しない (#2852)。それだとキーボードから触れる要素がタブに1つも無くなり、
   label に tabindex を付けて凌いでいた。label は Enter でも Space でも
   発火しない（クリックのときだけ radio へ転送される）ので、フォーカスは
   当たるのに切り替えられなかった。
   radio 自体をフォーカス対象に戻すと、ブラウザのラジオグループの振る舞い
   （Tab で組に入り、矢印キーで移動しながら選択、Tab で抜ける）がそのまま効く。
   絶対配置なので帯のレイアウトには入らない（親の .tabs が position: relative）*/
.tabs input[type="radio"] {
  position: absolute;
  top: 0;
  left: 0;
  width: 1px;
  height: 1px;
  margin: 0;
  opacity: 0;
  /* 見えない1pxを踏めてしまわないようにする。押す対象は label */
  pointer-events: none;
}
/* 中身の切り替えに動きを付ける (#2728)。タブ帯（ラベル）の hover と選択は
   すでに hover-speed で送っているが、中身は瞬時に入れ替わるので、押した結果が
   同じ場所で差し替わったことに気づきにくかった。

   こちらのタブは display で出し入れしているため transition が効かない。
   表示された瞬間に動く animation を使う。ランキング（.tab-stack）は
   重ねてあるので透明度の遷移側で送る */
@keyframes tab-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.chart-tabs input:checked + .tab_item + .tab_content,
.year-tabs input:checked + .tab_item + .tab_content {
  animation: tab-fade-in tab-speed ease;
}
/* 動きを減らす設定では切り替えを瞬時に戻す。0.05秒の色や面の送りは
   動きではないので止めない（#2686 と同じ線引き） */
@media (prefers-reduced-motion: reduce) {
  .chart-tabs input:checked + .tab_item + .tab_content,
  .year-tabs input:checked + .tab_item + .tab_content {
    animation: none;
  }
}
/* 選択されているタブ。上辺にブランドネイビーのアクセントを置いて
   所在をはっきりさせる（選択状態＝インタラクションなので --brand-navy の
   守備範囲。ページャーの選択色と同じ扱い）。
   塗りで主張させるとランキングの中身より目立ってしまうので線1本に留める */
.tabs input:checked + .tab_item {
  background-color: var(--surface-base);
  color: var(--ink-strong);
  /* 本体と同じ白地になることでひと続きに見える。枠線は使わない。
     上辺のアクセントだけ残して選択状態を示す */
  border-top-color: var(--brand-navy);
  font-weight: bold;
}
.tab_content {
  display: none;
  clear: both;
  /* 本体だけ白。選択タブ（白）とそのままつながり、未選択タブは帯に沈む。
     影はカード（.tabs）が持つので、ここでは持たない */
  background-color: var(--surface-base);
  border-radius: 0 0 card-radius card-radius;
  padding: 18px 22px;
}

/* トレンドと年間人気を同じマスに重ね、枠の高さを常に両者の最大にする (#2683)。
   以前はタブを切り替えるたびに枠の高さが変わり、下の「連載から探す」以降が
   上下に動いていた。差は件数（どちらも10本）ではなくタイトルの折り返し数で、
   幅が狭いほど開く（実測で 1280px 幅 12px・375px 幅 34px）。

   隠す側を display: none にすると箱ごと消えて高さを取れないので、
   grid の同じマスに重ねて visibility で隠す。visibility なら
   display: none と同じく読み上げ・タブ移動からも外れる */
.tab-stack {
  display: grid;
  clear: both;
}
.tab-stack > .tab_content {
  grid-area: 1 / 1;
  display: block;
  visibility: hidden;
  /* 切り替えに動きを付ける (#2728)。ここは display で出し入れせず同じマスに
     重ねてあるので、透明度を送れる */
  opacity: 0;
}
/* **transition は表示される側に書く。** 基底（上）に置くと消える側も
   0.18秒かけて薄くなり、同じマスに重ねてある2枚が同時に見えて文字が重なる。
   「出るときだけ送る」形にしたいので、#2686 の「transition は基底側」の
   原則をここでは意図して外す */
#monthly:checked ~ .tab-stack > #popular_monthly,
#yearly:checked ~ .tab-stack > #popular_yearly {
  visibility: visible;
  opacity: 1;
  transition: opacity tab-speed ease;
}
/* 動きを減らす設定では瞬時に切り替える。詳細度が同じなので、打ち消しは
   必ず上のルールより後ろに置く（メディアクエリは詳細度を上げない） */
@media (prefers-reduced-motion: reduce) {
  #monthly:checked ~ .tab-stack > #popular_monthly,
  #yearly:checked ~ .tab-stack > #popular_yearly {
    transition: none;
  }
}
/* 隠れている側は「畳んだ状態」の高さで数える。開いたまま切り替えると、
   開いた分の空白がもう片方の下に残ってしまう */
#monthly:checked ~ .tab-stack > #popular_yearly .ranking-more > :not(summary),
#yearly:checked ~ .tab-stack > #popular_monthly .ranking-more > :not(summary) {
  display: none;
}
/* 隠れている側のサムネは読み込ませない。見えないのに初期表示で8枚・321KB
   増える（残り2枚は両方のランキングに載っている記事で、どちらでも読む）。
   ただし行の高さはサムネが決めるので、img を落とすだけだと折り返し数が
   変わって高さが合わなくなる。同じ寸法の空の箱に差し替える。
   寸法は .post-list-icon img と同じ1箇所で持つ（a 側の padding も効いたまま） */
#monthly:checked ~ .tab-stack > #popular_yearly .post-list-icon img,
#yearly:checked ~ .tab-stack > #popular_monthly .post-list-icon img {
  display: none;
}
#monthly:checked ~ .tab-stack > #popular_yearly .post-list-icon::before,
#yearly:checked ~ .tab-stack > #popular_monthly .post-list-icon::before {
  content: '';
}

.github-edit-icon {
  display: inline-block;
  width: 24px;
  height: 24px;
  margin-right: 1em;
  background-size: contain;
  background-image: url("data:image/svg+xml;base64,");
}

/* 新着の目印。以前は白抜き＋濃い背景の塗りバッジで、タイトルより主張が
   強かった。隣に並ぶ .post-meta（日付・反響数）と同じく控えめな添え物として
   扱い、枠線だけの表現にする */
.newitem{
  /* #8a8a8a は白背景に対して 3.45 で AA を下回るため少し濃くする。
     枠線は装飾なので薄いままでよい */
  color: var(--ink-mute);
  padding: 0 4px;
  margin-left: 0.4em;
  display: inline-block;
  box-sizing: border-box;
  background-color: transparent;
  border: 1px solid var(--rule-base);
  border-radius: radius-small;
  font-weight: normal;
  font-size: text-meta;
  line-height: leading-row;
  vertical-align: middle;
}
/* ヘッダーの右端のサイト内検索 (#2399)。サイドバーから昇格し、全ページで同じ位置に出す。
   枠を持つのはフォーム1つだけで、中の入力欄と送信ボタンは地も枠も持たない。
   反応もフォームの側だけに置く（1部品1反応・外側優先 #2686）。
   帯が写真でなくなったので絶対配置をやめ、通常のフローで並べている (#2877) */
.header-search {
  display: flex;
  align-items: center;
  /* 帯が詰まったときに縮むのはここ（上の .header-brand の段を参照） */
  min-width: 0;
  border: 1px solid var(--rule-base);
  border-radius: radius-small;
  background: var(--surface-tint);
  transition: border-color hover-speed ease, background-color hover-speed ease;
}
.header-search:hover {
  border-color: var(--rule-strong);
}
.header-search:focus-within {
  border-color: var(--rule-strong);
  background: var(--surface-base);
}
.header-search input {
  width: 200px;
  min-width: 0;
  height: 32px;
  padding: 0 (space-step * 3);
  font-size: 16px; /* 16px 未満だと iOS がフォーカス時に画面をズームする */
  border: 0;
  background: none;
  border-radius: radius-small 0 0 radius-small;
}
.header-search input::placeholder {
  color: var(--ink-faint);
}
.header-search button {
  display: flex;
  align-items: center;
  height: 32px;
  padding: 0 (space-step * 2);
  border: 0;
  cursor: pointer;
  font-size: 16px; /* アイコン（.svg-icon = 1em）の実寸を決める */
  color: var(--ink-mute);
  background: none;
  border-radius: 0 radius-small radius-small 0;
}
.header-search button .svg-icon,
.header-search-open .svg-icon {
  margin-right: 0;
}
/* 展開用の虫眼鏡ラベルと、畳む ✕。入力欄が常時出ている広い画面では使わない
   （PC は入力欄が 200px で外側が広く、外をクリックすれば閉じる） */
.header-search-open,
.header-search-close {
  display: none;
}
/* 幅575px以下では虫眼鏡だけにして、帯の残りをサイト名に譲る。
   タップ（label→input フォーカス）で :focus-within により展開する。JS は使わない。
   送信はキーボードの検索キーが担うため、送信ボタンは出さない
   （タップでの送信は Safari が button にフォーカスを与えず、
   blur で先に閉じてしまうため成立しない） */
@media (max-width: 575px) {
  .header-search {
    border-color: transparent;
    background: none;
  }
  .header-search-open {
    display: flex;
    align-items: center;
    margin: 0;
    padding: space-step;
    /* .svg-icon が 1em なので、これは文字ではなくアイコンの実寸。段の外 */
    font-size: 20px;
    color: var(--ink-mute);
    cursor: pointer;
  }
  .header-search input {
    width: 0;
    padding: 0;
    opacity: 0;
    transition: width 0.15s ease, opacity 0.15s ease;
  }
  .header-search button {
    display: none;
  }
  .site-header:has(.header-search:focus-within) .header-backdrop {
    display: block;
  }
  /* 展開中は帯を覆う。入力欄だけを伸ばすとサイト名を押し出して帯が崩れる。
     覆ったフォームが位置の基準になるので、下に開くパネルは帯の下辺に揃う。
     **左右の余白はフォームではなく中の部品が持つ** (#2888)。フォームに
     padding を置くと、全幅で出すパネルを同じ量だけ外へ出し戻す指定が要る */
  .header-search:focus-within {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 0;
    border-color: transparent;
    border-radius: 0;
    background: var(--surface-base);
  }
  .header-search:focus-within .header-search-open {
    padding: space-step (space-step * 2);
  }
  .header-search:focus-within input {
    width: 100%;
    opacity: 1;
  }
  /* パネルも全幅にする。端に接するので左右の枠と角丸は落とし、
     中の余白はページの左右の余白（.container の 12px）に揃える */
  .header-search:focus-within .header-search-hint {
    left: 0;
    right: 0;
    width: auto;
    padding-left: (space-step * 3);
    padding-right: (space-step * 3);
    border-left: 0;
    border-right: 0;
    border-radius: 0;
  }
  /* 広がっているときだけ右端に出す。押せる面は 24×24px を下回らないように
     上下左右に 4px ずつ取る */
  .header-search:focus-within .header-search-close {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    padding: space-step (space-step * 2);
    font-size: 20px; /* アイコン（.svg-icon = 1em）の実寸を決める */
    color: var(--ink-mute);
    cursor: pointer;
  }
  .header-search-close .svg-icon {
    margin-right: 0;
  }
}
/* 検索窓を押したときに出る行き先の一覧 (#2791)。フォームの :focus-within で開き、
   input:placeholder-shown で「打ち始めたら閉じる」を作る。JS は使わない。
   影は持たない (#2747)。白い面と枠で本文から浮かせる */
/* 位置の基準は .header-bar（狭い幅で展開したときだけ .header-search）。
   どちらでも top: 100% が帯の下辺、right: 0 が本文と同じ右端になる */
.header-search-hint {
  position: absolute;
  top: 100%;
  right: 0;
  /* タグのチップが3〜4個ずつ折り返す幅。カテゴリを3列に並べるための 530px は、
     カテゴリと連載をヘッダーのナビへ移して要らなくなった (#2877)。
     引く 24px は .container の左右の余白 12px × 2 */
  width: unquote('min(420px, calc(100vw - 24px))');
  /* 面の中の余白は四辺で1つの値にする。中のチップは負のマージンを持つので
     （ul.tag-list の -13px）、辺ごとに値が違うと打ち消しが噛み合わず、
     左端が枠に貼り付く (#2887) */
  padding: (space-step * 4);
  /* 320px 幅では1列に落ちて縦に伸びるので、面の中で送れるようにする */
  max-height: unquote('calc(100vh - ' + header-height + ')');
  overflow-y: auto;
  background: var(--surface-base);
  border: 1px solid var(--rule-base);
  border-radius: 4px;
  color: var(--ink-strong);
  visibility: hidden;
  opacity: 0;
  /* 閉じるときだけ visibility を遅らせる。Safari はクリックでリンクに
     フォーカスを与えず、blur で先に閉じるとタップが着地しない（送信ボタンを
     モバイルで出していないのと同じ理由）。消えるまでの間に click が届く */
  transition: opacity 0.12s ease, visibility 0s 0.3s;
}
.header-search:focus-within input:placeholder-shown ~ .header-search-hint {
  visibility: visible;
  opacity: 1;
  transition: opacity 0.12s ease;
}
/* 枠の中のラベル。見出しではなく面の中の仕切りなので h2 は使わない */
.header-search-hint-label {
  margin: 0 0 10px;
  font-size: text-base;
  font-weight: bold;
  color: var(--ink-mute);
}
/* 地の文の中では ul.tag-list が -13px でチップの「文字」を段落の左端へ
   そろえる (#2429 / #2453)。囲みの中では枠の左端をそろえる方が正しいので
   打ち消す。間隔は gap が持つ (#2864)。チップのマージンで作ると、
   行末と最終行のぶんだけ右と下に余分な空きが出て四辺が揃わない (#2887) */
.header-search-hint ul.tag-list {
  margin: 0;
  display: flex;
  flex-wrap: wrap;
  gap: (space-step * 3);
}
/* チップはホームでは 12px。あちらは本文と並ぶ添えの情報だが、こちらは
   面の中の行き先そのものなので一段上げる */
.header-search-hint .tag-list-link {
  font-size: text-base;
  margin: 0;
}
/* 全件への行き先。ヘッダーのナビの「連載の一覧を見る」と同じ部品
   （.header-dropdown-more）で、色・線・hover の面はそちらが持つ。
   行の左右の padding だけ落とすのは、この面ではラベルとチップが
   padding の端から始まるため（あちらは行そのものが左右に 12px 持つ並び）*/
.header-search-hint-more {
  margin-top: (space-step * 3);
  padding-left: 0;
  padding-right: 0;
}
.reference-posts-item a {
  color: var(--ink-strong);
}
.list-sub-text {
  font-size: text-lead;
  margin-left: 4px;
}
.author-profile {
  padding: 0 0 20px 0;
}
/* ブランドの絵柄はリンク青で塗ると本文のリンクの一部に見えるので、文字色の段に
   乗せて絵として見せる。押せることは .icon-link の地（面）が示すので、
   hover でも色は動かさない。状態ごとに書いているのは詳細度のためで、
   metronic の `a:hover`（0,1,1）に勝つ必要がある */
.author-profile .icon-link,
.author-profile .icon-link:hover,
.author-profile .icon-link:focus {
  color: var(--ink-strong);
}

/* 白地の画像（スライドや白背景のスクリーンショット）は本文と地続きに見えて
   どこまでが画像か分からない。記事側で class="bordered" を付けて縁取る。
   全画像に一律で付けないのは、枠を内蔵した画像や写真では二重線になるため */
.article-entry img.bordered {
  border: 1px solid var(--rule-base);
}

/* パンくずリスト直下のページング情報（2ページ以降） */
.pagination-info {
  margin-top: 20px;
  color: var(--ink-mute);
}

/* 全件への導線（#2304 / #2893）。ホームの連載・特設の枠、サイドバーの人気のタグ、
   記事末の連載ナビと著者紹介で共用する。ヘッダーのドロップダウンの
   「連載の一覧を見る」（.header-dropdown-more）と同じ役なので、色も同じ ink-mute。
   14px は「行として並ぶもの」の段で、添えのメタ（.panel-meta 11.7px）と分ける */
.more-link {
  text-align: right;
  font-size: text-row;
  margin-top: 8px;
}
/* 青をやめたぶんの手がかりは末尾の > が持つ。太さは 400 のまま置く。
   14px の1行を 700 にすると、行の中で主従が付く前に重くなる（#2803） */
.more-link a {
  color: var(--ink-mute);
}
/* 添えの情報のリンクと同じ「ink-mute から ink-strong へ一段濃く＋下線」(#2699)。
   面の打ち消しは著者紹介が class="nav" を持つためで、無いと .nav a:hover の
   灰色の面と下線が二重になる（1部品1反応 #2686） */
.more-link a:hover,
.more-link a:focus {
  color: var(--ink-strong);
  text-decoration: underline;
  background-color: transparent;
}
/* /tags/ の「人気のタグ」2列パネル（直近1年/累計 #2358）。
   summary-panel の枠と小ラベルを継ぎ、チップが収まるよう下側だけ広げる。
   row の負のトップマージンはカラム自身のガターと相殺するため対策不要 */
.tag-pool-panel {
  padding-bottom: 12px;
}
/* 既定の 2px はタイル数値用の詰め。チップ相手だとラベルが貼り付いて見える */
.tag-pool-panel .summary-panel-label {
  margin-bottom: 10px;
}

/* /series/ の年ごとの枠。ラベルと枠線は summary-panel を継ぎ、
   カードが収まるよう下側の padding だけ広げる */
.series-year {
  padding-bottom: 16px;
  margin-bottom: 24px;
}
/* row(g-4) の負のトップマージンが年ラベルに食い込むため枠内では無効化する。
   ラベルとカードの間隔がカード同士の間隔（24px）と同じになる */
.series-year .series-panels {
  margin-top: 0;
}
/* 年ラベル横のその年の内訳 (#2572)。年が先に読めるよう間を空ける。
   色・大きさは親（summary-panel-label）のまま継ぐ */
.series-year-meta {
  margin-left: 12px;
}

/* サムネの無い連載の空き枠。.panel-thumb img と同じ寸法 */
.panel-thumb-empty {
  display: block;
  width: 88px;
  height: 59px;
  background: var(--surface-mute);
  border-radius: radius-small;
}

/* カテゴリページの見出し行（#2294）。RSS購読アイコンを見出しの右端に置く */
.list-page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
/* 円と色と hover は .share-btn が持つ（マークアップで両方のクラスを付ける）。
   アイコンだけのリンクの反応は「地が一段変わる」1種類にそろえる (#2686)。
   ここが持つのは、長いカテゴリ名に押されて円が潰れないようにする指定だけ */
.feed-icon-link {
  flex: none;
}

/* Mermaidの背景をテーマのスタイルから独立させる。
   pre.mermaid はSVGキャッシュ未生成時のフォールバック（ブラウザ描画）、
   .mermaid-svg はビルド時に生成したSVGのインライン展開先（#1955）。
   両者は同じ mermaid の DOM になるため、見た目を揃えて同じ規則を当てる */
pre.mermaid {
  background-color: transparent !important;
  border: none !important;
  padding: 0 !important;
  font-size: inherit; /* コードブロック用の文字サイズを図に持ち込まない */
}
.mermaid-svg {
  margin: 0 0 1rem; /* bootstrap-subset の pre と同じ余白 */
}
pre.mermaid,
.mermaid-svg {
  line-height: 1; /* SVGの上下にできる余分な空白を消す */
}
.mermaid-svg svg {
  max-width: 100%;
  height: auto;
}
/* .article-entry p 等のスタイルがMermaid SVG内の foreignObject に波及するのを防ぐ */
.article-entry pre.mermaid p,
.article-entry pre.mermaid span,
.article-entry pre.mermaid li,
.article-entry .mermaid-svg p,
.article-entry .mermaid-svg span,
.article-entry .mermaid-svg li {
  color: inherit !important;
  font-size: inherit !important;
  line-height: inherit !important;
  text-align: inherit !important;
  margin: 0;
}

/* /articles/20260602a/ で崩れたため */
.article-entry pre.mermaid .edgeLabel,
.article-entry .mermaid-svg .edgeLabel {
  color: var(--ink-strong);
}

/* ラベルは foreignObject に計測時のサイズで固定embedされるが、計測時のフォント
   （ビルド側は Noto CJK）と読者環境のフォント（游ゴシック等）は一致させようがなく、
   読者側が大きいと既定の overflow: hidden で文字が途中で切られる（#2302）。
   切り捨てをやめ、はみ出しても描画する。SVG内の要素なので大文字小文字は区別される */
.article-entry pre.mermaid foreignObject,
.article-entry .mermaid-svg foreignObject {
  overflow: visible;
}

/* ::: note の種別。持たせるのは色だけで、寸法は .note-container が1箇所で決める。
   以前は両方が padding / margin / border-radius を宣言しており、同じ詳細度の
   後勝ちで .note-container 側だけが効いていた。読んでも効いている値が分からない
   状態で、CLAUDE.md の「1つの要素のサイズは1箇所でしか決めない」に反していた (#2486)

   tip の地は以前 #8E96AA24 と透過色だったが、他の3つに合わせて不透明にした。
   白地に載せた実効値と同じなので見た目は変わらない。透過のままだと、ここから
   色を導くたびに合成計算が要る（#2482 でその合成を誤って1段濃い色を算出した） */
note-tip-bg = #eff0f3
note-info-bg = #e5f8e2
note-warn-bg = #fdf9e2
note-alert-bg = #ffdbdb

.note-container.note-tip {
  background: note-tip-bg;
}
.note-container.note-info {
  background: note-info-bg;
}
.note-container.note-warn {
  background: note-warn-bg;
}
.note-container.note-alert {
  background: note-alert-bg;
}

/* 左右非対称（左16 / 右24）で、下は 0.2rem = 3px しか無かった。
   中の最後の段落の下マージンで見かけ上は埋まるが、1段落だけの注記では
   下が詰まる。囲みの余白はここで四方を決め、最後の要素の下マージンは消す */
.note-container {
  display: flex;
  align-items: flex-start; /* アイコンとテキストを上揃えにする */
  padding: 16px 20px;
  margin: 24px 0;
  border-radius: card-radius;
}
.note-container > div > :last-child {
  margin-bottom: 0;
}

/* モバイルでは note の本文だけが狭かった (#2521)。幅375pxで本文カラムは
   351px あるのに、note の中は枠の padding 40px とアイコン列 28.4px を引いて
   282.6px しかない。19.5% が一律に削られ、本文15.6pxで1行4文字強の差になる。

   地の色を画面端まで伸ばし、文字の位置は段落と揃える。左右の padding を
   .container と同じ12pxにすると note の中の文字の左端が段落の左端と一致し、
   幅も完全に戻る。読者から見ると文字の位置は何も変わらず、色の帯だけが
   端まで伸びた形になる。padding を20pxのまま全幅にすると、note の文字だけが
   本文より8px内側へ入って段差がかえって目立つ。

   50% は .container の内側幅を指すので、margin は左右とも -12px になる。
   100vw と違いスクロールバーの幅を含まない。

   絵柄は本文と連動させず、左上に置いた装飾として扱う。1行目の横に回り込ませる
   float も試したが、float が避けるのは行ボックスだけで、箇条書きやコードブロックが
   自前で持つ左の溝とは重なる。実際に箇条書きで始まる3件でマーカーが潰れていた。
   絶対配置なら中身が何で始まっても関係が無く、要素ごとの特例を持たずに済む */
@media (max-width: 767px) {
  .article-entry .note-container {
    display: block;
    padding-left: 12px;
    padding-right: 12px;
    position: relative;
  }
  /* 端まで伸ばすのは .article-entry の直下にある note だけ (#2568)。

     calc(50% - 50vw) の 50% は「その note を包む箱」の幅を指すので、
     入れ子になると包む箱のぶんだけ余分に外へ出る。折りたたみの中では
     details::details-content の overflow: hidden（開閉のアニメーション #2522）が
     はみ出しを切り落とし、絵柄と文字が欠けていた。
     幅375pxでは note が左右に27pxずつ出て、絵柄（左から12px）は
     切り取られる側に落ちる。

     入れ子の中では帯を伸ばさず、囲みのままにする。構えと絵柄の位置は
     上の共通指定が持つので、入れ子でも見え方は揃う */
  .article-entry > .note-container {
    margin-inline: calc(50% - 50vw);
    /* 画面端まで伸びた帯に角丸は掛からない */
    border-radius: 0;
  }
  /* 絵柄のぶんの空きは、絵柄を単独で持つタイトル無しの note だけに掛ける。
     タイトル付き（24件）は絵柄がタイトル行の中に収まっていて上に帯が要らない。
     全体に掛けるとタイトルの上に何も無い空きが42px空く */
  .article-entry .note-container:not(.note-has-title) {
    padding-top: 42px;
    /* 上が絵柄のぶん厚くなるので、下も広げて釣り合わせる。
       16px のままだと本文の最終行が枠の下辺に近づいて詰まって見える */
    padding-bottom: 24px;
  }
  .article-entry .note-container > .note-icon {
    position: absolute;
    top: 14px;
    left: 12px;
    height: 18px;
    margin-right: 0;
  }
}

/* タイトル付きの note (#2490)。タイトルがアイコンを引き受けるので2列をやめ、
   本文は枠いっぱいを使う。タイトル無しの note は従来の2列のままなので、
   既存の225件の見た目は動かない */
.note-container.note-has-title {
  display: block;
}
/* flex にしない (#2600)。フレックスコンテナ直下ではテキストが匿名アイテムに割れ、
   タイトル内のインラインコードが独立のアイテムになる。幅が足りないと各テキストが
   自分の狭い幅の中で個別に折り返し、コードの前後で改行された縦割りの表示になる。
   アイコンを絶対配置にしてテキストを1つのインライン整形文脈に保つ。
   padding-left はアイコンの幅 18px + 従来の margin-right 0.8em で、
   折り返した行がアイコンの右端に揃う位置（flex のときと同じ）*/
.note-title {
  position: relative;
  padding-left: calc(18px + 0.8em);
  /* 本文（.article-entry p の 1.2em）と同じ大きさ。太字だけで見出しと分かるので、
     サイズは上げない。上げると note が節の見出しのように強く見える */
  font-size: text-body;
  font-weight: bold;
  line-height: leading-body;
  color: var(--ink-strong);
  margin-bottom: 6px;
}
/* 共通指定の 2.1em は「.note-container の 13px × 本文1行分」で決めた値。
   タイトル行は font-size が 1.2em なので、同じ 2.1em だと枠が行より高くなる。
   タイトルの行ボックスに合わせ直す。top: 0 で1行目に付くので、
   タイトルが複数行でも絵柄は1行目の中央に乗る（flex の align-items: center は
   ブロック全体に対して中央で、2行のタイトルでは行間に浮いていた） */
.note-title .note-icon {
  position: absolute;
  top: 0;
  left: 0;
  height: unit(leading-body, 'em');
}
.note-body > :last-child {
  margin-bottom: 0;
}

/* note の中のインラインコードは、その note 自身の色を一段濃くしたものにする。
   #eee のままだと色の付いた地に無彩色の灰色が乗って異物になる。

   黒の半透明で一律に暗くする手もあるが、それだと色が濁って「地の色の濃い版」
   ではなく「汚れた地」に見える。joshwcomeau.com が枠の地に --color-*-100、
   その中のインラインコードに --color-*-200 と、同じ色相の1段深い色を当てて
   いるのと同じ考え方を採る。

   値は各 note の地を HSL で 明度 ×0.94 / 彩度 ×0.94 したもの。彩度も少し
   下げるのは、明度を下げると同じ彩度でも色が強く出るため（参考サイトの
   100→200 も S を 0.90〜0.94 倍している）。 */
/* tip の地だけ透過色（rgba(142,150,170,0.141)）なので、白地に載せた
   実効値 #eff0f3 から導く */
.article-entry .note-container.note-tip :not(pre) > code {
  background: code-bg(note-tip-bg);
}
.article-entry .note-container.note-info :not(pre) > code {
  background: code-bg(note-info-bg);
}
.article-entry .note-container.note-warn :not(pre) > code {
  background: code-bg(note-warn-bg);
}
.article-entry .note-container.note-alert :not(pre) > code {
  background: code-bg(note-alert-bg);
}

/* note の中のテーブル (#2520)。table は全体で background-color: white を
   持つため、色の付いた地の上では白い矩形が載り、note の一部ではなく
   貼り付けた別物に見えていた。中では地を継承させる。

   ヘッダは同じ note のインラインコードと同じ規則（code-bg）で導く。
   「note の中の一段濃い面」が1つの規則で説明でき、値を個別に決めずに済む。
   地との差は 1.07〜1.22 で、白地の表（ヘッダの surface-tint と白で 1.09）と同程度。

   罫線 #ccc は共通のまま変えない。線が示すのは表の構造で、地の色に
   染めると表ごとに濃さが変わり構造の読み取りが不安定になる。
   各 note の地とのコントラストは 1.25〜1.52 で、白地の 1.61 と大きく違わない。

   コードブロックは figure.highlight > table という構造なので、素の table を
   指すとこちらにも当たる。同じ詳細度で後から書いた分だけ勝ってしまい、
   note の中のコードブロックから地（#2b2b2b）が消えていた。
   親が .highlight でないものだけに絞る（#2546） */
.article-entry .note-container :not(.highlight) > table {
  background-color: transparent;
}
.article-entry .note-container.note-tip th {
  background-color: code-bg(note-tip-bg);
}
.article-entry .note-container.note-info th {
  background-color: code-bg(note-info-bg);
}
.article-entry .note-container.note-warn th {
  background-color: code-bg(note-warn-bg);
}
.article-entry .note-container.note-alert th {
  background-color: code-bg(note-alert-bg);
}

/* note の中のリンクは一段暗い青にする。地を濃くした分、本文色（ink-strong）は
   4色すべてで余裕があるが、link-blue は alert の上で AA を割る。
   参考サイトも枠の中のリンク色を枠ごとに変えている。
   比はスタイルガイド（/specials/styleguide/）が note の4色すべてに対して
   計算で出すので、ここには書かない */
.article-entry .note-container a,
.article-entry .note-container a code {
  color: var(--link-on-note);
}
.article-entry .note-container a:visited,
.article-entry .note-container a:visited code {
  color: var(--link-on-note-visited);
}

/* :not(pre) > code でインラインコードだけに効かせる。付けないと
   コードブロック内の code にも背景が乗る（.article-entry pre code の
   background: none より詳細度が高い） */

/* 本文側のフレックスアイテム。
   min-width の初期値 auto のままだと、内部のコードブロックの最小内容幅より狭くなれず、
   狭い画面でコンテナごと画面外にはみ出してしまう。
   0 を明示すると幅を画面に合わせられ、コードブロックは .highlight の
   overflow: auto でコンテナ内を横スクロールする */
.note-container > div {
  flex: 1;
  min-width: 0;
}

/* アイコンは種別ごとに絵柄だけが違う。大きさ・位置・繰り返しの指定は共通なので
   ここで1度だけ書き、種別側は background-image だけを持つ。
   以前は3種それぞれが同じ7行を丸ごと繰り返しており、tip を足し忘れても
   気づけなかった（tip だけアイコンが出ていなかった #2485） */
.note-container .note-icon {
  display: inline-block;
  width: 18px;
  /* 枠は1行目の行ボックスと同じ高さにして、その中央に絵柄を置く。
     本文は font-size 1.2em・line-height 1.75em なので行ボックスは 2.1em。
     以前は 18px の枠を transform: translateY(4px) で下げていたが、
     中央に来る値は (27.3 - 18) / 2 = 4.65px で 0.65px 上にずれていた。
     この書き方なら本文のサイズを変えても中央が保たれる (#2485) */
  height: 2.1em;
  margin-right: 0.8em;
  flex-shrink: 0;
  background-size: 18px 18px;
  background-repeat: no-repeat;
  background-position: center;
}

/* tip は電球。他の3種と同じく「塗りの丸に白い記号」の作りに揃える。
   丸の色 #5f6b85 は地（#eff0f3）に対して 4.74 で、図形の基準（3.0）を満たす。
   18px で潰れないよう、電球のガラスと口金は太い塊だけで描いている */
.note-container.note-tip .note-icon {
  background-image: url("data:image/svg+xml;base64,");
}
.note-container.note-info .note-icon {
  background-image: url("data:image/svg+xml;base64,");
}
.note-container.note-warn .note-icon {
  background-image: url("data:image/svg+xml;base64,");
}
.note-container.note-alert .note-icon {
  background-image: url("data:image/svg+xml;base64,");
}

/* リンクプレビューカードのスタイル */
.link-preview-card {
  max-width: 500px;
  margin: 1.5em 0;
  border: 1px solid var(--rule-base);
  border-radius: card-radius;
  overflow: hidden;
  background-color: var(--surface-base);
}
.link-preview-card-title,
.link-preview-card-image {
  transition: color hover-speed ease, opacity hover-speed ease;
}
/* 反応は他のカードと同じ「中身が一段引く」 (#2747)。以前は影に上がって
   いたが、影を1段だけ残すとサイト全体から影を落としきれない。
   画像は background-image なので、img ではなく要素の透明度を落とす */
.link-preview-card:hover .link-preview-card-title {
  color: var(--ink-mute);
}
.link-preview-card:hover .link-preview-card-image {
  opacity: 0.7;
}

.link-preview-card-anchor {
  display: flex;
  text-decoration: none;
  color: inherit;
  min-height: 110px;
}
/* 反応はカードの持ち上がりだけにする (#2699)。color: inherit は静止状態にしか
   効かず、打ち消しが無いと hover で文字が青くなって下線も出る。
   .article-entry を付けるのは、本文の a:hover（0,2,1）に勝たせるため */
.article-entry .link-preview-card-anchor:hover,
.article-entry .link-preview-card-anchor:focus {
  color: inherit;
  text-decoration: none;
}

.link-preview-card-main {
  padding: 12px 16px;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.link-preview-card-title {
  font-size: 1em;
  font-weight: bold;
  margin-bottom: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.link-preview-card-description {
  font-size: text-meta;
  color: var(--ink-mute);
  line-height: leading-row;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2; /* 表示する行数を2行に制限 */
  overflow: hidden;
  flex-grow: 1;
}

.link-preview-card-meta {
  display: flex;
  align-items: center;
  font-size: text-meta;
  color: var(--ink-faint);
  margin-top: 8px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.link-preview-card-favicon {
  width: 16px;
  height: 16px;
  margin-right: 6px;
  border-radius: radius-small;
}

.link-preview-card-image {
  flex-shrink: 0;
  width: 110px;
  background-size: cover;
  background-position: center;
  border-left: 1px solid var(--rule-base);
}

/* 画像がない場合のスタイル調整 */
.link-preview-card-anchor:not(:has(.link-preview-card-image)) .link-preview-card-main {
  width: 100%;
}

/* スライド・動画の埋め込み (#2454)。記事側は width / height を固定値で
   書いているため、狭い画面では幅だけ縮んで高さが残り縦に空くか、
   幅が画面を超えてはみ出す。幅を親に合わせ、高さは縦横比で決める。

   Speakerdeck は埋め込みコードが自前で
   `width:100%; height:auto; aspect-ratio:560/315` を持っているので触らない。

   比率は提供元ごとの決め打ち。デッキの縦横比が枠と違っても、提供元の
   プレイヤーが枠の中で余白を作るだけで中身は切れない。
   迷う場合は縦長（値の小さい方）を採り、確実に収まる側へ倒している */
.article-entry iframe[src*='docs.google.com'],
.article-entry iframe[src*='slideshare.net'],
.article-entry iframe[src*='youtube.com'] {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto;
}
/* 960x569。記事で幅も高さも指定しているものが揃ってこの比率 */
.article-entry iframe[src*='docs.google.com'] {
  aspect-ratio: 960 / 569;
}
/* 476x400。プレイヤーの操作バーを含む比率で、記事の実測は 1.19〜1.21 に
   収まる。最も縦長の 1.19 を採る */
.article-entry iframe[src*='slideshare.net'] {
  aspect-ratio: 476 / 400;
}
.article-entry iframe[src*='youtube.com'] {
  aspect-ratio: 560 / 315;
}

/* スタイルガイド（/specials/styleguide/）の見本 (#2856)。

   このページに値を手で書かない。色見本の地・16進数・コントラスト比のどれも
   _variables.styl の変数から出すので、変数を変えれば表示もそのまま変わる。
   手で書き写すと「一致していることを主張する」形になり、片方だけ直したときに
   ページが嘘をつく（コメントの禁じ手と同じ #2768）。

   文字の見本はコア側のセレクタに .sg-* を足して実物の値を借りる。
   ここで font-size を書き写すと、サイズを決める場所が2つになる（#1927 / #1928）*/

// WCAG のコントラスト比。Stylus の contrast() は整数に丸めるので明度から出す
sg-contrast(fg, bg)
  lum-fg = luminosity(fg) + 0.05
  lum-bg = luminosity(bg) + 0.05
  hi = lum-fg > lum-bg ? lum-fg : lum-bg
  lo = lum-fg > lum-bg ? lum-bg : lum-fg
  round((hi / lo) * 100) / 100

// 1トークンにつき「地」と「16進数の文字」を出す。クラスは要素に直接付ける
// （.sg-chip.sg-ink-strong）。行を囲む要素に付ける形だと表のセルに書けない
sg-swatches(map)
  for name, value in map
    .sg-chip.sg-{name} {
      background: value
    }
    .sg-hex.sg-{name}::after {
      content: unquote('"' + value + '"')
    }

// 地に対する比。半透明の rule-on-dark は明度が出せないので渡さない
sg-ratios(map, ground)
  for name, value in map
    .sg-ratio.sg-{name}::after {
      content: unquote('"' + sg-contrast(value, ground) + '"')
    }

// 地が複数ある色（note の4色の上のリンク）は最小の比を出す。AA を満たすかは
// いちばん厳しい地で決まるので、範囲ではなくその1つを載せる
sg-contrast-min(fg, grounds)
  lowest = 21
  for ground in grounds
    ratio = sg-contrast(fg, ground)
    if ratio < lowest
      lowest = ratio
  lowest

sg-ratios-min(map, grounds)
  for name, value in map
    .sg-ratio.sg-{name}::after {
      content: unquote('"' + sg-contrast-min(value, grounds) + '"')
    }

sg-on-white = {
  'ink-strong': ink-strong,
  'ink-mute': ink-mute,
  'ink-faint': ink-faint,
  'rule-base': rule-base,
  'rule-weak': rule-weak,
  'rule-strong': rule-strong,
  'surface-tint': surface-tint,
  'surface-mute': surface-mute,
  'brand-navy': brand-navy,
  'brand-gray': brand-gray,
  'brand-crimson': brand-crimson,
}
sg-on-navy = {
  'on-dark-strong': on-dark-strong,
  'on-dark': on-dark,
  'on-dark-mute': on-dark-mute,
  'navy-raised': navy-raised,
  'crimson-on-dark': crimson-on-dark,
}
sg-no-ratio = {
  'rule-on-dark': rule-on-dark,
}
// リンクの段。地が3種類あるので比の出し方も3つに分ける (#2860)
sg-link-on-white = {
  'link-blue': link-blue,
  'link-visited': link-visited,
}
sg-link-on-tint = {
  'link-on-tint': link-on-tint,
}
sg-link-on-note = {
  'link-on-note': link-on-note,
  'link-on-note-visited': link-on-note-visited,
}
sg-note-grounds = note-tip-bg note-info-bg note-warn-bg note-alert-bg

sg-swatches(sg-on-white)
sg-swatches(sg-on-navy)
sg-swatches(sg-no-ratio)
sg-swatches(sg-link-on-white)
sg-swatches(sg-link-on-tint)
sg-swatches(sg-link-on-note)
sg-ratios(sg-on-white, #fff)
sg-ratios(sg-on-navy, brand-navy)
sg-ratios(sg-link-on-white, #fff)
sg-ratios(sg-link-on-tint, surface-mute)
sg-ratios-min(sg-link-on-note, sg-note-grounds)

/* トークンの一覧は素の表で組む。見本・16進数・比だけがこの3つのクラスで、
   変数名と用途は文章なので Markdown 側が持つ */
.sg-chip {
  border: solid 1px var(--rule-base);
  border-radius: radius-small;
  display: block;
  height: 24px;
  width: 24px;
}
.sg-hex,
.sg-ratio {
  font-family: font-mono;
  white-space: nowrap;
}
/* 暗地の段はネイビーの上に置く。白や薄いグレーは白地の上では見えない (#2839) */
.sg-chip-ground {
  background: brand-navy;
  border-radius: radius-small;
  display: block;
  padding: 4px;
  width: 32px;
}
.sg-chip-ground .sg-chip {
  border-color: var(--rule-on-dark);
}
/* リンクの段は地の上に置く。白地の見本と並べたときに「どの地での色か」が
   見本そのもので分かる (#2860)。alert を使うのは note の4色でいちばん厳しい地 */
.sg-chip-tint {
  background: var(--surface-mute);
}
.sg-chip-note {
  background: note-alert-bg;
}
/* 明るい地の上では枠を戻す。上の rule-on-dark は白の半透明なので見えない */
.sg-chip-tint .sg-chip,
.sg-chip-note .sg-chip {
  border-color: var(--rule-base);
}

/* 文字の見本。大きさと太さはコア側のルールから借りる */
.sg-type-label {
  color: var(--ink-mute);
  font-size: text-meta;
  margin: 24px 0 0;
}
/* 見本の中の見出しは「そこに節が始まった」わけではないので、
   実物のルールが持つ上の空きだけ打ち消す */
.sg-type .sg-title,
.sg-type .sg-h2,
.sg-type .sg-h3,
.sg-type .sg-h4,
.sg-type .sg-h5,
.sg-type .sg-h6 {
  margin-top: 0;
}

/* 出版・寄稿の一覧 (#2912)。表紙は並べない。買い物ページではなく
   「誰が何を書いたか」の記録なので、書名と執筆者が読めることを優先する。
   1件は「書名」＋「寄稿タイトル ／ 執筆者 ／ 記事」の2行 */
.publication-list {
  margin-bottom: (space-step * 6);
}
.publication-item {
  border-top: 1px solid var(--rule-weak);
  padding: (space-step * 3) 0;
}
.publication-name {
  margin: 0;
  font-size: text-body;
}
.publication-meta {
  margin: (space-step) 0 0;
  color: var(--ink-mute);
  font-size: text-meta;
}

/* 文字サイズの7段。行間・間隔と同じく、値は _variables.styl のトークンから出す。
   ここにも px を書かない */
sg-sizes = {
  'meta': text-meta,
  'base': text-base,
  'row': text-row,
  'body': text-body,
  'lead': text-lead,
  'title': text-title,
  'display': text-display,
}
for name, value in sg-sizes
  .sg-size-{name} .sg-size-sample {
    font-size: value
  }
  .sg-size-{name} .sg-size-value::after {
    content: unquote('"' + value + '"')
  }

.sg-size {
  border-top: solid 1px var(--rule-weak);
  padding: 12px 0;
}
.sg-size-label {
  color: var(--ink-mute);
  font-size: text-meta;
}
.sg-size-value {
  font-family: font-mono;
  margin-left: 8px;
}
.sg-size-sample {
  margin: 4px 0 0;
}

/* 行間の3段。同じ大きさの文字を3つの段で組んで、差が行送りだけになるようにする。
   値は _variables.styl のトークンを文字にして出す */
sg-leadings = {
  'heading': leading-heading,
  'body': leading-body,
  'row': leading-row,
}
for name, value in sg-leadings
  .sg-leading-{name} .sg-leading-lines {
    line-height: value
  }
  .sg-leading-{name} .sg-leading-value::after {
    content: unquote('"' + value + '"')
  }

.sg-leading {
  border-top: solid 1px var(--rule-weak);
  padding: 12px 0;
}
.sg-leading-label {
  color: var(--ink-mute);
  font-size: text-meta;
}
.sg-leading-value {
  font-family: font-mono;
  margin-left: 8px;
}
.sg-leading-lines {
  margin: 4px 0 0;
}

/* 間隔の段。刻み（space-step）に倍数を掛けて出すので、ここにも px を書かない */
sg-space-steps = 1 2 3 4 5 6 7 8 10 12
for n in sg-space-steps
  .sg-space-{n} .sg-space-bar {
    width: space-step * n
  }
  .sg-space-{n} .sg-space-value::after {
    content: unquote('"' + (space-step * n) + '"')
  }

.sg-spaces {
  margin: 0 0 24px;
}
.sg-space-item {
  align-items: center;
  display: flex;
  gap: 8px;
  padding: 2px 0;
}
.sg-space-bar {
  background: var(--brand-navy);
  border-radius: radius-small;
  flex: none;
  height: 16px;
}
.sg-space-value {
  color: var(--ink-mute);
  font-family: font-mono;
  font-size: text-meta;
}

/* 状態の見本。色と太さはパンくずの実物のルールから借りる（上の .sg-crumb*）*/
.sg-state {
  border: solid 1px var(--rule-base);
  border-radius: card-radius;
  margin: 0 0 24px;
  padding: 12px 16px;
}
.sg-state-row {
  align-items: baseline;
  display: flex;
  flex-wrap: wrap;
  gap: 8px 16px;
  margin: 0;
}
.sg-state-item {
  align-items: baseline;
  display: flex;
  gap: 8px;
}
.sg-state-label {
  color: var(--ink-faint);
  font-size: text-meta;
}

/* 角丸の3段。値は変数から出す */
.sg-shapes {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin: 0 0 24px;
}
.sg-shape {
  align-items: center;
  background: var(--surface-tint);
  border: solid 1px var(--rule-base);
  color: var(--ink-mute);
  display: flex;
  font-size: text-meta;
  height: 72px;
  justify-content: center;
  width: 120px;
}
.sg-shape-small {
  border-radius: radius-small;
}
.sg-shape-card {
  border-radius: card-radius;
}
.sg-shape-pill {
  border-radius: 999px;
}
