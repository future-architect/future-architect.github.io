/* サイトの土台。body / 見出し / リンク / ヘッダー / パンくず / ページャー /
   フッター / details / .blog-info / 404 と、ブランド色の :root 宣言。

   もとは metronic というテンプレート由来だったが、実体はこのプロジェクトが
   書いたもの（#2759）。残っていた元テンプレートの死んだルールは削除済み。
   下の theme-styles とはファイル内の順序でカスケードが決まるので、
   この塊は必ず先頭に置く（後勝ちで theme-styles が上書きする前提）*/

/* 変数はここで読み込む。CSS を1行も出さないのでカスケードには影響せず、
   ファイルの先頭から変数が使える。以前は下の「General Overrides」の位置に
   あり、それより前で変数を書くと解決されずに文字列がそのまま出ていた (#2753) */
@import "_variables"

/* CSS からブランド色を引くための配り口。値と役の説明は _variables.styl が
   1箇所で持ち、ここはそれを CSS に渡すだけ。Stylus 側に値を置くのは、
   スタイルガイド（/specials/styleguide/）が見本の地・16進数・コントラスト比を
   同じ1つの値から出せるようにするため。CSS 変数だけだと計算に使えない */
:root {
  --a-color: var(--link-blue);
  --brand-navy: brand-navy;
  --brand-gray: brand-gray;
  --brand-crimson: brand-crimson;

  --on-dark-strong: on-dark-strong;
  --on-dark: on-dark;
  --on-dark-mute: on-dark-mute;
  --navy-raised: navy-raised;
  --rule-on-dark: rule-on-dark;
  --crimson-on-dark: crimson-on-dark;

  // 表彰の淡金 (#2742)。ブランド色は表彰に広げないので、この系統だけが持つ色
  --award-gold: award-gold;
  --award-gold-on-tint: award-gold-on-tint;
  --award-bronze: award-bronze;
  --award-card-from: award-card-from;
  --award-card-to: award-card-to;
  --award-card-rule: award-card-rule;

    // 文字・罫線・面の段と、リンクの4値 (#2746)。ダークモードで実行時に差し替えるため、
  // 使う側は var() で引く。値と役の説明は _variables.styl が持ったままにする
  // （CSS 変数は計算に使えず、スタイルガイドが luminosity() から比を出せなくなる #2858）
  --ink-strong: ink-strong;
  --ink-mute: ink-mute;
  --ink-faint: ink-faint;

  --rule-base: rule-base;
  --rule-weak: rule-weak;
  --rule-strong: rule-strong;

  --surface-base: surface-base;
  --surface-tint: surface-tint;
  --surface-mute: surface-mute;

  --link-blue: link-blue;
  --link-visited: link-visited;
  --link-on-tint: link-on-tint;
  --link-on-note: link-on-note;
  --link-on-note-visited: link-on-note-visited;
}

/* General body settings */
body {
	color: var(--ink-strong);
	direction: ltr;
	font: 400 13px 'Open Sans', Arial, sans-serif;
	/* font の一括指定は line-height を normal に戻すので、段を明示して
	   フォント依存をなくす。指定を持たない要素はここを継ぐ */
	line-height: leading-row;
	background: var(--surface-base);
}

/***
General typography
***/
/* 行間は見出しの段で1つに固定する。ここに `font: 300 'Open Sans', sans-serif`
   と書かれていたが、font の一括指定は font-size を省くと宣言ごと捨てられるため
   何も効いていなかった（見出しは bootstrap-subset の 1.2 で描かれていた）*/
h1, h2, h3, h4, h5, h6 {
	line-height: leading-heading;
	margin: 0 0 10px;
}

/* ホバーで現れる見出しアンカーの目印は theme-styles.styl が持つ (#2736)。
   ここにあった `h2:hover ::before { content:'#' }` は、見出しの子孫の全要素を
   対象にしていて <a> や <strong> を含む見出しで # が複数出るうえ、
   絶対配置で見出しの箱の外に浮いていて押せなかった */
h1 {
	margin-bottom: 15px;
}

/***
Fix link outlines after click
***/
a {
  color: var(--a-color);
}
a, a:focus, a:hover, a:active {
	outline: 0;
 	text-decoration: none;
}
a:hover, a:focus {
	color: var(--a-color);
	text-decoration: underline;
}
.article-entry a {
	text-decoration: none;
}
/* hover で変わるのは text-decoration-line だけで、この属性はアニメーション
   できない（色は a:hover と同値のまま）。効いていない transition-duration が
   残っていると hover の速さの定義が2箇所あるように見えるので消した。
   速さは _variables.styl の hover-speed が1箇所で持つ (#2693) */
.article-entry a:hover,
.article-entry a:focus {
	text-decoration: underline;
}
.article-entry a:visited {
	color: var(--link-visited);
}

/* 地の文のリンクは色だけで区別しない (#2926)。link-blue と地の文 (ink-strong) の
   比は 2.17 で、色が見えない読者には隣の文字と見分けが付かない。白地の AA (4.5) を
   保つ輝度と、地の文と 3:1 を作る輝度は重ならないので、色を替えても解決しない。
   .article-entry a でまとめて当てると見出しのアンカーと We're hiring のカードまで
   拾うため、地の文の器で取る。下線は currentColor なので訪問済みは紫の線になる */
.article-entry p a,
.article-entry li a,
.article-entry td a,
p.specials-text a {
	text-decoration: underline;
	text-underline-offset: 3px;
	text-decoration-thickness: 1px;
}
/* 静止で下線を持つので、反応は線の太さで返す */
.article-entry p a:hover,
.article-entry p a:focus,
.article-entry li a:hover,
.article-entry li a:focus,
.article-entry td a:hover,
.article-entry td a:focus,
p.specials-text a:hover,
p.specials-text a:focus {
	text-decoration-thickness: 2px;
}
/* 脚注の番号は上付きの数字で、地の文に紛れる形ではない（axe も拾わない）。
   脚注リストの戻り矢印のほうは本文の直後に続くので下線を持つ */
.article-entry sup a {
	text-decoration: none;
}

/***
Misc tools
***/
.margin-bottom-20 {
	margin-bottom: 20px !important;
}
.margin-bottom-40 {
	margin-bottom: 40px !important;
}
.margin-top-30 {
  margin-top: 30px !important;
}

/* overides metro scrolbars in IE10 and makes them look like a default scrollbar */
@-ms-viewport{
	width: auto !important;
}

::-moz-selection {
  color: var(--on-dark-strong);
  background: var(--brand-navy);
}
::selection {
  color: var(--on-dark-strong);
  background: var(--brand-navy);
}
/* 本文のリンクは下線が hover 時にしか無く、選択の白文字では本文と
   区別が付かなくなる。文字色は既定（白）のまま、下線で区別する。
   対象は本文（.article-entry）だけに絞る。素の a まで広げると、
   青いリンクの見た目をしていないもの（タグチップ・著者名などの
   グレーのメタリンク）まで選択で下線が付いてしまう */
.article-entry a::-moz-selection {
  text-decoration: underline;
}
.article-entry a::selection {
  text-decoration: underline;
}
/* フッターはネイビー地なので、ネイビーの選択色では選択が見えない。
   塗りと文字を反転させる（ネイビー文字とグレー地で 12.72）。
   footer 要素で絞ると記事内の <footer>（関連記事など、白地）にも
   誤爆するため、ネイビーの面を持つクラスで絞る */
.site-footer ::-moz-selection {
  color: var(--brand-navy);
  background: var(--brand-gray);
}
.site-footer ::selection {
  color: var(--brand-navy);
  background: var(--brand-gray);
}

/***
Header and header elements
***/
/* ヘッダーは1段・64px の帯 (#2877)。以前は 1500×360 の写真バナーの上に 80px の
   中央タイトルを載せた 151px の塊で、全ページの先頭でそれだけ縦を使っていた。
   縦に返した約90px のぶん、空いた横にサイト名・ナビ・検索を1行で並べる。
   **追従（sticky）はしない。** 64px の帯が全ページで本文の上に常に乗ることになり、
   読んでいる面が狭くなる。サイドバーの目次は追従する (#2909)。
   影は持たない (#2747)。下辺の 1px の罫線が本文との境目を作る */
.site-header {
  position: relative;
  background: var(--surface-base);
  border-bottom: 1px solid var(--rule-weak);
  margin-bottom: 23px;
  /* 下に開くドロップダウンと検索のヒントパネルが本文の上に出る */
  z-index: 999;
}
/* 帯の中身。左端はページ本文と同じ .container の内側に揃える。
   下に開くパネルの位置の基準もここが持つ（top: 100% が帯の下辺になる） */
.header-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: (space-step * 4);
  height: header-height;
}
/* 帯の中のリンクは下線で反応しない。土台の `a:hover, a:focus` が青（--a-color）と
   下線を当ててくるので、当たる箇所で明示して外す。`:hover` だけ書くと
   **Tab で来たときに土台が勝って青くなる**（詳細度は 0,1,1 対 0,1,0）。
   所在は輪郭（focus-visible）だけで示し、hover は色か面のどちらか一方で受ける。
   64px の帯の中で下線を重ねると合図が2つになる */
.header-brand-link:hover,
.header-brand-link:focus,
.header-nav-link:hover,
.header-nav-link:focus,
.header-dropdown-item:hover,
.header-dropdown-item:focus,
.header-dropdown-more:hover,
.header-dropdown-more:focus {
  text-decoration: none;
}
/* 全件への導線は面を一段変えて反応するので、文字色は動かさない (#2859)。
   土台の青は下線と同じく当たる箇所で外す。中に span を持つ他の行は
   span 側が色を決めているため、青が見えるのはここだけ (#2887) */
.header-dropdown-more:hover,
.header-dropdown-more:focus {
  color: var(--ink-mute);
}
/* サイト名。ホームでは h1、それ以外のページでは div で出している。見た目は同じ */
/* 帯が詰まったときに縮むのは検索欄だけ。サイト名とナビは縮めない
   （サイト名が折り返すと帯の高さが動き、ナビは white-space: nowrap で縮めない）。
   ナビ4つが並ぶ 992〜1199px では余りが 14px しか無いので、フォントの実寸が
   違う環境でも崩れないように、逃げ場を検索欄の側に作っておく */
.header-brand {
  margin: 0;
  flex-shrink: 0;
}
.header-brand-link {
  display: flex;
  align-items: center;
  gap: (space-step * 3);
  text-decoration: none;
}
/* コーポレートのロゴ。実寸 257.99×81.92 のうち FUTURE の文字は下の31%で、
   上はクリムゾンの2本の線。だからブログ名より小さく見えるのが正しい */
.header-logo {
  display: block;
  flex-shrink: 0;
  width: 88px;
  height: 28px;
}
.header-brand-text {
  display: flex;
  flex-direction: column;
}
/* 英字の見た目は Web フォント無しの範囲で作る (#2131)。Avenir Next（macOS/iOS の
   幾何学グロテスク）と Segoe UI Variable Display（Win11 の見出し用）を優先し、
   無い環境は従来のシステムスタックに落ちる。固定の英字なので絵文字フォントは要らない */
.header-title {
  font-size: text-lead;
  line-height: leading-heading;
  font-family: "Avenir Next", "Segoe UI Variable Display", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
  font-weight: 700;
  /* 英字の見出しは字間を詰めると締まる */
  letter-spacing: -0.01em;
  color: var(--ink-strong);
}
/* 和文は英字に添える名前なので一段落とす。写真の上に置いていた頃の
   字間 0.35em と影は、白地では役が無い。
   太さを書かないとホームだけ 500 になる。囲みがホームは h1・他ページは div で、
   bootstrap の h1〜h6（font-weight: 500）を継ぐため。#2585 で line-height が
   同じ形の差を生んだのと同じ罠で、500 は太さの段（400 / 700 / 800）にも無い */
.header-title-sub {
  font-size: text-meta;
  line-height: leading-heading;
  font-weight: 400;
  color: var(--ink-mute);
}
/* サイト名は hover に応えない。フッターの .footer-logo も同じで、あちらは
   周りのリンクの下線が伸びる反応から外すために text-decoration: none を
   固定している。ロゴは行き先を示す部品ではなくサイトの名前で、絵柄には
   下線を引く相手も無い。所在はリンク全体に出る focus の輪郭が示す */

/* 行き先の帯。畳んだ中身は :hover と :focus-within で開く。JS は使わない
   ——検索窓のヒントパネル (#2791) と同じ形 */
.header-nav {
  flex-shrink: 0;
}
.header-nav-list {
  display: flex;
  align-items: center;
  gap: (space-step * 7);
  margin: 0;
  padding: 0;
  list-style: none;
}
.header-nav-item {
  /* ドロップダウンの位置の基準。帯と同じ高さを持たせて、引き金とパネルの間に
     隙間を作らない。1px でも空くとそこでカーソルが外れてパネルが閉じる */
  position: relative;
  display: flex;
  align-items: center;
  height: header-height;
}
/* details は帯の中では箱としてだけ働く。高さを引き継がないと引き金が上に寄る。
   padding を戻すのは、本文の折りたたみ用に素の details が padding-bottom: 24px を
   持っているため。そのぶん中身の箱が縮んで、引き金が 12px 上にずれる */
.header-nav-disclosure {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 0;
}
/* 引き出し用の組ラベル。帯では summary が引き金を兼ねるので出さない */
.header-nav-label {
  display: none;
  margin: 0;
}
/* summary の既定の三角は消す。開閉の向きは .header-nav-caret が示す */
.header-nav-trigger {
  list-style: none;
  cursor: pointer;
}
.header-nav-trigger::-webkit-details-marker {
  display: none;
}
.header-nav-link,
.header-nav-trigger {
  display: flex;
  align-items: center;
  padding: 0;
  border: 0;
  background: none;
  font-family: inherit;
  font-size: text-row;
  line-height: leading-row;
  color: var(--ink-mute);
  text-decoration: none;
  white-space: nowrap;
  transition: color hover-speed ease;
}
/* 反応は色を一段濃くするだけ。`:focus` も書くのは、書かないと土台の
   `a:focus` の青が勝つため（上の下線の話と同じ詳細度） */
.header-nav-link:hover,
.header-nav-link:focus,
.header-nav-trigger:hover,
.header-nav-item:focus-within .header-nav-trigger {
  color: var(--ink-strong);
}
.header-nav-caret {
  color: var(--ink-faint);
  transition: transform hover-speed ease;
}
.header-nav-item:hover .header-nav-caret,
.header-nav-disclosure[open] .header-nav-caret {
  transform: rotate(180deg);
}
/* 畳んだ行き先。影は持たない (#2747) ので、白い面と枠で本文から浮かせる。
   閉じるときだけ visibility を遅らせるのはヒントパネルと同じ理由で、
   Safari が消える前にタップを着地させるため */
.header-dropdown {
  position: absolute;
  top: 100%;
  right: 0;
  width: 288px;
  padding: (space-step * 2);
  background: var(--surface-base);
  border: 1px solid var(--rule-base);
  border-radius: card-radius;
  visibility: hidden;
  opacity: 0;
  transition: opacity 0.12s ease, visibility 0s 0.3s;
}
/* カテゴリは18件あるので2列にする。列数は数えず**列幅の下限**で決める。
   最長の行は DataEngineering の101px（13px・Noto Sans CJK の実測）＋
   アイコン 16.9px ＋3桁の件数 33.7px = 151px で、行の左右の余白 24px を足すと
   175px。下限を 190px に置くと 420px のパネルで必ず2列になり（190×2+8 ≤ 404）、
   引き出しに入る狭い幅では自動で1列に落ちる（幅375pxの端末が境目）。
   行は折り返さない指定なので、列が細るより列数が減る方が正しい。
   グリッドではなく多段組にするのは、群 (#2908) を列の途中で割らないため。
   グリッドだと行の高さが左右で揃い、件数の少ない群の下に空きが出る */
.header-dropdown-grid {
  width: 420px;
  columns: 190px;
  column-gap: (space-step * 2);
}
/* 群は列をまたいで割らない。空きは列の下端に寄せる */
.header-dropdown-group {
  break-inside: avoid;
  margin-bottom: (space-step * 4);
}
.header-dropdown-group:last-child {
  margin-bottom: 0;
}
.header-nav-item:hover .header-dropdown,
.header-nav-disclosure[open] ~ .header-dropdown {
  visibility: visible;
  opacity: 1;
  transition: opacity 0.12s ease;
}
/* 開いたままカーソルもフォーカスも離れたら畳んで見せる（open 属性は残る）。
   これが無いと、別の引き金にカーソルを乗せたときに2枚が同じ位置で重なる。
   引き金へ戻れば また出るので、開いた読者の意図は保たれる。
   **幅で囲むのは、引き出し（1024px 以下）ではパネルを常時開いて並べているため。**
   囲まないとこの規則の詳細度が勝ち、引き出しで引き金を押した瞬間に消える */
@media (min-width: 1025px) {
  .header-nav-item:not(:hover):not(:focus-within) .header-nav-disclosure[open] ~ .header-dropdown {
    visibility: hidden;
    opacity: 0;
  }
}
/* 行として並ぶものなので、反応は面を一段 (#2686) */
.header-dropdown-item {
  display: block;
  padding: (space-step * 2) (space-step * 3);
  border-radius: radius-small;
  text-decoration: none;
  transition: background-color hover-speed ease;
}
.header-dropdown-item:hover,
.header-dropdown-more:hover {
  background: var(--surface-mute);
}
/* パネルの中の仕切り。見出しではなく面の中のラベルなので h2 は使わない
   （検索のヒントパネルと同じ扱い） */
.header-dropdown-label {
  margin: 0 0 (space-step * 2);
  padding: 0 (space-step * 3);
  font-size: text-meta;
  line-height: leading-row;
  font-weight: 700;
  color: var(--ink-mute);
}
/* カテゴリの群の名前 (#2908)。素の12pxでは18行の並びの中に埋もれるので枠で囲む。
   タグのチップ（ピル型・薄い地）と取り違えられないよう、角は radius-small の
   四角のままで地は敷かない。「押せば絞り込める」と読まれる形を避ける (#2892) */
.category-group-label {
  display: inline-block;
  margin: 0 0 space-step;
  padding: 2px (space-step * 2);
  border: 1px solid var(--rule-base);
  border-radius: radius-small;
  font-size: text-meta;
  line-height: leading-row;
  font-weight: 700;
  color: var(--ink-strong);
}
/* 枠の中の文字を、行のアイコンの頭（.header-dropdown-item の左 12px）に揃える。
   枠1px と左パディングのぶんだけ枠を左へ出す */
.header-dropdown-group .category-group-label {
  margin-left: (space-step * 3) - chip-pad-x - 1px;
}
/* 群と群の間だけ空ける。最初の群は枠の見出し（h2「カテゴリー」）の直下に付く */
.widget > .category-group-label {
  margin-top: (space-step * 4);
}
.widget > .category-group-label:first-child {
  margin-top: 0;
}
/* カテゴリ・連載の行。リソース / アクティビティの行と違って説明を持たない。
   名前が主題そのもので、6行並ぶので太字にもしない（検索パネルのカテゴリ行を
   素の太さにしたのと同じ理由）。説明はカテゴリ個別ページが持つ */
.header-dropdown-row {
  display: block;
  font-size: text-base;
  line-height: leading-row;
  color: var(--ink-strong);
  /* 1行1件の並びなので折り返させない。折り返すと行の高さが揃わず、
     2列のときは左右の行がずれる */
  white-space: nowrap;
}
/* 右肩の件数は「総数」の意味 (#2129)。押す対象ではない添えなので薄い段に置く */
.header-dropdown-count {
  margin-left: space-step;
  font-size: text-meta;
  font-weight: normal;
  color: var(--ink-faint);
}
/* 全件への導線。行の並びとは役が違うので、仕切りの線を1本入れて下に置く */
.header-dropdown-more {
  display: block;
  margin-top: space-step;
  padding: (space-step * 2) (space-step * 3);
  border-top: 1px solid var(--rule-weak);
  font-size: text-meta;
  line-height: leading-row;
  color: var(--ink-mute);
}
.header-dropdown-name {
  display: block;
  font-size: text-base;
  line-height: leading-heading;
  font-weight: 700;
  color: var(--ink-strong);
}
.header-dropdown-desc {
  display: block;
  margin-top: space-step;
  font-size: text-meta;
  line-height: leading-row;
  color: var(--ink-mute);
}
.header-utility {
  display: flex;
  align-items: center;
  /* ナビと検索の間。縦棒があった頃はこの gap が棒の左右それぞれに効いて
     24 + 1 + 24 = 49px 空いていたので、棒を外した (#2901) ぶんを足して保つ。
     992px 未満は下のブロックで1段に戻す（引き金と検索が隣り合うため） */
  gap: (space-step * 12);
}
/* 全幅で覆っている間、後ろの本文をぼかす面 (#2888)。Cloudflare と同じ形で、
   開いたパネルと帯だけがはっきり見える。ぼかしの量は向こうの実測値（8px）。
   出るのは**全幅で覆う2つの状態だけ**——モバイルの引き出しと、575px 以下で
   広がった検索。PC の hover のドロップダウンには出さない。カーソルが乗った
   だけで本文全体がぼけるのは意図しない発火になる。
   開いているかは :has() で拾う。引き金（:checked / :focus-within）が帯の中に
   あるので、兄弟結合子では外の面まで届かない。
   **position: fixed にはしない。** ヘッダーは追従しない (#2877) ので、開いたまま
   送られると引き出しは一緒に上へ動くのにぼかしだけ残る。引き出しと同じく
   ヘッダーを基準にした絶対配置で、帯の下から 100vh 分だけ敷く。
   開閉に合わせて出し入れするのは display で、透過は動かさない。
   visibility では隠れている間も 100vh の箱が残り、短いページに縦の
   スクロールが生まれる。引き出し自体も瞬時に開くので合わせている */
.header-backdrop {
  display: none;
  position: absolute;
  top: header-height;
  left: 0;
  right: 0;
  height: 100vh;
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(8px);
}
/* 引き出しの引き金。992px 以上では要らないので display: none で消す
   （タブ順からも外れる）。狭い幅では下のメディアクエリが形を与える */
.header-drawer-input,
.header-drawer-toggle {
  display: none;
}
/* ナビは 992px 未満では帯から降りて引き出しに入る (#2877)。帯に並べると検索と
   重なるが、消してしまうとカテゴリと連載への行き先がモバイルから無くなる
   （フッター4列はリソースとアクティビティしか持たず、サイドバーのカテゴリは
   記事ページでは意図して伏せている）。
   開閉はチェックボックスの :checked と兄弟結合子で作る。JS は使わない
   ——ランキングのタブ（.tabs input:checked + .tab_item）と同じ手 */
@media (max-width: 991px) {
  /* ここではナビが帯から降りるので、帯に並ぶのは引き金と検索の2つ。
     縦棒はもともと出していなかったので、間隔も元の1段のまま (#2901) */
  .header-utility {
    gap: (space-step * 6);
  }
  /* 見えないがフォーカスできる形 (#2852)。display: none にすると Space で
     開閉できなくなり、代わりに label へ tabindex を付けると今度は発火しない */
  .header-drawer-input {
    display: block;
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  /* 引き金は三本線で、開くと ✕ に変わる (#2883)。1枚の絵は動かせないので
     svg-icon の辞書は使わず、3本の span を並べて回す（Feedly のマークを
     CSS の mask で描いているのと同じ、辞書に無い形は CSS 側で作る流儀）。
     押せる面は 24×24px を下回らないように上下左右に 4px ずつ取る */
  .header-drawer-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: space-step;
    margin: 0;
    padding: space-step;
    cursor: pointer;
  }
  .header-drawer-bar {
    display: block;
    width: 20px;
    height: 2px;
    /* 線なのでピルにする。角丸の段の3つ目 */
    border-radius: 999px;
    background: var(--ink-mute);
    /* 開閉は反応ではなく状態の変化なので、hover-speed ではなくこちらの段
       （details の開閉・タブの切り替えと同じ 0.18s） */
    transition: transform tab-speed ease, opacity tab-speed ease;
  }
  /* 上下の線を中央へ寄せてから回す。6px は線の高さ2pxと間隔4pxの和で、
     間隔の段として選んだ値ではない。角度は参照実装（リクルートサイト）と
     同じ ±135deg で、45deg と違って回る向きが両者で逆になる */
  .header-drawer-input:checked + .header-drawer-toggle .header-drawer-bar:nth-child(1) {
    transform: translateY(6px) rotate(-135deg);
  }
  .header-drawer-input:checked + .header-drawer-toggle .header-drawer-bar:nth-child(2) {
    opacity: 0;
  }
  .header-drawer-input:checked + .header-drawer-toggle .header-drawer-bar:nth-child(3) {
    transform: translateY(-6px) rotate(135deg);
  }
  /* 輪郭は見えない input ではなく label に描く (#2852) */
  .header-drawer-input:focus-visible + .header-drawer-toggle {
    outline: 2px solid var(--brand-navy);
    outline-offset: 2px;
  }
  .header-nav {
    display: none;
  }
  /* 開いた引き出しは帯の下に敷く。帯の高さを押し広げないように絶対配置で、
     縦に溢れる中身は面の中で送れるようにする */
  .site-header:has(.header-drawer-input:checked) .header-backdrop {
    display: block;
  }
  .header-drawer-input:checked ~ .header-nav {
    display: block;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: unquote('calc(100vh - ' + header-height + ')');
    overflow-y: auto;
    padding: (space-step * 2) 0 (space-step * 4);
    background: var(--surface-base);
    border-bottom: 1px solid var(--rule-base);
  }
  /* 中は縦積み。横帯のための指定（高さ・折り返さない並び）を戻す */
  .header-nav-list {
    display: block;
  }
  .header-nav-item {
    display: block;
    height: auto;
  }
  /* 中身は常に並ぶので畳みの引き金は出さず、組のラベルに替える (#2945)。
     summary のままにすると open が false のまま中身が見えていて、
     支援技術に「折りたたみ（閉）」と読まれる */
  .header-nav-disclosure {
    display: none;
  }
  .header-nav-label {
    display: block;
    padding: (space-step * 2) (space-step * 3);
    font-size: text-row;
    line-height: leading-row;
    font-weight: 700;
    color: var(--ink-strong);
  }
  .header-nav-link {
    padding: (space-step * 2) (space-step * 3);
    font-weight: 700;
    color: var(--ink-strong);
  }
  /* パネルは畳まれず、その場に並ぶ。浮かせる必要が無いので枠も影も持たない */
  .header-dropdown,
  .header-dropdown-grid {
    position: static;
    visibility: visible;
    opacity: 1;
    width: auto;
    padding: 0 0 (space-step * 3);
    border: 0;
    border-radius: 0;
    transition: none;
  }
  .header-dropdown-item {
    padding: (space-step * 2) (space-step * 3);
  }
  /* ラベルは組の見出し（引き金）が兼ねるが、「人気の」は条件なので残す */
  .header-dropdown-label {
    padding: 0 (space-step * 3);
  }
  /* 全件への導線の仕切り線は引き出しでは引かない。線はドロップダウン
     （幅288px の浮いたパネル）の中で「下に付いている1行」を示すためのもので、
     画面いっぱいの引き出しでは幅351pxの罫線になり、節の区切りに見えてしまう。
     引き出しでは次の組の見出し（「リソース」）が区切りを持っているので、
     ここは間隔だけで足りる（まとまりは間隔の差が作る #2747）。
     .header-nav で絞るのは、同じクラスを使う検索窓のヒントパネルが
     別の器（浮いたパネル）にいるため */
  .header-nav .header-dropdown-more {
    margin-top: (space-step * 2);
    border-top: 0;
  }
}
/* breadcrumb */
.breadcrumb {
	background: none;
	padding: 0;
	font: 14px "Open Sans", sans-serif;
	/* font の一括指定が line-height を normal に戻すので段を明示する */
	line-height: leading-row;
	margin-bottom: 4px;
}
.breadcrumb > li + li:before {
  	content: ">";
    -moz-osx-font-smoothing: grayscale;
    display: inline-block;
    font-style: normal;
    font-weight: normal;
    line-height: 1;
    padding: 0 5px; /* 記号の左右に余白を追加 */
}

