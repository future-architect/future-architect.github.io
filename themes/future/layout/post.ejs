<div class="container">
  <%# 記事の1段上はカテゴリ一覧ではなく、その記事のカテゴリ (#2837)。
      記事から「カテゴリ全部」へ行く読者はいない。カテゴリ一覧への導線は、
      「他のカテゴリは？」となる位置＝カテゴリページのパンくずが持つ。
      記事そのものは真下の h1 が示すので、パンくずには題名を重ねない。
      全1477記事がカテゴリをちょうど1つ持つので親は一意に決まる %>
  <%# アイコンを添えるのは記事のパンくずだけ。本文のメタ行からカテゴリを外した
      ぶん、絵柄がそのまま移ってくる形にする (#2837)。一覧・期間・著者の
      パンくずは素のテキストのまま %>
  <% const cat = page.categories && page.categories.length ? page.categories.toArray()[0] : null; %>
  <%- partial('_partial/breadcrumb', {items: [
        {label: 'ホーム', url: '/'}
      ].concat(cat ? [{
        label: cat.name + ' カテゴリ',
        url: cat.path,
        icon: partial('_partial/category-icon', {name: cat.name}).trim()
      }] : [])}) %>
  <section id="main" tabindex="-1" class="margin-top-30">
    <%# 受賞記事の印とタイトルは本文と同じ列の中にある（_partial/article #2570）%>
    <%- partial('_partial/article', {post: page, index: false}) %>
  </section>
</div>
<%# 自動生成の推薦は記事の外なので container の外に置く (#2874)。
    全幅の面でフッターに接する帯にする %>
<%- partial('_partial/article-appendix', {post: page}) %>
