<%# サイドバーの Tech Cast。最新3本を RSS（scripts/techcast_latest.js）から出す。
    リンク先は podcasters.spotify.com で、リンクテキストはエピソード名なので
    外部と読めない。矢印と sr-only で名乗る（フッターと同じ形 #2346 / #2729）。
    以前は helper が HTML を組み立てていたため、textlint の
    no-unmarked-external-link から見えない場所にリンクがあった。

    アイコンの partial は .trim() する。EJS タグの間の改行がそのまま出力に混ざり、
    文字と矢印の間に空白ができて、そこで行が折り返せてしまう（矢印だけが次の行に落ちる） %>
<div class="widget">
  <ul class="nav techcast">
    <% techcast_items().forEach(function(item){ %>
    <li>
      <a href="<%= item.link %>" title="フューチャーがお届けするポッドキャストです。<%= item.title %>" target="_blank" rel="noopener"><% if (item.isNew) { %><span class="newitem">NEW</span> <% } %><%= item.title %><span class="sr-only">（外部サイト）</span><%- partial('_partial/svg-icon', {icon: 'external-link', class_name: 'svg-icon-trailing'}).trim() %></a>
    </li>
    <% }) %>
  </ul>
</div>
