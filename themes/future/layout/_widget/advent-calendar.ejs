<%# 歴代の年リンク。データは source/_data/advent_calendar.yml が持ち、
    特設ページ（/specials/advent-calendar/）と共用する (#2464)。
    「2025年」は行き先が読めないので、矢印と sr-only で名乗る
    （フッターと同じ形 #2346 / #2729）。以前は見出しに「（Qiita）」と
    書いて一括で名乗っていたが、見出しにサービス名が入るのが目に付いた %>
<div class="widget">
  <ul class="nav-flex">
    <% (site.data.advent_calendar || []).forEach(function(c){ %>
    <li><a href="<%= c.url %>" title="<%= c.name %> Advent Calendar <%= c.year %> #Qiita" target="_blank" rel="noopener"><%= c.year %>年<span class="sr-only">（外部サイト）</span><%- partial('_partial/svg-icon', {icon: 'external-link', class_name: 'svg-icon-trailing'}).trim() %></a></li>
    <% }) %>
  </ul>
  <p class="more-link"><a href="/specials/advent-calendar/">歴代の一覧を見る</a></p>
</div>
