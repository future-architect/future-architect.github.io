<%# 歴代の年リンク。データは source/_data/advent_calendar.yml が持ち、
    特設ページ（/specials/advent-calendar/）と共用する (#2464)。
    中のリンクは年だけを名乗る Qiita 行き。11本に個別に付けず
    サイドバーの見出しが一括で名乗る (#2346) %>
<div class="widget">
  <ul class="nav-flex">
    <% (site.data.advent_calendar || []).forEach(function(c){ %>
    <li><a href="<%= c.url %>" title="<%= c.name %> Advent Calendar <%= c.year %> #Qiita" target="_blank" rel="noopener"><%= c.year %>年</a></li>
    <% }) %>
  </ul>
  <p class="more-link"><a href="/specials/advent-calendar/">歴代の一覧を見る</a></p>
</div>
