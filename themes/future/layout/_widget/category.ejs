<%# 群と並びは popular_category_groups() が1箇所で持つ (#2908)。ここで sort し直すと、
    ヘッダーのドロップダウンと /categories/ のポータルと並びが割れる。
    ここだけ全件ではなく上限8件に絞る（枠の見出しが条件を名乗る） %>
<div class="widget category-groups margin-bottom-40">
  <% popular_category_groups(page.category).forEach(function(g){ %>
  <p class="category-group-label"><%= g.name %></p>
  <ul class="nav sidebar-categories">
    <% g.categories.forEach(function(c){ %>
    <li class="<%= is_category(c.name) ? 'category-list-current' : '' %>"><a href="<%- url_for(c.path) %>" title="<%= c.name %> カテゴリの記事 累計<%= c.count %>本（直近1年 <%= c.recent %>本）"><%- partial('../_partial/category-icon', {name: c.name}) %><%= c.name %><span class="sidebar-count"><%= c.count %></span></a></li>
    <% }) %>
  </ul>
  <% }) %>
</div>
