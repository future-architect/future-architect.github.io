<%# 群と並びは active_category_groups() が1箇所で持つ (#2908)。ここで sort し直すと、
    ヘッダーのドロップダウンと /categories/ のポータルと並びが割れる。
    ここだけ全件ではなく活発なカテゴリに絞る（枠の見出しが条件を名乗る） %>
<div class="widget margin-bottom-40">
  <% active_category_groups(page.category).forEach(function(g){ %>
  <p class="category-group-label"><%= g.name %></p>
  <ul class="nav sidebar-categories">
    <% g.categories.forEach(function(c){ %>
    <li class="<%= is_category(c.name) ? 'category-list-current' : '' %>"><a href="<%- url_for(c.path) %>"><%- partial('../_partial/category-icon', {name: c.name}) %><%= c.name %> (<%= c.count %>)</a></li>
    <% }) %>
  </ul>
  <% }) %>
</div>
