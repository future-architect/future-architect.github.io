<%# ガイドラインのポータル (#2295)。実体（外部サイト）への入口と、
    タグ「ガイドライン」の公開アナウンス記事のパネルを節ごとに出す。
    どの節に属するかは記事本文が張っている外部リンクで自動分類する。
    節を手で管理しなくても、新しいアナウンス記事が増えれば勝手に並ぶ %>
<div class="container">
  <%# ページ自身は名乗らない。主題は真下の h1 が示している（#2580）%>
  <%- partial('_partial/breadcrumb', {items: [
        {label: 'ホーム', url: '/'},
        {label: '特設', url: '/specials/'}
      ]}) %>
  <%# 記事・トップページと同じ「本文 + サイドバー」の幅にする（レビューで確定）。
      本文の行長もこの列幅が抑える %>
  <div class="row">
    <main id="main" tabindex="-1" class="col-md-9 blog-posts">
  <div class="margin-top-30">
    <div class="footer-gap">
      <h1 class="list-page margin-bottom-20">フューチャーのガイドライン</h1>
      <%# 3つの実体はこのブログとは別のサイト（同じ future-architect.github.io だが別リポジトリ）。
          リンク1本ずつに印を付けるのではなく、ページの本文で一度名乗る。読み物のページは
          どこも同じ扱いで、印は全ページ共通の枠と記事末のパネルだけが持つ (#2729) %>
      <p class="specials-text">フューチャーが無償公開している設計ガイドライン・コーディング規約・学習コンテンツの入口です。いずれもこのブログとは別のサイトで公開しており、現場のプロジェクトで培った知見を有志がまとめ、継続的に更新しています。</p>
      <%
        // 母集合はタグ「ガイドライン」∪「コーディング規約」。コーディング規約の
        // 公開アナウンスは「コーディング規約」タグ側にしか付いていない記事がある。
        // フロントマターに専用キーは足さない（見えない語彙になり、入稿ツール側の
        // 対応も要る）。本文が張っている外部リンクで節に自動分類し、
        // どのサイトにもリンクしない記事（タグの緩い使われ方）は自然に落ちる
        const seen = new Set();
        const posts = [];
        ['ガイドライン', 'コーディング規約'].forEach(function(name){
          const t = site.tags.findOne({name: name});
          if (t) t.posts.forEach(function(p){
            if (!seen.has(p._id)) { seen.add(p._id); posts.push(p); }
          });
        });
        posts.sort((a, b) => b.date - a.date);
        const links = p => String(p.content || '');
        const arch = posts.filter(p => links(p).includes('arch-guidelines'));
        const coding = posts.filter(p => !links(p).includes('arch-guidelines') && links(p).includes('coding-standards'));
        const ts = posts.filter(p => !links(p).includes('arch-guidelines') && links(p).includes('typescript-guide'));
      %>
      <%# パネルは共用の post-panel-grid（/series/ と同じ部品・3列）。年の囲みは付けない %>

      <%- partial('_partial/section-heading', {id: 'archguidelines', text: '設計ガイドライン（Future Architecture Guidelines）'}) %>
      <p class="specials-text">Web API・Terraform・ログ・バッチ・PostgreSQL・非同期処理・データマネジメントなど、システム設計の指針を領域別にまとめたガイドライン集です。ソフトスキルや性能テスト入門などの読み物も含みます。</p>
      <p class="specials-text"><a href="https://future-architect.github.io/arch-guidelines/" target="_blank" rel="noopener">Future Architecture Guidelines を読む</a></p>
      <%- partial('_partial/post-panel-grid', {posts: arch}) %>

      <%- partial('_partial/section-heading', {id: 'codingstandards', text: 'コーディング規約（Future Enterprise Coding Standards）'}) %>
      <p class="specials-text">エンタープライズ領域に特化したコーディング規約です。Java・SQL などの言語規約と、Gitブランチフローなどの開発プロセス規約を含みます。</p>
      <p class="specials-text"><a href="https://future-architect.github.io/coding-standards/" target="_blank" rel="noopener">Future Enterprise Coding Standards を読む</a></p>
      <%- partial('_partial/post-panel-grid', {posts: coding}) %>

      <%- partial('_partial/section-heading', {id: 'typescript', text: '仕事ですぐに使えるTypeScript'}) %>
      <p class="specials-text">JavaScript を経由せず、最初から TypeScript でウェブフロントエンド開発を学ぶための教育コンテンツです。</p>
      <p class="specials-text"><a href="https://future-architect.github.io/typescript-guide/" target="_blank" rel="noopener">仕事ですぐに使えるTypeScript を読む</a></p>
      <%- partial('_partial/post-panel-grid', {posts: ts}) %>

      <%- partial('_partial/section-heading', {id: 'relatedtags', text: '関連タグ'}) %>
      <div class="blog-tags">
        <%- partial('_partial/tag-chips', {items: [
              {name: 'ガイドライン', path: '/tags/ガイドライン/'},
              {name: 'コーディング規約', path: '/tags/コーディング規約/'},
            ]}) %>
      </div>
    </div>
  </div>
    </main>
    <aside class="col-md-3 blog-sidebar">
      <%- partial('_partial/sidebar', {specialsToc: [
        {id: 'archguidelines', text: '設計ガイドライン'},
        {id: 'codingstandards', text: 'コーディング規約'},
        {id: 'typescript', text: '仕事ですぐに使えるTypeScript'},
        {id: 'relatedtags', text: '関連タグ'},
      ]}) %>
    </aside>
  </div>
</div>
