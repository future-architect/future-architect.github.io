<%# 出版・寄稿の一覧 (#2912)。記事のフロントマターの books / magazines から
    scripts/publications.js が集める。表紙は並べない——買い物ページではなく
    「誰が何を書いたか」の記録なので、書名・寄稿タイトル・執筆者が読めることを優先する。
    行き先は出版社のページで、リンク1本ずつに印を付けずページの本文で一度名乗る (#2729) %>
<% const pub = publications(); %>
<div class="container">
  <%- partial('_partial/breadcrumb', {items: [
        {label: 'ホーム', url: '/'},
        {label: '特設', url: '/specials/'}
      ]}) %>
  <div class="row">
    <main id="main" tabindex="-1" class="col-md-9 blog-posts">
  <div class="margin-top-30">
    <div class="footer-gap">
      <h1 class="list-page margin-bottom-20">出版・寄稿</h1>
      <p class="specials-text">フューチャーの社員が書いた書籍<%= pub.books.length %>点と、技術誌への寄稿<%= pub.magazines.length %>件です。書名・号の名前は出版社のページに、それぞれの行は書いた本人によるブログの記事にリンクしています。</p>

      <%- partial('_partial/section-heading', {id: 'books', text: '書籍'}) %>
      <ul class="publication-list">
        <% pub.books.forEach(function(b){ %>
        <li class="publication-item">
          <p class="publication-name"><a href="<%= b.url %>" target="_blank" rel="noopener"><%= b.name %></a></p>
          <p class="publication-meta"><%= b.by %> ／ <a href="<%= b.post.path %>"><%= b.post.title %></a></p>
        </li>
        <% }) %>
      </ul>

      <%- partial('_partial/section-heading', {id: 'magazines', text: '技術誌への寄稿'}) %>
      <%# まとめる単位は号ではなく寄稿1件。1つの号に複数の寄稿があり、書いた人も違う %>
      <ul class="publication-list">
        <% pub.magazines.forEach(function(m){ %>
        <li class="publication-item">
          <p class="publication-name"><a href="<%= m.url %>" target="_blank" rel="noopener"><%= m.name %></a></p>
          <p class="publication-meta"><% if (m.work) { %><%= m.work %> ／ <% } %><%= m.by %> ／ <a href="<%= m.post.path %>"><%= m.post.title %></a></p>
        </li>
        <% }) %>
      </ul>

      <%- partial('_partial/section-heading', {id: 'relatedtags', text: '関連タグ'}) %>
      <div class="blog-tags">
        <%- partial('_partial/tag-chips', {items: [
            {name: '出版', path: '/tags/出版/'},
            {name: '外部寄稿', path: '/tags/外部寄稿/'},
          ]}) %>
      </div>
    </div>
  </div>
    </main>
    <aside class="col-md-3 blog-sidebar" aria-label="サイドバー">
      <%- partial('_partial/sidebar', {specialsToc: [
        {id: 'books', text: '書籍'},
        {id: 'magazines', text: '技術誌への寄稿'},
        {id: 'relatedtags', text: '関連タグ'},
      ]}) %>
    </aside>
  </div>
</div>
