<%# 出版・寄稿の一覧 (#2912)。記事のフロントマターの books / magazines から
    scripts/publications.js が集める。書影を添えるのは書籍の節だけ——技術誌は
    23件のうち13件が号ごとの表紙を持たない（2本のまとめ記事に由来する）。
    行き先は出版社のページで、リンク1本ずつに印を付けずページの本文で一度名乗る (#2729) %>
<% const pub = publications(); %>
<div class="container">
  <%- partial('_partial/breadcrumb', {items: [
        {label: 'ホーム', url: '/'},
        {label: '特設', url: '/specials/'}
      ]}) %>
  <div class="row">
    <main id="main" tabindex="-1" class="col-md-9 blog-posts">
  <div class="margin-top-30">
    <div class="footer-gap">
      <h1 class="list-page margin-bottom-20">出版・寄稿</h1>
      <p class="specials-text">フューチャーの社員が書いた書籍<%= pub.books.length %>点と、技術誌への寄稿<%= pub.magazineCount %>件です。書名・号の名前は出版社のページに、それぞれの行は書いた本人によるブログの記事にリンクしています。</p>

      <%- partial('_partial/section-heading', {id: 'books', text: '書籍'}) %>
      <%# 書籍はパネルのグリッド（連載・HTTF と同じ部品）で2列。3列にすると添えの
          「執筆者 ／ 記事タイトル」が幅122〜212pxで3〜4行に折り返し、文字の塊が
          書影（80px）より高くなる。2列なら題は1行、添えは1〜2行に収まる %>
      <div class="series-panels row">
        <% pub.books.forEach(function(b){ %>
        <div class="col-12 col-md-6">
          <%- partial('_partial/panel-card', {
                url: b.url,
                title: b.name,
                thumb: Object.assign({src: b.cover, variant: 'book'}, image_size(b.cover)),
                // 著者名は出さない。共著・共訳でも1名しか出ないので単著に見える
                meta: '<a href="' + url_for(b.post.path) + '">' + escape_html(b.post.title) + '</a>',
                external: true,
              }) %>
        </div>
        <% }) %>
      </div>

      <%- partial('_partial/section-heading', {id: 'magazines', text: '技術誌への寄稿'}) %>
      <%# 1行目が「何に書いたか」（号と章）、2行目以降が「誰が書き、どの記事で報告したか」。
          同じ章に複数人が寄稿していれば、その行の中に人を積む %>
      <ul class="publication-list">
        <% pub.magazines.forEach(function(m){ %>
        <li class="publication-item">
          <p class="publication-name"><a href="<%= m.url %>" target="_blank" rel="noopener"><%= m.name %></a><% if (m.work) { %><span class="publication-work"><%= m.work %></span><% } %></p>
          <% m.items.forEach(function(w){ %>
          <p class="publication-meta"><%= w.by %> ／ <a href="<%= w.post.path %>"><%= w.post.title %></a></p>
          <% }) %>
        </li>
        <% }) %>
      </ul>

      <%- partial('_partial/section-heading', {id: 'relatedtags', text: '関連タグ'}) %>
      <div class="blog-tags">
        <%- partial('_partial/tag-chips', {items: [
            {name: '出版', path: '/tags/出版/'},
            {name: 'SoftwareDesign', path: '/tags/SoftwareDesign/'},
          ]}) %>
      </div>
    </div>
  </div>
    </main>
    <aside class="col-md-3 blog-sidebar" aria-label="サイドバー">
      <%- partial('_partial/sidebar', {specialsToc: [
        {id: 'books', text: '書籍'},
        {id: 'magazines', text: '技術誌への寄稿'},
        {id: 'relatedtags', text: '関連タグ'},
      ]}) %>
    </aside>
  </div>
</div>
