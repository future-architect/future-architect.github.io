<div class="container">
  <%- partial('_partial/breadcrumb', {items: [
        {label: 'ホーム', url: '/'}
      ]}) %>
  <div class="row">
    <main id="main" tabindex="-1" class="col-md-9 margin-top-30">
    <div class="footer-gap">
      <%# 一覧ページは個別ページ（user）の複数形を持つ (#2571)。
          users-group は Management カテゴリが使っているので避ける %>
      <h1 class="list-page margin-bottom-20"><%- partial('_partial/svg-icon', {icon: 'users'}) %>著者一覧</h1>

      <%# 表彰の一覧 (#2409)。受賞バッジは著者ページ (#2149) にしか出ず、
          顔ぶれを一覧で見る場所がなかった。データは awards.yml 一元。
          並びは確定構成の「定番」枠に相当する位置（グラフの後・一覧の前） %>
      <%- partial('_partial/section-heading', {id: 'awards', text: 'Best Blogger of the Year'}) %>
      <%# .specials-text は名前こそ特設ページ由来だが実体は「本文サイズの地の文」 %>
      <p class="specials-text"><%- partial('_partial/award-name') %> は、社外に影響を与えた記事を執筆した著者を年1回表彰する取り組みです。累計3回の受賞で殿堂入りします。</p>
      <% const awards = awards_list(); %>
      <%# 殿堂入りは年1回の表彰の主役なので、金のカードで大きく称える。
          各年の受賞者は著者ページのバッジと同じチップで淡々と並べ、
          主役と記録の役割を分ける %>
      <% if (awards.hall.length) { %>
      <div class="awards-hall">
        <% awards.hall.forEach(function(h){ %>
        <div class="awards-hall-card">
          <span class="awards-hall-label"><%- partial('_partial/svg-icon', {icon: 'crown'}) %>殿堂入り</span>
          <a class="awards-hall-name" href="<%- url_for('authors/' + h.author + '/') %>"><%= h.author %></a>
          <span class="awards-hall-years"><% h.years.forEach(function(y){ %><span class="awards-hall-medal"><%- partial('_partial/award-medal', {nth: y.nth}) %><%= y.year %></span><% }) %></span>
        </div>
        <% }) %>
      </div>
      <% } %>
      <ul class="award-years">
        <% awards.years.forEach(function(y){ %>
        <li>
          <span class="award-year"><%= y.year %></span>
          <span class="award-winners">
            <% y.authors.forEach(function(a){ %>
            <a class="award-chip<%= a.nth >= 3 ? ' award-chip-hall' : (a.nth === 2 ? ' award-chip-repeat' : '') %>" href="<%- url_for('authors/' + a.name + '/') %>" title="<%= a.name %>（<%= a.nth %>回目の受賞）"><%- partial('_partial/award-medal', {nth: a.nth >= 2 ? a.nth : null}) %><%= a.name %></a>
            <% }) %>
          </span>
        </li>
        <% }) %>
      </ul>

      <%# ページの主役である一覧に見出しが無く、h1 の次が「年別 著者数の推移」
          だったため、文書の見出しの並びからこの節が抜けていた。
          語彙は同じ立場の一覧ページ（すべてのカテゴリ / すべての連載）に揃える %>
      <%- partial('_partial/section-heading', {id: 'authors', text: 'すべての著者'}) %>
      <%# 全年を縦に並べると16セクションになるが、普段見るのは今年だけなので
          タブで切り替える。既定は今年 (#2073)。ランキングと同じ radio + label 方式 %>
      <div class="nav tabs year-tabs" role="radiogroup" aria-label="集計する年">
        <%
          const currentYear = new Date().getFullYear();
          for (let year = currentYear; year >= 2016; year--) {
        %>
        <input id="authors-<%= year %>" type="radio" name="authors_year"<%= year === currentYear ? ' checked' : '' %>>
        <label class="tab_item" for="authors-<%= year %>"><%= year %><%- partial('_partial/tab-hint') %></label>
        <div class="tab_content">
          <%# 新規著者はその年が初投稿の著者。一覧の NEW マークと同じ定義 (#2413) %>
          <%- partial('_partial/summary-tiles', {items: [
                {value: count_authors(year.toString()), label: '著者数'},
                {value: count_new_authors(year.toString()), label: '新規著者'},
                {value: count_articles_year(year.toString()), label: '投稿'},
              ]}) %>
          <%- list_authors(year.toString()) %>
        </div>
        <% } %>
        <input id="authors-all" type="radio" name="authors_year">
        <label class="tab_item tab_item-all" for="authors-all">全期間<%- partial('_partial/tab-hint') %></label>
        <div class="tab_content">
          <%- partial('_partial/summary-tiles', {items: [
                {value: count_authors(), label: '著者数'},
                {value: count_articles(), label: '投稿'},
              ]}) %>
          <%- list_authors() %>
        </div>
      </div>

    </div>
    </main>
    <aside class="col-md-3 blog-sidebar" aria-label="サイドバー">
      <%- partial('_partial/sidebar-index-authors') %>
    </aside>
  </div>
</div>
