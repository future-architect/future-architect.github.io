<%# アドベントカレンダーの特設ページ (#2464)。歴代の Qiita カレンダーへの
    入口と、ブログ側にあるアドベントカレンダー記事をまとめる。
    年の一覧は source/_data/advent_calendar.yml が持ち、サイドバーの
    ウィジェットと共用する。記事はタグ・series から自動収集するので、
    手で更新するのは年1回の yml だけ。

    「その年の記事一覧」は置かない。参加記事は原則 Qiita 側に投稿する方針で、
    ブログに自社カレンダーの記事として書かれたものは2017〜2020年の7本しかなく、
    しかも本文の書き出しでしか判別できない（タグも series も無い）。
    2021年以降は0本。年ごとの枠を作っても11年のうち4年しか埋まらないため、
    実在する参加レポートへのリンクだけを添える %>
<div class="container">
  <%# ページ自身は名乗らない。主題は真下の h1 が示している（#2580）%>
  <%- partial('_partial/breadcrumb', {items: [
        {label: 'ホーム', url: '/'},
        {label: '特設', url: '/specials/'}
      ]}) %>
  <%# 記事・トップページと同じ「本文 + サイドバー」の幅にする %>
  <div class="row">
    <main class="col-md-9 blog-posts">
  <section id="main" class="margin-top-30">
    <div class="footer-gap">
      <h1 class="list-page margin-bottom-20">アドベントカレンダー</h1>
      <p class="specials-text">フューチャーは2015年から毎年 Qiita Advent Calendar に参加しています。IT技術であること以外はフリーテーマで、毎年12月に社員がリレー形式で記事を公開しています。参加記事は原則として Qiita 側に投稿するため、各年の記事はカレンダーのページから辿ってください。</p>

      <%- partial('_partial/section-heading', {id: 'calendars', text: '歴代のアドベントカレンダー'}) %>
      <%
        // 参加レポート（「Qiita Advent Calendar 20XX に参加します」）を公開年で引く。
        // タグ「アドベントカレンダー」のうち series を持つものはリバイバル連載の
        // 索引記事で、その年のカレンダーの告知ではないので除く
        const reports = {};
        const reportTag = site.tags.findOne({name: 'アドベントカレンダー'});
        if (reportTag) reportTag.posts.forEach(function(p){
          if (p.series) return;
          reports[p.date.year()] = p;
        });
        const calendars = site.data.advent_calendar || [];
      %>
      <div class="series-panels row g-4">
        <% calendars.forEach(function(c){ %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="article-card series-panel h-100">
            <%# 歴代に共通する絵が無いので空き枠。連載パネルと同じ扱い %>
            <span class="panel-thumb panel-thumb-empty"></span>
            <div class="panel-body">
              <a href="<%= c.url %>" class="panel-title" target="_blank" rel="noopener"><%= c.name %> Advent Calendar <%= c.year %></a>
              <div class="panel-meta">
                Qiita（外部サイト）<% if (c.series2) { %>・<a href="<%= c.series2 %>" target="_blank" rel="noopener">シリーズ2</a><% } %>
              </div>
              <% if (reports[c.year]) { %>
              <div class="panel-meta"><a href="<%- url_for(reports[c.year].path) %>">参加レポートを読む</a></div>
              <% } %>
            </div>
          </div>
        </div>
        <% }) %>
      </div>

      <%- partial('_partial/section-heading', {id: 'revival', text: 'ブログで読めるアドベントカレンダー記事'}) %>
      <p class="specials-text margin-bottom-20">過去のアドベントカレンダーで反響の大きかった Qiita 記事を、内容を最新化してこのブログに再掲した連載です。当時の記事をそのまま写すのではなく、公開後に変わった前提や書き足りなかった点を著者自身が加えています。</p>
      <%
        // series 名に「アドベントカレンダー」を含む連載を集める。連載名を直書きすると
        // 次のリバイバル（年が変わると別の series 名になる）で書き換えが要る
        const revivalPosts = site.posts.toArray()
          .filter(p => String(p.series || '').includes('アドベントカレンダー'))
          .sort((a, b) => b.date - a.date);
      %>
      <%- partial('_partial/post-panel-grid', {posts: revivalPosts}) %>
    </div>
  </section>
    </main>
    <aside class="col-md-3 blog-sidebar">
      <%- partial('_partial/sidebar', {specialsToc: [
        {id: 'calendars', text: '歴代のアドベントカレンダー'},
        {id: 'revival', text: 'ブログで読めるアドベントカレンダー記事'},
      ]}) %>
    </aside>
  </div>
</div>
