<%# Markdown で書いた固定ページ用の最小レイアウト。
    このファイルが無いと Hexo が post 用レイアウトへフォールバックし、
    関連記事・SNSボタン・We're hiring まで付いてしまう (#2077)。
    サイドバーは目次を出せるときだけ添える（下のコメント #2559）%>
<%# .container が無いと .row が画面幅いっぱいに広がりレイアウトが崩れる（#2295 で発覚）。
    他レイアウト（post.ejs 等）と同じく container で包む %>
<div class="container">
  <%- partial('_partial/breadcrumb-page') %>
  <%# 見出しから目次を組む (#2559)。EJS の特設ページは項目を specialsToc に
      手で書くが、Markdown のページは本文があるので組める。
      出す価値が無いとき（見出しが1つだけ等）は空が返る。条件は scripts/page_toc.js %>
  <% const tocHtml = page_toc(page.content); %>
  <div class="row">
    <main id="main" tabindex="-1" class="col-md-9 blog-posts">
      <%# 本文がページの最後の要素なので footer-gap でフッター前の間隔を持つ %>
      <article class="article blog-item footer-gap">
        <div class="article-inner">
          <%# 1024px 以下ではサイドバーの目次が本文の下に落ちて役に立たないので、
              記事と同じく本文の直前に畳んだ目次を出す (#2452) %>
          <% if (tocHtml) { %>
          <details class="toc-mobile" data-nosnippet>
            <summary>目次</summary>
            <div class="toc-section"><%- tocHtml %></div>
          </details>
          <% } %>
          <div class="article-entry">
            <%- page.content %>
          </div>
        </div>
      </article>
    </main>
    <%# サイドバーはページ自身の目次のための場所（tocOnly）。目次を出せるかは
        中身しだいなので、判断は渡した先（_partial/sidebar）に任せる。
        見出しが増えれば同じ枠に目次が出る (#2559)。

        カテゴリ一覧はここには置かない。特設ページは記事とは別の空間で、
        別の軸への導線を並べると意図がぼやける（タグ・著者のページと同じ扱い）。
        以前は目次を持たない /specials/ だけカテゴリ一覧が出ていて、
        同じ /specials/ 配下で不揃いになっていた %>
    <aside class="col-md-3 blog-sidebar" aria-label="サイドバー">
      <%- partial('_partial/sidebar', {tocHtml: tocHtml, tocOnly: true}) %>
    </aside>
  </div>
</div>
<%# 記事と同じ帯で We're hiring を足す (#3141)。出すページは frontmatter の
    career が名乗る。このレイアウトは特設ページ全体で共有していて、
    /specials/ の一覧のようなナビゲーターには要らない。
    記事の推薦（関連記事・被参照）は持たないので recommend は false %>
<% if (page.career) { %>
<%- partial('_partial/article-appendix', {post: page, recommend: false}) %>
<% } %>
