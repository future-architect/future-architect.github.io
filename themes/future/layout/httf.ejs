<%# HACK TO THE FUTURE の特設ページ (#2345)。コンテストの紹介と
    競技プログラミング記事の導線をまとめる。主題はコンテストなので
    インターン等の学生向け一般コンテンツは載せない（レビューで確定）。
    記事はタグから自動収集。手で更新するのは開催一覧（年1回、先頭に追加）だけ %>
<div class="container">
  <%- partial('_partial/breadcrumb', {items: [
        {label: 'ホーム', url: '/'},
        {label: '特設', url: '/specials/'},
        {label: 'HACK TO THE FUTURE'}
      ]}) %>
  <section id="main" class="margin-top-30">
    <div class="footer-gap">
      <h1 class="list-page margin-bottom-20">HACK TO THE FUTURE</h1>
      <%# 冒頭のロゴはコンテスト一覧のアイキャッチと同じ絵で冗長になるため置かない（レビューで確定） %>
      「HACK TO THE FUTURE」（#HTTF）は、フューチャー主催のヒューリスティック型プログラミングコンテストです。2018年から毎年 AtCoder で開催しており、参加登録者のうちフューチャーに興味をお持ちの方には、新卒採用における優先案内などの特典があります。

      <%- partial('_partial/section-heading', {id: 'why', text: 'フューチャーが HACK TO THE FUTURE を開催する理由'}) %>
      フューチャーは、コンピュータサイエンスを駆使してさまざまな業界・分野の社会課題に挑戦してきました。特定の手法に特化せず技術の原理原則を重視し、課題解決に本当に最適なものがなければ自ら作り出す——そのDNAの先にアルゴリズムの未来への確信があり、その活用に秀でた人材と出会うために、独自のコンテストとして HACK TO THE FUTURE を開催しています。大会名には、競技プログラマーの未来を技術力で "HACK" してほしいという思いを込めています。「難しいけど面白い」と感じる方は、きっとフューチャーのカルチャーにマッチするはずです。

      <%- partial('_partial/section-heading', {id: 'contests', text: '歴代のコンテスト'}) %>
      <%
        // 2018年から全回、年ごとに1パネル。新しい回が始まったらこの先頭に1行追加する。
        // 2023年以前は予選・本選（本選はオープンコンテスト）の2本立てで、final にそのリンクを持つ
        const httfContests = [
          {title: 'HACK TO THE FUTURE 2026', url: 'https://atcoder.jp/contests/ahc056', meta: 'AtCoder Heuristic Contest 056'},
          {title: 'HACK TO THE FUTURE 2025', url: 'https://atcoder.jp/contests/AHC040', meta: 'AtCoder Heuristic Contest 040'},
          {title: 'HACK TO THE FUTURE 2024', url: 'https://atcoder.jp/contests/AHC027', meta: 'AtCoder Heuristic Contest 027'},
          {title: 'HACK TO THE FUTURE 2023', url: 'https://atcoder.jp/contests/AHC016', qualLabel: '予選（AHC016）', final: 'https://atcoder.jp/contests/future-contest-2023-final-open'},
          {title: 'HACK TO THE FUTURE 2022', url: 'https://atcoder.jp/contests/future-contest-2022-qual', qualLabel: '予選', final: 'https://atcoder.jp/contests/future-contest-2022-final-open'},
          {title: 'HACK TO THE FUTURE 2021', url: 'https://atcoder.jp/contests/future-contest-2021-qual', qualLabel: '予選', final: 'https://atcoder.jp/contests/future-contest-2021-final-open'},
          {title: 'HACK TO THE FUTURE 2020', url: 'https://atcoder.jp/contests/future-contest-2020-qual', qualLabel: '予選', final: 'https://atcoder.jp/contests/future-contest-2020-final-open'},
          {title: 'HACK TO THE FUTURE 2019', url: 'https://atcoder.jp/contests/future-contest-2019-qual', qualLabel: '予選', final: 'https://atcoder.jp/contests/future-contest-2019-final-open'},
          {title: 'HACK TO THE FUTURE 2018', url: 'https://atcoder.jp/contests/future-contest-2018-qual', qualLabel: '予選', final: 'https://atcoder.jp/contests/future-contest-2018-final-open'},
        ];
      %>
      <div class="series-panels row g-4">
        <% httfContests.forEach(function(c){ %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="article-card series-panel h-100">
            <%# ロゴは切り抜くと欠けるので contain 表示（panel-thumb-contain） %>
            <a href="<%= c.url %>" title="<%= c.title %>" class="img_wrap panel-thumb panel-thumb-contain" target="_blank" rel="noopener">
              <img src="/httf_logo.png" alt="" width="640" height="280" loading="lazy">
            </a>
            <div class="panel-body">
              <a href="<%= c.url %>" class="panel-title" target="_blank" rel="noopener"><%= c.title %></a>
              <div class="panel-meta">
                <% if (c.final) { %><a href="<%= c.url %>" target="_blank" rel="noopener"><%= c.qualLabel %></a>・<a href="<%= c.final %>" target="_blank" rel="noopener">本選</a>（外部サイト）<% } else { %><%= c.meta %>（外部サイト）<% } %>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>

      <%- partial('_partial/section-heading', {id: 'kyopro', text: '競技プログラミングの記事'}) %>
      HTTF を主催するフューチャーには、業務でも趣味でも競技プログラミングに親しむ社員がいます。コンテストのビジュアライザ制作の裏側、社内バーチャルコンテストの開催記、競プロを入り口に入社したメンバーの話など、フューチャーと競技プログラミングの関わりが分かる記事を集めました。
      <%
        // タグ「競技プログラミング」∪「AtCoder」から自動収集。
        // 「コンテスト」タグは統合予定 (#2334) のため収集キーにしない
        const seen = new Set();
        const kyoproPosts = [];
        ['競技プログラミング', 'AtCoder'].forEach(function(name){
          const t = site.tags.findOne({name: name});
          if (t) t.posts.forEach(function(p){
            if (!seen.has(p._id)) { seen.add(p._id); kyoproPosts.push(p); }
          });
        });
        kyoproPosts.sort((a, b) => b.date - a.date);
      %>
      <%- partial('_partial/post-panel-grid', {posts: kyoproPosts}) %>
    </div>
  </section>
</div>
