<%# HACK TO THE FUTURE の特設ページ (#2345)。コンテストの紹介と
    競技プログラミング記事の導線をまとめる。主題はコンテストなので
    インターン等の学生向け一般コンテンツは載せない（レビューで確定）。
    記事はタグから自動収集。手で更新するのは開催一覧（年1回、先頭に追加）だけ %>
<div class="container">
  <%# ページ自身は名乗らない。主題は真下の h1 が示している（#2580）%>
  <%- partial('_partial/breadcrumb', {items: [
        {label: 'ホーム', url: '/'},
        {label: '特設', url: '/specials/'}
      ]}) %>
  <%# 記事・トップページと同じ「本文 + サイドバー」の幅にする（レビューで確定）。
      本文の行長もこの列幅が抑える %>
  <div class="row">
    <main id="main" tabindex="-1" class="col-md-9 blog-posts">
  <div class="margin-top-30">
    <div class="footer-gap">
      <h1 class="list-page margin-bottom-20">HACK TO THE FUTURE</h1>
      <%# 冒頭のロゴはコンテスト一覧のアイキャッチと同じ絵で冗長になるため置かない（レビューで確定） %>
      <p class="specials-text">「HACK TO THE FUTURE」（#HTTF）は、フューチャー主催のヒューリスティック型プログラミングコンテストです。2018年から毎年 AtCoder で開催しており、参加登録者のうちフューチャーに興味をお持ちの方には、新卒採用における優先案内などの特典があります。</p>

      <%- partial('_partial/section-heading', {id: 'why', text: 'フューチャーが HACK TO THE FUTURE を開催する理由'}) %>
      <p class="specials-text">フューチャーは、コンピュータサイエンスを駆使してさまざまな業界・分野の社会課題に挑戦してきました。特定の手法に特化せず技術の原理原則を重視し、課題解決に本当に最適なものがなければ自ら作り出す——そのDNAの先にアルゴリズムの未来への確信があり、その活用に秀でた人材と出会うために、独自のコンテストとして HACK TO THE FUTURE を開催しています。大会名には、競技プログラマーの未来を技術力で "HACK" してほしいという思いを込めています。「難しいけど面白い」と感じる方は、きっとフューチャーのカルチャーにマッチするはずです。</p>

      <%- partial('_partial/section-heading', {id: 'contests', text: '歴代のコンテスト'}) %>
      <%# 2018年から全回、年ごとに1パネル。中身は source/_data/httf.yml が持つ。
          ホームの「特集」枠が開催中かどうかを同じ年から決めるので、
          2箇所に年を書かないためにデータへ出した (#2892) %>
      <% const httfContests = (site.data.httf || []).map(function(c){
           return Object.assign({title: 'HACK TO THE FUTURE ' + c.year, qualLabel: c.qual_label}, c);
         }); %>
      <div class="series-panels row g-4">
        <% httfContests.forEach(function(c){ %>
        <div class="col-12 col-md-6 col-lg-4">
          <%# ロゴは切り抜くと欠けるので contain 表示。
              このページは読み物（歴代の記録）なので外部リンクの印は付けない (#2729)。
              行き先は冒頭の本文が「2018年から毎年 AtCoder…」と名乗っている %>
          <%- partial('_partial/panel-card', {
                url: c.url,
                title: c.title,
                thumb: {src: '/httf_logo.png', width: 640, height: 280, contain: true},
                meta: c.final
                  ? `<a href="${c.url}" target="_blank" rel="noopener">${c.qualLabel}</a>・<a href="${c.final}" target="_blank" rel="noopener">本選</a>`
                  : c.meta,
                external: true,
              }) %>
        </div>
        <% }) %>
      </div>

      <%- partial('_partial/section-heading', {id: 'kyopro', text: '競技プログラミングの記事'}) %>
      <p class="specials-text margin-bottom-20">HTTF を主催するフューチャーには、業務でも趣味でも競技プログラミングに親しむ社員がいます。コンテストのビジュアライザ制作の裏側、社内バーチャルコンテストの開催記、競プロを入り口に入社したメンバーの話など、フューチャーと競技プログラミングの関わりが分かる記事を集めました。</p>
      <%
        // タグ「競技プログラミング」∪「AtCoder」から自動収集。
        // 「コンテスト」タグは統合予定 (#2334) のため収集キーにしない
        // 関連タグのチップも同じ配列から出す (#3101)
        const RELATED_TAGS = ['競技プログラミング', 'AtCoder'];
        const seen = new Set();
        const kyoproPosts = [];
        RELATED_TAGS.forEach(function(name){
          const t = site.tags.findOne({name: name});
          if (t) t.posts.forEach(function(p){
            if (!seen.has(p._id)) { seen.add(p._id); kyoproPosts.push(p); }
          });
        });
        kyoproPosts.sort((a, b) => b.date - a.date);
      %>
      <%- partial('_partial/post-panel-grid', {posts: kyoproPosts}) %>

      <%- partial('_partial/section-heading', {id: 'relatedtags', text: '関連タグ'}) %>
      <div class="blog-tags">
        <%- partial('_partial/tag-chips', {items: RELATED_TAGS.map(function(name){ return {name: name, path: '/tags/' + name + '/'}; })}) %>
      </div>
    </div>
  </div>
    </main>
    <aside class="col-md-3 blog-sidebar" aria-label="サイドバー">
      <%- partial('_partial/sidebar', {specialsToc: [
        {id: 'why', text: 'フューチャーが HACK TO THE FUTURE を開催する理由'},
        {id: 'contests', text: '歴代のコンテスト'},
        {id: 'kyopro', text: '競技プログラミングの記事'},
        {id: 'relatedtags', text: '関連タグ'},
      ]}) %>
    </aside>
  </div>
</div>
