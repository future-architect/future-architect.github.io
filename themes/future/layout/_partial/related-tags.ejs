<%# タグページの関連タグ。archive.ejs が読者の状態に合わせて位置を変えて使う。
    1ページ目 = 一覧の前（このタグで合っているかの絞り込み直し）、
    最終ページ = ページャーの下（読み尽くした読者への次の導線）(#2088 / #2213) %>
<% const groups = related_tags(page.tag); %>
<% if (groups.length) { %>
<aside data-nosnippet aria-label="関連タグ">
  <section class="popular-articles related-tag-groups margin-bottom-20">
    <%# 見出しは記事ページの「関連記事」に合わせる。あちらも内部ではスコアで
        並べているが強度は名乗っていない。「関連が強いタグ」とすると根拠を
        問われるうえ、実際には絞り込み系と発見系が混在していて言い切れない %>
    <%- partial('section-heading', {id: 'relatedtags', text: '関連タグ'}) %>
    <%# チップだと関連の中身（何本の記事を共有しているか・同じ系列か）が
        title 属性に隠れてホバーしないと分からない。著者ページの
        「よく使うタグ」と同じ tendency-panel の作りで常時見せる (#2172) %>
    <%# 群ごとに読者の目的が違う（中を絞り込む / 隣の話題へ移る / 版を選ぶ）ので、
        目的はラベルが名乗り、パネルは本数だけを出す (#2569)。
        「N本に絞り込む」のように動詞をパネルへ持たせるとラベルと二重になるうえ、
        系列の子はタグ付け漏れで完全な部分集合とは限らないため、
        絞り込みだと言い切れない。移動先の総数と共通本数はホバーの title に残す %>
    <%# 版のページ（Go1.27）から見ると、親（Go）は広げる相手、別の版（Go1.26）は
        同じ軸の別の値で、目的が違う。「同じ系列」だと親向けの言い方に読めて
        どちらの関係なのか分からないため、群を分けて別々に名乗る。
        軸が年の系列（インターン2022 / GoogleCloudNext2024）は「他の年」。
        この2群の title は総数だけ。関係は見出しが名乗っていて、括弧に書くと
        同じことを2回言う。他の群の括弧は見出しに無い共通本数を足している (#3077)
        共起の群はスコア順の上位8件（MAX_CO_TAGS）で全件ではないので、
        「よく使われるカテゴリ」と同じく「よく」が抜粋であることを名乗る (#2670 / #3075)。
        ラベルは体言止め。h2「関連タグ」の下なので「〜で探す」は二度言いになる (#3083) %>
    <% const labels = {
         detail: 'もっと詳しいタグ',
         adjacent: 'よく一緒に使われるタグ',
         broader: 'もっと広いタグ',
         versions: '他のバージョン',
         years: '他の年',
       }; %>
    <% const note = (kind, t) =>
         kind === 'broader'
           ? t.covers
             ? `${t.name} の記事 ${t.posts}本（${page.tag} の記事もすべて含む）`
             : `${t.name} の記事 ${t.posts}本（うち ${page.tag} と共通 ${t.co}本）`
           : kind === 'versions' || kind === 'years'
             ? `${t.name} の記事 ${t.posts}本`
             : t.fresh === 0
               ? `${t.name} の記事 ${t.posts}本（すべて ${page.tag} の記事）`
               : `${t.name} の記事 ${t.posts}本（うち ${page.tag} と共通 ${t.co}本）`; %>
    <% groups.forEach(function(g){ %>
    <h3 class="panels-label"><%= labels[g.kind] %></h3>
    <%# 共起の群だけは共通本数が関係の強さそのもの。他の群は移動先の本数
        （＝押した先の一覧の長さ）を出す。どちらも数字だけで、何を数えたかは
        見出しが名乗る（「一緒に使われる」の下なら一緒に使われた本数と読める）。
        総数と共通本数の両方は title が持つ (#3075) %>
    <%- partial('tendency-panels', {kind: 'tag', items: g.tags.map(function(t){
          return {name: t.name, path: t.path, title: note(g.kind, t),
                  note: `${g.kind === 'adjacent' ? t.co : t.posts}本`};
        })}) %>
    <% }) %>
  </section>
</aside>
<% } %>
