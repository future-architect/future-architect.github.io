<!-- START SIDEBAR  -->
<%# data-nosnippet: サイドバー（目次・カテゴリ）は全ページ共通または本文の
    再掲で、スニペットに出す価値が無い (#2359)。
    以前は全体を1枚の div で包んでいたが、その div の高さが目次の高さと同じに
    なり、中の position: sticky に動く余地が無かった (#2909)。節ごとに付ける %>
<%# 特設ページは本文が page.content でなくレイアウト側にあるため toc() が使えない。
    レイアウトから specialsToc（[{id, text}]）を受け取って目次を組む (#2345)。
    目次を出すページではページ内移動が主なので、カテゴリ一覧は出さない。
    Markdown のページは本文があるので、レイアウト側で組んだ目次の HTML を
    tocHtml で受け取る (#2559) %>
<% const sToc = (typeof specialsToc === 'undefined') ? null : specialsToc; %>
<%# tocHtml は空で渡ることがある（見出しが足りないページ）。その場合は目次の枠を
    出さない。tocOnly は「このサイドバーはページ自身の目次のための場所」という
    レイアウト側の宣言で、目次を出せるかどうかとは別に、カテゴリ一覧を抑える %>
<% const pageToc = (typeof tocHtml === 'undefined' || !tocHtml) ? null : tocHtml; %>
<% const isTocOnly = (typeof tocOnly !== 'undefined' && tocOnly) || !!sToc; %>
<%# 検索はヘッダー右上に昇格した (#2399)。二重の導線は置かない %>
<% if (is_post()) { %>
<section class="toc-section" data-nosnippet>
  <h2 class="margin-top-30">目次</h2>
  <%- toc(page.content, {list_number:false, max_depth:4}) %>
</section>
<% } %>
<% if (sToc) { %>
<section class="toc-section" data-nosnippet>
  <h2 class="margin-top-30">目次</h2>
  <%- partial('_partial/toc-list', {items: sToc}) %>
</section>
<% } %>
<% if (pageToc) { %>
<section class="toc-section" data-nosnippet>
  <h2 class="margin-top-30">目次</h2>
  <%- pageToc %>
</section>
<% } %>
<%# カテゴリとタグは記事ページでは出さない。記事を読んでいる最中のサイドバーでは
    目次と並んで導線が競合し、本文から目を逸らすノイズになる。
    記事からの回遊は、記事末の「関連記事」「この記事を参照している記事」が担う。
    タグ・著者のページでも出さない。読者は既にその軸で絞り込んでおり、
    別の軸の一覧を並べても意図がぼやける。検索窓は上で常に出している。
    カテゴリのページには残す。絞り込みの結果であると同時に、
    別のカテゴリへ移る導線を兼ねているため。
    目次のための場所（tocOnly）でも出さない。特設ページは記事とは別の空間で、
    目次がまだ出せないページ（見出しが1つ）でも扱いを揃える (#2559) %>
<% if (!is_post() && !is_tag() && !page.author && !isTocOnly) { %>
<section class="category" data-nosnippet>
<h2 class="margin-top-30">カテゴリー</h2>
<%- partial('_widget/category.ejs') %>
</section>
<%# 連載もブログ内の記事を見つける軸なので、カテゴリ・タグと同じ場所に置く (#2892)。
    646本（全記事の44%）を束ねていて、粗い軸から細い軸への順ではカテゴリとタグの間に入る
    （18カテゴリ → 78連載 → 714タグ）。全件でないことは見出しの「人気の」が名乗る (#2670) %>
<section class="sidebar-series" data-nosnippet>
<h2 class="margin-top-30">人気の連載</h2>
<%- partial('_widget/series.ejs') %>
<p class="more-link"><a href="/series/">連載一覧へ<%- partial('svg-icon', {icon: 'chevron-right', class_name: 'svg-icon-trailing'}).trim() %></a></p>
</section>
<%# タグはカテゴリと並べて置く (#2885)。どちらもブログ内の記事を見つける軸で、
    サイドバーの用途はそこに限る (#2880)。カテゴリを先にするのは粗い軸から
    細い軸への順。件数は theme.tag_display_max_count で、全件でないことは
    見出しの「人気の」が名乗る (#2670) %>
<section class="sidebar-tags" data-nosnippet>
<h2 class="margin-top-30">人気のタグ</h2>
<div class="blog-tags">
  <%- partial('_widget/tag.ejs') %>
</div>
<p class="more-link"><a href="/tags/">タグ一覧へ<%- partial('svg-icon', {icon: 'chevron-right', class_name: 'svg-icon-trailing'}).trim() %></a></p>
</section>
<% } %>
<% if (is_post() || sToc || pageToc) { %>
<%# 読んでいる節の目次の行に面を塗る (#2909)。見た目は CSS が持ち、ここは
    aria-current="location" を付け替えるだけ。目で見る読者・支援技術・機械の
    3方向に同じ違いを渡す形（パンくずの現在地 #2705 と同じ考え方）。

    このブログで2つ目のクライアント JS（1つ目は #2565 のリンクのコピー）。
    外部ライブラリは足さない。requestAnimationFrame が無い環境では何も起きず、
    目次はスクロールに反応しないだけで壊れない。

    **IntersectionObserver は使わない。** rootMargin で線を作ると「線より上」と
    「画面より下」がどちらも isIntersecting: false になり、最下部から先頭へ飛んだ
    ときに後ろの見出しがこの2状態の間を移動するだけでコールバックが呼ばれない。
    状態をキャッシュすると古い値が残り、最後の章が現在地に居座る。
    毎回その場で測る形にして状態を持たない。

    サイドバーの目次と本文前のモバイル目次は同じ見出しを指すので、
    行は見出しごとに束ねて両方に同じ印を付ける（幅で出ている方が変わるだけ） %>
<script>
  (function () {
    if (typeof Map !== 'function' || !window.requestAnimationFrame) return;
    var links = document.querySelectorAll('.toc-section a[href^="#"]');
    if (!links.length) return;

    // 見出し → その見出しを指す目次の行（サイドバーとモバイルで2本ある）
    var rows = new Map();
    Array.prototype.forEach.call(links, function (a) {
      var raw = a.hash.slice(1);
      if (!raw) return;
      var id = raw;
      // 目次の href は percent encode 済みだが、見出しの id は生の文字列
      try { id = decodeURIComponent(raw); } catch (e) { /* そのまま使う */ }
      var heading = document.getElementById(id);
      if (!heading) return;
      if (!rows.has(heading)) rows.set(heading, []);
      rows.get(heading).push(a);
    });
    if (!rows.size) return;

    var headings = [];
    rows.forEach(function (_, heading) { headings.push(heading); });
    headings.sort(function (a, b) {
      // 4 は DOCUMENT_POSITION_FOLLOWING
      return a.compareDocumentPosition(b) & 4 ? -1 : 1;
    });

    // 画面の上から 32px の線を越えた見出しを「読み始めた」とみなす。
    // 帯は追従しないので、送った後の画面の上端が基準になる。
    //
    // **線は「見出しから次の見出しまでの最小距離」より浅くする。** 目次の行を
    // クリックすると見出しが画面の上端（top 0）へ来るので、線が深いと次の見出しも
    // 線より上に入り、次の節が現在地になってしまう。CSS の値から出した最小距離は
    // h4 の直後に h4 が来る 46px（h3→h4 が 49px、h2→h3 が 72px）
    var LINE = 32;
    var current = null;
    var queued = false;

    var mark = function (heading, on) {
      rows.get(heading).forEach(function (a) {
        if (on) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    };

    var pick = function () {
      // 最下部では最後の見出しを現在地にする。そこから先へは送れないので、
      // 最後の節が画面より短い記事では線まで上がってこない
      var doc = document.documentElement;
      if (window.innerHeight + window.pageYOffset >= doc.scrollHeight - 4) {
        return headings[headings.length - 1];
      }
      // 文書順に並んでいるので、線より下に出たらそれ以降は全部下にある
      var found = null;
      for (var i = 0; i < headings.length; i++) {
        if (headings[i].getBoundingClientRect().top >= LINE) break;
        found = headings[i];
      }
      return found;
    };

    var update = function () {
      queued = false;
      var found = pick();
      if (found === current) return;
      if (current) mark(current, false);
      if (found) mark(found, true);
      current = found;
    };

    var schedule = function () {
      if (queued) return;
      queued = true;
      window.requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    // 画像や図の読み込みで位置が動く／ハッシュ付きで開かれた場合に測り直す
    window.addEventListener('load', schedule);
    window.addEventListener('hashchange', schedule);
  })();
</script>
<% } %>
<%# そのページ自身の統計 (#2911)。カテゴリ・タグ・著者の1ページ目にだけ出す。
    #2880 の「サイドバーは記事を見つける軸だけ」は他の軸の一覧を並べない規則で、
    そのページ自身の数字はそれには当たらない。
    カテゴリページでは軸（カテゴリー・人気の連載・人気のタグ）の後ろに置く。
    軸がサイドバーの主目的で、統計は添え %>
<%# 呼び出し側が showStats で宣言する。page.author は記事ページのフロントマターにも
    あり、page.category は「◯◯以外の記事」（自前の集計を持つ）にもあるので、
    ページの種類をここで当てにしない %>
<% if ((typeof showStats !== 'undefined' && showStats) && page.current === 1) { %>
<%- partial('sidebar-stats') %>
<% } %>
<!-- END SIDEBAR -->
