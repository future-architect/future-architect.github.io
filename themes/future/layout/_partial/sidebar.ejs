<!-- START SIDEBAR  -->
<%# data-nosnippet: サイドバー（検索窓・目次・カテゴリ・Tech Cast・アドベント
    カレンダー）は全ページ共通または本文の再掲で、スニペットに出す価値が無い (#2359) %>
<div data-nosnippet>
<%# 特設ページは本文が page.content でなくレイアウト側にあるため toc() が使えない。
    レイアウトから specialsToc（[{id, text}]）を受け取って目次を組む (#2345)。
    目次を出すページではページ内移動が主なので、カテゴリ一覧は出さない。
    Markdown のページは本文があるので、レイアウト側で組んだ目次の HTML を
    tocHtml で受け取る (#2559) %>
<% const sToc = (typeof specialsToc === 'undefined') ? null : specialsToc; %>
<%# tocHtml は空で渡ることがある（見出しが足りないページ）。その場合は目次の枠を
    出さない。tocOnly は「このサイドバーはページ自身の目次のための場所」という
    レイアウト側の宣言で、目次を出せるかどうかとは別に、カテゴリ一覧を抑える %>
<% const pageToc = (typeof tocHtml === 'undefined' || !tocHtml) ? null : tocHtml; %>
<% const isTocOnly = (typeof tocOnly !== 'undefined' && tocOnly) || !!sToc; %>
<%# 検索はヘッダー右上に昇格した (#2399)。二重の導線は置かない %>
<% if (is_post()) { %>
<section class="toc-section">
  <h2 class="margin-top-30">目次</h2>
  <%- toc(page.content, {list_number:false, max_depth:4}) %>
</section>
<% } %>
<% if (sToc) { %>
<section class="toc-section">
  <h2 class="margin-top-30">目次</h2>
  <ol class="toc">
    <% sToc.forEach(function(item){ %>
    <li class="toc-item toc-level-2"><a class="toc-link" href="#<%= item.id %>"><span class="toc-text"><%= item.text %></span></a></li>
    <% }) %>
  </ol>
</section>
<% } %>
<% if (pageToc) { %>
<section class="toc-section">
  <h2 class="margin-top-30">目次</h2>
  <%- pageToc %>
</section>
<% } %>
<%# カテゴリは記事ページでは出さない。記事を読んでいる最中のサイドバーでは
    目次と並んで導線が競合し、本文から目を逸らすノイズになる。
    記事からの回遊は、記事末の「関連記事」「この記事を参照している記事」が担う %>
<% if (!is_post()) { %>
<%# タグ・著者のページでも出さない。読者は既にその軸で絞り込んでおり、
    別の軸の一覧を並べても意図がぼやける。検索窓は上で常に出している。
    カテゴリのページには残す。絞り込みの結果であると同時に、
    別のカテゴリへ移る導線を兼ねているため。
    目次のための場所（tocOnly）でも出さない。特設ページは記事とは別の空間で、
    目次がまだ出せないページ（見出しが1つ）でも扱いを揃える (#2559) %>
<% if (!is_tag() && !page.author && !isTocOnly) { %>
<section class="category">
<h2 class="margin-top-30">カテゴリー</h2>
<%- partial('_widget/category.ejs') %>
</section>
<% } %>
<%# Tech Cast はホームの1ページ目だけに出す。アドベントカレンダーと同じ
    扱い（#2016）。カテゴリ・タグ・著者のページを見ている読者はすでに
    絞り込みを終えており、ホームの2ページ目以降も新着記事を繰っている
    最中なので、別の入口を出すと意図がぼやける。PC / モバイルを問わない。
    モバイルでは更新が止まっていることも踏まえて一律に隠しており、
    そちらは CSS（.podcast-link のメディアクエリ）で処理している %>
<% if (is_home() && page.current === 1) { %>
<section class="podcast-link">
<h2 class="margin-top-30">Tech Cast</h2>
<%- partial('_widget/techcast.ejs') %>
</section>
<% } %>
<%# アドベントカレンダーはホームの1ページ目だけに出す。
    カテゴリ・タグ・著者のページを見ている読者は、すでに自分で絞り込んだ
    状態で記事を探している。そこへ Qiita の外部リンク11本を並べると意図が
    ぼやける。ホームの2ページ目以降も、新着記事をページで繰っている最中で
    同じことが言える %>
<% if (is_home() && page.current === 1) { %>
<section class="advent-calendar">
<h2 class="margin-top-30">アドベントカレンダー</h2>
<%- partial('_widget/advent-calendar.ejs') %>
</section>
<% } %>
<% } %>
</div>
<!-- END SIDEBAR -->
