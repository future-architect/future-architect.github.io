<%# 統計タイル (#2999)。items は [{value, label, sub}] で渡す。
    sub は内訳の印で、総シェア数に対する X / Facebook / はてブ / Pocket のように
    一段下げて従属を示す (#2096)。

    variant: 'row' を渡すと数値とラベルを同じ行に並べる。サイドバーは列の内寸が
    208〜298px しかなく、タイル（数値の下にラベル）を横に並べられない (#2911)。
    クラスと大きさの段は本文のタイルと共有していて、変えるのは <br> の有無だけ。

    **引数名に layout は使えない。** Hexo がレイアウト名として持っている予約語で、
    partial に渡しても届かない（渡したつもりでタイルのまま描かれる） %>
<% const summaryRow = typeof variant !== 'undefined' && variant === 'row'; %>
<ul class="summary">
  <% items.forEach(function(r){ %>
  <li<%- r.sub ? ' class="summary-sub"' : '' %>><span class="summary-count"><%= r.value %></span><%- summaryRow ? '' : '<br>' %><span class="summary-label"><%= r.label %></span></li>
  <% }) %>
</ul>
