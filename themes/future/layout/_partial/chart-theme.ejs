<%# グラフの文字と軸をテーマに追従させる (#2746)。
    **echarts の option では CSS 変数を参照できない**（値は JavaScript 側にある）ので、
    :root から実効値を読んで option に流し込む。読み取りは描画時と、
    テーマを切り替えたときの2回だけ。

    各チャートは setOption のあとに themeChart(インスタンス) を1回呼ぶ。
    どの色を使うかをここが1箇所で決めるので、チャートごとに散らない %>
<script>
  window.themeChart = (function () {
    var charts = [];
    // トークンは light-dark() で両方の値を持つので、変数のまま読むと
    // 「light-dark(…, …)」の文字列が返る。要素の色として解決させてから読む
    var probe;
    function tokens() {
      if (!probe) {
        probe = document.createElement('span');
        probe.hidden = true;
        probe.style.color = 'var(--ink-mute)';
        probe.style.backgroundColor = 'var(--rule-base)';
        document.body.appendChild(probe);
      }
      var s = getComputedStyle(probe);
      return { text: s.color, line: s.backgroundColor };
    }
    // 元の option が凡例を持っているか。**持っていないチャートに legend を渡すと、
    // echarts がそこで凡例を作ってしまう**（既定は show: true で系列名を全部出す）。
    // サイドバーのグラフは系列が1本なので凡例を出していない (#2911)
    // 軸も同じで、円グラフに xAxis / yAxis を渡すと軸が生える
    function has(chart, key) {
      var v = (chart.getOption() || {})[key];
      return Array.isArray(v) && v.length > 0;
    }
    function apply(chart, parts) {
      var t = tokens();
      // 既存の option に重ねる。系列の色は触らない（カテゴリ色は #2170 で固定）
      var option = { textStyle: { color: t.text } };
      if (parts.axis) {
        option.xAxis = { axisLabel: { color: t.text }, axisLine: { lineStyle: { color: t.line } } };
        option.yAxis = { axisLabel: { color: t.text }, splitLine: { lineStyle: { color: t.line } } };
      }
      if (parts.legend) option.legend = { textStyle: { color: t.text } };
      // 円グラフの扇の外の名前は textStyle を継がない。系列は順番で重なるので、
      // 円でない系列には空のオブジェクトを渡して位置だけ合わせる
      if (parts.pie) {
        option.series = chart.getOption().series.map(function (s) {
          return s.type === 'pie' ? { label: { color: t.text } } : {};
        });
      }
      chart.setOption(option);
    }
    document.addEventListener('themechange', function () {
      charts.forEach(function (c) {
        apply(c.chart, c);
      });
    });
    return function (chart) {
      if (!chart) return;
      // 凡例の有無は最初に1度だけ見る。apply の後は自分が足した legend が
      // getOption に出るので、毎回見ると判定が変わる
      var entry = { chart: chart, legend: has(chart, 'legend'), axis: has(chart, 'xAxis'),
        pie: (chart.getOption().series || []).some(function (s) { return s.type === 'pie'; }) };
      charts.push(entry);
      apply(entry.chart, entry);
    };
  })();
</script>
