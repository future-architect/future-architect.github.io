<!-- シェアボタン START -->
<%# 記事末と一覧カードのシェアボタン (#2716)。

    ブランド色は使わずサイトの語彙で描く。アイコンはネイビー、枠は rule-base。
    サービスの区別はアイコンの形が担うので、文字のラベルは出さない。
    シェア数は枠の外（ボタンの下）に小さく出す。読者にとっては「どれくらい
    読まれていそうか」の判断材料で、一覧の♡（総シェア数）の明細に当たる。
    0 のときは出さない（旧実装は 0 のときサービス名を出していた）。

    ロゴは塗り（fill）のインラインSVGで、色は currentColor で追従させる。
    以前は通常時と hover 時の2枚を base64 で持っていて、色の定義が
    サービスごとに2箇所あった。`.svg-icon`（#2306）は線画の Tabler 用なので
    こちらには使わない %>
<%
  const SHARE_ICONS = {
    x: {
      viewBox: '0 0 1200 1227',
      paths: ['M714.163 519.284L1160.89 0H1055.03L667.137 450.887L357.328 0H0L468.492 681.821L0 1226.37h105.866L515.491 750.218L842.672 1226.37H1200L714.137 519.284H714.163ZM658.88 583.579L569.165 687.828L892.476 1150.301H1055.08L658.88 583.579ZM611.412 515.685L306.615 79.6944H144.011L521.697 619.934L611.412 515.685Z'],
    },
    facebook: {
      viewBox: '0 0 12.8 24',
      transform: 'translate(-31.455 -20.239)',
      paths: ['M39.763,44.239V33.292h3.774l.565-4.266H39.763V26.3c0-1.235.352-2.077,2.171-2.077h2.32V20.407a31.887,31.887,0,0,0-3.381-.168c-3.345,0-5.635,1.988-5.635,5.64v3.146H31.455v4.266h3.783V44.239Z'],
    },
    hatebu: {
      viewBox: '0 0 355.004 300',
      paths: [
        'M280.009,0h70v200.005h-70V0z',
        'M215.192,160.596c-11.844-13.239-28.314-20.683-49.443-22.288c18.795-5.122,32.443-12.616,41.077-22.628c8.593-9.88,12.856-23.292,12.856-40.171c0-13.362-2.922-25.184-8.579-35.397c-5.805-10.152-14.14-18.276-25.102-24.357c-9.586-5.274-20.98-8.994-34.262-11.188c-13.349-2.126-36.709-3.198-70.231-3.198H0V298.63h83.976c33.737,0,58.064-1.182,72.94-3.441c14.863-2.337,27.334-6.27,37.428-11.662c12.484-6.587,22.007-15.964,28.662-28.01c6.698-12.085,10.014-26.02,10.014-41.956C233.017,191.514,227.079,173.798,215.192,160.596z M75.26,67.27h17.398c20.108,0,33.617,2.267,40.59,6.787c6.877,4.542,10.388,12.38,10.388,23.547c0,10.745-3.733,18.313-11.118,22.751c-7.483,4.354-21.117,6.562-41.079,6.562H75.26V67.27z M144.276,237.733c-7.916,4.862-21.557,7.251-40.696,7.251H75.265v-64.949h29.54c19.654,0,33.243,2.475,40.469,7.414c7.343,4.942,10.955,13.665,10.955,26.191C156.226,224.85,152.263,232.899,144.276,237.733z',
        'M315.014,220.003c-22.101,0-40.002,17.891-40.002,39.991c0,22.1,17.902,40.006,40.002,40.006c22.072,0,39.99-17.906,39.99-40.006C355.004,237.894,337.088,220.003,315.014,220.003z',
      ],
    },
    pocket: {
      viewBox: '75.247 261.708 445.529 401.074',
      paths: ['M114.219 261.708c-24.275 1.582-38.972 15.44-38.972 40.088v147.611c0 119.893 119.242 214.114 222.393 213.37 115.986-.837 223.137-98.779 223.137-213.37V301.796c0-24.741-15.626-38.693-40.088-40.088h-366.47zm93.943 120.079L297.64 466.8l89.571-85.013c40.088-16.835 57.574 28.927 41.111 42.321L311.685 535.443c-3.813 3.628-24.183 3.628-27.996 0L167.051 424.107c-15.72-14.789 4.743-61.295 41.111-42.32z'],
    },
  };
%>
  <ul class="social-button">
    <%# いいね (#1949)。共有の丸と同じ行の左端に置く。外へ出す導線ではなく
        「ここに残す」操作なので、丸の列との間を一段広く空ける。
        器・ボタン・数字は共有ボタンと同じ部品（.share-item / .share-btn /
        .share-count）で、違うのは横幅だけ。丸ではなく横長の錠剤にして、
        役が違うことを形で示す。

        コピー (#2565) と同じく li に hidden を付けておき、script が外す。
        押しても何も起きないボタンを見せない（送り先が未設定なら出さない）。
        数は like_count_cache.json から焼き込むので、表示のために
        読者のブラウザが数を読みに行くことはない %>
    <% const likeId = (typeof actions !== 'undefined' && actions) ? like_post_id(post) : ''; %>
    <% if (likeId) { %>
    <% const likes = like_count(likeId); %>
    <li class="share-item like-item" data-like-id="<%= likeId %>" hidden>
      <%# 押す前の名前は title（OSのツールチップ）と sr-only が持つ。件数は
          共有ボタンと同じく読み上げ名に畳む (#3066)。

          押した後は title を外す。すでに押したボタンに「いいね」と出ても
          意味が無く、下の礼の吹き出しと二重にも見える %>
      <button type="button" class="share-btn like-button" aria-pressed="false" title="いいね">
        <%- partial('svg-icon', {icon: 'clap', class_name: 'like-icon-outline'}) %>
        <%- partial('svg-icon', {icon: 'clap-filled', class_name: 'like-icon-filled'}) %>
        <span class="sr-only like-sr">いいね<%= likes ? `（${likes}件）` : '' %></span>
      </button>
      <%# 押した瞬間に上へ抜ける +1 と、その後に一度だけ出す礼。
          礼の形はコピーの「コピーしました」と1つのルールを共有する %>
      <%# 叩いたときの祝い。光と点の2枚を ::before / ::after で持つので DOM は1つ %>
      <span class="like-burst" aria-hidden="true"></span>
      <%# 入れた数の札。1つだけ、決まった場所に出る %>
      <span class="like-plus" aria-hidden="true">+1</span>
      <%# 浮かぶ風船のひな型。叩くたびに複製して飛ばすので、前のが残っていても消えない %>
      <span class="like-float" aria-hidden="true"></span>
      <span class="share-copied like-thanks" aria-hidden="true">ありがとうございました！</span>
      <span class="share-copied like-hold" aria-hidden="true">長押しでキャンセルします</span>
      <%# 0 のときは共有の数字と同じく出さない %>
      <span class="share-count like-count" aria-hidden="true"<%= likes ? '' : ' hidden' %>><%= likes %></span>
    </li>
    <% } %>
    <%
        let link = full_url_for(path).replace("index.html", "");
        let title = "";

        // Pocketのサービス終了日
        const pocketExpiryDate = new Date('2025-07-08');
        // 判定用の基準日（デフォルトはビルド時の現在時刻）
        let targetDate = new Date();

        if (typeof post !== 'undefined') {
            link = post.permalink;
            title = post.title;
            // 記事ページの場合は、基準日を「記事の公開日」で上書きする
            if (post.date) {
                targetDate = new Date(post.date);
            }
        }

        const shares = [
          {
            icon: 'x',
            label: 'Xでポストする',
            unit: 'ポスト',
            count: get_x_count(link),
            href: 'https://twitter.com/intent/tweet?url=' + link
              + '&related=twitterapi%2Ctwitter&text=' + encodeURIComponent(title + " | フューチャー技術ブログ"),
          },
          {
            icon: 'facebook',
            label: 'Facebookでシェアする',
            unit: 'シェア',
            count: get_fb_count(link),
            href: 'http://www.facebook.com/share.php?u=' + link + '&t=' + encodeURIComponent(title),
          },
          {
            icon: 'hatebu',
            // リンク先は追加フォームではなくエントリーページなので「見る」
            label: 'はてなブックマークで見る',
            unit: 'ブックマーク',
            count: get_hatebu_count(link),
            href: 'https://b.hatena.ne.jp/entry/s/' + encodeURI(link).replace('https://', ''),
          },
        ];
        // Pocket はサービス終了。終了日より前に公開した記事にだけ残す
        if (targetDate < pocketExpiryDate) {
          shares.push({
            icon: 'pocket',
            label: 'Pocketに保存する',
            unit: '保存',
            count: get_pocket_count(link),
            href: 'https://getpocket.com/save?url=' + encodeURI(link),
          });
        }
    %>
    <% shares.forEach(function(s){ %>
    <% const svg = SHARE_ICONS[s.icon]; %>
    <li class="share-item">
      <%# title はマウス向けの補足、sr-only は読み上げ向けの名前。数字だけが
          リンク名になっていた（「8」というリンクに聞こえる）のを直す。
          数字は枠の外に置くのでリンクの外だが、読み上げでは名前に含める %>
      <a class="share-btn" href="<%- s.href %>" rel="nofollow" title="<%= s.label %>">
        <svg class="share-btn-icon" viewBox="<%= svg.viewBox %>" fill="currentColor" aria-hidden="true"><% if (svg.transform) { %><g transform="<%= svg.transform %>"><% } %><% svg.paths.forEach(function(d){ %><path d="<%= d %>"/><% }) %><% if (svg.transform) { %></g><% } %></svg>
        <%# 一覧では25枚が同じ名前で行き先だけ違うので記事名を足す (#3066)。
            記事ページは1組しか無く、直上の h1 が記事を名乗るので足さない %>
        <% const srName = is_post() ? s.label : `${s.label}：${title}`; %>
        <span class="sr-only"><%= srName %><%= s.count ? `（${s.count}${s.unit}）` : '' %></span>
      </a>
      <% if (s.count) { %><span class="share-count" aria-hidden="true"><%= s.count %></span><% } %>
    </li>
    <% }) %>
    <%# リンクのコピー (#2565)。記事ページだけに出す（呼び出し側が actions を
        渡す）。一覧は次に読む記事を選ぶ場所で、共有はまだ起きない。

        JS を使うのはこのブログで2つ目の例外（1つ目は #1949 のいいね）。
        Clipboard API は JS 無しでは呼べない。外部ライブラリは足さず、
        素の navigator.clipboard を使う。

        **他アプリへの共有（navigator.share）は置かない。** モバイルの
        ブラウザは共有シートをツールバー／メニューに最初から持っており、
        ページ側に置いても同じ機能が二重になるだけ。コピーの方は
        ブラウザ UI からだと共有シート経由で2手かかるので、ここに置く意味がある。

        li に hidden を付けておき、対応している環境でだけ script が外す。
        押しても何も起きないボタンを見せない（クリップボードへの書き込みは
        https と localhost だけ）。li 側に付けるのは、button だけ隠すと
        空の li が ul の gap を作って並びに穴があくため %>
    <% if (typeof actions !== 'undefined' && actions) { %>
    <li class="share-item" data-share-action="copy" hidden>
      <button type="button" class="share-btn" title="リンクをコピーする">
        <%- partial('svg-icon', {icon: 'link'}) %>
        <span class="share-icon-done"><%- partial('svg-icon', {icon: 'check'}) %></span>
        <%# aria-live で、コピーしたことを読み上げに伝える %>
        <span class="sr-only" aria-live="polite">リンクをコピーする</span>
      </button>
      <%# 押したことが見えるように吹き出しを出す。読み上げには上の sr-only が
          伝えるので、こちらは aria-hidden にして二重に読ませない %>
      <span class="share-copied" aria-hidden="true">コピーしました</span>
    </li>
    <% } %>
  </ul>
<% if (typeof actions !== 'undefined' && actions) { %>
<script>
  (function () {
    var url = <%- JSON.stringify(link) %>;
    var enable = function (name, handler) {
      var item = document.querySelector('[data-share-action="' + name + '"]');
      if (!item) return;
      item.hidden = false;
      item.querySelector('button').addEventListener('click', handler);
    };
    // いいね (#1949)。送り先が設定されていなければボタンごと出さない
    var likeEndpoint = <%- JSON.stringify(theme.likes_endpoint || '') %>;
    var likeItem = document.querySelector('.like-item');
    if (likeItem && likeEndpoint && window.fetch) {
      // 1人が入れられるのは3つまで（Medium の拍手と同じ形）。上限まで入れた後は
      // 長押し（キーボードはもう一度押す）で取り消す
      var LIKE_MAX = 3;
      // 長押しは案内を出してから、もう一拍おいて取り消す。押し始めた瞬間に
      // 消えると取り返しがつかない
      var LIKE_HOLD_HINT = 250;
      var LIKE_HOLD = 1000;
      // 風船は叩き終わってからしばらく残す
      var LIKE_PLUS_HOLD = 900;
      // 連打はまとめて1回送る。1つずつ送ると KV の書き込み（無料枠は1日1000）を
      // 3倍消費する。読者には押した瞬間に数が動くので待ち時間は見えない
      var LIKE_FLUSH = 800;

      var likeId = likeItem.dataset.likeId;
      var likeBtn = likeItem.querySelector('.like-button');
      var likeCount = likeItem.querySelector('.like-count');
      var likeSr = likeItem.querySelector('.like-sr');
      var likeThanks = likeItem.querySelector('.like-thanks');
      var likePlus = likeItem.querySelector('.like-plus');
      var likeHold = likeItem.querySelector('.like-hold');
      var likeBurst = likeItem.querySelector('.like-burst');
      var likeFloat = likeItem.querySelector('.like-float');
      var likeKey = 'liked:' + likeId;

      // 何個入れたかは端末が覚える。別ブラウザやシークレットウィンドウからは
      // また入れられるが、認証を持たない以上そこまでしか防げない
      var mine = 0;
      try { mine = Math.min(LIKE_MAX, Number(localStorage.getItem(likeKey)) || 0); } catch (e) {}
      var pending = 0;
      var flushTimer = null;
      var plusTimer = null;
      var thanked = mine > 0;
      var held = false;
      var holdTimer = null;
      var hintTimer = null;
      var thanksTimer = null;
      var thanksHideTimer = null;

      // 同じクラスを付け直すだけでは再生されない。外して1回レイアウトさせる
      var replay = function (el, name) {
        el.classList.remove(name);
        void el.offsetWidth;
        el.classList.add(name);
      };
      // 風船は叩くたびに撃ち直さない。1つが浮いたまま数字だけ差し替わり、
      // 叩き終わってから消える。撃ち直すと連打で数字が次々に流れて落ち着かない
      // 1つ目・2つ目・3つ目で祝いを一段ずつ強くする。強さは li の
      // is-level-N が持ち、CSS 変数で跳ねと光と点にまとめて効かせる
      var setLevel = function () {
        likeItem.classList.remove('is-level-1', 'is-level-2', 'is-level-3');
        if (mine > 0) likeItem.classList.add('is-level-' + Math.min(mine, LIKE_MAX));
      };
      // 礼と長押しの案内は同じ場所に出るので重ねない
      var hideThanks = function () {
        clearTimeout(thanksTimer);
        clearTimeout(thanksHideTimer);
        likeThanks.classList.remove('is-thanks');
      };
      // 浮かぶ風船は1つずつ別の要素にして飛ばす。使い回すと、前のが浮いている間に
      // 次を出したときに前のが消える。**札（+3）はここに含めない**——数字が
      // 散らばって重なると、そのぶん送られたように読めてしまう
      // 札を避けて左右へ広く散らす。0 の近くを混ぜると札の真下で渋滞する
      var FLOAT_DX = [-26, 22, -34, 30, -18, 38, -30, 26];
      var FLOAT_SIZE = [7, 5, 9, 6, 8];
      var floatCount = 0;
      var launchFloat = function () {
        // 段が上がるほど数を増やす
        for (var i = 0; i < Math.min(mine, LIKE_MAX); i++) {
          (function () {
            var el = likeFloat.cloneNode(false);
            el.style.setProperty('--dx', FLOAT_DX[floatCount % FLOAT_DX.length] + 'px');
            el.style.setProperty('--size', FLOAT_SIZE[floatCount % FLOAT_SIZE.length] + 'px');
            el.style.setProperty('--delay', (floatCount % 3) * 60 + 'ms');
            floatCount++;
            el.classList.add('is-rising');
            likeItem.appendChild(el);
            // 動きを止める設定ではアニメーションが走らないので、時間で片づける
            setTimeout(function () { el.remove(); }, 1800);
          })();
        }
      };
      var showPlus = function () {
        launchFloat();
        // 札が出るのは3つ目に届いたときだけ。1つだけを決まった場所に出す
        if (mine >= LIKE_MAX) {
          likePlus.textContent = '+' + mine;
          // 出ている間にもう一度叩かれたら、出し直さずに小さく揺らす
          if (likePlus.classList.contains('is-shown')) replay(likePlus, 'is-shaking');
          else likePlus.classList.add('is-shown');
        }
        // 待ちは毎回引き直す。礼はここが引き金なので、3つ入れなくても出る
        clearTimeout(plusTimer);
        plusTimer = setTimeout(function () {
          likePlus.classList.remove('is-shown', 'is-shaking');
          // 礼は叩き終わってから
          if (!thanked) {
            thanked = true;
            thanksTimer = setTimeout(function () {
              // 長押しの案内が出ている間は出さない
              if (likeHold.classList.contains('is-holding')) return;
              likeThanks.classList.add('is-thanks');
              thanksHideTimer = setTimeout(function () {
                likeThanks.classList.remove('is-thanks');
              }, 2000);
            }, 250);
          }
        }, LIKE_PLUS_HOLD);
      };
      var showCount = function (n) {
        likeCount.textContent = String(n);
        likeCount.hidden = n <= 0;
        likeSr.textContent = 'いいね' + (n > 0 ? '（' + n + '件）' : '')
          + (mine >= LIKE_MAX ? '。もう一度押すと取り消します' : '');
      };
      var paint = function () {
        likeBtn.setAttribute('aria-pressed', mine > 0 ? 'true' : 'false');
        if (mine > 0) likeBtn.removeAttribute('title');
        else likeBtn.setAttribute('title', 'いいね');
      };
      var remember = function () {
        try {
          if (mine > 0) localStorage.setItem(likeKey, String(mine));
          else localStorage.removeItem(likeKey);
        } catch (e) {}
      };

      var send = function () {
        var delta = pending;
        if (!delta) return;
        pending = 0;
        fetch(likeEndpoint + '/like/' + likeId + '?n=' + delta, { method: 'POST' })
          .then(function (res) { return res.ok ? res.json() : Promise.reject(res.status); })
          .then(function (data) {
            mine = data.mine;
            showCount(data.likes);
            remember();
            paint();
          })
          .catch(function () {
            // 届かなかったので見た目も戻す
            mine = Math.max(0, mine - delta);
            showCount(Math.max(0, (Number(likeCount.textContent) || 0) - delta));
            remember();
            paint();
          });
      };

      likeBtn.addEventListener('click', function (event) {
        // キーボードで起こしたクリックは detail が 0。上限まで入れた後の
        // 長押しは指でしかできないので、キーボードはもう一度押すと取り消しにする
        if (held) { held = false; return; }
        if (mine >= LIKE_MAX) {
          if (event.detail === 0) { cancel(); return; }
          // 上限に届いた後も叩ける。増えるのは見た目だけで、風船は
          // 「いくつ入れたか」を出しているので +3 のまま出続ける
          setLevel();
          replay(likeBtn, 'is-liking');
          replay(likeBurst, 'is-bursting');
          showPlus();
          return;
        }

        // 叩いた瞬間に跳ねと風船を返す。往復を待たせると入ったかが分からない
        mine += 1;
        pending += 1;
        showCount((Number(likeCount.textContent) || 0) + 1);
        remember();
        paint();
        setLevel();
        replay(likeBtn, 'is-liking');
        replay(likeBurst, 'is-bursting');
        showPlus();

        clearTimeout(flushTimer);
        flushTimer = setTimeout(send, LIKE_FLUSH);
      });

      var cancel = function () {
        if (mine <= 0) return;
        hideThanks();
        clearTimeout(plusTimer);
        likePlus.classList.remove('is-shown', 'is-shaking');
        Array.prototype.forEach.call(likeItem.querySelectorAll('.like-float.is-rising'), function (el) {
          el.remove();
        });
        likeItem.classList.remove('is-level-1', 'is-level-2', 'is-level-3');
        var back = mine;
        clearTimeout(flushTimer);
        pending = 0;
        mine = 0;
        thanked = false;
        showCount(Math.max(0, (Number(likeCount.textContent) || 0) - back));
        remember();
        paint();
        fetch(likeEndpoint + '/unlike/' + likeId, { method: 'POST' })
          .then(function (res) { return res.ok ? res.json() : Promise.reject(res.status); })
          .then(function (data) { mine = data.mine; showCount(data.likes); remember(); paint(); })
          .catch(function () { mine = back; showCount((Number(likeCount.textContent) || 0) + back); remember(); paint(); });
      };

      // 長押しで取り消し。1つでも入れていれば効く。何が起きるかを先に見せてから、
      // もう一拍おいて実行する
      likeBtn.addEventListener('pointerdown', function () {
        if (mine <= 0) return;
        hintTimer = setTimeout(function () {
          hideThanks();
          likeHold.classList.add('is-holding');
        }, LIKE_HOLD_HINT);
        holdTimer = setTimeout(function () {
          likeHold.classList.remove('is-holding');
          held = true;
          cancel();
        }, LIKE_HOLD);
      });
      ['pointerup', 'pointerleave', 'pointercancel'].forEach(function (type) {
        likeBtn.addEventListener(type, function () {
          clearTimeout(hintTimer);
          clearTimeout(holdTimer);
          likeHold.classList.remove('is-holding');
        });
      });

      setLevel();
      paint();
      likeItem.hidden = false;
    }

    // 書き込みは https（と localhost）でしか許可されない
    if (navigator.clipboard && window.isSecureContext) {
      enable('copy', function () {
        var button = this;
        navigator.clipboard.writeText(url).then(function () {
          // アイコンをチェックに差し替え、読み上げにも結果を伝える。
          // 2秒で元に戻す（押した合図としてはこれで足りる）
          button.classList.add('is-copied');
          button.title = 'リンクをコピーしました';
          button.querySelector('.sr-only').textContent = 'リンクをコピーしました';
          setTimeout(function () {
            button.classList.remove('is-copied');
            button.title = 'リンクをコピーする';
            button.querySelector('.sr-only').textContent = 'リンクをコピーする';
          }, 2000);
        });
      });
    }
  })();
</script>
<% } %>
<!-- シェアボタン END -->
