<%# 一覧を絞り込む2択（#2038 の「◯◯以外の記事」）。items は {label, count, url, current}。
    行き先は別の URL なので、その場で切り替わるタブの形にしない。
    いま見ている側はリンクにせず、太さで示す（パンくずの現在地と同じ #2722） %>
<ul class="list-filter" aria-label="絞り込み">
  <% items.forEach(function(item){ %>
  <li><% if (item.current) { %><span class="list-filter-current" aria-current="<%= page.current > 1 ? 'true' : 'page' %>"><% } else { %><a href="<%- url_for(item.url) %>"><% } %><%= item.label %><span class="list-filter-count"><%= item.count %>本</span><% if (item.current) { %></span><% } else { %></a><% } %></li>
  <% }) %>
</ul>
