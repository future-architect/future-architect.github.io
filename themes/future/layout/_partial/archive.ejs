<%# ホームの1ページ目だけ、ランキングを記事リストより前に出す。
    ホームに来る読者は「どんな記事があるか」をざっと掴みたいのであって、
    公開順の先頭から読みたいわけではない %>
<% const isHome = is_home(); %>
<% const isHomeFirst = isHome && page.current === 1; %>
<% if (isHomeFirst) { %>
  <section class="popular-articles home-ranking">
      <%- partial('section-heading', {id: 'popular', text: 'よく読まれている記事'}) %>
      <div class="margin-bottom-20 nav tabs" role="radiogroup" aria-label="ランキングの期間">
        <input id="monthly" type="radio" name="tab_item" checked>
        <label class="tab_item" for="monthly">トレンド<%- partial('tab-hint') %></label>
        <input id="yearly" type="radio" name="tab_item">
        <label class="tab_item" for="yearly">年間人気<%- partial('tab-hint') %></label>
        <%# 2枚を同じマスに重ねて、枠の高さを常に両者の最大にする。
            タブを切り替えると下のセクションが上下に動いていた (#2683) %>
        <div class="tab-stack">
          <div class="tab_content" id="popular_monthly">
            <%- popular_posts('monthly') %>
          </div>
          <div class="tab_content" id="popular_yearly">
            <%- popular_posts('yearly') %>
          </div>
        </div>
      </div>
  </section>
<% } %>
<%# はじめて来た読者は記事の探し方が分からない。ランキングと新着の間に
    まとまった読み物への入口を置く (#2039)。
    カテゴリ・タグ・連載という「探す軸」はサイドバーが持つ (#2885 / #2892)。
    ここに出すのは軸ではなく、いま動いているもの2枚 %>
<% if (isHomeFirst) { %>
  <%# 特設ページへの入口 (#2295 / #2421)。テキスト1行では視線が滑るため
      パネルにする (#2343)。外部サイトへ直接飛ばさず、サイト内のポータルを
      紹介する（説明と外部サイトへの分岐はポータル側が担う）。
      全件は /specials/ が持つので、ここに並べるのは2枚まで。
      残りは下の全件導線から辿る %>
  <%# 並べる2枚は旬で決める (#2880)。季節もの（アドベントカレンダー・Tech Cast・HTTF）が
      前に入り、いつでも出せる連載とガイドラインが後ろから落ちる。
      季節ものの間はシーズンの長さの順で、常設のうち連載を先に置くのは
      旬のものが1枚も無い期間を無くすため (#2892)。
      以前は HTTF が無条件に入っていて、オフシーズンでも枠を1つ取っていた %>
  <%
    // カレンダーの年を advent_calendar.yml に足す作業がそのままスイッチになる。
    // 年が変われば一致しなくなるので、シーズンの終わりを別に持たなくてよい
    const calendars = site.data.advent_calendar || [];
    const adventYear = calendars.length ? Number(calendars[0].year) : null;
    // HTTF も同じ形。回の年は開催年の翌年なので（2026年の回は2025年11月開催）、
    // 年が今年に追いつくまでが開催中。httf.yml へ1行足す作業がスイッチになる
    const contests = site.data.httf || [];
    const httfYear = contests.length ? Number(contests[0].year) : null;
    const thisYear = new Date().getFullYear();
    const latestEpisode = techcast_episodes()[0];
    const specialPanels = [];
    // 枠には連載・アクティビティ・リソースが混ざって出るので、1枚ずつ種別を名乗らせる
    // (#2892)。語彙はヘッダーのナビとフッターの列が持っているものだけを使う
    if (adventYear === thisYear) {
      specialPanels.push({
        url: '/specials/advent-calendar/',
        label: 'アクティビティ',
        labelIcon: 'speakerphone',
        more: {url: '/specials/', text: '特設ページ一覧へ'},
        title: 'アドベントカレンダー',
        meta: adventYear + '年のカレンダーが公開中です。',
      });
    }
    if (latestEpisode && latestEpisode.isNew) {
      specialPanels.push({
        url: '/specials/techcast/',
        label: 'アクティビティ',
        labelIcon: 'speakerphone',
        more: {url: '/specials/', text: '特設ページ一覧へ'},
        title: 'Future Tech Cast',
        meta: '新しいエピソード「' + latestEpisode.title + '」を公開しました。',
      });
    }
    if (httfYear && httfYear > thisYear) {
      specialPanels.push({
        url: '/specials/httf/',
        label: 'アクティビティ',
        labelIcon: 'speakerphone',
        more: {url: '/specials/', text: '特設ページ一覧へ'},
        title: 'HACK TO THE FUTURE',
        meta: httfYear + '年の回を AtCoder で開催中です。',
        // ロゴは切り抜くと欠けるので contain 表示
        thumb: {src: '/httf_logo.png', width: 640, height: 280, contain: true},
      });
    }
    // 出すのは「すぐ下の新着一覧に1本も出ていない連載」のうち最後に更新されたもの
    // (#3135)。最新の連載はその記事自体が新着一覧に並ぶので、パネルにしても二重になる。
    // 連載の顔は索引記事のサムネなのでそのまま借りる
    const doneSeries = featured_series(page.posts);
    if (doneSeries) {
      specialPanels.push({
        url: url_for(doneSeries.index.path),
        label: '連載',
        labelIcon: 'run-baton',
        more: {url: '/series/', text: '連載一覧へ'},
        title: doneSeries.name,
        // 説明文は索引記事の lede。ガイドラインのパネルと同じ「1文で名乗る」に揃える。
        // 名乗りしか書かれていない連載だけ、規模と更新月に戻す
        // （更新の日付は年月まで #2404。/series/ の期間表記とも揃う）
        meta: doneSeries.summary
          ? escape_html(doneSeries.summary)
          : '全' + doneSeries.total + '本・' + date(doneSeries.latest, 'YYYY.MM') + ' 更新',
        thumb: {src: doneSeries.index.thumbnail, width: 200, height: 135},
      });
    }
    specialPanels.push({
      url: '/specials/guidelines/',
      label: 'リソース',
      labelIcon: 'book',
      more: {url: '/specials/', text: '特設ページ一覧へ'},
      title: 'フューチャーのガイドライン',
      meta: '設計ガイドライン・コーディング規約・TypeScript 教材の入口です。',
      thumb: {src: '/archtecture_guidelines.png', width: 200, height: 135},
    });
  %>
  <%# 「◯◯一覧へ」は種別ごとの導線なので、置ける場所が中身で変わる (#2892)。
      2枚の種別が揃っている回（特設2枚）は節の下にまとめて置ける。
      連載と特設が混ざる回は行き先が2つになるので、それぞれのパネルの中に入れる %>
  <% const shownPanels = specialPanels.slice(0, 2); %>
  <% const sharedMore = new Set(shownPanels.map(function(p){ return p.more.url; })).size === 1
       ? shownPanels[0].more : null; %>
  <%# ここだけ囲みを持つ (#3152)。パネルの既定はフラットで、枠線は「強調のために
      枚数を絞った」ときの印。この枠は候補の中から旬の2枚を選んで出している (#2892)
      ので、その条件に当たる。行き先の全件は /series/ ・ /specials/ が持ち、
      そちらはフラットな一覧になる %>
  <section class="series-panels series-panels-boxed">
    <%# 連載の索引は記事なので「特設ページ」では名前が実態と合わない (#2892)。
        連載も特設ページも「記事1本ではない、まとまった読み物への入口」なので特集で束ねる %>
    <%- partial('section-heading', {id: 'specials', text: '特集'}) %>
    <div class="row">
      <% shownPanels.forEach(function(p){ %>
      <div class="col-12 col-md-6">
        <%# 旬の2枚に専用の絵が無いときは空き枠。サムネの無い連載（/series/）と行頭を揃える。
            全件導線は、2枚の行き先が同じならこの節の下にまとめる (#2892) %>
        <%- partial('panel-card', {
              url: p.url,
              title: p.title,
              thumb: p.thumb,
              label: {icon: p.labelIcon, text: p.label},
              meta: p.meta,
              more: sharedMore ? null : p.more,
            }) %>
      </div>
      <% }) %>
    </div>
    <%# 記法ガイドはパネルに出していない。全件は /specials/ が持つ %>
    <% if (sharedMore) { %>
    <%- partial('more-link', {url: sharedMore.url, text: sharedMore.text}) %>
    <% } %>
  </section>
<% } %>
<%# 関連タグは1ページ目だけ一覧の前に出す。カテゴリページの
    「よく使われるタグ」と同じ位置で、絞り込み直しの導線は一覧を
    読み始める前にある方が働く (#2088)。2ページ目以降は下（ページャーの後）。
    ホームの全タグ一覧と両方を置くと読者がどちらを見ればよいか迷うため、
    タグページはこちらだけ（文脈あり・数個 ＞ 文脈なし・714件） %>
<% if (is_tag() && page.current === 1) { %>
<%- partial('related-tags') %>
<% } %>
<% if (pagination == 2){ %>
  <% page.posts.each(function(post){ %>
    <%- partial('article', {post: post, index: true}) %>
  <% }) %>
<% } else { %>
  <section class="archives-wrap">
    <%# ホームだけ見出しを出す。タグ／カテゴリ／著者ページは
        パンくずと h1 が既に「何の一覧か」を示しているため不要。
        1ページ目は新着そのものだが、2ページ目以降は全記事を繰っている
        途中なので「新着記事」だと実態とずれる %>
    <%# 呼び出し側は list_heading で見出しを渡せる（カテゴリページ等）。
        archives-wrap の margin-top の内側に置かないと、呼び出し側の h2 と
        間隔を二重取りして見出しとリストが離れる %>
    <% const listHeading = (typeof list_heading !== 'undefined' && list_heading) ? list_heading : (isHome ? (page.current === 1 ? '新着記事' : '記事一覧') : null); %>
    <%# 総本数は一覧の見出しの行に添える (#2911)。統計を畳んだので、
        「このカテゴリ／タグ／著者に何本あるか」を出す場所がここになる。
        2ページ目以降は、そこに現在位置を足して「全N本のうち X ～ Y 本目」にする
        (#3187)。以前は見出しの上に別の行（.pagination-info）で出していたが、
        同じ「何本あるか」を2つの場所が別々の言い方で持っていた。
        perPage は各ジェネレータの per_page（すべて25）と合わせる。
        記事数の単位はサイト全体で「本」に揃える (#2209) %>
    <% const listTotal = (typeof list_total !== 'undefined' && list_total) ? list_total : null; %>
    <% const perPage = 25; %>
    <% let listMeta = null; %>
    <% if (listTotal) { %>
    <% listMeta = page.current > 1
         ? `全${listTotal}本のうち ${(page.current - 1) * perPage + 1} ～ ${Math.min(page.current * perPage, listTotal)} 本目`
         : `全${listTotal}本`; %>
    <% } %>
    <% if (listHeading) { %>
    <%- partial('section-heading', {id: 'posts', text: listHeading, meta: listMeta}) %>
    <% } %>
    <%# 見出しとリストの間に置きたい補足を呼び出し側から差し込む %>
    <% if (typeof list_note !== 'undefined' && list_note) { %>
    <%- list_note %>
    <% } %>
    <div class="archives">
      <% page.posts.each(function(post, i){ %>
      <%- partial('archive-post', {post: post, even: i % 2 == 0, index: true}) %>
      <% }) %>
    </div>
    <% if (page.posts.length){ %>
    <div id="page-nav" class="pagination">
      <%# 連載ナビの「前の記事／次の記事」と同じ対象明示型の日本語にする (#2095) %>
      <%- paginator({prev_text:'前のページ', next_text:'次のページ', mid_size:3, end_size:2, show_all:false}) %>
    </div>
    <% } %>
  </section>
<% } %>


  <%# 最終ページだけ、読み尽くした読者への次の導線をページャーの下に出す
      (#2213)。途中のページは次のページへ進むのが本線なので挟まない。
      タグ = 関連タグ、カテゴリ = 関連カテゴリ。1ページ目と同じ部品。
      1ページしか無いときは一覧の前の表示と重複するので出さない。
      著者ページには出さない。タグ・カテゴリの対に合わせるなら「関連著者」
      だが、機械的に他の著者を推薦することはしない (#2200) %>
  <% if (page.current === page.total && page.current !== 1) { %>
  <%# ここではページの最後のブロックになるので、フッター前の共通間隔を取る %>
  <div class="footer-gap">
  <% if (is_tag()) { %>
  <%- partial('related-tags') %>
  <% } else if (is_category()) { %>
  <%- partial('related-categories') %>
  <% } %>
  </div>
  <% } %>
