<%# ラベル付きの行 (#3064)。左のラベルが群を名乗り、右にその群のチップを並べる。
    行の上下の罫線が群の範囲を示す。著者一覧の受賞年と、タグ一覧の頭文字の索引が同じ形。

    引数:
      rows [{id, label, items}]  id は行への飛び先（省略可）
      variant 'tag'   … items は tag-chips と同じ {name, path, count, title}
              'award' … items は {name, nth}。著者ページへの受賞チップ %>
<ul class="label-rows">
  <% rows.forEach(function(r){ %>
  <li<%- r.id ? ` id="${r.id}"` : '' %>>
    <span class="label-rows-label"><%= r.label %></span>
    <% if (variant === 'award') { %>
    <span class="label-rows-items">
      <% r.items.forEach(function(a){ %>
      <a class="award-chip<%= a.nth >= 3 ? ' award-chip-hall' : (a.nth === 2 ? ' award-chip-repeat' : '') %>" href="<%- url_for('authors/' + a.name + '/') %>" title="<%= a.name %>（<%= a.nth %>回目の受賞）"><%- partial('award-medal', {nth: a.nth >= 2 ? a.nth : null}) %><%= a.name %></a>
      <% }) %>
    </span>
    <% } else { %>
    <div class="label-rows-items blog-tags"><%- partial('tag-chips', {items: r.items}) %></div>
    <% } %>
  </li>
  <% }) %>
</ul>
