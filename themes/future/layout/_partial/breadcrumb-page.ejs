<%# Markdown で書いたページのパンくず (#2580)。

    EJS のレイアウトはページごとに専用ファイルがあるので項目を直書きできるが、
    Markdown のページは page.ejs を共有するため、
    どこに属するかをパスから組む。/specials/ 配下が増えても勝手に付く。

    現在地は出さない。ページの主題は真下の h1 が名乗っており、
    パンくずで重ねない（記事ページ post.ejs と同じ扱い）。
    /specials/ 配下は EJS で書いたページ（guidelines / httf）も同じ扱いにしてある。
    結果、下位ページは「ホーム > 特設」、/specials/ 自身は「ホーム」1項目に
    なるのでパンくずが出ない (#2837) %>
<%
// 名前空間 -> 表示名。特設ページは /specials/ 配下に切ってある (#2344)
const NAMESPACES = { specials: '特設' };
const segs = String(page.path || '')
  .replace(/index\.html$/, '')
  .split('/')
  .filter(Boolean);
const ns = NAMESPACES[segs[0]];
%><% if (ns) { %><%- partial('breadcrumb', {items: [
  {label: 'ホーム', url: '/'}
].concat(segs.length > 1 ? [{label: ns, url: '/' + segs[0] + '/'}] : [])}) %><% } %>
