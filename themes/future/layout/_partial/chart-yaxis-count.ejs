<%# 投稿数チャートの縦軸。echarts の option を組む前に
    const axis = <この部品>; として使い、series には積み上げ前の系列配列の式を渡す
    （例: partial('_partial/chart-yaxis-count', {series: 'chartData.series'})）。
    option 側では yAxis: axis.yAxis と series: axis.decorate(...) の2箇所で受ける。

    上限は積み上げの最大を5の倍数へ切り上げる（8本なら10、11本なら15）。
    目盛は5刻みで固定する。ページを移っても目盛が揃い、棒の高さを
    そのまま見比べられる。自動目盛だと 0.5 刻みや3刻みが出て、
    ページごとに基準が変わっていた（#2466）。
    下限を5に置くのは、月1本の対象で棒が天井に張り付くのを避けるため。

    上限5のページだけは 1 / 3 / 5 に線を引く。5刻みだと線が0と5の2本しか
    出ず、棒が何本を指すのか読めない。値軸の目盛は0起点の等間隔しか置けず
    1,3,5 を目盛では作れないので、線は markLine で引き、軸側の線は消す。

    軸の規則を1箇所でしか決めないための共有部品。タグ・カテゴリ・著者・月の
    4ページに同じ式が散ると、片方だけ直して基準がズレる %>
(function (series) {
  const peak = series.length
    ? Math.max(0, ...series[0].data.map((_, i) => series.reduce((n, s) => n + (s.data[i] || 0), 0)))
    : 0;
  const max = Math.max(5, Math.ceil(peak / 5) * 5);
  const odd = max === 5;
  return {
    yAxis: {
      type: 'value',
      min: 0,
      max: max,
      interval: odd ? 1 : 5,
      <%# 線を引いた 1 / 3 / 5 だけに数字を出す。0 は軸の足元なので他ページと同じく残す %>
      axisLabel: odd ? { formatter: (v) => (v === 0 || v % 2 ? v : '') } : {},
      splitLine: { show: !odd }
    },
    decorate: (list) =>
      odd && list.length
        ? [
            Object.assign({}, list[0], {
              markLine: {
                silent: true,
                symbol: 'none',
                label: { show: false },
                <%# 軸の目盛線（splitLine）と同じ色。棒の上に重なるので薄く引く %>
                lineStyle: { color: '#e0e6f1', width: 1, type: 'solid', opacity: 0.9 },
                data: [{ yAxis: 1 }, { yAxis: 3 }, { yAxis: 5 }]
              }
            })
          ].concat(list.slice(1))
        : list
  };
})(<%- series %>)
