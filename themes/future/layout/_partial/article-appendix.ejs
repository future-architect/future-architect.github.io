<%#
  記事末の自動生成ブロック (#2874)。関連記事・被参照・We're hiring。

  本文に従属するもの（連載ナビ・共有ボタン・著者紹介）とは従属の強さが違うので、
  記事の <article> の外に出し、全幅の面で切ってフッターに接する帯にする。
  中身は .container で他ページと同じ左右の揃いに戻す。

  名前を持たせて complementary landmark にする。見出しで飛ばす読者が
  この帯をまとめて飛ばせる。面は目で見る読者に同じ境目を渡す。
%>
<aside class="article-appendix" aria-label="関連情報">
  <div class="container">
    <%# 中身は白に戻す。行の細線・hover の面・NEW の枠はいずれも白地の上で
        決めた値で、グレーの上では一段弱くなる（#2732）。グレーは領域の枠として
        外側に残す %>
    <div class="article-appendix-inner">
    <%# 縦に積むリストなので1件ごとの囲みは持たず、節見出しと行の区切りで分ける (#2820)。
        見出しは一覧ページと同じ section-heading。本文との違いは帯の面が示すので、
        大きさは動かさない（面と大きさの両方は動かさない #2722）。
        節の外の空きは帯の padding が持つので、ここでは margin を付けない %>
    <section class="related-post nav" data-nosnippet>
      <%- partial('section-heading', {id: 'related', text: '関連記事'}) %>
      <%- list_related_posts(post) %>
    </section>
    <%# 被参照が無いと helper は空を返す。見出しを EJS 側へ出したので、
        節ごと出さないと見出しだけが残る %>
    <% const referenceHtml = list_reference_posts(post); %>
    <% if (referenceHtml) { %>
    <section class="reference-post nav" data-nosnippet>
      <%- partial('section-heading', {id: 'reference', text: 'この記事を参照している記事'}) %>
      <%- referenceHtml %>
    </section>
    <% } %>
    <% if (!page.skip_career){ %>
    <section class="career-counseling article-entry nav" data-nosnippet>
      <%- partial('section-heading', {id: 'career', text: "We're hiring"}) %>
      <p>フューチャーで一緒に働く仲間を大募集しています！ また、様々なコンテンツも公開中です。</p>

      <div class="row g-4">
        <%# サムネイルを左に小さく置き、見出しと説明を右に積む横並びの構成。
            以前は画像がカード幅の半分を占め、場所の割に情報量が薄かった %>
        <% hiring_panels(post).forEach(function(panel){ %>
        <div class="col-12 col-md-6">
          <%# h-100 は付けない。囲みが無いので高さをそろえる相手が無く、
              align-items: center と組むと短い方の中身が縦に浮く %>
          <div class="article-card">
            <%# 器は寸法台帳の「横並びのカード」＝ panel-thumb（88×59 の切り抜き）。
                3枚の元画像は比がまちまち（1.9〜2.76）で、height: auto だと高さが
                32〜46px にばらつき、面の hover の範囲が1枚ごとに違って見えた (#3113) %>
            <a href="<%= panel.url %>" title="<%= panel.title %>" class="thumb-link panel-thumb" tabindex="-1" aria-hidden="true">
              <img src="<%= panel.image %>" alt="" width="<%= panel.width %>" height="<%= panel.height %>"<% if (panel.bordered) { %> class="bordered"<% } %> loading="lazy">
            </a>
            <div class="hiring-card-body">
              <%# ラベルから行き先が読めないパネルだけ、矢印と sr-only で名乗る
                  （フッター・サイドバーと同じ形 #2346 / #2729）。
                  note・LEAD TO THE FUTURE はメディア名が名乗っている %>
              <a href="<%= panel.url %>" class="hiring-card-label"><%= panel.label %><% if (panel.external) { %><span class="sr-only">（外部サイト）</span><%- partial('_partial/svg-icon', {icon: 'external-link', class_name: 'svg-icon-trailing'}).trim() %><% } %></a>
              <div class="lede"><%= panel.lede %></div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </section>
    <% } %>
    </div>
  </div>
</aside>
