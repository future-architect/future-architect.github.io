<%# 投稿推移のグラフ。粒度は年の指定に関わらず月 (#2432)。
    読み手が知りたいのは「どれくらいのペースで書かれているか」で、
    それは月の単位で見るもの。個別ページ（カテゴリ・タグ・著者）も月なので、
    ページをまたいでも同じ密度で読める。

    2枚目のタブはページの単位で変える。年ページは「バケットの中の内訳」で
    月の中の週。全期間で同じことをすると「10年分の月の中の第何週か」になり
    読み取るべき問いが無くなるので、代わりに年を重ねた月の推移を出す (#2757) %>
<div class="nav tabs chart-tabs" role="radiogroup" aria-label="グラフの内訳">
  <%# 既定はカテゴリ別。粗密より、何のジャンルが書かれているかの方が
      最初に見たい情報 %>
  <input id="chart-tab-category" type="radio" name="chart_tab" checked>
  <label class="tab_item" for="chart-tab-category">カテゴリ別<%- partial('tab-hint') %></label>
  <div class="tab_content">
    <div id="chart-category" style="width:100%;min-height:250px"></div>
  </div>
  <% if (year) { %>
  <input id="chart-tab-period" type="radio" name="chart_tab">
  <label class="tab_item" for="chart-tab-period">週別<%- partial('tab-hint') %></label>
  <div class="tab_content">
    <div id="chart-period" style="width:100%;min-height:250px"></div>
  </div>
  <% } else { %>
  <input id="chart-tab-years" type="radio" name="chart_tab">
  <label class="tab_item" for="chart-tab-years">年別<%- partial('tab-hint') %></label>
  <div class="tab_content">
    <div id="chart-years" style="width:100%;min-height:250px"></div>
  </div>
  <% } %>
</div>
<%- partial('echarts-script') %>
<script type="text/javascript">
<% if (year) { %>
  const periodData = <%- posts_stack_series(year) %>;
  const periodChart = echarts.init(document.getElementById('chart-period'));
  periodChart.setOption({
    tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
    <%# 凡例は1行に収める。折り返すと grid.bottom（1行分の32px）を越えて
        X軸の月ラベルに重なる。モバイルでは「第1週〜第5週」の5項目が
        入り切らず実際に重なっていた (#2430)。
        カテゴリ別のグラフと同じ type:'scroll' で、溢れた分は矢印で送る %>
    legend: { bottom: 0, type: 'scroll' },
    grid: { left: 0, right: '2%', bottom: 32, containLabel: true },
    xAxis: { type: 'category', data: periodData.buckets },
    <%# 上限は echarts の自動に任せる (#2466)。手で 90 に丸めると刻みは 20 のまま
        最上段だけ 80→90 と間隔が変わる。自動は上限を刻みの倍数（100）に取る。
        タブの2枚は同じ投稿を別の内訳で積んでいて合計が等しいので、
        自動でも軸は揃い、タブを切り替えても目盛は動かない %>
    yAxis: { type: 'value', min: 0 },
    <%# 棒の高さが期間の合計、内訳はその中の週。第1週→第5週と順序に意味が
        あるので同系の段で塗る。色は scripts/chart_colors.js が1箇所で持つ %>
    color: <%- chart_series_colors('weeks') %>,
    series: periodData.slots.map((data, i) => ({
      name: periodData.labels[i],
      type: 'bar',
      stack: 'posts',
      data
    }))
  });
  themeChart(periodChart);
<% } else { %>
  const yearData = <%- posts_year_overlay_series() %>;
  const yearsChart = echarts.init(document.getElementById('chart-years'));
  yearsChart.setOption({
    <%# 同じ月の全年を1つの吹き出しに出す。年どうしの差を読むグラフなので、
        1本ずつ見るより並べた方が速い %>
    tooltip: { trigger: 'axis' },
    legend: { bottom: 0, type: 'scroll', selected: yearData.selected },
    grid: { left: 0, right: '2%', bottom: 32, containLabel: true },
    <%# 折れ線なので端に余白を作らない。1月と12月が軸の端に来る %>
    xAxis: { type: 'category', data: yearData.months, boundaryGap: false },
    <%# 上限は自動。カテゴリ別のタブは全11年ぶんの月を積んでいて最大が違うので、
        タブをまたいで目盛は揃わない（見ている年の範囲が違うため） %>
    yAxis: { type: 'value', min: 0 },
    <%# 5本を濃淡だけで分けると、細い線では隣り合う段の区別が付かない。
        年ごとに色相を変えて、古い年ほど彩度を落として引かせる。
        echarts の option では CSS 変数を参照できないので、ブランド色は
        同値をリテラルで持つ。
        線は図形なので基準は 3:1。明るい黄色（#FFC107 は 1.63、#E6A700 でも
        2.12）は細い線だと消えるため、3:1 を満たす一番明るい黄色を選ぶ。
        白地とのコントラストは 5.35 / 16.34 / 3.25 / 3.18 / 3.23 %>
    color: ['#D5004A', '#0A1461', '#B8860B', '#689F38', '#8f8f8f'],
    <%# 点は出さない。5本 × 12か月で60個並ぶと線の形が読み取れない。
        ホバーしたときだけ echarts が点を出すので、値は読める %>
    series: yearData.series.map((s, i) => ({
      name: s.name,
      type: 'line',
      showSymbol: false,
      <%# 太さは scripts/chart_style.js が1箇所で持つ %>
      lineStyle: { width: <%= chart_line_width() %> },
      <%# 系列は新しい年が先。echarts は後の系列を上に描くので、
          そのままだと古い年が前に出る。z を逆順に振って新しい年を上に置く。
          太さが揃っているので、手前に来るのは新しい年だけが頼り。
          既定の 2 より下に落とすと軸の補助線に潜るので +2 する %>
      z: yearData.series.length - i + 2,
      data: s.data
    }))
  });
  themeChart(yearsChart);
<% } %>

  const catData = <%- year ? get_monthly_category_data(year) : get_monthly_category_data() %>;
  const catColors = <%- category_colors() %>;
  const categoryChart = echarts.init(document.getElementById('chart-category'));
  categoryChart.setOption({
    tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
    legend: { bottom: 0, type: 'scroll' },
    grid: { left: 0, right: '2%', bottom: 32, containLabel: true },
    xAxis: {
      type: 'category',
      data: catData.months,
      axisLabel: <%- partial('_partial/chart-xaxis-year-labels', {months: 'catData.months', el: 'chart-category'}).trim() %>
    },
    yAxis: { type: 'value', min: 0 },
    <%# カテゴリは順序に意味が無いので色相で分け、名前で固定する (#2170) %>
    series: catData.series.map(s => ({
      name: s.name,
      type: 'bar',
      stack: 'categories',
      itemStyle: { color: catColors[s.name] },
      data: s.data
    }))
  });
  themeChart(categoryChart);
</script>
