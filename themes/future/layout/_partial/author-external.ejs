<%# 同じ著者の他の媒体の記事 (#3428)。記事末の著者紹介と著者ページが呼ぶ。
    題が行き先を名乗るが外部と読めないので、リンクごとに矢印と sr-only を付ける (#2729) %>
<ul class="author-external">
  <% items.forEach(function(e){ %>
  <li>
    <a href="<%= e.url %>" target="_blank" rel="noopener"><%= e.title %><span class="sr-only">（外部サイト）</span><%- partial('svg-icon', {icon: 'external-link', class_name: 'svg-icon-trailing'}).trim() %></a>
    <span class="author-external-meta"><%= e.media %><% if (e.date) { %> · <%= e.date.replace(/-/g, '.') %><% } %></span>
  </li>
  <% }) %>
</ul>
