<%# 記事のパネルグリッド。/specials/ 配下のページで共用する（#2345 で
    guidelines から切り出し）。特設ページは記事と同じ「本文 + サイドバー」幅なので、
    トップの連載枠と同じ2列にする。
    呼び出し: partial('post-panel-grid', {posts: [...]}) %>
<% if (posts.length) { %>
<div class="series-panels row g-4">
  <% posts.forEach(function(p){ %>
  <div class="col-12 col-md-6">
    <div class="article-card series-panel h-100">
      <% if (p.thumbnail) { %>
      <a href="<%- url_for(p.path) %>" title="<%= p.title %>" class="img_wrap panel-thumb">
        <img src="<%= p.thumbnail %>" alt="" width="200" height="135" loading="lazy">
      </a>
      <% } else { %>
      <span class="panel-thumb panel-thumb-empty"></span>
      <% } %>
      <div class="panel-body">
        <a href="<%- url_for(p.path) %>" class="panel-title"><%= p.title %></a>
        <div class="panel-meta"><%= date(p.date, 'YYYY.MM.DD') %> 公開</div>
      </div>
    </div>
  </div>
  <% }) %>
</div>
<% } %>
