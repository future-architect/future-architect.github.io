<%# カテゴリ・タグ・著者ページの統計とグラフ (#2911)。本文の先頭に置いていたものを
    サイドバーへ逃がす。読者がこれらのページに来る目的は「その記事を読む」ことで、
    総シェア数の内訳も投稿数の推移もその判断には効かない。消さないのは運営と
    書き手がこの数字を見に来るため。1ページ目だけに出す %>
<%
  // 3種のどれかを見分けて、数字とグラフのヘルパーを揃える。
  // 著者はシェア数がページのローカル（author_generator.js）に載っている
  let stats = null;
  if (page.tag) {
    const s = summary_tag(page.tag);
    const t = tag_stats(page.tag);
    stats = {
      total: [
        {label: '投稿', value: count_tag(page.tag)},
        {label: '著者数', value: s.authors},
        {label: '総シェア数', value: s.total},
        {label: 'X', value: s.twitter, sub: true},
        {label: 'Facebook', value: s.facebook, sub: true},
        {label: 'はてブ', value: s.hatebu, sub: true},
        {label: 'Pocket', value: s.pocket, sub: true},
      ],
      recent: t && t.recent > 0
        ? [{label: '投稿', value: t.recent}, {label: '著者数', value: t.recentAuthorCount}]
        : [],
      chart: tag_monthly_chart(page.tag),
      chartLabel: '投稿数（カテゴリ別）',
    };
  } else if (page.category) {
    const s = summary_category(page.category);
    const c = category_stats(page.category);
    stats = {
      total: [
        {label: '投稿', value: count_category(page.category)},
        {label: '著者数', value: s.authors},
        {label: '総シェア数', value: s.total},
        {label: 'X', value: s.twitter, sub: true},
        {label: 'Facebook', value: s.facebook, sub: true},
        {label: 'はてブ', value: s.hatebu, sub: true},
        {label: 'Pocket', value: s.pocket, sub: true},
      ],
      recent: c && c.recent > 0
        ? [{label: '投稿', value: c.recent}, {label: '著者数', value: c.recentAuthorCount}]
        : [],
      chart: category_monthly_chart(page.category),
      // 系列はそのカテゴリ1本だけなので内訳は書かない
      chartLabel: '投稿数',
    };
  } else if (page.author) {
    const a = author_stats(page.author);
    stats = {
      total: [
        {label: '投稿', value: count_author(page.author)},
        {label: '総シェア数', value: page.authorSNSCnt},
        {label: 'X', value: page.twitterShare, sub: true},
        {label: 'Facebook', value: page.facebookShare, sub: true},
        {label: 'はてブ', value: page.hatebu, sub: true},
        {label: 'Pocket', value: page.pocket, sub: true},
      ],
      recent: a && a.recent > 0 ? [{label: '投稿', value: a.recent}] : [],
      chart: author_monthly_chart(page.author),
      chartLabel: '投稿数（カテゴリ別）',
    };
  }
%>
<% if (stats) { %>
<%# 見出しは置かない (#2911)。「累計」「直近1年」のラベルと数字が並んでいれば
    何のブロックかは見て分かる。目で見えない読者には aria-label が名乗る %>
<section class="sidebar-stats" data-nosnippet aria-label="統計">
  <%# 箱と時間軸のラベルは本文の統計と同じ部品。中身だけタイルから行に替える。
      208px の列にタイルを7つ並べると3.4倍の幅が要る。
      シェアの内訳（X・Facebook・はてブ・Pocket）は総シェア数の内訳なので、
      本文と同じく summary-sub で一段下げる (#2096)。
      0行の間引きと桁そろえは sidebar-summary-panel が持つ（一覧ページと共有）%>
  <%- partial('sidebar-summary-panel', {total: stats.total, recent: stats.recent}) %>
  <% if (stats.chart) { %>
  <%# 凡例は出さない。カテゴリ別の積み上げは最長の「DataEngineering」だけで
      117.9px あり、208px の列では横送りになって場所だけ取る。
      どの色が何かはツールチップ（trigger: axis）が名乗る %>
  <%# 一覧ページと同じく「量（内訳）」の形でグラフを名乗る。h2 を持たないので、
      ラベルが無いと何の数のグラフか分からない %>
  <span class="sidebar-stats-chart-label"><%= stats.chartLabel %></span>
  <div id="chart" class="sidebar-stats-chart"></div>
  <%- partial('echarts-script') %>
  <script type="text/javascript">
    const chartData = <%- stats.chart %>;
    const catColors = <%- category_colors() %>;
    const sidebarChart = echarts.init(document.getElementById('chart'));
    sidebarChart.setOption({
      <%# タイトルは直上の h2 が担うので、チャート内では重ねない %>
      title: {},
      tooltip: { trigger: 'axis' },
      <%# 既定の grid.left 10% で右へズレて見える。軸ラベル込みで左端に寄せる。
          right に余白を置くのは、containLabel が**端のカテゴリラベルのはみ出しを
          見ない**ため。軸の最後が1月に当たると「2026年」の半分が外へ出て切れる %>
      grid: { left: 0, right: 16, top: 8, bottom: 0, containLabel: true },
      xAxis: {
        type: 'category',
        boundaryGap: true,
        data: chartData.months,
        <%# 目盛りは月ごとに1本立つ。軸の月数は中央値80・最長128なので、
            208〜298px の列では縦線の帯になって棒より目立つ。年ラベルは3〜4本しか
            出ないので、目盛りと対応も付かない %>
        axisTick: { show: false },
        axisLabel: <%- partial('chart-xaxis-year-labels', {months: 'chartData.months', el: 'chart'}).trim() %>
      },
      yAxis: <%- partial('chart-yaxis-count', {series: 'chartData.series'}).trim() %>,
      <%# 色はカテゴリ名で固定 (#2170) %>
      series: chartData.series.map(s => Object.assign({}, s, { itemStyle: { color: catColors[s.name] } }))
    });
    themeChart(sidebarChart);
  </script>
  <% } %>
</section>
<% } %>
