<div class="row article-card">
  <% if (post.thumbnail) { %>
  <a href="<%- url_for(post.path) %>" title="<%= post.title %>" class="col-sm-4 col-md-4 thumb-link card-thumb">
    <%# image_size_attribute は width="300" height="225" というタグの断片を返す。
        エスケープする出力に渡すと引用符が &#34; になり、属性として壊れる (#2690) %>
    <img src="<%= post.thumbnail %>" class="img-responsive" alt="" <%- image_size_attribute(post.thumbnail) %> loading="lazy">
  </a>
  <div class="col-sm-8 col-md-8 archive-post-body">
  <% } else { %>
  <div class="col-xs-12 archive-post-body">
  <% } %>
    <div class="archive-post-item">
      <a href="<%- url_for(post.path) %>">
        <%- partial('post/title', {class_name: 'archive-post-title'}) %>
        <div class="blog-item">
          <div class="lede">
          <% if (index == true){ %>
          <%- post.lede || post.excerpt || post.content %>
          <% } else { %>
          <%- post.lede || post.excerpt %>
          <% } %>
          </div>
        </div>
      </a>
    </div>
    <ul class="blog-info">
      <li class="blog-info-item"><%- partial('post/date', {class_name: 'archive-article-date', date_format: 'YYYY.MM.DD'}) %></li>
      <li class="blog-info-item"><%- partial('post/tag') %></li>
    </ul>
  </div>
  <%# シェアボタンは DOM ではここ（サムネイル → 本文 → シェア）に置き、
      PC での位置はグリッドの領域が決める（サムネイルの真下 #2747）。
      並べ替えを CSS に任せるのは、狭い画面で列が縦に積んだときに
      この順序がそのまま「画像 → 本文 → シェア」になるため %>
  <%- partial('social-button', {post: post, feed:false}) %>
</div>
