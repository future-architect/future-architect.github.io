<%# 記事ページではタイトルがページの主見出しなので h1、一覧ページでは
    節見出し（section-heading の h2）の中に並ぶので h3 にする (#2919) %>
<% const titleTag = is_post() ? "h1" : "h3" %>
<<%= titleTag %> class="<%= class_name %>"><%= post.title %>
  <% if (is_post()) {%>
    <a href="<%= edit_url(page.source) %>" title="Suggest Edits" aria-label="この記事をGitHubで編集する" class="github-edit"><%- partial('../svg-icon', {icon: 'pencil', class_name: 'svg-icon-trailing'}) %></a>
  <% } %>
</<%= titleTag %>>
