<!-- BEGIN PRE-FOOTER -->
<%# data-nosnippet: 全ページ共通の定型文が検索結果のスニペットに出ないようにする (#2359)。
    Google の検索一致そのものは防げない点に注意（要素単位の除外手段が無い） %>
<footer class="site-footer" data-nosnippet>
  <div class="pre-footer">
    <div class="container">
      <div class="row">
        <div class="col-lg-4 col-md-4 pre-footer-col">
          <h2>About Us</h2>
          <%# フッターは1文目だけ出す。全文はホームの site-lede（index.ejs）が出す。
              コーポレートURLは説明の続きなので、段落を分けず改行で詰める %>
          <p><%- theme.about.split('。')[0] %>。<br />
          <a href="<%= theme.corporate_url %>"><%= theme.corporate_url %></a></p>
          <div class="social-btn x-btn-follow x-btn-follow">
            <a
              href="https://x.com/intent/follow?screen_name=future_techblog"
              target="_blank"
              rel="nofollow noopener"
            >
              <i></i
              <%# social-btn-label は Feedly 側と同じアイコンとの間隔（margin-left 6px）を
                  与えるために併用する。無いとテキスト開始位置が Feedly とズレる %>
              ><span class="social-btn-label x-btn-follow-label"
                <%# X アイコンが「X」と読めるため「Xでフォロー」だと X が重複して見える。
                    サービス名はアイコンに任せて動詞だけにする (#2036) %>
                > フォロー</span
              >
            </a>
          </div>
          <%# 購読の導線。以前はトップページ下部のシェアボタン群に紛れていたが、
              拡散ではなく購読という別の行動なので、フォローと並べる方が意図に近い。
              リンクは1つにまとめて、タップ領域が隣接しないようにしている。
              RSS は Links のアイコン行に置く（アイコンの置き場を1箇所に揃える） %>
          <div class="social-btn feedly-btn feedly-btn-follow">
            <a
              href="https://feedly.com/i/subscription/feed%2Fhttps%3A%2F%2Ffuture-architect.github.io%2Fatom.xml"
              target="_blank"
              rel="nofollow noopener"
              title="Feedly でフューチャー技術ブログを購読する"
            >
              <i></i
              ><span class="social-btn-label"
                <%# キャッシュのキーは末尾スラッシュ付き。config.url は付いていないため
                    full_url_for('/') で元のシェアボタンと同じ形に揃える %>
                > Feedlyで購読（<%= get_feedly_count(full_url_for('/')) %>人）</span
              >
            </a>
          </div>
        </div>
        <div class="col-lg-4 col-md-4 pre-footer-col">
          <h2>Contact</h2>
          <%# margin-bottom-40 は旧レイアウトの名残。列が一番高くなる幅では
              そのままネイビー帯との空白になるので付けない %>
          <address>
            <%# 導線は X とメールアイコンの2つ。アドレスはリンクにせず
                その下にテキストで出す（コピーして使う人向け。mailto はアイコンが担う） %>
            <p>
              記事への問い合わせ先:
              <a
                class="icon-link"
                href="https://x.com/future_techblog"
                title="X で問い合わせる"
                aria-label="X"
                ><%- partial('_partial/svg-icon', {icon: 'brand-x'}) %></a
              >
              <a
                class="icon-link"
                href="mailto:<%= theme.email %>"
                title="メールで問い合わせる"
                aria-label="メール"
                ><%- partial('_partial/svg-icon', {icon: 'mail'}) %></a
              ><br />
              <%= theme.email %>
            </p>
            <a
              class="ext-link"
              href="https://www.future.co.jp/contact_us/"
              title="お問い合わせページ"
              target="_blank"
              rel="noopener"
              <%# ブログ内のページとも読める語なので外部を名乗る (#2346)。
                  フッターは文字ではなくアイコンで示し、読み上げ用の隠しテキストを残す %>
              >その他のお問い合わせ先<span class="sr-only">（外部サイト）</span><%- partial('_partial/svg-icon', {icon: 'external-link'}) %></a
            ><br />
          </address>
        </div>
        <div class="col-lg-4 col-md-4 pre-footer-col footer-links">
          <h2>Links
          </h2>
          <%# title に宣伝文を書かない。全ページ共通の文言はサイト内検索の
              一致を汚す（「Software Design」で「デザイン」が当たる #2359） %>
          <%# 未来報・LEAD TO THE FUTURE は We're hiring のパネルに移した (#2295)。
              メディアポリシーは方針・規約類の定石に従い下段の帯へ %>
          <%# アイコンで名乗り、読み上げは aria-label が担う（doctor も
              アイコンリンクは aria-label 側を見る）。connpass のチケット型
              シンボルは世界的ではないが、読者はほぼ国内なので通じる判断 %>
          <div class="icon-row">
            <a
              class="icon-link"
              href="https://future.connpass.com/"
              title="フューチャーの勉強会（connpass）"
              aria-label="connpass"
              target="_blank"
              rel="noopener"
              ><%- partial('_partial/svg-icon', {icon: 'brand-connpass'}) %></a
            >
            <a
              class="icon-link"
              href="https://github.com/future-architect"
              title="フューチャーのGitHub"
              aria-label="GitHub"
              target="_blank"
              rel="noopener"
              ><%- partial('_partial/svg-icon', {icon: 'brand-github'}) %></a
            >
            <a
              class="icon-link"
              href="https://www.youtube.com/channel/UCJUSwYYd0CkGgmEKAW7QVpw"
              title="フューチャーYoutubeチャネル"
              aria-label="Youtube"
              target="_blank"
              rel="noopener"
              ><%- partial('_partial/svg-icon', {icon: 'brand-youtube'}) %></a
            >
            <a
              class="icon-link"
              href="/atom.xml"
              title="RSSリーダーでフューチャー技術ブログを購読する"
              aria-label="RSSで購読"
              ><%- partial('_partial/svg-icon', {icon: 'rss'}) %></a
            >
          </div>
        </div>
      </div>
    </div>
  </div>
  <%# グレー地とネイビー帯の境界に立つ階段 (#2812)。白 → 薄いグレー →
      クリムゾンの3段で、差し色は最上段だけ。装飾なので読み上げから外す %>
  <div class="footer-steps" aria-hidden="true">
    <span class="footer-step footer-step-1"></span>
    <span class="footer-step footer-step-2"></span>
    <span class="footer-step footer-step-3"></span>
  </div>
  <div class="footer">
    <div class="container">
      <div class="row">
        <div class="col-md-6 footer-copyright">
          Copyright 2016 - <%= date(new Date(), 'YYYY') %> by Future
          Corporation
        </div>
        <%# 方針・規約類は最下段の帯に置く定石に従い、Links から移した %>
        <div class="col-md-6 footer-policy">
          <a
            class="ext-link"
            href="https://www.future.co.jp/architect/socialmediapolicy/"
            title="ソーシャルメディアポリシー"
            target="_blank"
            rel="noopener"
            <%# ブログ内のページとも読める語なので外部を名乗る (#2346)。
                フッターは文字ではなくアイコンで示し、読み上げ用の隠しテキストを残す %>
            >メディアポリシー<span class="sr-only">（外部サイト）</span><%- partial('_partial/svg-icon', {icon: 'external-link'}) %></a
          >
        </div>
      </div>
    </div>
  </div>
</footer>
