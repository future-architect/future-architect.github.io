<%# カテゴリページの関連カテゴリ (#2200)。タグページの関連タグと同じく、
    読者の状態に合わせて位置を変えて使う。1ページ目 = 一覧の前、
    最終ページ = ページャーの下（読み尽くした読者への次の導線）(#2213)。
    件数ではなく根拠タグを名乗る。数字にするとどのタグで
    つながったのかが隠れて、読者が関連の質を判断できない。
    根拠タグは「Go・Docker が共通」の地の文ではなく、/tags/ の親子の木と同じ
    枝の下にチップで置く。押せない「共通するタグ」は木の実在しないノードと
    同じラベルで描く %>
<% const rc = related_categories(page.category, page.withoutPosts); %>
<% if (rc.length) { %>
<aside data-nosnippet aria-label="関連カテゴリ">
  <section class="popular-articles">
    <%- partial('section-heading', {id: 'relatedcategories', text: '関連カテゴリ'}) %>
    <ul class="tag-forest">
      <% rc.forEach(function(c){ %>
      <li>
        <p class="tag-forest-label"><a href="<%- url_for(c.path) %>" title="<%= c.name %> カテゴリの記事へ"><%- partial('category-icon', {name: c.name}) %><%= c.name %></a></p>
        <div class="tag-forest-branch">
          <p class="category-group-label">共通するタグ</p>
          <div class="tag-forest-branch">
            <div class="blog-tags"><%- partial('tag-chips', {items: c.tags}) %></div>
          </div>
        </div>
      </li>
      <% }) %>
    </ul>
  </section>
</aside>
<% } %>
