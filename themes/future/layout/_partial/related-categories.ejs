<%# カテゴリページの関連カテゴリ (#2200)。タグページの関連タグと同じく、
    読者の状態に合わせて位置を変えて使う。1ページ目 = 一覧の前、
    最終ページ = ページャーの下（読み尽くした読者への次の導線）(#2213)。
    注記は件数ではなく根拠タグを名乗る。数字にするとどのタグで
    つながったのかが隠れて、読者が関連の質を判断できない %>
<% const rc = related_categories(page.category); %>
<% if (rc.length) { %>
<aside data-nosnippet aria-label="関連カテゴリ">
  <section class="popular-articles margin-bottom-20">
    <% if (rc.length) { %>
    <%- partial('section-heading', {id: 'relatedcategories', text: '関連カテゴリ'}) %>
    <%- partial('tendency-panels', {kind: 'category', items: rc.map(function(c){
          return {name: c.name, path: c.path, title: `${c.name} カテゴリの記事へ`, note: `${c.tags.join('・')}を共有`};
        })}) %>
    <% } %>
  </section>
</aside>
<% } %>
