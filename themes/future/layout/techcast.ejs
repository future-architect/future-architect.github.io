<%# Future Tech Cast の特設ページ (#2854)。番組の入口とエピソード一覧をまとめる。
    エピソードは RSS（scripts/techcast_latest.js）から出すので、
    手で更新するものは無い。

    プレイヤーは番組の埋め込み1つだけ。RSS には Spotify の埋め込み用
    エピソードID が入っておらず（あるのは anchor.fm のID）、各回のプレイヤーは
    手でID を書くしかない。番組の埋め込みは常に最新回を指す %>
<div class="container">
  <%# ページ自身は名乗らない。主題は真下の h1 が示している（#2580）%>
  <%- partial('_partial/breadcrumb', {items: [
        {label: 'ホーム', url: '/'},
        {label: '特設', url: '/specials/'}
      ]}) %>
  <%# 記事・トップページと同じ「本文 + サイドバー」の幅にする %>
  <div class="row">
    <main id="main" tabindex="-1" class="col-md-9 blog-posts">
  <div class="margin-top-30">
    <div class="footer-gap">
      <h1 class="list-page margin-bottom-20">Future Tech Cast</h1>
      <p class="specials-text">「Future Tech Cast」は、フューチャー技術ブログから派生したポッドキャストです。Spotify で配信しており、業務で使っているテクノロジーの深掘りトーク、ブログ記事のサマリトーク、社員のキャリアやチームの仕事の話をお届けしています。</p>

      <%- partial('_partial/section-heading', {id: 'listen', text: '最新エピソード'}) %>
      <%# 高さ 152px は Spotify の compact プレイヤー。352px にすると
          埋め込みの中にエピソード一覧が出て、下の表と二重になる %>
      <iframe class="podcast-embed" src="https://open.spotify.com/embed/show/6ntaBQ28GSDaOztBphH6oi?utm_source=generator" title="Future Tech Cast の最新エピソード" width="100%" height="152" frameborder="0" allowfullscreen allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>

      <%
        const episodes = techcast_episodes();
        // 一覧の件数と初回の年月は数字を書かずに RSS から出す。
        // 新しい回が公開されたら文もそのまま追随する
        const firstEpisode = episodes[episodes.length - 1];
      %>
      <%- partial('_partial/section-heading', {id: 'episodes', text: 'エピソード一覧'}) %>
      <p class="specials-text margin-bottom-20"><% if (firstEpisode) { %><%= date(firstEpisode.date, 'YYYY年M月') %>の第1回から全<%= episodes.length %>回を配信しています。<% } %>タイトルを押すと Spotify のエピソードページが開きます。</p>
      <%# .scroll は記事中の表と同じ横スクロール枠（scripts/table_filter.js が付けるもの）%>
      <div class="scroll">
        <table>
          <thead>
            <tr>
              <%# 回数の列は作らない。番号はタイトルの「#N」が持つ
                  （RSS の itunes:episode を使わない理由は techcast_latest.js）%>
              <th>エピソード</th>
              <th class="cell-nowrap">公開日</th>
              <th class="cell-nowrap">長さ</th>
            </tr>
          </thead>
          <tbody>
            <% episodes.forEach(function(ep){ %>
            <tr>
              <%# このページは読み物（番組の記録）なので外部リンクの印は付けない (#2729)。
                  行き先は冒頭の本文が「Spotify で配信しており」と名乗っている %>
              <td><a href="<%= ep.link %>" target="_blank" rel="noopener"><%= ep.title %></a></td>
              <td class="cell-nowrap"><%= date(ep.date, 'YYYY.MM.DD') %></td>
              <td class="cell-nowrap"><%= ep.duration %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <%- partial('_partial/section-heading', {id: 'posts', text: 'ポッドキャストの記事'}) %>
      <p class="specials-text margin-bottom-20">番組の立ち上げや収録の裏側は、ブログ側の記事にも書いています。</p>
      <%
        // タグ「ポッドキャスト」から自動収集
        const podcastTag = site.tags.findOne({name: 'ポッドキャスト'});
        const podcastPosts = podcastTag ? podcastTag.posts.sort('-date').toArray() : [];
      %>
      <%- partial('_partial/post-panel-grid', {posts: podcastPosts}) %>
    </div>
  </div>
    </main>
    <aside class="col-md-3 blog-sidebar" aria-label="サイドバー">
      <%- partial('_partial/sidebar', {specialsToc: [
        {id: 'listen', text: '最新エピソード'},
        {id: 'episodes', text: 'エピソード一覧'},
        {id: 'posts', text: 'ポッドキャストの記事'},
      ]}) %>
    </aside>
  </div>
</div>
