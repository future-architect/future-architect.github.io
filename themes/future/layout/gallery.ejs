<%# 部品ギャラリー (#2985)。partial として共通化されている部品を、実物を呼んで並べる。
    /doctor/ と同じ運営用のページで、読者向けには作っていない（head.ejs で noindex、
    /specials/ の一覧にも載せない）。

    **見本は本物の partial を呼ぶ。** 作り直した見本は腐るので置かない
    （スタイルガイドが色を _variables.styl から引くのと同じ流儀 #2856）。

    **並びは 要素 → 部品 → かたまり。** 小さいものから組み上がっていく順で、
    デザインシステムのカタログの通例に合わせる。

    **出すのは見本を持つ部品だけ。** テンプレートの全 partial を並べる場所ではない
    （ページの骨格や head のような見た目を持たないものまで並ぶと、
    「共通の部品はどれか」が読み取れなくなる）。見本を持たない部品は
    scripts/ui_gallery.js の NOT_SHOWN が理由ごと引き受け、
    **どちらでもないものだけ**が /doctor/ の「共通部品の台帳」に警告として出る (#3045)。

    **ここで新しい部品は作らない。** いま共通化されているものだけを展示する。
    どれを部品にするかは #2985 の候補一覧で別に決める %>
<%
  const samples = ui_gallery_samples();
  const samplePost = samples.post;
  // 著者紹介は「_profile.yml に about があり投稿3本以上」でしか出ない (#2567)。
  // 条件を満たす記事でないと見本が空になる
  const authorPost = site.posts.sort('date', -1).toArray()
    .find(function(p){ const pr = get_profile_data(p.author); return pr && pr.about; });
%>
<div class="container">
  <%- partial('_partial/breadcrumb', {items: [
        {label: 'ホーム', url: '/'},
        {label: '特設', url: '/specials/'}
      ]}) %>
  <div class="row">
    <main id="main" tabindex="-1" class="col-md-9 blog-posts">
  <div class="margin-top-30">
    <div class="footer-gap">
      <h1 class="list-page margin-bottom-20">部品ギャラリー</h1>
      <p class="specials-text">テンプレートで共通化されている部品を、実物を呼んで並べたページです。見た目の決まりそのものは <a href="/specials/styleguide/">スタイルガイド</a>、保守用の台帳（呼び出し元と分類の漏れ）は <a href="/doctor/">記事ドクター</a> が持ちます。</p>

      <%- partial('_partial/section-heading', {id: 'elements', text: '要素'}) %>
      <p class="specials-text">それ以上分けられない最小の部品です。絵柄の辞書は <code>_partial/svg-icon.ejs</code> が1箇所で持ち、カテゴリ名との対応は <code>_partial/category-icon.ejs</code> の側にあります。</p>
      <div class="gallery-item">
        <p class="gallery-name"><code>_partial/svg-icon</code></p>
        <ul class="gallery-icons">
          <% ['code','cloud','server','infinity','browser','mountain','brain','database','device-mobile','file-code','device-watch','building-store','chart-dots','users-group','robot','shield-lock','key','augmented-reality','tag','tags','category','users','user','calendar-stats','run-baton','book','speakerphone','crown','rss','external-link','chevron-right','chevron-down','search'].forEach(function(name){ %>
          <li><%- partial('_partial/svg-icon', {icon: name}) %><span class="gallery-note"><%= name %></span></li>
          <% }) %>
        </ul>
      </div>
      <div class="gallery-item">
        <p class="gallery-name"><code>_partial/category-icon</code></p>
        <ul class="gallery-icons">
          <% category_groups().forEach(function(g){ g.categories.forEach(function(c){ %>
          <li><%- partial('_partial/category-icon', {name: c.name}) %><span class="gallery-note"><%= c.name %></span></li>
          <% }); }) %>
        </ul>
      </div>
      <div class="gallery-item">
        <p class="gallery-name"><code>_partial/award-medal・award-name</code></p>
        <%# メダルの色は受賞回数で決まる（灰 → 銅 → 金）。withNumber: false なら
            色だけ使い数字は描かない (#2422) %>
        <ul class="gallery-icons">
          <li><%- partial('_partial/award-medal', {nth: 1}) %><span class="gallery-note">1回</span></li>
          <li><%- partial('_partial/award-medal', {nth: 2}) %><span class="gallery-note">2回</span></li>
          <li><%- partial('_partial/award-medal', {nth: 3}) %><span class="gallery-note">3回</span></li>
          <li><%- partial('_partial/award-medal', {nth: 3, withNumber: false}) %><span class="gallery-note">数字なし</span></li>
        </ul>
        <p class="award-name"><%- partial('_partial/award-name') %></p>
      </div>

      <%- partial('_partial/section-heading', {id: 'components', text: '部品'}) %>
      <p class="specials-text">要素を組んだ、1つの役を持つまとまりです。見本は <a href="<%- url_for(samplePost.path) %>"><%= samplePost.title %></a> の実データを使っています。</p>
      <div class="gallery-item">
        <p class="gallery-name"><code>_partial/section-heading</code></p>
        <%# meta を渡すと行の右端に添えが付く (#2911) %>
        <%- partial('_partial/section-heading', {id: 'sample-heading', text: 'meta なし'}) %>
        <%- partial('_partial/section-heading', {id: 'sample-heading-meta', text: 'meta あり', meta: '全327本'}) %>
      </div>
      <div class="gallery-item">
        <p class="gallery-name"><code>_partial/breadcrumb</code></p>
        <%# url を持たない項目が現在地。2項目未満なら何も出さない (#2837) %>
        <%- partial('_partial/breadcrumb', {items: [
              {label: 'ホーム', url: '/'},
              {label: 'カテゴリ', url: '/categories/'}
            ]}) %>
        <%- partial('_partial/breadcrumb', {items: [
              {label: 'ホーム', url: '/'},
              {label: 'すべての記事', url: '/articles/'},
              {label: '2ページ目'}
            ]}) %>
      </div>
      <div class="gallery-item">
        <p class="gallery-name"><code>_partial/tab-hint</code></p>
        <div class="nav tabs" role="radiogroup" aria-label="見本のタブ">
          <input id="gallery-tab-a" type="radio" name="gallery_tab" checked>
          <label class="tab_item" for="gallery-tab-a">1枚目<%- partial('_partial/tab-hint') %></label>
          <div class="tab_content"><p class="specials-text">タブの帯は radio と label で作ります。矢印キーで切り替えられることは <code>tab-hint</code> が名乗ります（#2852）。</p></div>
          <input id="gallery-tab-b" type="radio" name="gallery_tab">
          <label class="tab_item" for="gallery-tab-b">2枚目<%- partial('_partial/tab-hint') %></label>
          <div class="tab_content"><p class="specials-text">2枚目の中身です。</p></div>
        </div>
      </div>
      <div class="gallery-item">
        <p class="gallery-name"><code>_partial/summary-tiles</code></p>
        <%# 既定はタイル（数値の下にラベル）。sub は内訳の印 (#2096)。
            variant: 'row' はサイドバー用で、列の内寸にタイルを並べられないため (#2911) %>
        <%- partial('_partial/summary-tiles', {items: [
              {value: 1481, label: '投稿'},
              {value: 25599, label: '総シェア数'},
              {value: 12345, label: 'X', sub: true},
              {value: 678, label: 'はてブ', sub: true},
            ]}) %>
        <div class="gallery-sidebar-scale">
          <%- partial('_partial/summary-tiles', {items: [
                {value: 1481, label: '投稿'},
                {value: 25599, label: '総シェア数'},
                {value: 12345, label: 'X', sub: true},
              ], variant: 'row'}) %>
        </div>
      </div>
      <div class="gallery-item">
        <p class="gallery-name"><code>_partial/sidebar-summary-panel</code></p>
        <%# 統計の枠。中身は summary-tiles の行組み。recent を渡すと
            「累計 / 直近1年」の対になり、渡さなければラベルを置かない %>
        <div class="gallery-sidebar-scale">
          <%- partial('_partial/sidebar-summary-panel', {
                total: [
                  {value: 1481, label: '投稿'},
                  {value: 25599, label: '総シェア数'},
                  {value: 12345, label: 'X', sub: true},
                ],
                recent: [{value: 107, label: '投稿'}],
              }) %>
        </div>
      </div>
      <div class="gallery-item">
        <p class="gallery-name"><code>_partial/pagination-info</code></p>
        <%- partial('_partial/pagination-info', {total: 327, page: {current: 2}}) %>
      </div>
      <div class="gallery-item">
        <p class="gallery-name"><code>_partial/toc-list</code></p>
        <%- partial('_partial/toc-list', {items: [{id: 'elements', text: '要素'}, {id: 'components', text: '部品'}, {id: 'patterns', text: 'かたまり'}]}) %>
      </div>
      <div class="gallery-item">
        <p class="gallery-name"><code>_partial/post/date・post/tag・post/title・post/category</code></p>
        <ul class="blog-info">
          <li class="blog-info-item"><%- partial('_partial/post/date', {post: samplePost, class_name: 'archive-article-date', date_format: 'YYYY.MM.DD'}) %></li>
          <%- post_author_link(samplePost) %>
        </ul>
        <div class="article-header-tags"><%- partial('_partial/post/tag', {post: samplePost}) %></div>
        <%- partial('_partial/post/title', {post: samplePost, class_name: 'archive-post-title'}) %>
        <% if (samplePost.categories && samplePost.categories.length) { %>
        <p><%- partial('_partial/post/category', {cat: samplePost.categories.first()}) %></p>
        <% } %>
      </div>
      <div class="gallery-item">
        <p class="gallery-name"><code>_partial/tag-chips</code></p>
        <%# 右肩の件数（count）は「タグ総数」の意味だけに使う (#2129)。
            渡さなければ名前だけのチップになる %>
        <div class="blog-tags">
          <%- partial('_partial/tag-chips', {items: recent_popular_tags(6).map(function(t){
                return {name: t.name, path: t.path, count: t.count, title: `${t.name} の記事 ${t.count}本`};
              })}) %>
          <%- partial('_partial/tag-chips', {items: recent_popular_tags(3).map(function(t){
                return {name: t.name, path: t.path};
              })}) %>
        </div>
      </div>
      <div class="gallery-item">
        <p class="gallery-name"><code>_partial/tendency-panels</code></p>
        <%# カテゴリはチップにせずテキストリンク＋アイコン、タグはチップ。
            この見分けが2つの枝の理由そのもの %>
        <%- partial('_partial/tendency-panels', {kind: 'category', items: category_groups()[0].categories.slice(0, 3).map(function(c){
              return {name: c.name, path: c.path, title: `${c.name} カテゴリの記事へ`, note: `${c.count}本が所属`};
            })}) %>
        <%- partial('_partial/tendency-panels', {kind: 'tag', items: recent_popular_tags(3).map(function(t){
              return {name: t.name, path: t.path, title: `${t.name} タグの記事へ`, note: `${t.count}本で使用`};
            })}) %>
      </div>
      <div class="gallery-item">
        <p class="gallery-name"><code>_partial/social-button</code></p>
        <%- partial('_partial/social-button', {post: samplePost, actions: true}) %>
      </div>

      <%- partial('_partial/section-heading', {id: 'patterns', text: 'かたまり'}) %>
      <p class="specials-text">部品を組んで、そのまま画面の一区画になるものです。</p>
      <div class="gallery-item">
        <p class="gallery-name"><code>_partial/archive-post</code></p>
        <%# index は「一覧の中か」。true だと lede の代わりに本文全文を出す %>
        <%- partial('_partial/archive-post', {post: samplePost, index: false}) %>
      </div>
      <div class="gallery-item">
        <p class="gallery-name"><code>_partial/panel-card</code></p>
        <%# 名札あり・サムネ無し・別タブの3通り。列は呼び出し側が持つので、
            見本でも col を書いて並べる %>
        <div class="series-panels row g-4">
          <div class="col-12 col-md-6">
            <%- partial('_partial/panel-card', {
                  url: url_for(samplePost.path),
                  title: samplePost.title,
                  thumb: {src: samplePost.thumbnail, width: 200, height: 135},
                  label: {icon: 'run-baton', text: '連載'},
                  meta: '全9本・2026.08 更新',
                  more: {url: '/series/', text: '連載一覧へ'},
                }) %>
          </div>
          <div class="col-12 col-md-6">
            <%- partial('_partial/panel-card', {
                  url: 'https://atcoder.jp/',
                  title: 'サムネイルの無いカード（別タブで開く）',
                  meta: 'panel-thumb-empty で行頭を揃える',
                  external: true,
                }) %>
          </div>
        </div>
      </div>
      <div class="gallery-item">
        <p class="gallery-name"><code>_partial/post-panel-grid</code></p>
        <%- partial('_partial/post-panel-grid', {posts: samples.panelPosts}) %>
      </div>
      <% if (authorPost) { %>
      <div class="gallery-item">
        <p class="gallery-name"><code>_partial/author-box</code></p>
        <%- partial('_partial/author-box', {post: authorPost}) %>
      </div>
      <% } %>
      <div class="gallery-item">
        <p class="gallery-name"><code>_widget/category・series・tag</code></p>
        <%# サイドバーの列の内寸（208〜298px #2943）で描く。本文の幅で見ると実物と違って見える。
            枠の見出し（「活発なカテゴリ」など）はここに書かない。文字列を二重に持つと、
            サイドバー側で言い換えたときにこのページだけが古い名前を出す %>
        <div class="gallery-sidebar-scale">
          <%- partial('_widget/category') %>
          <%- partial('_widget/series') %>
          <div class="blog-tags"><%- partial('_widget/tag') %></div>
        </div>
      </div>
    </div>
  </div>
    </main>
    <aside class="col-md-3 blog-sidebar">
      <%- partial('_partial/sidebar', {specialsToc: [
        {id: 'elements', text: '要素'},
        {id: 'components', text: '部品'},
        {id: 'patterns', text: 'かたまり'},
      ]}) %>
    </aside>
  </div>
</div>
