{
    "customRules": ["./.markdownlint/heading-vocab.cjs"],
    "config": {
      "heading-vocab": true, // 見出しの表記ゆれを止める（.markdownlint/heading-vocab.cjs）
      "line-length": false, // MD013  行の長さ
      "no-hard-tabs": false, // MD010 Markdown中にTSVを書くとエラーになるため
      "no-duplicate-heading": false, // MD024 - Multiple headings with the same content
      "no-trailing-punctuation": false, // MD026 ヘディングに句読点（.,;:!?）を許容したい
      "no-alt-text": false, // MD045 画像のalt。2,058件あり、書くのは人なので止めない
      "table-column-style": false, // MD060 表のパイプ揃え。自動修正が無く、全角では文字数を揃えても表示は揃わない
      "commands-show-output": false, // MD014 シェル例の $ を外す修正が入る。コード例は著者の書いたまま残す
      "ol-prefix": false, // MD029 番号を振り直す修正が入る。引用中の採番や 0 始まりを壊す
      "no-inline-html": false, // MD033 HTMLは許容
      "hr-style": "---", // MD035 水平線。多数派に揃える
      "no-bare-urls": false, // MD034 URLのリンク化条件
      "no-blanks-blockquote": false, // MD028 空行で区切った連続する引用は別々の引用。> を足すと1つに統合されてしまう
      "no-space-in-emphasis":false, // MD037  $$など数式で問題になったため外す
      "link-fragments":false // MD051 相対パス設定
    },
    "ignores": [".git", "node_modules"] // 無視するディレクトリ
}
  