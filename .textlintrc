{
  "filters": {
    "comments": true,
    "allowlist": {
      "allow": [
        "...",
        "ML",
        "entity",
        "git",
        "github.com",
        "✧+(0゚・∀・)",
        "あるある",
        "まあまあ",
        "みみみ",
        "チェーン",
        "ドキュメンテーション",
        "ワード",
        "・・・",
        "運用もチーム連携もコンプラ対応も",
        "ヽ(*゚д゚)ノ",
        "世界135",
        "実用",
        "引用",
        "知らない",
        "運用",
        "！！",
        "！？",
        "？",
        "ｶﾞｻｺﾞｿ",
        "ｽﾔｧ",
        "ﾏﾀﾞｰ",
        "ﾜｧｲ"
      ]
    }
  },
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": {
        "max": 200
      },
      "no-exclamation-question-mark": false,
      "ja-no-weak-phrase": false,
      "max-kanji-continuous-len": {
        "max": 10
      },
      "ja-no-redundant-expression": {
        "dictOptions": {
          "dict3": { "disabled": true },
          "dict4": { "disabled": true }
        }
      },
      "ja-no-successive-word": {
        "allow": [
          "/^[^\\p{L}\\p{N}]+$/u",
          "〇", "ｗ", "ｘ",
          "一つ", "１つ", "ほど", "ほぼ", "もっと", "よく", "など", "なぜ", "なに", "そう",
          "また", "さて", "はい", "どこ", "ぜひ", "え", "ええ", "いやいや", "どーも", "まぁ",
          "都度", "毎度", "感謝", "安い", "長い", "少々", "強", "つよ", "がっ", "ばい",
          "おれ", "めでたし", "ごめん", "よし", "飛ばし", "フル", "担", "まごう"
        ]
      }
    },
    "prh": {
      "rulePaths": ["./prh.yml"]
    }
  }
}
