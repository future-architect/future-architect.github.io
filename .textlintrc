{
  "filters": {
    "comments": true,
    "allowlist": {
      "allow": [
        "...",
        "ML",
        "entity",
        "git",
        "github.com",
        "✧+(0゚・∀・)",
        "あるある",
        "まあまあ",
        "チェーン",
        "ドキュメンテーション",
        "ワード",
        "・・・",
        "ヽ(*゚д゚)ノ",
        "世界135",
        "実用",
        "引用",
        "知らない",
        "運用",
        "！！",
        "！？",
        "？",
        "ｶﾞｻｺﾞｿ",
        "ｽﾔｧ",
        "ﾏﾀﾞｰ",
        "ﾜｧｲ"
      ]
    }
  },
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": {
        "max": 200
      },
      "no-exclamation-question-mark": false,
      "ja-no-weak-phrase": false,
      "max-kanji-continuous-len": {
        "max": 10
      }
    },
    "prh": {
      "rulePaths": ["./prh.yml"]
    }
  }
}
