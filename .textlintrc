{
  "filters": {
    "comments": true,
    "allowlist": {
      "allow": [
        "運用",
        "ｶﾞｻｺﾞｿ",
        "ｽﾔｧ",
        "ﾏﾀﾞｰ",
        "ﾜｧｲ",
        "！！",
        "？",
        "git",
        "github.com",
        "..."
      ]
    }
  },
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": {
        "max": 200
      },
      "no-exclamation-question-mark": false,
      "ja-no-weak-phrase": false,
      "max-kanji-continuous-len": {
        "max": 10
      }
    },
    "prh": {
      "rulePaths": ["./prh.yml"]
    }
  }
}
